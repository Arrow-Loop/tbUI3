# Store every file byte-for-byte (no CRLF/LF conversion)
* -text

# twinBASIC project and package containers are binary; never touch line endings
*.twinproj binary
*.twinpack binary
*.ico binary
*.bmp binary
*.png binary

# Exported twinBASIC sources: keep exactly as the exporter writes them
*.twin -text diff
*.tbform -text diff
*.tbcontrol -text diff
Settings -text diff

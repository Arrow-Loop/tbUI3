Module AutoCompleteGuids

Public Type [_AC_GUID]
	Data1 As Long
	Data2 As Integer
	Data3 As Integer
	Data4(0 To 7) As Byte
End Type

End Module

Module [_AC_KERNEL32]

[UseGetLastError(False)]
Public Declare PtrSafe Sub [_CopyMemory] Lib "KERNEL32.DLL" Alias "RtlMoveMemory" (ByRef Destination As Any, ByRef Source As Any, ByVal Length As Long)

End Module

Module [_AC_OLE32]

[UseGetLastError(False)]
Public Declare PtrSafe Function [_CoTaskMemAlloc] Lib "OLE32.DLL" Alias "CoTaskMemAlloc" (ByVal cBytes As Long) As LongPtr
[UseGetLastError(False)]
Public Declare PtrSafe Sub [_CoTaskMemFree] Lib "OLE32.DLL" Alias "CoTaskMemFree" (ByVal hMem As LongPtr)

End Module
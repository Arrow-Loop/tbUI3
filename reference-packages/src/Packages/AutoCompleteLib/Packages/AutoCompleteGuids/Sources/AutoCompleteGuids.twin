/*
This package substitutes the AutoCompleteGuids.tlb in projects with 64-bit versions, though it can be used in 32-bit as well.
*/

[InterfaceId("00000101-0000-0000-C000-000000000046")]
[OleAutomation(False)]
Interface IEnumString Extends stdole.IUnknown
    Sub Next(ByVal cElt As Long, ByVal rgElt As LongPtr, ByVal lpcEltFetched As LongPtr)
    Sub Skip(ByVal cElt As Long)
    Sub Reset()
    Sub Clone(ByRef ppEnum As AutoCompleteGuids.IEnumString)
End Interface

[InterfaceId("E1EEF6A0-0378-11E3-8FFD-0800200C9A66")]
' [ DualInterface, DispInterface ]
Interface IEnumStringVB Extends stdole.IDispatch
    [DispId(1)]
    Sub Next(ByRef RetVal As Long, ByVal cElt As Long, ByVal rgElt As LongPtr, ByVal lpcEltFetched As LongPtr)
    [DispId(2)]
    Sub Skip(ByRef RetVal As Long, ByVal cElt As Long)
    [DispId(3)]
    Sub Reset(ByRef RetVal As Long)
    [DispId(4)]
    Sub Clone(ByRef RetVal As Long, ByVal lppEnum As LongPtr)
End Interface


Module OLEGuids

Public Type OLERECT
	Left As Long
	Top As Long
	Right As Long
	Bottom As Long
End Type

Public Type OLEPOINT
    X As Long
    Y As Long
End Type

Public Type OLEACCELMSG
    hWnd As LongPtr
    Message As Long
    wParam As LongPtr
    lParam As LongPtr
    Time As Long
    PT As OLEPOINT
End Type
    
Public Type OLESIZE
	CX As Long
    CY As Long
End Type

Public Type OLEINPLACEFRAMEINFO
	cb As Long
	fMDIApp As Long
	hWndFrame As LongPtr
	hAccel As LongPtr
	cAccelEntries As Long
End Type

Public Type OLECONTROLINFO
    cb As Long
    hAccel As LongPtr
    cAccel As Integer
    dwFlags As Long
End Type

Public Type OLECLSID
	Data1 As Long
	Data2 As Integer
	Data3 As Integer
	Data4(0 To 7) As Byte
End Type

Public Type OLEDISPPARAMS
    rgvarg As LongPtr
    rgdispidNamedArgs As LongPtr
    cArgs As Long
    cNamedArgs As Long
End Type

Public Type OLECAUUID
    cElems As Long
    pElems As LongPtr
End Type

Public Type OLECALPOLESTR
    cElems As Long
    pElems As LongPtr
End Type

Public Type OLECADWORD
    cElems As Long
    pElems As LongPtr
End Type

End Module
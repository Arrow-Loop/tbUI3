' =====================================================
' mAesUsage.twin - AES Usage Examples
' TwinBASIC Project - Crypto Module - AES
' =====================================================
' This module demonstrates how to use the cAes class with
' all supported cipher modes (ECB, CBC, CFB, OFB, CTR, GCM)
' using both CryptoAPI and CNG backends.
' =====================================================

Option Explicit

Public Module mAesUsage

    ' =====================================================
    ' Local Helper Function: Convert bytes to hex string
    ' =====================================================
    Private Function BytesToHex(ByRef bytes() As Byte) As String
        On Error GoTo ErrorHandler
        
        If UBound(bytes) < LBound(bytes) Then
            BytesToHex = ""
            Exit Function
        End If
        
        Dim result As String
        result = ""
        
        Dim i As Long
        For i = LBound(bytes) To UBound(bytes)
            result = result & Right$("0" & Hex$(bytes(i)), 2)
        Next i
        
        BytesToHex = result
        Exit Function
        
ErrorHandler:
        BytesToHex = ""
    End Function

    ' =====================================================
    ' Example 1: Basic CBC Mode (Most Common)
    ' Uses CryptoAPI backend
    ' =====================================================
    Public Sub Example_CBC_Basic()
        Debug.Print "=== Example 1: CBC Mode (CryptoAPI) ==="
        
        Dim aes As cAes = New cAes
        
        ' Set key and IV
        aes.SetKeyFromString "MySecretKey12345"
        aes.GenerateRandomIV
        
        ' Encrypt
        Dim plainText As String
        plainText = "Hello, AES Encryption!"
        
        Dim cipherText As String
        cipherText = aes.EncryptString(plainText)
        Debug.Print "Encrypted: " & cipherText
        
        ' Decrypt
        Dim decryptedText As String
        decryptedText = aes.DecryptString(cipherText)
        Debug.Print "Decrypted: " & decryptedText
        
        Set aes = Nothing
    End Sub

    ' =====================================================
    ' Example 2: ECB Mode (Not Recommended for Production)
    ' Uses CryptoAPI backend
    ' =====================================================
    Public Sub Example_ECB()
        Debug.Print "=== Example 2: ECB Mode (CryptoAPI) ==="
        
        Dim aes As cAes = New cAes
        
        ' Set mode to ECB
        aes.CipherMode = AesCipherMode.ECB
        aes.SetKeyFromString "MySecretKey12345"
        
        Dim plainText As String
        plainText = "Hello, AES Encryption!"
        
        Dim cipherText As String
        cipherText = aes.EncryptString(plainText)
        Debug.Print "Encrypted: " & cipherText
        
        Dim decryptedText As String
        decryptedText = aes.DecryptString(cipherText)
        Debug.Print "Decrypted: " & decryptedText
        
        Set aes = Nothing
    End Sub

    ' =====================================================
    ' Example 3: CFB Mode (Requires CNG)
    ' Uses CNG backend
    ' =====================================================
    Public Sub Example_CFB()
        Debug.Print "=== Example 3: CFB Mode (CNG) ==="
        
        ' Check if CNG is available
        If Not mWin32CNG.IsCNGAvailable() Then
            Debug.Print "CNG not available (requires Vista or later)"
            Exit Sub
        End If
        
        Dim aes As cAes = New cAes
        
        ' Set mode to CFB
        aes.CipherMode = AesCipherMode.CFB
        aes.SetKeyFromString "MySecretKey12345"
        aes.GenerateRandomIV
        
        Dim plainText As String
        plainText = "Hello, AES CFB Mode!"
        
        Dim cipherText As String
        cipherText = aes.EncryptString(plainText)
        Debug.Print "Encrypted: " & cipherText
        
        Dim decryptedText As String
        decryptedText = aes.DecryptString(cipherText)
        Debug.Print "Decrypted: " & decryptedText
        
        Set aes = Nothing
    End Sub


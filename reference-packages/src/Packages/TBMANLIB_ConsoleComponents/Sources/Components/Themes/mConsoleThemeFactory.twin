' =====================================================
' mConsoleThemeFactory.twin - Theme Factory Module
' Modern Console Library for TwinBASIC - Components
' =====================================================

Public Module mConsoleThemeFactory

    ' Create default (dark) theme
    Public Function CreateDefault() As cConsoleTheme
        Dim theme As New cConsoleTheme
        theme.Background = ConsoleColor.Black
        theme.Foreground = ConsoleColor.Gray
        theme.Primary = ConsoleColor.Blue
        theme.Secondary = ConsoleColor.DarkGray
        theme.Success = ConsoleColor.Green
        theme.Warning = ConsoleColor.Yellow
        theme.Error = ConsoleColor.Red
        theme.Info = ConsoleColor.Cyan
        theme.Muted = ConsoleColor.DarkGray
        theme.Border = ConsoleColor.DarkGray
        theme.HeaderBackground = ConsoleColor.DarkBlue
        theme.HeaderForeground = ConsoleColor.White
        theme.SelectedBackground = ConsoleColor.DarkBlue
        theme.SelectedForeground = ConsoleColor.White
        Return theme
    End Function

    ' Create HTOP-style theme
    Public Function CreateHTOP() As cConsoleTheme
        Dim theme As New cConsoleTheme
        theme.Background = ConsoleColor.Black
        theme.Foreground = ConsoleColor.Gray
        theme.Primary = ConsoleColor.Cyan
        theme.Secondary = ConsoleColor.DarkBlue
        theme.Success = ConsoleColor.Green
        theme.Warning = ConsoleColor.Yellow
        theme.Error = ConsoleColor.Red
        theme.Info = ConsoleColor.Cyan
        theme.Muted = ConsoleColor.DarkGray
        theme.Border = ConsoleColor.Gray
        theme.HeaderBackground = ConsoleColor.DarkBlue
        theme.HeaderForeground = ConsoleColor.White
        theme.SelectedBackground = ConsoleColor.Blue
        theme.SelectedForeground = ConsoleColor.White
        Return theme
    End Function

    ' Create light theme
    Public Function CreateLight() As cConsoleTheme
        Dim theme As New cConsoleTheme
        theme.Background = ConsoleColor.White
        theme.Foreground = ConsoleColor.Black
        theme.Primary = ConsoleColor.Blue
        theme.Secondary = ConsoleColor.Gray
        theme.Success = ConsoleColor.DarkGreen
        theme.Warning = ConsoleColor.DarkYellow
        theme.Error = ConsoleColor.DarkRed
        theme.Info = ConsoleColor.DarkCyan
        theme.Muted = ConsoleColor.Gray
        theme.Border = ConsoleColor.Gray
        theme.HeaderBackground = ConsoleColor.DarkGray
        theme.HeaderForeground = ConsoleColor.White
        theme.SelectedBackground = ConsoleColor.Gray
        theme.SelectedForeground = ConsoleColor.Black
        Return theme
    End Function

End Module

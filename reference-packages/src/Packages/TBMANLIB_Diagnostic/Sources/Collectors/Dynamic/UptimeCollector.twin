' =====================================================
' UptimeCollector.twin - 系统运行时间收集器
' Twinbasic Diagnostic Tool
' =====================================================

' 系统运行时间收集器
' 刷新模式：Dynamic（每次刷新都获取）
' 使用 GetTickCount64 获取运行时间
[ ClassId ("08A2B3C4-D5E6-F7A8-B9C0-D1E2F3A4B5C6") ]
[ InterfaceId ("08A2B3C4-D5E6-F7A8-B9C0-D1E2F3A4B5C7") ]
Public Class UptimeCollector
    Implements IDiagnosticCollector

    ' === IDiagnosticCollector 实现 ===

    Public Property Get IDiagnosticCollector_CategoryName() As String
        Return "Uptime"
    End Property

    Public Property Get IDiagnosticCollector_Description() As String
        Return "System uptime since last boot"
    End Property

    Public Property Get IDiagnosticCollector_RefreshMode() As RefreshMode
        Return RefreshMode.Dynamic
    End Property

    Public Property Get IDiagnosticCollector_RequiresElevation() As Boolean
        Return False
    End Property

    Public Property Get IDiagnosticCollector_SupportsSummary() As Boolean
        Return False
    End Property

    Public Function IDiagnosticCollector_Collect() As DiagnosticResult(Of KeyValuePair(Of String, String))
        Dim result As DiagnosticResult(Of KeyValuePair(Of String, String))
        Set result = New DiagnosticResult(Of KeyValuePair(Of String, String))("Uptime")

        ' 获取系统运行时间（毫秒）
        Dim uptimeMs As LongLong = GetTickCount64()

        ' 格式化为人类可读格式
        result.AddItem New KeyValuePair(Of String, String)("Uptime", _
            FormatHelper.FormatUptime(uptimeMs))

        ' 计算各个时间单位
        Dim totalSeconds As LongLong = uptimeMs \ 1000
        Dim totalMinutes As LongLong = totalSeconds \ 60
        Dim totalHours As LongLong = totalMinutes \ 60
        Dim totalDays As LongLong = totalHours \ 24

        result.AddItem New KeyValuePair(Of String, String)("Total Days", CStr(totalDays))
        result.AddItem New KeyValuePair(Of String, String)("Total Hours", CStr(totalHours))
        result.AddItem New KeyValuePair(Of String, String)("Total Seconds", CStr(totalSeconds))

        ' 计算启动时间
        Dim bootTime As Date = Now - (CDbl(uptimeMs) / 86400000#)
        result.AddItem New KeyValuePair(Of String, String)("Boot Time", _
            FormatHelper.FormatDateTime(bootTime))

        Return result
    End Function

    Public Function IDiagnosticCollector_CollectSummary() As DiagnosticResult(Of KeyValuePair(Of String, String))
        Return IDiagnosticCollector_Collect()
    End Function

End Class

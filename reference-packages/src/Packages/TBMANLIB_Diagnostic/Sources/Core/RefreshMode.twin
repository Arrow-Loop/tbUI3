' =====================================================
' RefreshMode.twin - 刷新模式枚举
' Twinbasic Diagnostic Tool
' =====================================================

Public Module RefreshModeModule

' 收集器刷新模式枚举
' 用于标识收集器数据的变化频率
Public Enum RefreshMode
    Static = 0       ' 只获取一次，数据不变化（如 OS 版本、CPU 型号）
    Dynamic = 1      ' 每次刷新都获取（如 CPU 使用率、内存占用）
    SemiDynamic = 2  ' 可选刷新，变化较慢（如磁盘空间、网络配置）
End Enum

End Module

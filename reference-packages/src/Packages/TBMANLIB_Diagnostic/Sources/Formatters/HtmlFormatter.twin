' =====================================================
' HtmlFormatter.twin - HTML 格式化器
' Twinbasic Diagnostic Tool
' =====================================================

' HTML 格式化器
' 输出带样式的 HTML 报告
[ ClassId ("22A2B3C4-D5E6-F7A8-B9C0-D1E2F3A4B5C6") ]
[ InterfaceId ("22A2B3C4-D5E6-F7A8-B9C0-D1E2F3A4B5C7") ]
Public Class HtmlFormatter
    Implements IOutputFormatter

    Private m_Builder As StringBuilder
    Private m_InCategory As Boolean

    ' 构造函数
    Public Sub New()
        Set m_Builder = New StringBuilder
        m_InCategory = False
    End Sub

    ' === IOutputFormatter 实现 ===

    Public Property Get IOutputFormatter_FileExtension() As String
        Return ".html"
    End Property

    Public Property Get IOutputFormatter_FormatterName() As String
        Return "HTML"
    End Property

    Public Sub IOutputFormatter_BeginFormat()
        m_Builder.Clear
        m_InCategory = False

        ' HTML 头部和样式
        m_Builder.AppendLine "<!DOCTYPE html>"
        m_Builder.AppendLine "<html lang=""en"">"
        m_Builder.AppendLine "<head>"
        m_Builder.AppendLine "  <meta charset=""UTF-8"">"
        m_Builder.AppendLine "  <meta name=""viewport"" content=""width=device-width, initial-scale=1.0"">"
        m_Builder.AppendLine "  <title>Twinbasic Diagnostic Report</title>"
        m_Builder.AppendLine "  <style>"
        m_Builder.AppendLine GetCSSStyles()
        m_Builder.AppendLine "  </style>"
        m_Builder.AppendLine "</head>"
        m_Builder.AppendLine "<body>"
        m_Builder.AppendLine "  <div class=""container"">"
        m_Builder.AppendLine "    <header>"
        m_Builder.AppendLine "      <h1>Twinbasic Diagnostic Report</h1>"
        m_Builder.AppendLine "      <p class=""timestamp"">Generated: " & FormatHelper.FormatDateTime(Now) & "</p>"
        m_Builder.AppendLine "    </header>"
        m_Builder.AppendLine "    <main>"
    End Sub

    Public Sub IOutputFormatter_FormatCategory(ByVal categoryName As String)
        ' 如果已经在类别中，先结束
        If m_InCategory Then
            IOutputFormatter_EndCategory
        End If

        m_Builder.AppendLine "      <section class=""category"">"
        m_Builder.AppendLine "        <h2>" & FormatHelper.EscapeHtml(categoryName) & "</h2>"
        m_Builder.AppendLine "        <table>"
        m_Builder.AppendLine "          <tbody>"
        m_InCategory = True
    End Sub

    Public Sub IOutputFormatter_FormatItem(ByVal key As String, ByVal value As String)
        m_Builder.AppendLine "            <tr>"
        m_Builder.AppendLine "              <td class=""key"">" & FormatHelper.EscapeHtml(key) & "</td>"
        m_Builder.AppendLine "              <td class=""value"">" & FormatHelper.EscapeHtml(value) & "</td>"
        m_Builder.AppendLine "            </tr>"
    End Sub

    Public Sub IOutputFormatter_EndCategory()
        If m_InCategory Then
            m_Builder.AppendLine "          </tbody>"
            m_Builder.AppendLine "        </table>"
            m_Builder.AppendLine "      </section>"
            m_InCategory = False
        End If
    End Sub

    Public Function IOutputFormatter_EndFormat() As String
        ' 如果还在类别中，结束它
        If m_InCategory Then
            IOutputFormatter_EndCategory
        End If

        ' HTML 尾部
        m_Builder.AppendLine "    </main>"
        m_Builder.AppendLine "    <footer>"
        m_Builder.AppendLine "      <p>Twinbasic Diagnostic Tool v1.0</p>"
        m_Builder.AppendLine "    </footer>"
        m_Builder.AppendLine "  </div>"
        m_Builder.AppendLine "</body>"
        m_Builder.AppendLine "</html>"

        Return m_Builder.ToString()
    End Function

    ' === 私有方法 ===

    Private Function GetCSSStyles() As String
        Dim css As StringBuilder
        Set css = New StringBuilder

        css.AppendLine "    :root {"
        css.AppendLine "      --bg-color: #f5f5f5;"
        css.AppendLine "      --card-bg: #ffffff;"
        css.AppendLine "      --text-color: #333333;"
        css.AppendLine "      --border-color: #e0e0e0;"
        css.AppendLine "      --header-bg: #2196f3;"
        css.AppendLine "      --header-text: #ffffff;"
        css.AppendLine "      --key-color: #666666;"
        css.AppendLine "    }"
        css.AppendLine ""
        css.AppendLine "    @media (prefers-color-scheme: dark) {"
        css.AppendLine "      :root {"
        css.AppendLine "        --bg-color: #1a1a1a;"
        css.AppendLine "        --card-bg: #2d2d2d;"
        css.AppendLine "        --text-color: #e0e0e0;"
        css.AppendLine "        --border-color: #404040;"
        css.AppendLine "        --header-bg: #1565c0;"
        css.AppendLine "        --key-color: #9e9e9e;"
        css.AppendLine "      }"
        css.AppendLine "    }"
        css.AppendLine ""
        css.AppendLine "    * { box-sizing: border-box; margin: 0; padding: 0; }"
        css.AppendLine ""
        css.AppendLine "    body {"
        css.AppendLine "      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;"
        css.AppendLine "      background-color: var(--bg-color);"
        css.AppendLine "      color: var(--text-color);"
        css.AppendLine "      line-height: 1.6;"
        css.AppendLine "    }"
        css.AppendLine ""
        css.AppendLine "    .container {"
        css.AppendLine "      max-width: 900px;"
        css.AppendLine "      margin: 0 auto;"
        css.AppendLine "      padding: 20px;"
        css.AppendLine "    }"
        css.AppendLine ""
        css.AppendLine "    header {"
        css.AppendLine "      background: var(--header-bg);"
        css.AppendLine "      color: var(--header-text);"
        css.AppendLine "      padding: 30px;"
        css.AppendLine "      border-radius: 8px 8px 0 0;"
        css.AppendLine "      text-align: center;"
        css.AppendLine "    }"
        css.AppendLine ""
        css.AppendLine "    header h1 { font-size: 1.8em; margin-bottom: 10px; }"
        css.AppendLine "    header .timestamp { opacity: 0.9; font-size: 0.9em; }"
        css.AppendLine ""
        css.AppendLine "    main { background: var(--card-bg); padding: 20px; }"
        css.AppendLine ""
        css.AppendLine "    .category {"
        css.AppendLine "      margin-bottom: 25px;"
        css.AppendLine "      border: 1px solid var(--border-color);"
        css.AppendLine "      border-radius: 6px;"
        css.AppendLine "      overflow: hidden;"
        css.AppendLine "    }"
        css.AppendLine ""
        css.AppendLine "    .category h2 {"
        css.AppendLine "      background: var(--border-color);"
        css.AppendLine "      padding: 12px 15px;"
        css.AppendLine "      font-size: 1.1em;"
        css.AppendLine "      font-weight: 600;"
        css.AppendLine "    }"
        css.AppendLine ""
        css.AppendLine "    table { width: 100%; border-collapse: collapse; }"
        css.AppendLine ""
        css.AppendLine "    tr { border-bottom: 1px solid var(--border-color); }"
        css.AppendLine "    tr:last-child { border-bottom: none; }"
        css.AppendLine ""
        css.AppendLine "    td { padding: 10px 15px; }"
        css.AppendLine "    td.key { color: var(--key-color); width: 40%; font-weight: 500; }"
        css.AppendLine "    td.value { word-break: break-word; }"
        css.AppendLine ""
        css.AppendLine "    footer {"
        css.AppendLine "      background: var(--card-bg);"
        css.AppendLine "      padding: 15px;"
        css.AppendLine "      text-align: center;"
        css.AppendLine "      border-radius: 0 0 8px 8px;"
        css.AppendLine "      border-top: 1px solid var(--border-color);"
        css.AppendLine "      color: var(--key-color);"
        css.AppendLine "      font-size: 0.9em;"
        css.AppendLine "    }"
        css.AppendLine ""
        css.AppendLine "    @media print {"
        css.AppendLine "      body { background: white; }"
        css.AppendLine "      .container { max-width: none; }"
        css.AppendLine "    }"

        Return css.ToString()
    End Function

End Class

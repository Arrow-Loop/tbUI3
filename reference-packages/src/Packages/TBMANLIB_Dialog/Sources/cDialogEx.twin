    ' 比较 two GUID 是否相等
    Private Function IsEqualGUID(ByRef g1 As GUID, ByRef g2 As GUID) As Boolean
        IsEqualGUID = (g1.Data1 = g2.Data1) AndAlso _
                      (g1.Data2 = g2.Data2) AndAlso _
                      (g1.Data3 = g2.Data3) AndAlso _
                      (g1.Data4(0) = g2.Data4(0)) AndAlso _
                      (g1.Data4(1) = g2.Data4(1)) AndAlso _
                      (g1.Data4(2) = g2.Data4(2)) AndAlso _
                      (g1.Data4(3) = g2.Data4(3)) AndAlso _
                      (g1.Data4(4) = g2.Data4(4)) AndAlso _
                      (g1.Data4(5) = g2.Data4(5)) AndAlso _
                      (g1.Data4(6) = g2.Data4(6)) AndAlso _
                      (g1.Data4(7) = g2.Data4(7))
    End Function

    '=====================================================================
    ' COM 事件接收器 - 创建与销毁
    ' 手动构建 vtable + 对象结构，模拟 COM IFileDialogEvents 接口实现
    '=====================================================================

    ' 创建 COM 事件接收器
    ' 对象布局：[vtable_ptr (LongPtr)] [hIcon (LongPtr)] [cRef (Long, 对齐到 PtrSize)]
    Private Sub CreateEventSink()
        On Error Resume Next

        ' 分配 vtable（10 个指针槽位）
        m_pVTable = AllocMem(FDE_VTABLE_SLOTS * LenB(Of LongPtr))
        If m_pVTable = 0 Then Exit Sub

        ' 填充 vtable 槽位（IUnknown 3 + IFileDialogEvents 7）
        ' 使用 AddressOf Me.method 创建绑定到当前实例的回调 thunk
        PutMemPtr m_pVTable + 0 * LenB(Of LongPtr), AddressOf Me.Sink_QueryInterface
        PutMemPtr m_pVTable + 1 * LenB(Of LongPtr), AddressOf Me.Sink_AddRef
        PutMemPtr m_pVTable + 2 * LenB(Of LongPtr), AddressOf Me.Sink_Release
        PutMemPtr m_pVTable + 3 * LenB(Of LongPtr), AddressOf Me.Sink_OnFileOk
        PutMemPtr m_pVTable + 4 * LenB(Of LongPtr), AddressOf Me.Sink_OnFolderChanging
        PutMemPtr m_pVTable + 5 * LenB(Of LongPtr), AddressOf Me.Sink_OnFolderChange
        PutMemPtr m_pVTable + 6 * LenB(Of LongPtr), AddressOf Me.Sink_OnSelectionChange
        PutMemPtr m_pVTable + 7 * LenB(Of LongPtr), AddressOf Me.Sink_OnShareViolation
        PutMemPtr m_pVTable + 8 * LenB(Of LongPtr), AddressOf Me.Sink_OnTypeChange
        PutMemPtr m_pVTable + 9 * LenB(Of LongPtr), AddressOf Me.Sink_OnOverwrite

        ' 分配对象内存（3 个指针大小的槽位，确保对齐）
        ' [0] vtable_ptr, [PtrSize] hIcon, [2*PtrSize] cRef(padded)
        m_pSinkObj = AllocMem(3 * LenB(Of LongPtr))
        If m_pSinkObj = 0 Then
            FreeMem m_pVTable
            m_pVTable = 0
            Exit Sub
        End If

        ' 填充对象字段
        PutMemPtr m_pSinkObj, m_pVTable           ' offset 0: vtable 指针
        PutMemPtr m_pSinkObj + LenB(Of LongPtr), m_IconHandle  ' offset PtrSize: 图标句柄
        PutMem4 m_pSinkObj + 2 * LenB(Of LongPtr), 1           ' offset 2*PtrSize: 引用计数 = 1

        m_IconApplied = False
    End Sub

    ' 销毁 COM 事件接收器
    Private Sub DestroyEventSink()
        On Error Resume Next
        If m_pSinkObj <> 0 Then
            FreeMem m_pSinkObj
            m_pSinkObj = 0
        End If
        If m_pVTable <> 0 Then
            FreeMem m_pVTable
            m_pVTable = 0
        End If
        m_AdviseCookie = 0
        m_IconApplied = False
    End Sub

    '=====================================================================
    ' COM 事件接收器 - Advise/Unadvise 生命周期管理
    ' 通过 IFileDialog ComImport 接口直接调用 Advise/Unadvise
    '=====================================================================

    ' 注册事件回调（在 Show 之前调用）
    Private Sub SetupIconSink()
        On Error Resume Next
        If m_IconHandle = 0 Then Exit Sub

        ' 创建事件接收器
        CreateEventSink
        If m_pSinkObj = 0 Then Exit Sub

        ' 通过 ComImport 接口调用 Advise（参数 ByVal LongPtr 直接传递接收器指针）
        Dim hr As Long
        hr = m_pFileDialog.Advise(m_pSinkObj, m_AdviseCookie)
        If hr <> S_OK Then
            ' Advise 失败，销毁接收器
            DestroyEventSink
        End If
    End Sub

    ' 注销事件回调（在 Show 之后调用）
    Private Sub CleanupIconSink()
        On Error Resume Next
        If m_AdviseCookie = 0 Then
            ' 未注册过回调，直接销毁接收器
            If m_pSinkObj <> 0 Then DestroyEventSink
            Exit Sub
        End If

        ' 通过 ComImport 接口调用 Unadvise
        m_pFileDialog.Unadvise(m_AdviseCookie)

        ' 销毁接收器
        DestroyEventSink
    End Sub

    '=====================================================================
    ' COM 事件接收器 - IFileDialogEvents 回调方法实现
    ' 这些方法通过 AddressOf Me.method 填入 vtable
    ' COM 调用约定：第一个参数 this 是接收器对象指针（不是 cDialogEx 实例）
    ' AddressOf Me.method 会自动绑定当前 cDialogEx 实例（"remembers the instance"）
    '=====================================================================

    ' IUnknown::QueryInterface - 返回 IUnknown 或 IFileDialogEvents 接口指针
    Private Function Sink_QueryInterface(ByVal this As LongPtr, ByRef riid As GUID, ByRef ppvObj As LongPtr) As Long
        On Error Resume Next

        Dim iidUnk As GUID = GetIID_IUnknown()
        Dim iidFDE As GUID = GetIID_IFileDialogEvents()

        If IsEqualGUID(riid, iidUnk) OrElse IsEqualGUID(riid, iidFDE) Then
            ' 返回同一个对象指针（支持 IUnknown 和 IFileDialogEvents）
            ppvObj = this
            Sink_AddRef this
            Sink_QueryInterface = S_OK
        Else
            ppvObj = 0
            Sink_QueryInterface = E_NOINTERFACE
        End If
    End Function

    ' IUnknown::AddRef - 伪引用计数（始终返回 2，不需要真正管理生命周期）
    Private Function Sink_AddRef(ByVal this As LongPtr) As Long
        On Error Resume Next
        Dim cRef As Long
        GetMem4 this + 2 * LenB(Of LongPtr), cRef
        cRef = cRef + 1
        PutMem4 this + 2 * LenB(Of LongPtr), cRef
        Sink_AddRef = cRef
    End Function

    ' IUnknown::Release - 伪引用计数（对象由 cDialogEx 外部管理，不自动释放）
    Private Function Sink_Release(ByVal this As LongPtr) As Long
        On Error Resume Next
        Dim cRef As Long
        GetMem4 this + 2 * LenB(Of LongPtr), cRef
        If cRef > 0 Then
            cRef = cRef - 1
            PutMem4 this + 2 * LenB(Of LongPtr), cRef
        End If
        Sink_Release = cRef
    End Function

    ' IFileDialogEvents::OnFileOk - 不实现
    Private Function Sink_OnFileOk(ByVal this As LongPtr, ByVal pfd As LongPtr) As Long
        On Error Resume Next
        Sink_OnFileOk = E_NOTIMPL
    End Function

    ' IFileDialogEvents::OnFolderChanging - 不实现
    Private Function Sink_OnFolderChanging(ByVal this As LongPtr, ByVal pfd As LongPtr, ByVal psiFolder As LongPtr) As Long
        On Error Resume Next
        Sink_OnFolderChanging = E_NOTIMPL
    End Function

    ' IFileDialogEvents::OnFolderChange - 核心：获取对话框 HWND 并设置图标
    ' 使用 m_pFileDialog（通过 AddressOf thunk 可访问 Me）进行 QI 获取 IOleWindow
    Private Function Sink_OnFolderChange(ByVal this As LongPtr, ByVal pfd As LongPtr) As Long
        On Error Resume Next

        ' 检查是否已应用图标（避免重复设置）
        If m_IconApplied Then
            Sink_OnFolderChange = S_OK
            Exit Function
        End If

        ' 从接收器对象中读取图标句柄
        Dim hIcon As LongPtr
        GetMemPtr this + LenB(Of LongPtr), hIcon
        If hIcon = 0 Then
            Sink_OnFolderChange = S_OK
            Exit Function
        End If

        ' 通过 interface 赋值实现 QI：将 IFileDialog 转为 IOleWindow
        ' twinBASIC 自动调用 QueryInterface 进行接口转换
        Dim pOleWindow As IOleWindow
        Set pOleWindow = m_pFileDialog  ' 自动 QI 获取 IOleWindow 接口

        If pOleWindow Is Nothing Then
            Sink_OnFolderChange = S_OK
            Exit Function
        End If

        ' 调用 IOleWindow::GetWindow 获取对话框窗口句柄
        Dim hwndDlg As LongPtr
        Dim hr As Long
        hr = pOleWindow.GetWindow(hwndDlg)

        ' 释放 IOleWindow 引用（赋值 Nothing 自动调用 Release）
        Set pOleWindow = Nothing

        If hr <> S_OK OrElse hwndDlg = 0 Then
            Sink_OnFolderChange = S_OK
            Exit Function
        End If

        ' 设置对话框图标（大图标和小图标）
        SendMessageW hwndDlg, WM_SETICON, ICON_BIG, hIcon
        SendMessageW hwndDlg, WM_SETICON, ICON_SMALL, hIcon

        ' 标记图标已应用
        m_IconApplied = True

        Sink_OnFolderChange = S_OK
    End Function

    ' IFileDialogEvents::OnSelectionChange - 不实现
    Private Function Sink_OnSelectionChange(ByVal this As LongPtr, ByVal pfd As LongPtr) As Long
        On Error Resume Next
        Sink_OnSelectionChange = E_NOTIMPL
    End Function

    ' IFileDialogEvents::OnShareViolation - 不实现
    Private Function Sink_OnShareViolation(ByVal this As LongPtr, ByVal pfd As LongPtr, ByVal psi As LongPtr, ByRef pResponse As Long) As Long
        On Error Resume Next
        Sink_OnShareViolation = E_NOTIMPL
    End Function

    ' IFileDialogEvents::OnTypeChange - 不实现
    Private Function Sink_OnTypeChange(ByVal this As LongPtr, ByVal pfd As LongPtr) As Long
        On Error Resume Next
        Sink_OnTypeChange = E_NOTIMPL
    End Function

    ' IFileDialogEvents::OnOverwrite - 不实现
    Private Function Sink_OnOverwrite(ByVal this As LongPtr, ByVal pfd As LongPtr, ByVal psi As LongPtr, ByRef pResponse As Long) As Long
        On Error Resume Next
        Sink_OnOverwrite = E_NOTIMPL
    End Function

End Class
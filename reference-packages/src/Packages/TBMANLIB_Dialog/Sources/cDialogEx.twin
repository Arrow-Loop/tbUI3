    '=====================================================================
    ' 私有方法 - IFileDialogEvents COM 事件接收器（手动 vtable 构建）
    '=====================================================================

    ' IID_IUnknown = {00000000-0000-0000-C000-000000000046}
    Private Function GetIID_IUnknown() As GUID
        Dim g As GUID
        g.Data1 = &H0
        g.Data2 = &H0
        g.Data3 = &H0
        g.Data4(0) = &H0: g.Data4(1) = &H0: g.Data4(2) = &H0: g.Data4(3) = &HC0
        g.Data4(4) = &H0: g.Data4(5) = &H0: g.Data4(6) = &H0: g.Data4(7) = &H46
        GetIID_IUnknown = g
    End Function

    ' IID_IFileDialogEvents = {9732ECAC-5184-4A3E-9A27-62E2CE1CE3D2}
    Private Function GetIID_IFileDialogEvents() As GUID
        Dim g As GUID
        g.Data1 = &H9732ECAC
        g.Data2 = &H5184
        g.Data3 = &H4A3E
        g.Data4(0) = &H9A: g.Data4(1) = &H27: g.Data4(2) = &H62: g.Data4(3) = &HE2
        g.Data4(4) = &HCE: g.Data4(5) = &H1C: g.Data4(6) = &HE3: g.Data4(7) = &HD2

' =====================================================
' mDialog.twin - Common Dialog Types Module
' mDialog.twin - 公共对话框类型模块
' TBMANLIB Dialog Library
' =====================================================
' Function: Provides common type definitions for dialog classes
' 功能：为对话框类提供公共类型定义
' Author: woeoo (邓伟)
' Email: 215879458@qq.com
' Site: https://vb6.pro
' Date: 2026-03-11
' Version: 1.0.0
' =====================================================

Option Explicit

Public Module mDialog

    ' =====================================================
    ' Common Dialog Filter Specification
    ' =====================================================
    Public Type COMDLG_FILTERSPEC
        pszName As LongPtr
        pszSpec As LongPtr
    End Type

    ' =====================================================
    ' GUID Structure (for COM interfaces)
    ' =====================================================
    Public Type GUID
        Data1 As Long
        Data2 As Integer
        Data3 As Integer
        Data4(0 To 7) As Byte
    End Type

    ' =====================================================
    ' RECT Structure (commonly used)
    ' =====================================================
    Public Type RECT
        Left As Long
        Top As Long
        Right As Long
        Bottom As Long
    End Type

    ' =====================================================
    ' POINT Structure (commonly used)
    ' =====================================================
    Public Type POINT
        X As Long
        Y As Long
    End Type

    ' =====================================================
    ' Standard Paper Sizes (in inches)
    ' =====================================================
    Public Const PAPER_LETTER_WIDTH As Double = 8.5
    Public Const PAPER_LETTER_HEIGHT As Double = 11
    Public Const PAPER_LEGAL_WIDTH As Double = 8.5
    Public Const PAPER_LEGAL_HEIGHT As Double = 14
    Public Const PAPER_A4_WIDTH As Double = 8.27     ' 210mm
    Public Const PAPER_A4_HEIGHT As Double = 11.69   ' 297mm
    Public Const PAPER_A3_WIDTH As Double = 11.69    ' 297mm
    Public Const PAPER_A3_HEIGHT As Double = 16.54   ' 420mm

    ' =====================================================
    ' Measurement Constants
    ' =====================================================
    Public Const MM_PER_INCH As Double = 25.4
    Public Const TWIPS_PER_INCH As Long = 1440
    Public Const POINTS_PER_INCH As Long = 72

    ' =====================================================
    ' Helper: Convert inches to millimeters
    ' =====================================================
    Public Function InchesToMM(ByVal inches As Double) As Double
        InchesToMM = inches * MM_PER_INCH
    End Function

    ' =====================================================
    ' Helper: Convert millimeters to inches
    ' =====================================================
    Public Function MMToInches(ByVal mm As Double) As Double
        MMToInches = mm / MM_PER_INCH
    End Function

    ' =====================================================
    ' Helper: Convert inches to points
    ' =====================================================
    Public Function InchesToPoints(ByVal inches As Double) As Double
        InchesToPoints = inches * POINTS_PER_INCH
    End Function

    ' =====================================================
    ' Helper: Convert points to inches
    ' =====================================================
    Public Function PointsToInches(ByVal points As Double) As Double
        PointsToInches = points / POINTS_PER_INCH
    End Function

    ' =====================================================
    ' Helper: Convert twips to inches
    ' =====================================================
    Public Function TwipsToInches(ByVal twips As Long) As Double
        TwipsToInches = twips / TWIPS_PER_INCH
    End Function

    ' =====================================================
    ' Helper: Convert inches to twips
    ' =====================================================
    Public Function InchesToTwips(ByVal inches As Double) As Long
        InchesToTwips = CLng(inches * TWIPS_PER_INCH)
    End Function

    ' =====================================================
    ' Helper: Convert RGB to HTML color string
    ' =====================================================
    Public Function RGBToHtml(ByVal r As Long, ByVal g As Long, ByVal b As Long) As String
        RGBToHtml = "#" & Right$("0" & Hex$(r And &HFF), 2) & _
                         Right$("0" & Hex$(g And &HFF), 2) & _
                         Right$("0" & Hex$(b And &HFF), 2)
    End Function

    ' =====================================================
    ' Helper: Parse HTML color to RGB
    ' =====================================================
    Public Sub HtmlToRGB(ByVal htmlColor As String, ByRef r As Long, ByRef g As Long, ByRef b As Long)
        On Error GoTo ErrorHandler

        Dim strColor As String
        strColor = Trim$(htmlColor)

        ' Remove # prefix if present
        If Left$(strColor, 1) = "#" Then
            strColor = Mid$(strColor, 2)
        End If

        ' Parse hex color
        If Len(strColor) = 6 Then
            r = CLng("&H" & Mid$(strColor, 1, 2))
            g = CLng("&H" & Mid$(strColor, 3, 2))
            b = CLng("&H" & Mid$(strColor, 5, 2))
        Else
            r = 0: g = 0: b = 0
        End If
        Exit Sub

ErrorHandler:
        r = 0: g = 0: b = 0
    End Sub

End Module
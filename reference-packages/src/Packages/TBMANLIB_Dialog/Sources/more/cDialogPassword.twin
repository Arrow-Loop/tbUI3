' =====================================================
' cDialogPassword.twin - Password Input Dialog Class
' cDialogPassword.twin - 密码输入对话框类
' TBMANLIB Dialog Library
' =====================================================
' Function: Provides secure password input dialog with strength indicator
' 功能：提供安全的密码输入对话框，带密码强度指示和掩码字符支持
' Author: woeoo (邓伟)
' Email: 215879458@qq.com
' Site: https://vb6.pro
' Date: 2026-03-11
' Version: 1.1.0
' =====================================================

Option Explicit

[COMCreatable(False)]
Public Class cDialogPassword

    ' =====================================================
    ' Windows API Declarations
    ' =====================================================
    Private Declare PtrSafe Function SetTimer Lib "user32" (ByVal hWnd As LongPtr, ByVal nIDEvent As LongPtr, ByVal uElapse As Long, ByVal lpTimerFunc As LongPtr) As LongPtr
    Private Declare PtrSafe Function KillTimer Lib "user32" (ByVal hWnd As LongPtr, ByVal nIDEvent As LongPtr) As Long
    Private Declare PtrSafe Function FindWindowW Lib "user32" (ByVal lpClassName As LongPtr, ByVal lpWindowName As LongPtr) As LongPtr
    Private Declare PtrSafe Function FindWindowExW Lib "user32" (ByVal hWndParent As LongPtr, ByVal hWndChildAfter As LongPtr, ByVal lpClassName As LongPtr, ByVal lpWindowName As LongPtr) As LongPtr
    Private Declare PtrSafe Function SendMessageW Lib "user32" (ByVal hWnd As LongPtr, ByVal wMsg As Long, ByVal wParam As LongPtr, ByVal lParam As LongPtr) As LongPtr
    Private Declare PtrSafe Function GetClassNameW Lib "user32" (ByVal hWnd As LongPtr, ByVal lpClassName As LongPtr, ByVal nMaxCount As Long) As Long
    Private Declare PtrSafe Function GetWindow lib "user32" (ByVal hWnd As LongPtr, ByVal wCmd As Long) As LongPtr
    Private Declare PtrSafe Function GetDlgItem Lib "user32" (ByVal hDlg As LongPtr, ByVal nIDDlgItem As Long) As LongPtr

    ' =====================================================
    ' Constants
    ' =====================================================
    Private Const EM_SETPASSWORDCHAR As Long = &H00CC
    Private Const GW_CHILD As Long = 5
    Private Const GW_HWNDNEXT As Long = 2

    ' =====================================================
    ' Password Strength Enum
    ' =====================================================
    Public Enum PasswordStrength
        VeryWeak = 0
        Weak = 1
        Fair = 2
        Strong = 3
        VeryStrong = 4
    End Enum

    ' =====================================================
    ' Class Data
    ' =====================================================
    Private Type cDialogPasswordData
        mTitle As String
        mPrompt As String
        mPassword As String
        mConfirmPassword As String
        mPasswordChar As String
        mShowStrength As Boolean
        mRequireConfirm As Boolean
        mMinLength As Long
        mMaxLength As Long
        mRequireUppercase As Boolean
        mRequireLowercase As Boolean
        mRequireNumber As Boolean
        mRequireSpecial As Boolean
        mAllowShowPassword As Boolean
        mMaxAttempts As Long
        mAttemptCount As Long
        mOwnerHwnd As LongPtr
        mCancelled As Boolean
        mTimerId As LongPtr
    End Type

    Private mData As cDialogPasswordData

    ' =====================================================
    ' Class Initialize
    ' =====================================================
    Private Sub Class_Initialize()
        mData.mTitle = "Enter Password"
        mData.mPrompt = "Please enter your password:"
        mData.mPassword = ""
        mData.mConfirmPassword = ""
        mData.mPasswordChar = "*"
        mData.mShowStrength = True
        mData.mRequireConfirm = False
        mData.mMinLength = 8
        mData.mMaxLength = 128
        mData.mRequireUppercase = True
        mData.mRequireLowercase = True
        mData.mRequireNumber = True
        mData.mRequireSpecial = False
        mData.mAllowShowPassword = True
        mData.mMaxAttempts = 3
        mData.mAttemptCount = 0
        mData.mCancelled = False
        mData.mOwnerHwnd = 0
        mData.mTimerId = 0
    End Sub

    ' =====================================================
    ' Property: Dialog Title
    ' =====================================================
    Public Property Get Title() As String
        Title = mData.mTitle
    End Property

    Public Property Let Title(ByVal value As String)
        mData.mTitle = value
    End Property

    ' =====================================================
    ' Property: Prompt Text
    ' =====================================================
    Public Property Get Prompt() As String
        Prompt = mData.mPrompt
    End Property

    Public Property Let Prompt(ByVal value As String)
        mData.mPrompt = value
    End Property

    ' =====================================================
    ' Property: Password (read-only after dialog)
    ' =====================================================
    Public Property Get Password() As String
        Password = mData.mPassword
    End Property

    ' =====================================================
    ' Property: PasswordChar - 掩码字符（默认 *）
    ' =====================================================
    Public Property Get PasswordChar() As String
        PasswordChar = mData.mPasswordChar
    End Property

    Public Property Let PasswordChar(ByVal value As String)
        If Len(value) > 0 Then
            mData.mPasswordChar = Left$(value, 1)
        Else
            mData.mPasswordChar = "*"
        End If
    End Property

    ' =====================================================
    ' Property: Show Password Strength Indicator
    ' =====================================================
    Public Property Get ShowStrength() As Boolean
        ShowStrength = mData.mShowStrength
    End Property

    Public Property Let ShowStrength(ByVal value As Boolean)
        mData.mShowStrength = value
    End Property

    ' =====================================================
    ' Property: Require Password Confirmation
    ' =====================================================
    Public Property Get RequireConfirm() As Boolean
        RequireConfirm = mData.mRequireConfirm
    End Property

    Public Property Let RequireConfirm(ByVal value As Boolean)
        mData.mRequireConfirm = value
    End Property

    ' =====================================================
    ' Property: Minimum Password Length
    ' =====================================================
    Public Property Get MinLength() As Long
        MinLength = mData.mMinLength
    End Property

    Public Property Let MinLength(ByVal value As Long)
        mData.mMinLength = value
    End Property

    ' =====================================================
    ' Property: Maximum Password Length
    ' =====================================================
    Public Property Get MaxLength() As Long
        MaxLength = mData.mMaxLength
    End Property

    Public Property Let MaxLength(ByVal value As Long)
        mData.mMaxLength = value
    End Property

    ' =====================================================
    ' Property: Require Uppercase
    ' =====================================================
    Public Property Get RequireUppercase() As Boolean
        RequireUppercase = mData.mRequireUppercase
    End Property

    Public Property Let RequireUppercase(ByVal value As Boolean)
        mData.mRequireUppercase = value
    End Property

    ' =====================================================
    ' Property: Require Lowercase
    ' =====================================================
    Public Property Get RequireLowercase() As Boolean
        RequireLowercase = mData.mRequireLowercase
    End Property

    Public Property Let RequireLowercase(ByVal value As Boolean)
        mData.mRequireLowercase = value
    End Property

    ' =====================================================
    ' Property: Require Number
    ' =====================================================
    Public Property Get RequireNumber() As Boolean
        RequireNumber = mData.mRequireNumber
    End Property

    Public Property Let RequireNumber(ByVal value As Boolean)
        mData.mRequireNumber = value
    End Property

    ' =====================================================
    ' Property: Require Special Character
    ' =====================================================
    Public Property Get RequireSpecial() As Boolean
        RequireSpecial = mData.mRequireSpecial
    End Property

    Public Property Let RequireSpecial(ByVal value As Boolean)
        mData.mRequireSpecial = value
    End Property

    ' =====================================================
    ' Property: Allow Show Password Toggle
    ' =====================================================
    Public Property Get AllowShowPassword() As Boolean
        AllowShowPassword = mData.mAllowShowPassword
    End Property

    Public Property Let AllowShowPassword(ByVal value As Boolean)
        mData.mAllowShowPassword = value
    End Property

    ' =====================================================
    ' Property: Maximum Attempts
    ' =====================================================
    Public Property Get MaxAttempts() As Long
        MaxAttempts = mData.mMaxAttempts
    End Property

    Public Property Let MaxAttempts(ByVal value As Long)
        mData.mMaxAttempts = value
    End Property

    ' =====================================================
    ' Property: Owner Window Handle
    ' =====================================================
    Public Property Get OwnerHwnd() As LongPtr
        OwnerHwnd = mData.mOwnerHwnd
    End Property

    Public Property Let OwnerHwnd(ByVal value As LongPtr)
        mData.mOwnerHwnd = value
    End Property

    ' =====================================================
    ' Property: Was Cancelled (read-only)
    ' =====================================================
    Public Property Get Cancelled() As Boolean
        Cancelled = mData.mCancelled
    End Property

    ' =====================================================
    ' Method: Calculate Password Strength
    ' =====================================================
    Public Function GetStrength(ByVal password As String) As PasswordStrength
        Dim score As Long
        Dim hasUpper As Boolean
        Dim hasLower As Boolean
        Dim hasNumber As Boolean
        Dim hasSpecial As Boolean
        Dim i As Long
        Dim ch As String

        ' Check character types
        For i = 1 To Len(password)
            ch = Mid$(password, i, 1)
            If ch >= "A" And ch <= "Z" Then hasUpper = True
            If ch >= "a" And ch <= "z" Then hasLower = True
            If ch >= "0" And ch <= "9" Then hasNumber = True
            If InStr("!@#$%^&*()_+-=[]{}|;:',.<>?/~`", ch) > 0 Then hasSpecial = True
        Next i

        ' Calculate score
        score = 0

        ' Length score
        If Len(password) >= 8 Then score = score + 1
        If Len(password) >= 12 Then score = score + 1
        If Len(password) >= 16 Then score = score + 1

        ' Character variety score
        If hasUpper Then score = score + 1
        If hasLower Then score = score + 1
        If hasNumber Then score = score + 1
        If hasSpecial Then score = score + 2

        ' Map score to strength level
        If score <= 2 Then
            GetStrength = PasswordStrength.VeryWeak
        ElseIf score <= 4 Then
            GetStrength = PasswordStrength.Weak
        ElseIf score <= 6 Then
            GetStrength = PasswordStrength.Fair
        ElseIf score <= 8 Then
            GetStrength = PasswordStrength.Strong
        Else
            GetStrength = PasswordStrength.VeryStrong
        End If
    End Function

    ' =====================================================
    ' Method: Get Strength Description
    ' =====================================================
    Public Function GetStrengthDescription(ByVal strength As PasswordStrength) As String
        Select Case strength
            Case PasswordStrength.VeryWeak
                GetStrengthDescription = "Very Weak"
            Case PasswordStrength.Weak
                GetStrengthDescription = "Weak"
            Case PasswordStrength.Fair
                GetStrengthDescription = "Fair"
            Case PasswordStrength.Strong
                GetStrengthDescription = "Strong"
            Case PasswordStrength.VeryStrong
                GetStrengthDescription = "Very Strong"
        End Select
    End Function

    ' =====================================================
    ' Method: Validate Password
    ' =====================================================
    Public Function Validate(ByVal password As String) As String
        ' Returns empty string if valid, error message otherwise
        If Len(password) < mData.mMinLength Then
            Validate = "Password must be at least " & mData.mMinLength & " characters"
            Exit Function
        End If

        If Len(password) > mData.mMaxLength Then
            Validate = "Password must not exceed " & mData.mMaxLength & " characters"
            Exit Function
        End If

        If mData.mRequireUppercase Then
            Dim hasUpper As Boolean
            Dim i As Long
            For i = 1 To Len(password)
                If Mid$(password, i, 1) >= "A" And Mid$(password, i, 1) <= "Z" Then
                    hasUpper = True
                    Exit For
                End If
            Next i
            If Not hasUpper Then
                Validate = "Password must contain at least one uppercase letter"
                Exit Function
            End If
        End If

        If mData.mRequireLowercase Then
            Dim hasLower As Boolean
            For i = 1 To Len(password)
                If Mid$(password, i, 1) >= "a" And Mid$(password, i, 1) <= "z" Then
                    hasLower = True
                    Exit For
                End If
            Next i
            If Not hasLower Then
                Validate = "Password must contain at least one lowercase letter"
                Exit Function
            End If
        End If

        If mData.mRequireNumber Then
            Dim hasNumber As Boolean
            For i = 1 To Len(password)
                If Mid$(password, i, 1) >= "0" And Mid$(password, i, 1) <= "9" Then
                    hasNumber = True
                    Exit For
                End If
            Next i
            If Not hasNumber Then
                Validate = "Password must contain at least one number"
                Exit Function
            End If
        End If

        If mData.mRequireSpecial Then
            Dim hasSpecial As Boolean
            For i = 1 To Len(password)
                If InStr("!@#$%^&*()_+-=[]{}|;:',.<>?/~`", Mid$(password, i, 1)) > 0 Then
                    hasSpecial = True
                    Exit For
                End If
            Next i
            If Not hasSpecial Then
                Validate = "Password must contain at least one special character"
                Exit Function
            End If
        End If

        Validate = ""
    End Function

    ' =====================================================
    ' Method: SetTimer 回调 - 将 InputBox 编辑框设为密码模式
    ' =====================================================
    Private Sub TimerProc(ByVal hWnd As LongPtr, ByVal uMsg As Long, ByVal idEvent As LongPtr, ByVal dwTime As Long)
        ' 停止定时器
        KillTimer 0, idEvent

        ' 查找 InputBox 窗口（#32770 是标准对话框类名）
        Dim hDlg As LongPtr
        hDlg = FindWindowW(StrPtr("#32770"), StrPtr(mData.mTitle))
        If hDlg = 0 Then Exit Sub

        ' 遍历子窗口找 Edit 控件
        Dim hChild As LongPtr
        hChild = GetWindow(hDlg, GW_CHILD)
        Do While hChild <> 0
            Dim className As String
            className = Space$(256)
            Dim nLen As Long
            nLen = GetClassNameW(hChild, StrPtr(className), 256)
            If nLen > 0 Then
                className = Left$(className, nLen)
                If className = "Edit" Then
                    ' 设置密码掩码字符
                    Dim ch As Long
                    ch = AscW(mData.mPasswordChar)
                    SendMessageW hChild, EM_SETPASSWORDCHAR, ch, 0
                    Exit Do
                End If
            End If
            hChild = GetWindow(hChild, GW_HWNDNEXT)
        Loop
    End Sub

    ' =====================================================
    ' Method: 带掩码的 InputBox
    ' =====================================================
    Private Function MaskedInputBox(ByVal prompt As String, ByVal title As String, ByVal defaultVal As String) As String
        ' 启动定时器，10ms 后触发回调（足够 InputBox 窗口已创建）
        mData.mTimerId = SetTimer(0, 0, 10, AddressOf TimerProc)
        MaskedInputBox = InputBox(prompt, title, defaultVal)
    End Function

    ' =====================================================
    ' Method: Show Password Dialog
    ' =====================================================
    Public Function ShowDialog() As Boolean
        Dim strPassword As String
        Dim strConfirm As String
        Dim strError As String
        Dim attempts As Long

        attempts = 0

        ' 构造提示信息（含密码要求）
        Dim strPrompt As String
        strPrompt = mData.mPrompt & vbCrLf & vbCrLf & _
                    "Requirements:" & vbCrLf & _
                    "- Minimum " & mData.mMinLength & " characters" & _
                    IIf(mData.mRequireUppercase, vbCrLf & "- At least one uppercase letter", "") & _
                    IIf(mData.mRequireLowercase, vbCrLf & "- At least one lowercase letter", "") & _
                    IIf(mData.mRequireNumber, vbCrLf & "- At least one number", "") & _
                    IIf(mData.mRequireSpecial, vbCrLf & "- At least one special character", "")

        Do While attempts < mData.mMaxAttempts
            ' 用 SetTimer hack 实现密码掩码
            strPassword = MaskedInputBox(strPrompt, mData.mTitle, "")

            ' Check if user cancelled (StrPtr=0 means cancel, "" means empty input)
            If StrPtr(strPassword) = 0 Then
                mData.mCancelled = True
                ShowDialog = False
                Exit Function
            End If

            ' Validate password
            strError = Validate(strPassword)
            If strError <> "" Then
                attempts = attempts + 1
                If attempts < mData.mMaxAttempts Then
                    MsgBox strError & vbCrLf & vbCrLf & _
                           "Attempts remaining: " & (mData.mMaxAttempts - attempts), _
                           vbExclamation, mData.mTitle
                Else
                    MsgBox strError & vbCrLf & vbCrLf & _
                           "Maximum attempts reached.", _
                           vbCritical, mData.mTitle
                    mData.mCancelled = True
                    ShowDialog = False
                    Exit Function
                End If
            Else
                ' Password is valid
                If mData.mRequireConfirm Then
                    strConfirm = MaskedInputBox("Please confirm your password:", mData.mTitle & " - Confirm", "")
                    If StrPtr(strConfirm) = 0 Then
                        mData.mCancelled = True
                        ShowDialog = False
                        Exit Function
                    End If
                    If strConfirm <> strPassword Then
                        attempts = attempts + 1
                        If attempts < mData.mMaxAttempts Then
                            MsgBox "Passwords do not match!" & vbCrLf & vbCrLf & _
                                   "Attempts remaining: " & (mData.mMaxAttempts - attempts), _
                                   vbExclamation, mData.mTitle
                        Else
                            MsgBox "Passwords do not match!" & vbCrLf & vbCrLf & _
                                   "Maximum attempts reached.", _
                                   vbCritical, mData.mTitle
                            mData.mCancelled = True
                            ShowDialog = False
                            Exit Function
                        End If
                    Else
                        mData.mPassword = strPassword
                        mData.mCancelled = False
                        ShowDialog = True
                        Exit Function
                    End If
                Else
                    mData.mPassword = strPassword
                    mData.mCancelled = False
                    ShowDialog = True
                    Exit Function
                End If
            End If
        Loop

        mData.mCancelled = True
        ShowDialog = False
    End Function

    ' =====================================================
    ' Method: Show Password Change Dialog
    ' =====================================================
    Public Function ShowChangeDialog(ByRef oldPassword As String) As Boolean
        Dim strOld As String
        Dim strNew As String
        Dim strConfirm As String
        Dim strError As String

        ' Get old password
        strOld = MaskedInputBox("Enter current password:", mData.mTitle & " - Current Password", "")
        If StrPtr(strOld) = 0 Then
            mData.mCancelled = True
            ShowChangeDialog = False
            Exit Function
        End If

        ' Verify old password
        If oldPassword <> "" And strOld <> oldPassword Then
            MsgBox "Incorrect current password.", vbExclamation, mData.mTitle
            ShowChangeDialog = False
            Exit Function
        End If

        ' Get new password
        Dim strPrompt As String
        strPrompt = "Enter new password:" & vbCrLf & vbCrLf & _
                    "Requirements:" & vbCrLf & _
                    "- Minimum " & mData.mMinLength & " characters" & _
                    IIf(mData.mRequireUppercase, vbCrLf & "- At least one uppercase letter", "") & _
                    IIf(mData.mRequireLowercase, vbCrLf & "- At least one lowercase letter", "") & _
                    IIf(mData.mRequireNumber, vbCrLf & "- At least one number", "") & _
                    IIf(mData.mRequireSpecial, vbCrLf & "- At least one special character", "")

        strNew = MaskedInputBox(strPrompt, mData.mTitle & " - New Password", "")
        If StrPtr(strNew) = 0 Then
            mData.mCancelled = True
            ShowChangeDialog = False
            Exit Function
        End If

        ' Validate new password
        strError = Validate(strNew)
        If strError <> "" Then
            MsgBox strError, vbExclamation, mData.mTitle
            ShowChangeDialog = False
            Exit Function
        End If

        ' Check new password is different from old
        If strNew = strOld Then
            MsgBox "New password must be different from the current password.", vbExclamation, mData.mTitle
            ShowChangeDialog = False
            Exit Function
        End If

        ' Confirm new password
        strConfirm = MaskedInputBox("Confirm new password:", mData.mTitle & " - Confirm New Password", "")
        If StrPtr(strConfirm) = 0 Then
            mData.mCancelled = True
            ShowChangeDialog = False
            Exit Function
        End If

        If strConfirm <> strNew Then
            MsgBox "Passwords do not match.", vbExclamation, mData.mTitle
            ShowChangeDialog = False
            Exit Function
        End If

        ' Success
        oldPassword = strNew
        mData.mPassword = strNew
        ShowChangeDialog = True
    End Function

    ' =====================================================
    ' Method: Get Password Requirements Description
    ' =====================================================
    Public Function GetRequirementsDescription() As String
        Dim result As String

        result = "Password requirements:" & vbCrLf
        result = result & "- " & mData.mMinLength & " to " & mData.mMaxLength & " characters"

        If mData.mRequireUppercase Then
            result = result & vbCrLf & "- At least one uppercase letter (A-Z)"
        End If

        If mData.mRequireLowercase Then
            result = result & vbCrLf & "- At least one lowercase letter (a-z)"
        End If

        If mData.mRequireNumber Then
            result = result & vbCrLf & "- At least one number (0-9)"
        End If

        If mData.mRequireSpecial Then
            result = result & vbCrLf & "- At least one special character (!@#$%^&*...)"
        End If

        GetRequirementsDescription = result
    End Function

    ' =====================================================
    ' Method: Reset to default settings
    ' =====================================================
    Public Sub Reset()
        mData.mTitle = "Enter Password"
        mData.mPrompt = "Please enter your password:"
        mData.mPassword = ""
        mData.mConfirmPassword = ""
        mData.mPasswordChar = "*"
        mData.mShowStrength = True
        mData.mRequireConfirm = False
        mData.mMinLength = 8
        mData.mMaxLength = 128
        mData.mRequireUppercase = True
        mData.mRequireLowercase = True
        mData.mRequireNumber = True
        mData.mRequireSpecial = False
        mData.mAllowShowPassword = True
        mData.mMaxAttempts = 3
        mData.mAttemptCount = 0
        mData.mCancelled = False
        mData.mTimerId = 0
    End Sub

End Class

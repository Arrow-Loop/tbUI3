End Sub

' =====================================================
' Progress Dialog Tests
' =====================================================

' Test 29: Progress Dialog Simulation
Public Sub TestProgressDialog()
    Dim progress As New cDialogProgress

    With progress
        .Title = "Processing"
        .Message = "Processing files..."
        .Min = 0
        .Max = 100
        .ShowElapsedTime = True
        .ShowRemainingTime = True
    End With

    ' Simulate progress
    progress.Start()

    MsgBox "Progress started. Check Debug output for progress updates." & vbCrLf & vbCrLf & _
           "Note: In a real application, this would be integrated with a UI form.", _
           vbInformation, "Progress Dialog Test"

    ' This would normally be called during actual work
    progress.SimulateProgress 50
End Sub

' =====================================================
' Date/Time Dialog Tests
' =====================================================

' Test 30: Date Picker
Public Sub TestDatePicker()
    Dim dt As New cDialogDateTime

    If dt.ShowDatePicker("Select Appointment Date") Then
        MsgBox "Selected date:" & vbCrLf & _
               dt.FormatDate() & vbCrLf & _
               dt.GetDayOfWeekName() & vbCrLf & vbCrLf & _
               "Date value: " & dt.DateValue, _
               vbInformation, "Date Selected"
    Else
        MsgBox "Date selection cancelled", vbInformation, "Date Picker"
    End If
End Sub

' Test 31: Time Picker
Public Sub TestTimePicker()
    Dim dt As New cDialogDateTime

    dt.Is24HourFormat = False
    dt.ShowSeconds = True

    If dt.ShowTimePicker("Select Meeting Time") Then
        MsgBox "Selected time:" & vbCrLf & _
               dt.FormatTime() & vbCrLf & vbCrLf & _
               "Time value: " & dt.TimeValue, _
               vbInformation, "Time Selected"
    Else
        MsgBox "Time selection cancelled", vbInformation, "Time Picker"
    End If
End Sub

' Test 32: DateTime Picker
Public Sub TestDateTimePicker()
    Dim dt As New cDialogDateTime

    With dt
        .Title = "Select Event Date and Time"
        .Prompt = "Choose when the event will occur:"
        .MinYear = 2020
        .MaxYear = 2030
        .Is24HourFormat = True
        .ShowSeconds = False
    End With

    If dt.ShowDialog() Then
        MsgBox "Selected:" & vbCrLf & _
               dt.FormatDateTime() & vbCrLf & _
               dt.GetDayOfWeekName() & vbCrLf & vbCrLf & _
               "DateTime value: " & dt.DateTimeValue, _
               vbInformation, "DateTime Selected"
    Else
        MsgBox "Selection cancelled", vbInformation, "DateTime Picker"
    End If
End Sub

' Test 33: DateTime with Custom Format
Public Sub TestDateTimeCustomFormat()
    Dim dt As New cDialogDateTime

    dt.CustomFormat = "YYYY-MM-DD (DDD)"

    If dt.ShowDialog() Then
        MsgBox "Formatted date:" & vbCrLf & _
               dt.FormatDate(2) & vbCrLf & vbCrLf & _
               "Day of week: " & dt.GetDayOfWeekName() & vbCrLf & _
               "Month: " & dt.GetMonthName(), _
               vbInformation, "Custom Format"
    Else
        MsgBox "Selection cancelled", vbInformation, "Custom Format"
    End If
End Sub

' =====================================================
' Utility Function Tests
' =====================================================

' Test 34: mDialog Utility Functions
Public Sub TestUtilityFunctions()
    Dim r As Long, g As Long, b As Long

    ' Test HTML color conversion
    mDialog.HtmlToRGB "#FF8000", r, g, b

    MsgBox "Utility Functions Test:" & vbCrLf & vbCrLf & _
           "HTML #FF8000 to RGB:" & vbCrLf & _
           "R=" & r & ", G=" & g & ", B=" & b & vbCrLf & vbCrLf & _
           "RGB back to HTML: " & mDialog.RGBToHtml(r, g, b) & vbCrLf & vbCrLf & _
           "Paper sizes:" & vbCrLf & _
           "Letter: " & mDialog.PAPER_LETTER_WIDTH & " x " & mDialog.PAPER_LETTER_HEIGHT & " inches" & vbCrLf & _
           "A4: " & Format$(mDialog.MMToInches(210), "0.00") & " x " & Format$(mDialog.MMToInches(297), "0.00") & " inches", _
           vbInformation, "Utility Functions Test"
End Sub


' Quick test: Password Dialog with Cancelled check
Public Sub QuickTest()
    Dim dlg As New cDialogPassword

    dlg.Title = "Quick Password Test"

    If dlg.ShowDialog() Then
        MsgBox "Password accepted! Strength: " & dlg.GetStrengthDescription(dlg.GetStrength(dlg.Password)) & vbCrLf & _
               "Cancelled: " & CStr(dlg.Cancelled), vbInformation, "Quick Test"
    Else
        MsgBox "Cancelled property: " & CStr(dlg.Cancelled), vbInformation, "Quick Test"
    End If
End Sub

End Module

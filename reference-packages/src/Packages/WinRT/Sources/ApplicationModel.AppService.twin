Module mdlApplicationModelAppService
    
Public Enum AppServiceClosedStatus
    AppServiceClosedStatus_Completed
    AppServiceClosedStatus_Canceled
    AppServiceClosedStatus_ResourceLimitsExceeded
    AppServiceClosedStatus_Unknown
End Enum

Public Enum AppServiceConnectionStatus
    AppServiceConnectionStatus_Success
    AppServiceConnectionStatus_AppNotInstalled
    AppServiceConnectionStatus_AppUnavailable
    AppServiceConnectionStatus_AppServiceUnavailable
    AppServiceConnectionStatus_Unknown
    AppServiceConnectionStatus_RemoteSystemUnavailable
    AppServiceConnectionStatus_RemoteSystemNotSupportedByApp
    AppServiceConnectionStatus_NotAuthorized
    AppServiceConnectionStatus_AuthenticationError
    AppServiceConnectionStatus_NetworkNotAvailable
    AppServiceConnectionStatus_DisabledByPolicy
    AppServiceConnectionStatus_WebServiceUnavailable
End Enum

Public Enum AppServiceResponseStatus
    AppServiceResponseStatus_Success
    AppServiceResponseStatus_Failure
    AppServiceResponseStatus_ResourceLimitsExceeded
    AppServiceResponseStatus_Unknown
    AppServiceResponseStatus_RemoteSystemUnavailable
    AppServiceResponseStatus_MessageSizeTooLarge
    AppServiceResponseStatus_AppUnavailable
    AppServiceResponseStatus_AuthenticationError
    AppServiceResponseStatus_NetworkNotAvailable
    AppServiceResponseStatus_DisabledByPolicy
    AppServiceResponseStatus_WebServiceUnavailable
End Enum

Public Enum StatelessAppServiceResponseStatus
    StatelessAppServiceResponseStatus_Success
    StatelessAppServiceResponseStatus_AppNotInstalled
    StatelessAppServiceResponseStatus_AppUnavailable
    StatelessAppServiceResponseStatus_AppServiceUnavailable
    StatelessAppServiceResponseStatus_RemoteSystemUnavailable
    StatelessAppServiceResponseStatus_RemoteSystemNotSupportedByApp
    StatelessAppServiceResponseStatus_NotAuthorized
    StatelessAppServiceResponseStatus_ResourceLimitsExceeded
    StatelessAppServiceResponseStatus_MessageSizeTooLarge
    StatelessAppServiceResponseStatus_Failure
    StatelessAppServiceResponseStatus_Unknown
    StatelessAppServiceResponseStatus_AuthenticationError
    StatelessAppServiceResponseStatus_NetworkNotAvailable
    StatelessAppServiceResponseStatus_DisabledByPolicy
    StatelessAppServiceResponseStatus_WebServiceUnavailable
End Enum

End Module
    Property Let BackgroundColor(ByVal Value As Color)
    Property Get IsIgnoringHighContrast() As BooleanByte
    Property Let IsIgnoringHighContrast(ByVal Value As BooleanByte)
    Property Get BitmapEncoderId() As UUID
    Property Let BitmapEncoderId(ByVal BitmapEncoderId As UUID)
End Interface


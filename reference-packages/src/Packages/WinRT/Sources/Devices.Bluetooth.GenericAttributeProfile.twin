Module mdlDevicesBluetoothGenericAttributeProfile

Public Enum GattCharacteristicProperties
    GattCharacteristicProperties_None = &H0
    GattCharacteristicProperties_Broadcast = &H1
    GattCharacteristicProperties_Read = &H2
    GattCharacteristicProperties_WriteWithoutResponse = &H4
    GattCharacteristicProperties_Write = &H8
    GattCharacteristicProperties_Notify = &H10
    GattCharacteristicProperties_Indicate = &H20
    GattCharacteristicProperties_AuthenticatedSignedWrites = &H40
    GattCharacteristicProperties_ExtendedProperties = &H80
    GattCharacteristicProperties_ReliableWrites = &H100
    GattCharacteristicProperties_WritableAuxiliaries = &H200
End Enum

Public Enum GattClientCharacteristicConfigurationDescriptorValue
    GattClientCharacteristicConfigurationDescriptorValue_None
    GattClientCharacteristicConfigurationDescriptorValue_Notify
    GattClientCharacteristicConfigurationDescriptorValue_Indicate
End Enum

Public Enum GattCommunicationStatus
    GattCommunicationStatus_Success
    GattCommunicationStatus_Unreachable
    GattCommunicationStatus_ProtocolError
    GattCommunicationStatus_AccessDenied
End Enum

Public Enum GattOpenStatus
    GattOpenStatus_Unspecified
    GattOpenStatus_Success
    GattOpenStatus_AlreadyOpened
    GattOpenStatus_NotFound
    GattOpenStatus_SharingViolation
    GattOpenStatus_AccessDenied
End Enum

Public Enum GattProtectionLevel
    GattProtectionLevel_Plain
    GattProtectionLevel_AuthenticationRequired
    GattProtectionLevel_EncryptionRequired
    GattProtectionLevel_EncryptionAndAuthenticationRequired
End Enum

Public Enum GattRequestState
    GattRequestState_Pending
    GattRequestState_Completed
    GattRequestState_Canceled
End Enum

Public Enum GattServiceProviderAdvertisementStatus
    GattServiceProviderAdvertisementStatus_Created
    GattServiceProviderAdvertisementStatus_Stopped
    GattServiceProviderAdvertisementStatus_Started
    GattServiceProviderAdvertisementStatus_Aborted
    GattServiceProviderAdvertisementStatus_StartedWithoutAllAdvertisementData
End Enum

Public Enum GattSessionStatus
    GattSessionStatus_Closed
    GattSessionStatus_Active
End Enum

Public Enum GattSharingMode
    GattSharingMode_Unspecified
    GattSharingMode_Exclusive
    GattSharingMode_SharedReadOnly
    GattSharingMode_SharedReadAndWrite
End Enum

Public Enum GattWriteOption
    GattWriteOption_WriteWithResponse
    GattWriteOption_WriteWithoutResponse
End Enum

End Module
Module mdlDevicesBluetooth

Public Enum BluetoothAddressType
    BluetoothAddressType_Public
    BluetoothAddressType_Random
    BluetoothAddressType_Unspecified
End Enum

Public Enum BluetoothCacheMode
    BluetoothCacheMode_Cached
    BluetoothCacheMode_Uncached
End Enum

Public Enum BluetoothConnectionStatus
    BluetoothConnectionStatus_Disconnected
    BluetoothConnectionStatus_Connected
End Enum

Public Enum BluetoothError
    BluetoothError_Success
    BluetoothError_RadioNotAvailable
    BluetoothError_ResourceInUse
    BluetoothError_DeviceNotConnected
    BluetoothError_OtherError
    BluetoothError_DisabledByPolicy
    BluetoothError_NotSupported
    BluetoothError_DisabledByUser
    BluetoothError_ConsentRequired
    BluetoothError_TransportNotSupported
End Enum

Public Enum BluetoothLEPreferredConnectionParametersRequestStatus
    BluetoothLEPreferredConnectionParametersRequestStatus_Unspecified
    BluetoothLEPreferredConnectionParametersRequestStatus_Success
    BluetoothLEPreferredConnectionParametersRequestStatus_DeviceNotAvailable
    BluetoothLEPreferredConnectionParametersRequestStatus_AccessDenied
End Enum

Public Enum BluetoothMajorClass
    BluetoothMajorClass_Miscellaneous
    BluetoothMajorClass_Computer
    BluetoothMajorClass_Phone
    BluetoothMajorClass_NetworkAccessPoint
    BluetoothMajorClass_AudioVideo
    BluetoothMajorClass_Peripheral
    BluetoothMajorClass_Imaging
    BluetoothMajorClass_Wearable
    BluetoothMajorClass_Toy
    BluetoothMajorClass_Health
End Enum

Public Enum BluetoothMinorClass
    BluetoothMinorClass_Uncategorized
    BluetoothMinorClass_ComputerDesktop
    BluetoothMinorClass_ComputerServer
    BluetoothMinorClass_ComputerLaptop
    BluetoothMinorClass_ComputerHandheld
    BluetoothMinorClass_ComputerPalmSize

Module mdlDevicesEnumeration

Public Enum DeviceAccessStatus
    DeviceAccessStatus_Unspecified
    DeviceAccessStatus_Allowed
    DeviceAccessStatus_DeniedByUser
    DeviceAccessStatus_DeniedBySystem
End Enum

Public Enum DeviceClass
    DeviceClass_All
    DeviceClass_AudioCapture
    DeviceClass_AudioRender
    DeviceClass_PortableStorageDevice
    DeviceClass_VideoCapture
    DeviceClass_ImageScanner
    DeviceClass_Location
End Enum

Public Enum DeviceInformationKind
    DeviceInformationKind_Unknown
    DeviceInformationKind_DeviceInterface
    DeviceInformationKind_DeviceContainer
    DeviceInformationKind_Device
    DeviceInformationKind_DeviceInterfaceClass
    DeviceInformationKind_AssociationEndpoint
    DeviceInformationKind_AssociationEndpointContainer
    DeviceInformationKind_AssociationEndpointService
    DeviceInformationKind_DevicePanel
End Enum

Public Enum DevicePairingKinds
    DevicePairingKinds_None = &H0
    DevicePairingKinds_ConfirmOnly = &H1
    DevicePairingKinds_DisplayPin = &H2
    DevicePairingKinds_ProvidePin = &H4
    DevicePairingKinds_ConfirmPinMatch = &H8
    DevicePairingKinds_ProvidePasswordCredential = &H10
End Enum

Public Enum DevicePairingProtectionLevel
    DevicePairingProtectionLevel_Default
    DevicePairingProtectionLevel_None
    DevicePairingProtectionLevel_Encryption
    DevicePairingProtectionLevel_EncryptionAndAuthentication
End Enum

Public Enum DevicePairingResultStatus
    DevicePairingResultStatus_Paired
    DevicePairingResultStatus_NotReadyToPair
    DevicePairingResultStatus_NotPaired
    DevicePairingResultStatus_AlreadyPaired
    DevicePairingResultStatus_ConnectionRejected
    DevicePairingResultStatus_TooManyConnections
    DevicePairingResultStatus_HardwareFailure
    DevicePairingResultStatus_AuthenticationTimeout
    DevicePairingResultStatus_AuthenticationNotAllowed
    DevicePairingResultStatus_AuthenticationFailure
    DevicePairingResultStatus_NoSupportedProfiles
    DevicePairingResultStatus_ProtectionLevelCouldNotBeMet
    DevicePairingResultStatus_AccessDenied
    DevicePairingResultStatus_InvalidCeremonyData
    DevicePairingResultStatus_PairingCanceled
    DevicePairingResultStatus_OperationAlreadyInProgress
    DevicePairingResultStatus_RequiredHandlerNotRegistered
    DevicePairingResultStatus_RejectedByHandler
    DevicePairingResultStatus_RemoteDeviceHasAssociation
    DevicePairingResultStatus_Failed
End Enum

Public Enum DevicePickerDisplayStatusOptions
    DevicePickerDisplayStatusOptions_None = &H0
    DevicePickerDisplayStatusOptions_ShowProgress = &H1
    DevicePickerDisplayStatusOptions_ShowDisconnectButton = &H2
    DevicePickerDisplayStatusOptions_ShowRetryButton = &H4
End Enum

Public Enum DeviceUnpairingResultStatus
    DeviceUnpairingResultStatus_Unpaired
    DeviceUnpairingResultStatus_AlreadyUnpaired
    DeviceUnpairingResultStatus_OperationAlreadyInProgress
    DeviceUnpairingResultStatus_AccessDenied
    DeviceUnpairingResultStatus_Failed
End Enum

Public Enum DeviceWatcherEventKind

Module mdlDevicesInput

Public Enum PointerDeviceType
    PointerDeviceType_Touch
    PointerDeviceType_Pen
    PointerDeviceType_Mouse
End Enum

Public Type MouseDelta
    X As Long
    Y As Long
End Type

Public Type PointerDeviceUsage
    UsagePage As Long
    Usage As Long
    MinLogical As Long
    MaxLogical As Long
    MinPhysical As Long
    MaxPhysical As Long
    Unit As Long
    PhysicalMultiplier As Single
End Type

End Module
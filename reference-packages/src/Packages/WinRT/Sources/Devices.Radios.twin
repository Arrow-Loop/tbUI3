Module mdlDevicesRadios

Public Enum RadioAccessStatus
    RadioAccessStatus_Unspecified
    RadioAccessStatus_Allowed
    RadioAccessStatus_DeniedByUser
    RadioAccessStatus_DeniedBySystem
End Enum

Public Enum RadioKind
    RadioKind_Other
    RadioKind_WiFi
    RadioKind_MobileBroadband
    RadioKind_Bluetooth
    RadioKind_FM
End Enum

Public Enum RadioState
    RadioState_Unknown
    RadioState_On
    RadioState_Off
    RadioState_Disabled
End Enum

End Module
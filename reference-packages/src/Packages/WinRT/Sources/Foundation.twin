    X As Single
    Y As Single
    Z As Single
    W As Single
    Function FromCoordinates(Optional ByVal X As Single, Optional ByVal Y As Single, Optional ByVal Z As Single, Optional ByVal W As Single) As Quaternion: FromCoordinates.X = X: FromCoordinates.Y = Y: FromCoordinates.Z = Z: FromCoordinates.W = W: Me = FromCoordinates: End Function
End Type

Public Type Rational
    Numerator As Long
    Denominator As Long
    Function FromOperands(ByVal Numerator As Long, ByVal Denominator As Long) As Rational: FromOperands.Numerator = Numerator: FromOperands.Denominator = Denominator: Me = FromOperands: End Function
End Type

Public Type RECTF
    X As Single
    Y As Single
    Width As Single
    Height As Single
    Function Bottom() As Single: Bottom = RectHelperStatics.GetBottom(Me): End Function
    Function Contains(ByVal Point As POINTF) As Boolean: Contains = RectHelperStatics.Contains(Me, Point) = APITRUE: End Function
    Function Empty() As RECTF: Me = RectHelperStatics.Empty: Return CType(Of RECTF)(VarPtr(Me)): End Function
    Function Equals(ByVal TargetValue As RECTF) As Boolean: Equals = RectHelperStatics.Equals(Me, TargetValue) = APITRUE: End Function
    Function FromCoordinatesAndDimensions(ByVal X As Single, ByVal Y As Single, ByVal Width As Single, ByVal Height As Single) As RECTF: FromCoordinatesAndDimensions = RectHelperStatics.FromCoordinatesAndDimensions(X, Y, Width, Height): Me = FromCoordinatesAndDimensions: End Function
    Function FromLocationAndSize(ByVal Location As POINTF, ByVal Size As SIZEF) As RECTF: FromLocationAndSize = RectHelperStatics.FromLocationAndSize(Location, Size): Me = FromLocationAndSize: End Function
    Function FromPoints(ByVal Point1 As POINTF, ByVal Point2 As POINTF) As RECTF: FromPoints = RectHelperStatics.FromPoints(Point1, Point2): Me = FromPoints: End Function
    Function Intersect(ByVal Rect As RECTF) As RECTF: Intersect = RectHelperStatics.Intersect(Me, Rect): End Function
    Function IsEmpty() As Boolean: IsEmpty = RectHelperStatics.GetIsEmpty(Me) = APITRUE: End Function
    Function Left() As Single: Left = RectHelperStatics.GetLeft(Me): End Function
    Function Right() As Single: Right = RectHelperStatics.GetRight(Me): End Function
    Function Top() As Single: Top = RectHelperStatics.GetTop(Me): End Function
    Function UnionWithPoint(ByVal Point As POINTF) As RECTF: UnionWithPoint = RectHelperStatics.UnionWithPoint(Me, Point): End Function
    Function UnionWithRect(ByVal Rect As RECTF) As RECTF: UnionWithRect = RectHelperStatics.UnionWithRect(Me, Rect): End Function
End Type


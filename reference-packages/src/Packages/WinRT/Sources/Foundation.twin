Public Type Matrix3x2
    M11 As Single
    M12 As Single
    M21 As Single
    M22 As Single
    M31 As Single
    M32 As Single
    Function FromElements(ByVal M11 As Single, ByVal M12 As Single, ByVal M21 As Single, ByVal M22 As Single, ByVal M31 As Single, ByVal M32 As Single) As Matrix3x2
        With FromElements: .M11 = M11: .M12 = M12: .M21 = M21: .M22 = M22: .M31 = M31: .M32 = M32: End With
        Me = FromElements
    End Function
End Type

Public Type Matrix4x4
    M11 As Single
    M12 As Single
    M13 As Single
    M14 As Single
    M21 As Single
    M22 As Single
    M23 As Single
    M24 As Single
    M31 As Single
    M32 As Single
    M33 As Single
    M34 As Single
    M41 As Single
    M42 As Single
    M43 As Single
    M44 As Single
    Function FromElements(ByVal M11 As Single, ByVal M12 As Single, ByVal M13 As Single, ByVal M14 As Single, ByVal M21 As Single, ByVal M22 As Single, ByVal M23 As Single, ByVal M24 As Single, ByVal M31 As Single, ByVal M32 As Single, ByVal M33 As Single, ByVal M34 As Single, ByVal M41 As Single, ByVal M42 As Single, ByVal M43 As Single, ByVal M44 As Single) As Matrix4x4
        With FromElements
            .M11 = M11: .M12 = M12: .M13 = M13: .M14 = M14
            .M21 = M21: .M22 = M22: .M23 = M23: .M24 = M24
            .M31 = M31: .M32 = M32: .M33 = M33: .M34 = M34
            .M41 = M41: .M42 = M42: .M43 = M43: .M44 = M44
        End With
        Me = FromElements
    End Function
End Type


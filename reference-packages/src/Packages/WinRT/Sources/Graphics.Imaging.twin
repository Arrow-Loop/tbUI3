Module mdlGraphicsImaging

Public Enum BitmapAlphaMode
    BitmapAlphaMode_Premultiplied
    BitmapAlphaMode_Straight
    BitmapAlphaMode_Ignore
End Enum

Public Enum BitmapBufferAccessMode
    BitmapBufferAccessMode_Read
    BitmapBufferAccessMode_ReadWrite
    BitmapBufferAccessMode_Write
End Enum

Public Enum BitmapFlip
    BitmapFlip_None
    BitmapFlip_Horizontal
    BitmapFlip_Vertical
End Enum

Public Enum BitmapInterpolationMode
    BitmapInterpolationMode_NearestNeighbor
    BitmapInterpolationMode_Linear
    BitmapInterpolationMode_Cubic
    BitmapInterpolationMode_Fant
End Enum

Public Enum BitmapPixelFormat
    BitmapPixelFormat_Unknown
    BitmapPixelFormat_Rgba16 = 12
    BitmapPixelFormat_Rgba8 = 30
    BitmapPixelFormat_Gray16 = 57
    BitmapPixelFormat_Gray8 = 62
    BitmapPixelFormat_Bgra8 = 87
    BitmapPixelFormat_Nv12 = 103
    BitmapPixelFormat_P010 = 104
    BitmapPixelFormat_Yuy2 = 107
End Enum

Public Enum BitmapRotation
    BitmapRotation_None
    BitmapRotation_Clockwise90Degrees
    BitmapRotation_Clockwise180Degrees
    BitmapRotation_Clockwise270Degrees
End Enum

Public Enum ColorManagementMode
    ColorManagementMode_DoNotColorManage
    ColorManagementMode_ColorManageToSRgb
End Enum

Public Enum ExifOrientationMode
    ExifOrientationMode_IgnoreExifOrientation
    ExifOrientationMode_RespectExifOrientation
End Enum

Public Enum JpegSubsamplingMode
    JpegSubsamplingMode_Default
    JpegSubsamplingMode_Y4Cb2Cr0
    JpegSubsamplingMode_Y4Cb2Cr2
    JpegSubsamplingMode_Y4Cb4Cr4
End Enum

Public Enum PngFilterMode
    PngFilterMode_Automatic
    PngFilterMode_None
    PngFilterMode_Sub
    PngFilterMode_Up
    PngFilterMode_Average
    PngFilterMode_Paeth
    PngFilterMode_Adaptive
End Enum

Public Enum TiffCompressionMode
    TiffCompressionMode_Automatic
    TiffCompressionMode_None
    TiffCompressionMode_Ccitt3
    TiffCompressionMode_Ccitt4
    TiffCompressionMode_Lzw
    TiffCompressionMode_Rle
    TiffCompressionMode_Zip
    TiffCompressionMode_LzwhDifferencing
End Enum

Public Type BitmapBounds
    X As Long
    Y As Long
    Width As Long
    Height As Long
End Type

Public Type BitmapPlaneDescription
    StartIndex As Long
    Width As Long
    Height As Long
    Stride As Long
End Type

Public Type BitmapSize
    Width As Long
    Height As Long
End Type

End Module
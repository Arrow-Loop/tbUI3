Module mdlMediaCaptureFrames

Public Enum MediaFrameReaderAcquisitionMode
    MediaFrameReaderAcquisitionMode_Realtime
    MediaFrameReaderAcquisitionMode_Buffered
End Enum

Public Enum MediaFrameReaderStartStatus
    MediaFrameReaderStartStatus_Success
    MediaFrameReaderStartStatus_UnknownFailure
    MediaFrameReaderStartStatus_DeviceNotAvailable
    MediaFrameReaderStartStatus_OutputFormatNotSupported
    MediaFrameReaderStartStatus_ExclusiveControlNotAvailable
End Enum

Public Enum MediaFrameSourceGetPropertyStatus
    MediaFrameSourceGetPropertyStatus_Success
    MediaFrameSourceGetPropertyStatus_UnknownFailure
    MediaFrameSourceGetPropertyStatus_NotSupported
    MediaFrameSourceGetPropertyStatus_DeviceNotAvailable
    MediaFrameSourceGetPropertyStatus_MaxPropertyValueSizeTooSmall
    MediaFrameSourceGetPropertyStatus_MaxPropertyValueSizeRequired
End Enum

Public Enum MediaFrameSourceKind
    MediaFrameSourceKind_Custom
    MediaFrameSourceKind_Color
    MediaFrameSourceKind_Infrared
    MediaFrameSourceKind_Depth
    MediaFrameSourceKind_Audio
    MediaFrameSourceKind_Image
    MediaFrameSourceKind_Metadata
End Enum

Public Enum MediaFrameSourceSetPropertyStatus
    MediaFrameSourceSetPropertyStatus_Success
    MediaFrameSourceSetPropertyStatus_UnknownFailure
    MediaFrameSourceSetPropertyStatus_NotSupported
    MediaFrameSourceSetPropertyStatus_InvalidValue
    MediaFrameSourceSetPropertyStatus_DeviceNotAvailable
    MediaFrameSourceSetPropertyStatus_NotInControl
End Enum

Public Enum MultiSourceMediaFrameReaderStartStatus
    MultiSourceMediaFrameReaderStartStatus_Success
    MultiSourceMediaFrameReaderStartStatus_NotSupported
    MultiSourceMediaFrameReaderStartStatus_InsufficientResources
    MultiSourceMediaFrameReaderStartStatus_DeviceNotAvailable
    MultiSourceMediaFrameReaderStartStatus_UnknownFailure
End Enum

End Module
Module mdlMediaCapture

Public Enum AppBroadcastCameraCaptureState
    AppBroadcastCameraCaptureState_Stopped
    AppBroadcastCameraCaptureState_Started
    AppBroadcastCameraCaptureState_Failed
End Enum

Public Enum AppBroadcastCameraOverlayLocation
    AppBroadcastCameraOverlayLocation_TopLeft
    AppBroadcastCameraOverlayLocation_TopCenter
    AppBroadcastCameraOverlayLocation_TopRight
    AppBroadcastCameraOverlayLocation_MiddleLeft
    AppBroadcastCameraOverlayLocation_MiddleCenter
    AppBroadcastCameraOverlayLocation_MiddleRight
    AppBroadcastCameraOverlayLocation_BottomLeft
    AppBroadcastCameraOverlayLocation_BottomCenter
    AppBroadcastCameraOverlayLocation_BottomRight
End Enum

Public Enum AppBroadcastCameraOverlaySize
    AppBroadcastCameraOverlaySize_Small
    AppBroadcastCameraOverlaySize_Medium
    AppBroadcastCameraOverlaySize_Large
End Enum

Public Enum AppBroadcastCaptureTargetType
    AppBroadcastCaptureTargetType_AppView
    AppBroadcastCaptureTargetType_EntireDisplay
End Enum

Public Enum AppBroadcastExitBroadcastModeReason
    AppBroadcastExitBroadcastModeReason_NormalExit
    AppBroadcastExitBroadcastModeReason_UserCanceled
    AppBroadcastExitBroadcastModeReason_AuthorizationFail
    AppBroadcastExitBroadcastModeReason_ForegroundAppActivated
End Enum

Public Enum AppBroadcastMicrophoneCaptureState
    AppBroadcastMicrophoneCaptureState_Stopped
    AppBroadcastMicrophoneCaptureState_Started
    AppBroadcastMicrophoneCaptureState_Failed
End Enum

Public Enum AppBroadcastPlugInState
    AppBroadcastPlugInState_Unknown
    AppBroadcastPlugInState_Initialized
    AppBroadcastPlugInState_MicrosoftSignInRequired
    AppBroadcastPlugInState_OAuthSignInRequired
    AppBroadcastPlugInState_ProviderSignInRequired
    AppBroadcastPlugInState_InBandwidthTest
    AppBroadcastPlugInState_ReadyToBroadcast
End Enum

Public Enum AppBroadcastPreviewState
    AppBroadcastPreviewState_Started
    AppBroadcastPreviewState_Stopped
    AppBroadcastPreviewState_Failed
End Enum

Public Enum AppBroadcastSignInResult
    AppBroadcastSignInResult_Success
    AppBroadcastSignInResult_AuthenticationFailed
    AppBroadcastSignInResult_Unauthorized
    AppBroadcastSignInResult_ServiceUnavailable
    AppBroadcastSignInResult_Unknown
End Enum

Public Enum AppBroadcastSignInState
    AppBroadcastSignInState_NotSignedIn

Module mdlMediaCasting

Public Enum CastingConnectionErrorStatus
    CastingConnectionErrorStatus_Succeeded
    CastingConnectionErrorStatus_DeviceDidNotRespond
    CastingConnectionErrorStatus_DeviceError
    CastingConnectionErrorStatus_DeviceLocked
    CastingConnectionErrorStatus_ProtectedPlaybackFailed
    CastingConnectionErrorStatus_InvalidCastingSource
    CastingConnectionErrorStatus_Unknown
End Enum

Public Enum CastingConnectionState
    CastingConnectionState_Disconnected
    CastingConnectionState_Connected
    CastingConnectionState_Rendering
    CastingConnectionState_Disconnecting
    CastingConnectionState_Connecting
End Enum

Public Enum CastingPlaybackTypes
    CastingPlaybackTypes_None = &H0
    CastingPlaybackTypes_Audio = &H1
    CastingPlaybackTypes_Video = &H2
    CastingPlaybackTypes_Picture = &H4
End Enum

End Module
Module mdlMediaDevices

Public Enum AdvancedPhotoMode
    AdvancedPhotoMode_Auto
    AdvancedPhotoMode_Standard
    AdvancedPhotoMode_Hdr
    AdvancedPhotoMode_LowLight
End Enum

Public Enum AudioDeviceRole
    AudioDeviceRole_Default
    AudioDeviceRole_Communications
End Enum

Public Enum AutoFocusRange
    AutoFocusRange_FullRange
    AutoFocusRange_Macro
    AutoFocusRange_Normal

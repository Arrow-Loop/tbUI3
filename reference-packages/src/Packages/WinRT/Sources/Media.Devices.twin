    CaptureSceneMode_Night
    CaptureSceneMode_Beach
    CaptureSceneMode_Sunset
    CaptureSceneMode_Candlelight
    CaptureSceneMode_Landscape
    CaptureSceneMode_NightPortrait
    CaptureSceneMode_Backlit
End Enum

Public Enum CaptureUse
    CaptureUse_None
    CaptureUse_Photo
    CaptureUse_Video
End Enum


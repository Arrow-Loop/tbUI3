Module mdlMediaEffects

Public Enum AudioEffectType
    AudioEffectType_Other
    AudioEffectType_AcousticEchoCancellation
    AudioEffectType_NoiseSuppression
    AudioEffectType_AutomaticGainControl
    AudioEffectType_BeamForming
    AudioEffectType_ConstantToneRemoval
    AudioEffectType_Equalizer
    AudioEffectType_LoudnessEqualizer
    AudioEffectType_BassBoost
    AudioEffectType_VirtualSurround
    AudioEffectType_VirtualHeadphones
    AudioEffectType_SpeakerFill
    AudioEffectType_RoomCorrection
    AudioEffectType_BassManagement
    AudioEffectType_EnvironmentalEffects
    AudioEffectType_SpeakerProtection
    AudioEffectType_SpeakerCompensation
    AudioEffectType_DynamicRangeCompression
    AudioEffectType_FarFieldBeamForming
    AudioEffectType_DeepNoiseSuppression
End Enum

Public Enum AudioRenderCategory
    AudioRenderCategory_Other
    AudioRenderCategory_ForegroundOnlyMedia
    AudioRenderCategory_BackgroundCapableMedia
    AudioRenderCategory_Communications
    AudioRenderCategory_Alerts
    AudioRenderCategory_SoundEffects
    AudioRenderCategory_GameEffects
    AudioRenderCategory_GameMedia
    AudioRenderCategory_GameChat
    AudioRenderCategory_Speech
    AudioRenderCategory_Movie
    AudioRenderCategory_Media
End Enum

Public Enum MediaEffectClosedReason
    MediaEffectClosedReason_Done
    MediaEffectClosedReason_UnknownError
    MediaEffectClosedReason_UnsupportedEncodingFormat
    MediaEffectClosedReason_EffectCurrentlyUnloaded
End Enum

Public Enum MediaMemoryTypes
    MediaMemoryTypes_Gpu
    MediaMemoryTypes_Cpu
    MediaMemoryTypes_GpuAndCpu
End Enum
    
End Module
Module mdlMediaPlayback

Public Enum AutoLoadedDisplayPropertyKind
    AutoLoadedDisplayPropertyKind_None
    AutoLoadedDisplayPropertyKind_MusicOrVideo
    AutoLoadedDisplayPropertyKind_Music
    AutoLoadedDisplayPropertyKind_Video
End Enum

Public Enum FailedMediaStreamKind
    FailedMediaStreamKind_Unknown
    FailedMediaStreamKind_Audio
    FailedMediaStreamKind_Video
End Enum

Public Enum MediaBreakInsertionMethod
    MediaBreakInsertionMethod_Interrupt
    MediaBreakInsertionMethod_Replace
End Enum

Public Enum MediaCommandEnablingRule
    MediaCommandEnablingRule_Auto

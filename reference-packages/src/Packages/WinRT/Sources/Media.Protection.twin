Module mdlMediaProtection

Public Enum GraphicsTrustStatus
    GraphicsTrustStatus_TrustNotRequired
    GraphicsTrustStatus_TrustEstablished
    GraphicsTrustStatus_EnvironmentNotSupported
    GraphicsTrustStatus_DriverNotSupported
    GraphicsTrustStatus_DriverSigningFailure
    GraphicsTrustStatus_UnknownFailure
End Enum

Public Enum HdcpProtection
    HdcpProtection_Off
    HdcpProtection_On
    HdcpProtection_OnWithTypeEnforcement
End Enum

Public Enum HdcpSetProtectionResult
    HdcpSetProtectionResult_Success
    HdcpSetProtectionResult_TimedOut
    HdcpSetProtectionResult_NotSupported
    HdcpSetProtectionResult_UnknownFailure
End Enum

Public Enum ProtectionCapabilityResult
    ProtectionCapabilityResult_NotSupported
    ProtectionCapabilityResult_Maybe
    ProtectionCapabilityResult_Probably
End Enum

Public Enum RenewalStatus
    RenewalStatus_NotStarted
    RenewalStatus_UpdatesInProgress
    RenewalStatus_UserCancelled
    RenewalStatus_AppComponentsMayNeedUpdating
    RenewalStatus_NoComponentsFound
End Enum

Public Enum RevocationAndRenewalReasons
    RevocationAndRenewalReasons_UserModeComponentLoad = &H0
    RevocationAndRenewalReasons_KernelModeComponentLoad = &H1
    RevocationAndRenewalReasons_AppComponent = &H4
    RevocationAndRenewalReasons_GlobalRevocationListLoadFailed = &H10
    RevocationAndRenewalReasons_InvalidGlobalRevocationListSignature = &H20
    RevocationAndRenewalReasons_GlobalRevocationListAbsent = &H1000
    RevocationAndRenewalReasons_ComponentRevoked = &H2000
    RevocationAndRenewalReasons_InvalidComponentCertificateExtendedKeyUse = &H4000
    RevocationAndRenewalReasons_ComponentCertificateRevoked = &H8000&
    RevocationAndRenewalReasons_InvalidComponentCertificateRoot = &H8000&
    RevocationAndRenewalReasons_ComponentHighSecurityCertificateRevoked = &H20000
    RevocationAndRenewalReasons_ComponentLowSecurityCertificateRevoked = &H40000
    RevocationAndRenewalReasons_BootDriverVerificationFailed = &H100000
    RevocationAndRenewalReasons_ComponentSignedWithTestCertificate = &H1000000
    RevocationAndRenewalReasons_EncryptionFailure = &H10000000
End Enum

End Module
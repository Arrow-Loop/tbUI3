Module mdlMediaSpeechRecognition

Public Enum SpeechContinuousRecognitionMode
    SpeechContinuousRecognitionMode_Default
    SpeechContinuousRecognitionMode_PauseOnRecognition
End Enum

Public Enum SpeechRecognitionAudioProblem
    SpeechRecognitionAudioProblem_None
    SpeechRecognitionAudioProblem_TooNoisy
    SpeechRecognitionAudioProblem_NoSignal
    SpeechRecognitionAudioProblem_TooLoud
    SpeechRecognitionAudioProblem_TooQuiet
    SpeechRecognitionAudioProblem_TooFast
    SpeechRecognitionAudioProblem_TooSlow
End Enum

Public Enum SpeechRecognitionConfidence
    SpeechRecognitionConfidence_High
    SpeechRecognitionConfidence_Medium
    SpeechRecognitionConfidence_Low
    SpeechRecognitionConfidence_Rejected
End Enum

Public Enum SpeechRecognitionConstraintProbability
    SpeechRecognitionConstraintProbability_Default
    SpeechRecognitionConstraintProbability_Min
    SpeechRecognitionConstraintProbability_Max
End Enum

Public Enum SpeechRecognitionConstraintType
    SpeechRecognitionConstraintType_Topic
    SpeechRecognitionConstraintType_List
    SpeechRecognitionConstraintType_Grammar
    SpeechRecognitionConstraintType_VoiceCommandDefinition
End Enum

Public Enum SpeechRecognitionResultStatus
    SpeechRecognitionResultStatus_Success
    SpeechRecognitionResultStatus_TopicLanguageNotSupported
    SpeechRecognitionResultStatus_GrammarLanguageMismatch
    SpeechRecognitionResultStatus_GrammarCompilationFailure
    SpeechRecognitionResultStatus_AudioQualityFailure
    SpeechRecognitionResultStatus_UserCanceled
    SpeechRecognitionResultStatus_Unknown
    SpeechRecognitionResultStatus_TimeoutExceeded
    SpeechRecognitionResultStatus_PauseLimitExceeded
    SpeechRecognitionResultStatus_NetworkFailure
    SpeechRecognitionResultStatus_MicrophoneUnavailable
End Enum

Public Enum SpeechRecognitionScenario
    SpeechRecognitionScenario_WebSearch
    SpeechRecognitionScenario_Dictation
    SpeechRecognitionScenario_FormFilling
End Enum

Public Enum SpeechRecognizerState
    SpeechRecognizerState_Idle
    SpeechRecognizerState_Capturing
    SpeechRecognizerState_Processing
    SpeechRecognizerState_SoundStarted
    SpeechRecognizerState_SoundEnded
    SpeechRecognizerState_SpeechDetected
    SpeechRecognizerState_Paused
End Enum

End Module
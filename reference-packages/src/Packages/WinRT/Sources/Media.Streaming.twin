Module mdlMediaStreaming

Public Enum ConnectionStatus
    ConnectionStatus_Online
    ConnectionStatus_Offline
    ConnectionStatus_Sleeping
End Enum

Public Enum DeviceTypes
    DeviceTypes_Unknown = &H0
    DeviceTypes_DigitalMediaRenderer = &H1
    DeviceTypes_DigitalMediaServer = &H2
    DeviceTypes_DigitalMediaPlayer = &H4
End Enum

Public Enum TransportState
    TransportState_Unknown
    TransportState_Stopped
    TransportState_Playing
    TransportState_Transitioning
    TransportState_Paused
    TransportState_Recording
    TransportState_NoMediaPresent
    TransportState_Last
End Enum

Public Enum TransportStatus
    TransportStatus_Unknown
    TransportStatus_Ok
    TransportStatus_ErrorOccurred
    TransportStatus_Last
End Enum

Public Type PlaySpeed
    Numerator As Long
    Denominator As Long
End Type

Public Type TrackInformation
    Track As Long
    TrackId As Long
    TrackDuration As TimeSpan
End Type

Public Type PositionInformation
    TrackInformation As TrackInformation
    RelativeTime As TimeSpan
End Type

Public Type RenderingParameters
    Volume As Long
    Mute As BooleanByte
End Type

Public Type TransportInformation
    CurrentTransportState As TransportState
    CurrentTransportStatus As TransportStatus
    CurrentSpeed As PlaySpeed
End Type

End Module
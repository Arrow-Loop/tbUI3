Module mdlNetworkingBackgroundTransfer

Public Enum BackgroundTransferBehavior
    BackgroundTransferBehavior_Parallel
    BackgroundTransferBehavior_Serialized
End Enum

Public Enum BackgroundTransferCostPolicy
    BackgroundTransferCostPolicy_Default
    BackgroundTransferCostPolicy_UnrestrictedOnly
    BackgroundTransferCostPolicy_Always
End Enum

Public Enum BackgroundTransferPriority
    BackgroundTransferPriority_Default
    BackgroundTransferPriority_High
    BackgroundTransferPriority_Low
End Enum

Public Enum BackgroundTransferStatus
    BackgroundTransferStatus_Idle
    BackgroundTransferStatus_Running
    BackgroundTransferStatus_PausedByApplication
    BackgroundTransferStatus_PausedCostedNetwork
    BackgroundTransferStatus_PausedNoNetwork
    BackgroundTransferStatus_Completed
    BackgroundTransferStatus_Canceled
    BackgroundTransferStatus_Error
    BackgroundTransferStatus_PausedRecoverableWebErrorStatus
    BackgroundTransferStatus_PausedSystemPolicy = 32
End Enum

Public Type BackgroundDownloadProgress
    BytesReceived As UInt64
    TotalBytesToReceive As UInt64
    Status As BackgroundTransferStatus
    HasResponseChanged As BooleanByte
    HasRestarted As BooleanByte
End Type

Public Type BackgroundTransferFileRange
    Offset As UInt64
    Length As UInt64
End Type

Public Type BackgroundUploadProgress
    BytesReceived As UInt64
    BytesSent As UInt64
    TotalBytesToReceive As UInt64
    TotalBytesToSend As UInt64
    Status As BackgroundTransferStatus
    HasResponseChanged As BooleanByte
    HasRestarted As BooleanByte
End Type

End Module
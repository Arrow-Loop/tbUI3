[InterfaceId("F68CD4BF-A388-4E8B-91EA-54DD6DD901C0")]
Interface IHostNameStatics Extends IInspectable
    Function Compare(ByVal Value1 As LongPtr, ByVal Value2 As LongPtr) As Long
End Interface

Module mdlNetworking

Public Enum DomainNameType
    DomainNameType_Suffix
    DomainNameType_FullyQualified
End Enum

Public Enum HostNameSortOptions
    HostNameSortOptions_None = &H0
    HostNameSortOptions_OptimizeForLongConnections = &H2
End Enum

Public Enum HostNameType
    HostNameType_DomainName

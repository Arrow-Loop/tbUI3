Module mdlPerceptionSpatial

Public Enum SpatialAnchorExportPurpose
    SpatialAnchorExportPurpose_Relocalization
    SpatialAnchorExportPurpose_Sharing
End Enum

Public Enum SpatialEntityWatcherStatus
    SpatialEntityWatcherStatus_Created
    SpatialEntityWatcherStatus_Started
    SpatialEntityWatcherStatus_EnumerationCompleted
    SpatialEntityWatcherStatus_Stopping
    SpatialEntityWatcherStatus_Stopped
    SpatialEntityWatcherStatus_Aborted
End Enum

Public Enum SpatialLocatability
    SpatialLocatability_Unavailable
    SpatialLocatability_OrientationOnly
    SpatialLocatability_PositionalTrackingActivating
    SpatialLocatability_PositionalTrackingActive
    SpatialLocatability_PositionalTrackingInhibited
End Enum

Public Enum SpatialLookDirectionRange
    SpatialLookDirectionRange_ForwardOnly
    SpatialLookDirectionRange_Omnidirectional
End Enum

Public Enum SpatialMovementRange
    SpatialMovementRange_NoMovement
    SpatialMovementRange_Bounded
End Enum

Public Enum SpatialPerceptionAccessStatus
    SpatialPerceptionAccessStatus_Unspecified
    SpatialPerceptionAccessStatus_Allowed
    SpatialPerceptionAccessStatus_DeniedByUser
    SpatialPerceptionAccessStatus_DeniedBySystem
End Enum

Public Type SpatialBoundingBox
    Center As Vector3
    Extents As Vector3
End Type

Public Type SpatialBoundingFrustum
    Near As Plane
    Far As Plane
    Right As Plane
    Left As Plane
    Top As Plane
    Bottom As Plane
End Type

Public Type SpatialBoundingOrientedBox
    Center As Vector3
    Extents As Vector3
    Orientation As Quaternion
End Type

Public Type SpatialBoundingSphere
    Center As Vector3
    Radius As Single
End Type

Public Type SpatialRay
    Origin As Vector3
    Direction As Vector3
End Type

End Module
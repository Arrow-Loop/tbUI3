Module mdlSecurityAuthenticationWeb

Public Enum TokenBindingKeyType
    TokenBindingKeyType_Rsa2048
    TokenBindingKeyType_EcdsaP256
    TokenBindingKeyType_AnyExisting
End Enum

Public Enum WebAuthenticationOptions
    WebAuthenticationOptions_None = &H0
    WebAuthenticationOptions_SilentMode = &H1
    WebAuthenticationOptions_UseTitle = &H2
    WebAuthenticationOptions_UseHttpPost = &H4
    WebAuthenticationOptions_UseCorporateNetwork = &H8
End Enum

Public Enum WebAuthenticationStatus
    WebAuthenticationStatus_Success
    WebAuthenticationStatus_UserCancel
    WebAuthenticationStatus_ErrorHttp
End Enum

End Module
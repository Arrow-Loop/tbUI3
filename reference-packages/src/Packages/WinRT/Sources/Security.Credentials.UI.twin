Module mdlSecurityCredentialsUI

Public Enum AuthenticationProtocol
    AuthenticationProtocol_Basic
    AuthenticationProtocol_Digest
    AuthenticationProtocol_Ntlm
    AuthenticationProtocol_Kerberos
    AuthenticationProtocol_Negotiate
    AuthenticationProtocol_CredSsp
    AuthenticationProtocol_Custom
End Enum

Public Enum CredentialSaveOption
    CredentialSaveOption_Unselected
    CredentialSaveOption_Selected
    CredentialSaveOption_Hidden
End Enum

Public Enum UserConsentVerificationResult
    UserConsentVerificationResult_Verified
    UserConsentVerificationResult_DeviceNotPresent
    UserConsentVerificationResult_NotConfiguredForUser
    UserConsentVerificationResult_DisabledByPolicy
    UserConsentVerificationResult_DeviceBusy
    UserConsentVerificationResult_RetriesExhausted
    UserConsentVerificationResult_Canceled
End Enum

Public Enum UserConsentVerifierAvailability
    UserConsentVerifierAvailability_Available
    UserConsentVerifierAvailability_DeviceNotPresent
    UserConsentVerifierAvailability_NotConfiguredForUser
    UserConsentVerifierAvailability_DisabledByPolicy
    UserConsentVerifierAvailability_DeviceBusy
End Enum
    
End Module
Module mdlSecurityCredentials

Public Enum KeyCredentialAttestationStatus
    KeyCredentialAttestationStatus_Success
    KeyCredentialAttestationStatus_UnknownError
    KeyCredentialAttestationStatus_NotSupported
    KeyCredentialAttestationStatus_TemporaryFailure
End Enum

Public Enum KeyCredentialCreationOption
    KeyCredentialCreationOption_ReplaceExisting
    KeyCredentialCreationOption_FailIfExists
End Enum

Public Enum KeyCredentialStatus
    KeyCredentialStatus_Success
    KeyCredentialStatus_UnknownError
    KeyCredentialStatus_NotFound
    KeyCredentialStatus_UserCanceled
    KeyCredentialStatus_UserPrefersPassword
    KeyCredentialStatus_CredentialAlreadyExists
    KeyCredentialStatus_SecurityDeviceLocked
End Enum

Public Enum WebAccountPictureSize
    WebAccountPictureSize_Size64x64 = 64
    WebAccountPictureSize_Size208x208 = 208
    WebAccountPictureSize_Size424x424 = 424
    WebAccountPictureSize_Size1080x1080 = 1080
End Enum

Public Enum WebAccountState
    WebAccountState_None
    WebAccountState_Connected
    WebAccountState_Error
End Enum

End Module
Module mdlSecurityCryptographyCertificates

Public Enum CertificateChainPolicy
    CertificateChainPolicy_Base
    CertificateChainPolicy_Ssl
    CertificateChainPolicy_NTAuthentication
    CertificateChainPolicy_MicrosoftRoot
End Enum

Public Enum ChainValidationResult
    ChainValidationResult_Success
    ChainValidationResult_Untrusted
    ChainValidationResult_Revoked
    ChainValidationResult_Expired
    ChainValidationResult_IncompleteChain
    ChainValidationResult_InvalidSignature
    ChainValidationResult_WrongUsage
    ChainValidationResult_InvalidName
    ChainValidationResult_InvalidCertificateAuthorityPolicy
    ChainValidationResult_BasicConstraintsError
    ChainValidationResult_UnknownCriticalExtension
    ChainValidationResult_RevocationInformationMissing
    ChainValidationResult_RevocationFailure
    ChainValidationResult_OtherErrors
End Enum


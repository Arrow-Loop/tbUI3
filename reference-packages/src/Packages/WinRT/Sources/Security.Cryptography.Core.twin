Module mdlSecurityCryptographyCore

Public Enum Capi1KdfTargetAlgorithm
    Capi1KdfTargetAlgorithm_NotAes
    Capi1KdfTargetAlgorithm_Aes
End Enum

Public Enum CryptographicPadding
    CryptographicPadding_None
    CryptographicPadding_RsaOaep
    CryptographicPadding_RsaPkcs1V15
    CryptographicPadding_RsaPss
End Enum

Public Enum CryptographicPrivateKeyBlobType
    CryptographicPrivateKeyBlobType_Pkcs8RawPrivateKeyInfo
    CryptographicPrivateKeyBlobType_Pkcs1RsaPrivateKey
    CryptographicPrivateKeyBlobType_BCryptPrivateKey
    CryptographicPrivateKeyBlobType_Capi1PrivateKey
    CryptographicPrivateKeyBlobType_BCryptEccFullPrivateKey
End Enum

Public Enum CryptographicPublicKeyBlobType
    CryptographicPublicKeyBlobType_X509SubjectPublicKeyInfo
    CryptographicPublicKeyBlobType_Pkcs1RsaPublicKey
    CryptographicPublicKeyBlobType_BCryptPublicKey
    CryptographicPublicKeyBlobType_Capi1PublicKey
    CryptographicPublicKeyBlobType_BCryptEccFullPublicKey
End Enum

End Module
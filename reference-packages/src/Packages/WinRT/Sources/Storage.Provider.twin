Module mdlStorageProvider

Public Enum CachedFileOptions
    CachedFileOptions_None = &H0
    CachedFileOptions_RequireUpdateOnAccess = &H1
    CachedFileOptions_UseCachedFileWhenOffline = &H2
    CachedFileOptions_DenyAccessWhenOffline = &H4
End Enum

Public Enum CachedFileTarget
    CachedFileTarget_Local
    CachedFileTarget_Remote
End Enum

Public Enum ReadActivationMode
    ReadActivationMode_NotNeeded
    ReadActivationMode_BeforeAccess
End Enum

Public Enum StorageProviderHardlinkPolicy
    StorageProviderHardlinkPolicy_None
    StorageProviderHardlinkPolicy_Allowed
End Enum

Public Enum StorageProviderHydrationPolicy
    StorageProviderHydrationPolicy_Partial
    StorageProviderHydrationPolicy_Progressive
    StorageProviderHydrationPolicy_Full
    StorageProviderHydrationPolicy_AlwaysFull
End Enum

Public Enum StorageProviderHydrationPolicyModifier
    StorageProviderHydrationPolicyModifier_None = &H0
    StorageProviderHydrationPolicyModifier_ValidationRequired = &H1
    StorageProviderHydrationPolicyModifier_StreamingAllowed = &H2
    StorageProviderHydrationPolicyModifier_AutoDehydrationAllowed = &H4
    StorageProviderHydrationPolicyModifier_AllowFullRestartHydration = &H8
End Enum

Public Enum StorageProviderInSyncPolicy
    StorageProviderInSyncPolicy_Default = &H0
    StorageProviderInSyncPolicy_FileCreationTime = &H1
    StorageProviderInSyncPolicy_FileReadOnlyAttribute = &H2
    StorageProviderInSyncPolicy_FileHiddenAttribute = &H4
    StorageProviderInSyncPolicy_FileSystemAttribute = &H8
    StorageProviderInSyncPolicy_DirectoryCreationTime = &H10
    StorageProviderInSyncPolicy_DirectoryReadOnlyAttribute = &H20
    StorageProviderInSyncPolicy_DirectoryHiddenAttribute = &H40
    StorageProviderInSyncPolicy_DirectorySystemAttribute = &H80
    StorageProviderInSyncPolicy_FileLastWriteTime = &H100
    StorageProviderInSyncPolicy_DirectoryLastWriteTime = &H200
    StorageProviderInSyncPolicy_PreserveInsyncForSyncEngine = &H80000000
End Enum

Public Enum StorageProviderPopulationPolicy
    StorageProviderPopulationPolicy_Full
    StorageProviderPopulationPolicy_AlwaysFull
End Enum

Public Enum StorageProviderProtectionMode
    StorageProviderProtectionMode_Unknown
    StorageProviderProtectionMode_Personal
End Enum

Public Enum StorageProviderState
    StorageProviderState_InSync
    StorageProviderState_Syncing
    StorageProviderState_Paused
    StorageProviderState_Error
    StorageProviderState_Warning
    StorageProviderState_Offline
End Enum

Public Enum StorageProviderUICommandState
    StorageProviderUICommandState_Enabled
    StorageProviderUICommandState_Disabled
    StorageProviderUICommandState_Hidden
End Enum

Public Enum StorageProviderUriSourceStatus
    StorageProviderUriSourceStatus_Success
    StorageProviderUriSourceStatus_NoSyncRoot
    StorageProviderUriSourceStatus_FileNotFound
End Enum


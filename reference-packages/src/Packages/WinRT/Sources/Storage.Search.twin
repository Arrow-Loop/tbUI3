Module mdlStorageSearch

Public Enum CommonFileQuery
    CommonFileQuery_DefaultQuery
    CommonFileQuery_OrderByName
    CommonFileQuery_OrderByTitle
    CommonFileQuery_OrderByMusicProperties
    CommonFileQuery_OrderBySearchRank
    CommonFileQuery_OrderByDate
End Enum

Public Enum CommonFolderQuery
    CommonFolderQuery_DefaultQuery
    CommonFolderQuery_GroupByYear = 100
    CommonFolderQuery_GroupByMonth
    CommonFolderQuery_GroupByArtist
    CommonFolderQuery_GroupByAlbum
    CommonFolderQuery_GroupByAlbumArtist
    CommonFolderQuery_GroupByComposer
    CommonFolderQuery_GroupByGenre
    CommonFolderQuery_GroupByPublishedYear
    CommonFolderQuery_GroupByRating
    CommonFolderQuery_GroupByTag
    CommonFolderQuery_GroupByAuthor
    CommonFolderQuery_GroupByType
End Enum

Public Enum DateStackOption
    DateStackOption_None
    DateStackOption_Year
    DateStackOption_Month
End Enum

Public Enum FolderDepth
    FolderDepth_Shallow
    FolderDepth_Deep
End Enum

Public Enum IndexedState
    IndexedState_Unknown
    IndexedState_NotIndexed
    IndexedState_PartiallyIndexed
    IndexedState_FullyIndexed
End Enum

Public Enum IndexerOption
    IndexerOption_UseIndexerWhenAvailable
    IndexerOption_OnlyUseIndexer
    IndexerOption_DoNotUseIndexer
    IndexerOption_OnlyUseIndexerAndOptimizeForIndexedProperties
End Enum

Public Type SortEntry
    PropertyName As LongPtr
    AscendingOrder As BooleanByte
End Type

End Module
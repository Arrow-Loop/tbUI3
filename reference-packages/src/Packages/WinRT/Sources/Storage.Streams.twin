Module mdlStorageStreams

Public Enum ByteOrder
    ByteOrder_LittleEndian
    ByteOrder_BigEndian
End Enum

Public Enum FileAccessMode
    FileAccessMode_Read
    FileAccessMode_Write
End Enum

Public Enum FileOpenDisposition
    FileOpenDisposition_OpenExisting
    FileOpenDisposition_OpenAlways
    FileOpenDisposition_CreateNew
    FileOpenDisposition_CreateAlways
    FileOpenDisposition_TruncateExisting
End Enum

Public Enum InputStreamOptions
    InputStreamOptions_None
    InputStreamOptions_Partial
    InputStreamOptions_ReadAhead
End Enum

Public Enum UnicodeEncoding
    UnicodeEncoding_UTF8
    UnicodeEncoding_UTF16LE
    UnicodeEncoding_UTF16BE
End Enum
    
End Module
Module mdlStorage

Public Enum ApplicationDataCreateDisposition
    ApplicationDataCreateDisposition_Always
    ApplicationDataCreateDisposition_Existing
End Enum

Public Enum ApplicationDataLocality
    ApplicationDataLocality_Local
    ApplicationDataLocality_Roaming
    ApplicationDataLocality_Temporary
    ApplicationDataLocality_LocalCache
    ApplicationDataLocality_SharedLocal
End Enum

Public Enum CreationCollisionOption
    CreationCollisionOption_GenerateUniqueName
    CreationCollisionOption_ReplaceExisting
    CreationCollisionOption_FailIfExists
    CreationCollisionOption_OpenIfExists
End Enum

Public Enum FileAttributes
    FileAttributes_Normal = &H0
    FileAttributes_ReadOnly = &H1
    FileAttributes_Directory = &H10
    FileAttributes_Archive = &H20
    FileAttributes_Temporary = &H100
    FileAttributes_LocallyIncomplete = &H200
End Enum

Public Enum FileUpdateStatus
    FileUpdateStatus_Incomplete
    FileUpdateStatus_Complete
    FileUpdateStatus_UserInputNeeded
    FileUpdateStatus_CurrentlyUnavailable
    FileUpdateStatus_Failed
    FileUpdateStatus_CompleteAndRenamed
End Enum

Public Enum KnownFolderId
    KnownFolderId_AppCaptures
    KnownFolderId_CameraRoll
    KnownFolderId_DocumentsLibrary
    KnownFolderId_HomeGroup
    KnownFolderId_MediaServerDevices
    KnownFolderId_MusicLibrary
    KnownFolderId_Objects3D
    KnownFolderId_PicturesLibrary
    KnownFolderId_Playlists
    KnownFolderId_RecordedCalls
    KnownFolderId_RemovableDevices
    KnownFolderId_SavedPictures
    KnownFolderId_Screenshots
    KnownFolderId_VideosLibrary
    KnownFolderId_AllAppMods
    KnownFolderId_CurrentAppMods
    KnownFolderId_DownloadsFolder
End Enum

Public Enum KnownFoldersAccessStatus
    KnownFoldersAccessStatus_DeniedBySystem
    KnownFoldersAccessStatus_NotDeclaredByApp
    KnownFoldersAccessStatus_DeniedByUser
    KnownFoldersAccessStatus_UserPromptRequired
    KnownFoldersAccessStatus_Allowed
    KnownFoldersAccessStatus_AllowedPerAppFolder
End Enum

Public Enum KnownLibraryId
    KnownLibraryId_Music
    KnownLibraryId_Pictures
    KnownLibraryId_Videos
    KnownLibraryId_Documents
End Enum

Public Enum NameCollisionOption
    NameCollisionOption_GenerateUniqueName
    NameCollisionOption_ReplaceExisting
    NameCollisionOption_FailIfExists
End Enum

Public Enum PhotoOrientation
    PhotoOrientation_Unspecified
    PhotoOrientation_Normal
    PhotoOrientation_FlipHorizontal
    PhotoOrientation_Rotate180
    PhotoOrientation_FlipVertical
    PhotoOrientation_Transpose
    PhotoOrientation_Rotate270
    PhotoOrientation_Transverse
    PhotoOrientation_Rotate90
End Enum

Public Enum PropertyPrefetchOptions
    PropertyPrefetchOptions_None = &H0
    PropertyPrefetchOptions_MusicProperties = &H1
    PropertyPrefetchOptions_VideoProperties = &H2
    PropertyPrefetchOptions_ImageProperties = &H4
    PropertyPrefetchOptions_DocumentProperties = &H8
    PropertyPrefetchOptions_BasicProperties = &H10
End Enum

Public Enum StorageDeleteOption
    StorageDeleteOption_Default
    StorageDeleteOption_PermanentDelete
End Enum

Public Enum StorageItemTypes
    StorageItemTypes_None
    StorageItemTypes_File
    StorageItemTypes_Folder
End Enum

Public Enum StorageLibraryChangeType
    StorageLibraryChangeType_Created
    StorageLibraryChangeType_Deleted
    StorageLibraryChangeType_MovedOrRenamed
    StorageLibraryChangeType_ContentsChanged
    StorageLibraryChangeType_MovedOutOfLibrary
    StorageLibraryChangeType_MovedIntoLibrary
    StorageLibraryChangeType_ContentsReplaced
    StorageLibraryChangeType_IndexingStatusChanged
    StorageLibraryChangeType_EncryptionChanged
    StorageLibraryChangeType_ChangeTrackingLost
End Enum

Public Enum StorageOpenOptions
    StorageOpenOptions_None
    StorageOpenOptions_AllowOnlyReaders
    StorageOpenOptions_AllowReadersAndWriters
End Enum

Public Enum StreamedFileFailureMode
    StreamedFileFailureMode_Failed
    StreamedFileFailureMode_CurrentlyUnavailable
    StreamedFileFailureMode_Incomplete
End Enum

Enum ThumbnailMode
    ThumbnailMode_PicturesView
    ThumbnailMode_VideosView
    ThumbnailMode_MusicView
    ThumbnailMode_DocumentsView
    ThumbnailMode_ListView
    ThumbnailMode_SingleItem
End Enum

Public Enum ThumbnailOptions
    ThumbnailOptions_None = &H0
    ThumbnailOptions_ReturnOnlyIfCached = &H1
    ThumbnailOptions_ResizeThumbnail = &H2
    ThumbnailOptions_UseCurrentScale = &H4
End Enum

Public Enum ThumbnailType
    ThumbnailType_Image
    ThumbnailType_Icon
End Enum

Public Enum VideoOrientation
    VideoOrientation_Normal = 0
    VideoOrientation_Rotate90 = 90
    VideoOrientation_Rotate180 = 180
    VideoOrientation_Rotate270 = 270
End Enum
    

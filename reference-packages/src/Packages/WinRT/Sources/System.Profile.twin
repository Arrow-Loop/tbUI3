Module mdlSystemProfile

Public Enum PlatformDataCollectionLevel
    PlatformDataCollectionLevel_Security
    PlatformDataCollectionLevel_Basic
    PlatformDataCollectionLevel_Enhanced
    PlatformDataCollectionLevel_Full
End Enum

Public Enum SystemIdentificationSource
    SystemIdentificationSource_None
    SystemIdentificationSource_Tpm
    SystemIdentificationSource_Uefi
    SystemIdentificationSource_Registry
End Enum

Public Enum SystemOutOfBoxExperienceState
    SystemOutOfBoxExperienceState_NotStarted
    SystemOutOfBoxExperienceState_InProgress
    SystemOutOfBoxExperienceState_Completed
End Enum

Public Enum UnsupportedAppRequirementReasons
    UnsupportedAppRequirementReasons_Unknown
    UnsupportedAppRequirementReasons_DeniedBySystem
End Enum

End Module
Module mdlUICompositionDesktop

[UseGetLastError(False), DLLStackCheck(False)]
Public Declare PtrSafe Function CreateDispatcherQueueController Lib "coremessaging" (ByVal Options As DispatcherQueueOptions, DispatcherQueueController As IDispatcherQueueController) As HRESULT

Public Enum DISPATCHERQUEUE_THREAD_APARTMENTTYPE
    DQTAT_COM_NONE
    DQTAT_COM_ASTA
    DQTAT_COM_STA
End Enum

Public Enum DISPATCHERQUEUE_THREAD_TYPE
    DQTYPE_THREAD_DEDICATED = 1
    DQTYPE_THREAD_CURRENT
End Enum

Public Enum POINTER_BUTTON_CHANGE_TYPE
    POINTER_CHANGE_NONE
    POINTER_CHANGE_FIRSTBUTTON_DOWN
    POINTER_CHANGE_FIRSTBUTTON_UP
    POINTER_CHANGE_SECONDBUTTON_DOWN
    POINTER_CHANGE_SECONDBUTTON_UP
    POINTER_CHANGE_THIRDBUTTON_DOWN
    POINTER_CHANGE_THIRDBUTTON_UP
    POINTER_CHANGE_FOURTHBUTTON_DOWN
    POINTER_CHANGE_FOURTHBUTTON_UP
    POINTER_CHANGE_FIFTHBUTTON_DOWN
    POINTER_CHANGE_FIFTHBUTTON_UP
End Enum

Public Enum POINTER_FLAGS
    POINTER_FLAG_NONE = &H0
    POINTER_FLAG_NEW = &H1
    POINTER_FLAG_INRANGE = &H2
    POINTER_FLAG_INCONTACT = &H4
    POINTER_FLAG_FIRSTBUTTON = &H10
    POINTER_FLAG_SECONDBUTTON = &H20
    POINTER_FLAG_THIRDBUTTON = &H40
    POINTER_FLAG_FOURTHBUTTON = &H80
    POINTER_FLAG_FIFTHBUTTON = &H100
    POINTER_FLAG_PRIMARY = &H2000
    POINTER_FLAG_CONFIDENCE = &H4000
    POINTER_FLAG_CANCELED = &H8000&
    POINTER_FLAG_DOWN = &H10000
    POINTER_FLAG_UPDATE = &H20000
    POINTER_FLAG_UP = &H40000
    POINTER_FLAG_WHEEL = &H80000
    POINTER_FLAG_HWHEEL = &H100000
    POINTER_FLAG_CAPTURECHANGED = &H200000
    POINTER_FLAG_HASTRANSFORM = &H400000
End Enum

Public Enum POINTER_INPUT_TYPE
    PT_POINTER = 1
    PT_TOUCH
    PT_PEN
    PT_MOUSE
    PT_TOUCHPAD
End Enum

Public Type DispatcherQueueOptions
    dwSize As Long
    ThreadType As DISPATCHERQUEUE_THREAD_TYPE
    ApartmentType As DISPATCHERQUEUE_THREAD_APARTMENTTYPE
End Type

Public Type POINTER_INFO
    PointerType As POINTER_INPUT_TYPE
    PointerId As Long
    FrameId As Long
    PointerFlags As POINTER_FLAGS
    SourceDevice As LongPtr
    hWndTarget As LongPtr
    ptPixelLocation As POINTL
    ptHimetricLocation As POINTL
    ptPixelLocationRaw As POINTL
    ptHimetricLocationRaw As POINTL
    dwTime As Long
    HistoryCount As Long
    InputData As Long
    dwKeyStates As Long
    PerformanceCount As Currency
    ButtonChangeType As POINTER_BUTTON_CHANGE_TYPE
End Type
    
End Module
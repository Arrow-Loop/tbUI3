Interface ICompositionDrawingSurfaceInterop Extends IUnknown
    [PreserveSig]
    Function BeginDraw(UpdateRect As Any, rIID As Any, UpdateObject As Any, UpdateOffset As Any) As HRESULT
    [PreserveSig]
    Function EndDraw() As HRESULT
    [PreserveSig]
    Function Resize(ByVal SizePixels As SIZEL) As HRESULT
    [PreserveSig]
    Function Scroll(ScrollRect As Any, ClipRect As Any, ByVal OffsetX As Long, ByVal OffsetY As Long) As HRESULT
    [PreserveSig]
    Function ResumeDraw() As HRESULT
    [PreserveSig]
    Function SuspendDraw() As HRESULT
End Interface


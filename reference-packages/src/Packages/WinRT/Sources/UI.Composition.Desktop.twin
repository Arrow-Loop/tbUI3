Interface ICompositionDrawingSurfaceInterop2 Extends ICompositionDrawingSurfaceInterop
    [PreserveSig]
    Function CopySurface(ByVal DestinationResource As IUnknown, ByVal OffsetX As Long, ByVal OffsetY As Long, SourceRectangle As Any) As HRESULT
End Interface


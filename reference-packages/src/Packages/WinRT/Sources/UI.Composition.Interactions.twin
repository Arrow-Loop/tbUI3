Module mdlUICompositionInteractions

Public Enum InteractionBindingAxisModes
    InteractionBindingAxisModes_None = &H0
    InteractionBindingAxisModes_PositionX = &H1
    InteractionBindingAxisModes_PositionY = &H2
    InteractionBindingAxisModes_Scale = &H4
End Enum

Public Enum InteractionChainingMode
    InteractionChainingMode_Auto
    InteractionChainingMode_Always
    InteractionChainingMode_Never
End Enum

Public Enum InteractionSourceMode
    InteractionSourceMode_Disabled
    InteractionSourceMode_EnabledWithInertia
    InteractionSourceMode_EnabledWithoutInertia
End Enum

Public Enum InteractionSourceRedirectionMode
    InteractionSourceRedirectionMode_Disabled
    InteractionSourceRedirectionMode_Enabled
End Enum

Public Enum InteractionTrackerClampingOption
    InteractionTrackerClampingOption_Auto
    InteractionTrackerClampingOption_Disabled
End Enum

Public Enum InteractionTrackerPositionUpdateOption
    InteractionTrackerPositionUpdateOption_Default
    InteractionTrackerPositionUpdateOption_AllowActiveCustomScaleAnimation
End Enum

Public Enum VisualInteractionSourceRedirectionMode
    VisualInteractionSourceRedirectionMode_Off
    VisualInteractionSourceRedirectionMode_CapableTouchpadOnly
    VisualInteractionSourceRedirectionMode_PointerWheelOnly
    VisualInteractionSourceRedirectionMode_CapableTouchpadAndPointerWheel
End Enum

End Module
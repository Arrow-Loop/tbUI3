Module mdlUICompositionScenes

Public Enum SceneAlphaMode
	SceneAlphaMode_Opaque
	SceneAlphaMode_AlphaTest
	SceneAlphaMode_Blend
End Enum
    
Public Enum SceneAttributeSemantic
    SceneAttributeSemantic_Index
    SceneAttributeSemantic_Vertex
    SceneAttributeSemantic_Normal
    SceneAttributeSemantic_TexCoord0
    SceneAttributeSemantic_TexCoord1
    SceneAttributeSemantic_Color
    SceneAttributeSemantic_Tangent
End Enum

Public Enum SceneComponentType
    SceneComponentType_MeshRendererComponent
End Enum

Public Enum SceneWrappingMode
    SceneWrappingMode_ClampToEdge
    SceneWrappingMode_MirroredRepeat
    SceneWrappingMode_Repeat
End Enum

End Module
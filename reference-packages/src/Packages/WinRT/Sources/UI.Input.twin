Module mdlUIInput

Public Enum CrossSlidingState
    CrossSlidingState_Started
    CrossSlidingState_Dragging
    CrossSlidingState_Selecting
    CrossSlidingState_SelectSpeedBumping
    CrossSlidingState_SpeedBumping
    CrossSlidingState_Rearranging
    CrossSlidingState_Completed
End Enum

Public Enum DraggingState
    DraggingState_Started
    DraggingState_Continuing
    DraggingState_Completed
End Enum

Public Enum EdgeGestureKind
    EdgeGestureKind_Touch
    EdgeGestureKind_Keyboard
    EdgeGestureKind_Mouse
End Enum

Public Enum GazeInputAccessStatus
    GazeInputAccessStatus_Unspecified
    GazeInputAccessStatus_Allowed
    GazeInputAccessStatus_DeniedByUser
    GazeInputAccessStatus_DeniedBySystem
End Enum

Public Enum GestureSettings
    GestureSettings_None = &H0
    GestureSettings_Tap = &H1
    GestureSettings_DoubleTap = &H2
    GestureSettings_Hold = &H4
    GestureSettings_HoldWithMouse = &H8
    GestureSettings_RightTap = &H10
    GestureSettings_Drag = &H20
    GestureSettings_ManipulationTranslateX = &H40
    GestureSettings_ManipulationTranslateY = &H80
    GestureSettings_ManipulationTranslateRailsX = &H100
    GestureSettings_ManipulationTranslateRailsY = &H200
    GestureSettings_ManipulationRotate = &H400
    GestureSettings_ManipulationScale = &H800
    GestureSettings_ManipulationTranslateInertia = &H1000
    GestureSettings_ManipulationRotateInertia = &H2000
    GestureSettings_ManipulationScaleInertia = &H4000
    GestureSettings_CrossSlide = &H8000&
    GestureSettings_ManipulationMultipleFingerPanning = &H10000
End Enum

Public Enum HoldingState
    HoldingState_Started
    HoldingState_Completed
    HoldingState_Canceled
End Enum

Public Enum InputActivationState
    InputActivationState_None
    InputActivationState_Deactivated
    InputActivationState_ActivatedNotForeground
    InputActivationState_ActivatedInForeground
End Enum

Public Enum PointerUpdateKind
    PointerUpdateKind_Other
    PointerUpdateKind_LeftButtonPressed
    PointerUpdateKind_LeftButtonReleased
    PointerUpdateKind_RightButtonPressed
    PointerUpdateKind_RightButtonReleased
    PointerUpdateKind_MiddleButtonPressed
    PointerUpdateKind_MiddleButtonReleased
    PointerUpdateKind_XButton1Pressed
    PointerUpdateKind_XButton1Released
    PointerUpdateKind_XButton2Pressed
    PointerUpdateKind_XButton2Released
End Enum

Public Enum RadialControllerMenuKnownIcon
    RadialControllerMenuKnownIcon_Scroll
    RadialControllerMenuKnownIcon_Zoom
    RadialControllerMenuKnownIcon_UndoRedo
    RadialControllerMenuKnownIcon_Volume
    RadialControllerMenuKnownIcon_NextPreviousTrack
    RadialControllerMenuKnownIcon_Ruler
    RadialControllerMenuKnownIcon_InkColor
    RadialControllerMenuKnownIcon_InkThickness
    RadialControllerMenuKnownIcon_PenType
End Enum

Public Enum RadialControllerSystemMenuItemKind
    RadialControllerSystemMenuItemKind_Scroll
    RadialControllerSystemMenuItemKind_Zoom
    RadialControllerSystemMenuItemKind_UndoRedo

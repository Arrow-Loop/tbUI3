Module mdlUINotifications

Public Type NOTIFICATION_USER_INPUT_DATA
    Key As LongPtr
    Value As LongPtr
End Type

Public Type PROPERTYKEY
    FormatId As UUID
    PropertyId As Long
End Type

Public Type PROPVARIANT
    wVarType As Integer
    wReserved1 As Integer
    wReserved2 As Integer
    wReserved3 As Integer
    pVarData As LongPtr
    #If Win64 Then
    lPadding1 As Long
    lPadding2 As Long
    #Else
    lPadding As Long
    #End If
End Type

Public Type PROPVARIANTCA ' Counted Array
    wVarType As Integer
    wReserved1 As Integer
    wReserved2 As Integer
    wReserved3 As Integer
    cElements As Long
    #If Win64 Then
    lPadding As Long
    #End If
    pElements As LongPtr
End Type

Public Type STATSTG
    pwcsName As LongPtr
    Type As STGTY
    cbSize As Currency
    ModificationTime As Currency
    CreationTime As Currency
    AccessTime As Currency
    grfMode As STGM
    grfLocksSupported As LOCKTYPE
    CLSID As UUID
    grfStateBits As Long
    Reserved As Long
End Type


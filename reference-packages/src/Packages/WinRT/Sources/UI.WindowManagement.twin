Module mdlUIWindowManagement

Public Enum AppWindowClosedReason
    AppWindowClosedReason_Other
    AppWindowClosedReason_AppInitiated
    AppWindowClosedReason_UserInitiated
End Enum

Public Enum AppWindowFrameStyle
    AppWindowFrameStyle_Default
    AppWindowFrameStyle_NoFrame
End Enum

Public Enum AppWindowPresentationKind
    AppWindowPresentationKind_Default
    AppWindowPresentationKind_CompactOverlay
    AppWindowPresentationKind_FullScreen
End Enum

Public Enum AppWindowTitleBarVisibility
    AppWindowTitleBarVisibility_Default
    AppWindowTitleBarVisibility_AlwaysHidden
End Enum

Public Enum WindowingEnvironmentKind
    WindowingEnvironmentKind_Unknown
    WindowingEnvironmentKind_Overlapped
    WindowingEnvironmentKind_Tiled
End Enum

End Module
Module mdlUIXamlData

Public Enum BindingMode
    BindingMode_OneWay = 1
    BindingMode_OneTime
    BindingMode_TwoWay
End Enum

Public Enum RelativeSourceMode
    RelativeSourceMode_None
    RelativeSourceMode_TemplatedParent
    RelativeSourceMode_Self
End Enum

Public Enum UpdateSourceTrigger
    UpdateSourceTrigger_Default
    UpdateSourceTrigger_PropertyChanged
    UpdateSourceTrigger_Explicit
    UpdateSourceTrigger_LostFocus
End Enum

Public Type LoadMoreItemsResult
    Count As Long
End Type

End Module
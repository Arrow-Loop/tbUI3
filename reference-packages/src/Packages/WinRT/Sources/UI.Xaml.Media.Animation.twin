Module mdlUIXamlMediaAnimation

Public Enum ClockState
    ClockState_Active
    ClockState_Filling
    ClockState_Stopped
End Enum

Public Enum ConnectedAnimationComponent
    ConnectedAnimationComponent_OffsetX
    ConnectedAnimationComponent_OffsetY
    ConnectedAnimationComponent_CrossFade
    ConnectedAnimationComponent_Scale
End Enum

Public Enum EasingMode
    EasingMode_EaseOut
    EasingMode_EaseIn
    EasingMode_EaseInOut
End Enum

Public Enum FillBehavior
    FillBehavior_HoldEnd
    FillBehavior_Stop
End Enum

Public Enum RepeatBehaviorType
    RepeatBehaviorType_Count
    RepeatBehaviorType_Duration
    RepeatBehaviorType_Forever
End Enum

Public Enum SlideNavigationTransitionEffect
    SlideNavigationTransitionEffect_FromBottom
    SlideNavigationTransitionEffect_FromLeft
    SlideNavigationTransitionEffect_FromRight
End Enum

Public Type KeyTime
    TimeSpan As TimeSpan
    Function FromTimeSpan(ByVal TimeSpan As TimeSpan) As KeyTime: FromTimeSpan = KeyTimeHelperStatics.FromTimeSpan(TimeSpan): Me = FromTimeSpan: End Function
End Type

Public Type RepeatBehavior
    Count As Double
    Duration As TimeSpan
    Type As RepeatBehaviorType
    #If Win64 = 0 Then
    Padding As Long
    #End If
    Function Forever() As RepeatBehavior: Forever = RepeatBehaviorHelperStatics.Forever: Me = Forever: End Function
    Function FromCount(ByVal Count As Double) As RepeatBehavior: FromCount = RepeatBehaviorHelperStatics.FromCount(Count): Me = FromCount: End Function
    Function FromDuration(ByVal Duration As TimeSpan) As RepeatBehavior: FromDuration = RepeatBehaviorHelperStatics.FromDuration(Duration): Me = FromDuration: End Function
    Function HasCount() As Boolean: HasCount = RepeatBehaviorHelperStatics.GetHasCount(Me) = APITRUE: End Function
    Function HasDuration() As Boolean: HasDuration = RepeatBehaviorHelperStatics.GetHasDuration(Me) = APITRUE: End Function
    Function Equals(ByVal TargetValue As RepeatBehavior) As Boolean: Equals = RepeatBehaviorHelperStatics.Equals(Me, TargetValue) = APITRUE: End Function
End Type

End Module
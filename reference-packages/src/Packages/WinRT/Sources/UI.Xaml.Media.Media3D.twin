    Function FromElements(ByVal M11 As Double, ByVal M12 As Double, ByVal M13 As Double, ByVal M14 As Double, ByVal M21 As Double, ByVal M22 As Double, ByVal M23 As Double, ByVal M24 As Double, ByVal M31 As Double, ByVal M32 As Double, ByVal M33 As Double, ByVal M34 As Double, ByVal OffsetX As Double, ByVal OffsetY As Double, ByVal OffsetZ As Double, ByVal M44 As Double) As Matrix3D

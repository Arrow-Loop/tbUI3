Module mdlUIXamlMediaMedia3D

Public Type Matrix3D
    M11 As Double
    M12  As Double
    M13 As Double
    M14  As Double
    M21 As Double
    M22 As Double
    M23 As Double
    M24 As Double
    M31 As Double
    M32 As Double
    M33 As Double
    M34 As Double
    OffsetX As Double
    OffsetY As Double
    OffsetZ As Double
    M44 As Double
    Function Identity() As Matrix3D: Identity = Matrix3DHelperStatics.Identity: Me = Identity: End Function
    Function Multiply(ByVal Target As Matrix3D) As Matrix3D: Multiply = Matrix3DHelperStatics.Multiply(Me, Target): End Function
    Function FromElements(ByVal M11 As Double, ByVal M12 As Double, ByVal M13 As Double, ByVal M14 As Double, ByVal M21 As Double, ByVal M22 As Double, ByVal M23 As Double, ByVal M24 As Double, ByVal M31 As Double, ByVal M32 As Double, ByVal M33 As Double, ByVal M34 As Double, ByVal OffsetX As Double, ByVal OffsetY As Double, ByVal OffsetZ As Double, ByVal M44 As Double) As Matrix3D: FromElements = Matrix3DHelperStatics.FromElements(M11, M12, M13, M14, M21, M22, M23, M24, M31, M32, M33, M34, OffsetX, OffsetY, OffsetZ, M44): Me = FromElements: End Function
    Function HasInverse() As Boolean: HasInverse = Matrix3DHelperStatics.GetHasInverse(Me) = APITRUE: End Function
    Function IsIdentity() As Boolean: IsIdentity = Matrix3DHelperStatics.GetIsIdentity(Me) = APITRUE: End Function
    Function Invert() As Matrix3D: Invert = Matrix3DHelperStatics.Invert(Me): End Function
End Type

End Module
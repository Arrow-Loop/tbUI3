Public Type Matrix
    M11 As Double
    M12  As Double
    M21 As Double
    M22 As Double
    OffsetX As Double
    OffsetY As Double
    Function Identity() As Matrix: Identity = MatrixHelperStatics.Identity: Me = Identity: End Function
    Function FromElements(ByVal M11 As Double, ByVal M12 As Double, ByVal M21 As Double, ByVal M22 As Double, ByVal OffsetX As Double, ByVal OffsetY As Double) As Matrix: FromElements = MatrixHelperStatics.FromElements(M11, M12, M21, M22, OffsetX, OffsetY): Me = FromElements: End Function
    Function IsIdentity() As Boolean: IsIdentity = MatrixHelperStatics.GetIsIdentity(Me) = APITRUE: End Function
    Function Transform(ByVal Point As POINTF) As POINTF: Transform = MatrixHelperStatics.Transform(Me, Point): End Function
End Type


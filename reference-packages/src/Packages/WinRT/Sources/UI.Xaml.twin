Public Type CornerRadius
    TopLeft As Double
    TopRight As Double
    BottomRight As Double
    BottomLeft As Double
    Function FromRadii(ByVal TopLeft As Double, ByVal TopRight As Double, ByVal BottomRight As Double, ByVal BottomLeft As Double) As CornerRadius: FromRadii = CornerRadiusHelperStatics.FromRadii(TopLeft, TopRight, BottomRight, BottomLeft): Me = FromRadii: End Function
    Function FromUniformRadius(ByVal UniformRadius As Double) As CornerRadius: FromUniformRadius = CornerRadiusHelperStatics.FromUniformRadius(UniformRadius): Me = FromUniformRadius: End Function
End Type

Public Type Duration
    TimeSpan As TimeSpan
    Type As DurationType
    #If Win64 = 0 Then
    Padding As Long
    #End If
    Function Automatic() As Duration: Automatic = DurationHelperStatics.Automatic: Me = Automatic: End Function
    Function Compare(ByVal Value As Duration) As Long: Compare = DurationHelperStatics.Compare(Me, Value): End Function
    Function Forever() As Duration: Forever = DurationHelperStatics.Forever: Me = Forever: End Function
    Function FromTimeSpan(ByVal TimeSpan As TimeSpan) As Duration: FromTimeSpan = DurationHelperStatics.FromTimeSpan(TimeSpan): Me = FromTimeSpan: End Function
    Function HasTimeSpan() As Boolean: HasTimeSpan = DurationHelperStatics.GetHasTimeSpan(Me) = APITRUE: End Function
    Function Add(ByVal Duration As Duration) As Duration: Add = DurationHelperStatics.Add(Me, Duration): End Function
    Function Equals(ByVal Duration As Duration) As Boolean: Equals = DurationHelperStatics.Equals(Me, Duration) = APITRUE: End Function
    Function Subtract(ByVal Duration As Duration) As Duration: Subtract = DurationHelperStatics.Subtract(Me, Duration): End Function
End Type

Public Type GridLength
    Value As Double
    GridUnitType As GridUnitType
    Function Auto() As GridLength: Auto = GridLengthHelperStatics.Auto: Me = Auto: End Function
    Function FromPixels(ByVal Pixels As Double) As GridLength: FromPixels = GridLengthHelperStatics.FromPixels(Pixels): Me = FromPixels: End Function
    Function FromValueAndType(ByVal Value As Double, ByVal Type As GridUnitType) As GridLength: FromValueAndType = GridLengthHelperStatics.FromValueAndType(Value, Type): Me = FromValueAndType: End Function
    Function IsAbsolute() As Boolean: IsAbsolute = GridLengthHelperStatics.GetIsAbsolute(Me) = APITRUE: End Function
    Function IsAuto() As Boolean: IsAuto = GridLengthHelperStatics.GetIsAuto(Me) = APITRUE: End Function
    Function IsStar() As Boolean: IsStar = GridLengthHelperStatics.GetIsStar(Me) = APITRUE: End Function
    Function Equals(ByVal TargetValue As GridLength) As Boolean: Equals = GridLengthHelperStatics.Equals(Me, TargetValue) = APITRUE: End Function
End Type

Public Type Thickness
    Left As Double
    Top As Double
    Right As Double
    Bottom As Double
    Function FromLengths(ByVal Left As Double, ByVal Top As Double, ByVal Right As Double, ByVal Bottom As Double) As Thickness: FromLengths = ThicknessHelperStatics.FromLengths(Left, Top, Right, Bottom): Me = FromLengths: End Function
    Function FromUniformLength(ByVal UniformLength As Double) As Thickness: FromUniformLength = ThicknessHelperStatics.FromUniformLength(UniformLength): Me = FromUniformLength: End Function
End Type

Public Type TypeName

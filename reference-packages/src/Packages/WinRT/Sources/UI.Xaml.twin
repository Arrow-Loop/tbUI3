    Kind As TypeKind
    Function FromNameAndKind(ByVal Name As LongPtr, ByVal Kind As TypeKind) As TypeName: FromNameAndKind.Name = Name: FromNameAndKind.Kind = Kind: Me = FromNameAndKind: End Function
End Type


Module mdlUI

Public Type Color
    A As Byte
    R As Byte
    G As Byte
    B As Byte
    Private Sub Type_Assignment(ByVal RHS As Long): With CType(Of Color)(VarPtr(RHS)): Me.A = .A: Me.R = .R: Me.G = .G: Me.B = .B: End With: End Sub
    Private Function Type_Conversion() As Long: Type_Conversion = CType(Of UDTWrap(Of Long))(VarPtr(Me)).Value: End Function
    Private Function Type_DebugView() As String: Type_DebugView = "ARGB = " & Right$("00" & Hex$(Me.A), 2) & Right$("00" & Hex$(Me.R), 2) & Right$("00" & Hex$(Me.G), 2) & Right$("00" & Hex$(Me.B), 2): End Function
    Function FromARGB(Optional ByVal A As Byte = &HFF, Optional ByVal R As Byte, Optional ByVal G As Byte, Optional ByVal B As Byte) As Long: Me.A = A: Me.R = R: Me.G = G: Me.B = B: FromARGB = Me: End Function
End Type

Public Type WindowId
    Value As Currency
    Private Sub Type_Assignment(ByVal RHS As Currency): Me.Value = RHS: End Sub
    Private Function Type_Conversion() As Currency: Type_Conversion = Me.Value: End Function
End Type

End Module
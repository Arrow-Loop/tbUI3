Interface IHttpBaseProtocolFilter5 Extends IInspectable
    Property Get User() As IUser
End Interface

[InterfaceId("6D4DEE0C-E908-494E-B5A3-1263C9B8242A")]
Interface IHttpBaseProtocolFilterStatics Extends IInspectable

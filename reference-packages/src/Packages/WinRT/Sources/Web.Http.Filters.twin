[InterfaceId("C77E1CB4-3CEA-4EB5-AC85-04E186E63AB7")]
Interface IHttpCacheControl Extends IInspectable
    Property Get ReadBehavior() As HttpCacheReadBehavior
    Property Let ReadBehavior(ByVal Value As HttpCacheReadBehavior)
    Property Get WriteBehavior() As HttpCacheWriteBehavior
    Property Let WriteBehavior(ByVal Value As HttpCacheWriteBehavior)
End Interface

[InterfaceId("A4CB6DD5-0902-439E-BFD7-E12552B165CE")]
Interface IHttpFilter Extends IInspectable ' requires IClosable
    Function SendRequestAsync(ByVal Request As IHttpRequestMessage) As IAsyncOperationWithProgressIHttpResponseMessageHttpProgress
End Interface

[InterfaceId("3165FE32-E7DD-48B7-A361-939C750E63CC")]
Interface IHttpServerCustomValidationRequestedEventArgs Extends IInspectable
    Property Get RequestMessage() As IHttpRequestMessage
    Property Get ServerCertificate() As ICertificate
    Property Get ServerCertificateErrorSeverity() As SocketSslErrorSeverity
    Property Get ServerCertificateErrors() As IVectorView_ChainValidationResult
    Property Get ServerIntermediateCertificates() As IVectorView_ICertificate
    [PreserveSig]
    Function Reject() As HRESULT
    Function GetDeferral() As IDeferral
End Interface

Module mdlWebHttpFilters

Public Enum HttpCacheReadBehavior
    HttpCacheReadBehavior_Default
    HttpCacheReadBehavior_MostRecent
    HttpCacheReadBehavior_OnlyFromCache
    HttpCacheReadBehavior_NoCache
End Enum

Public Enum HttpCacheWriteBehavior
    HttpCacheWriteBehavior_Default
    HttpCacheWriteBehavior_NoCache
End Enum

Public Enum HttpCookieUsageBehavior
    HttpCookieUsageBehavior_Default
    HttpCookieUsageBehavior_NoCookies
End Enum

End Module
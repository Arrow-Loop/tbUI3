Module mdlWebUI

Public Enum WebViewControlPermissionState
	WebViewControlPermissionState_Unknown
	WebViewControlPermissionState_Defer
	WebViewControlPermissionState_Allow
	WebViewControlPermissionState_Deny
End Enum

Public Enum WebViewControlPermissionType
    WebViewControlPermissionType_Geolocation
    WebViewControlPermissionType_UnlimitedIndexedDBQuota
    WebViewControlPermissionType_Media
    WebViewControlPermissionType_PointerLock
    WebViewControlPermissionType_WebNotifications
    WebViewControlPermissionType_Screen
    WebViewControlPermissionType_ImmersiveView
End Enum

End Module
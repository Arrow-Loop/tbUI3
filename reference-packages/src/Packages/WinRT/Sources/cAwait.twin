[InterfaceId("D97ED766-D090-45C7-900C-C4A7B7612B09")]
Interface IUnsupportedInterface Extends IUnknown
    Sub UnsupportedInterfaceRequested(Guid As UUID, ppvObj As IAsyncActionCompletedHandler)
End Interface

Class cAwait

Implements IAgileObject, IAsyncActionCompletedHandler, IUnsupportedInterface

Public Enum QUEUESTATUS_FLAGS
    QS_KEY = &H1
    QS_MOUSEMOVE = &H2
    QS_MOUSEBUTTON = &H4
    QS_POSTMESSAGE = &H8
    QS_TIMER = &H10
    QS_PAINT = &H20
    QS_SENDMESSAGE = &H40
    QS_HOTKEY = &H80
    QS_ALLPOSTMESSAGE = &H100
    QS_RAWINPUT = &H400
    QS_TOUCH = &H800
    QS_POINTER = &H1000
    QS_MOUSE = QS_MOUSEMOVE Or QS_MOUSEBUTTON
    QS_INPUT = QS_MOUSE Or QS_KEY Or QS_RAWINPUT Or QS_TOUCH Or QS_POINTER
    QS_ALLEVENTS = QS_INPUT Or QS_POSTMESSAGE Or QS_TIMER Or QS_PAINT Or QS_HOTKEY
    QS_ALLINPUT = QS_INPUT Or QS_POSTMESSAGE Or QS_TIMER Or QS_PAINT Or QS_HOTKEY Or QS_SENDMESSAGE
End Enum

Public Enum WAIT_CONSTANTS
    WAIT_OBJECT_0 = &H0
    WAIT_ABANDONED_0 = &H80
    WAIT_TIMEOUT = &H102
    WAIT_FAILED = &HFFFFFFFF
    INFINITE = &HFFFFFFFF
End Enum

Private Enum UNSUPPORTED_INTERFACE_IDENTIFIERS
    IID_IApplicationFrame = &H40EAA015 ' {143715D9-A015-40EA-B695-D5CC267E36EE}
    IID_IApplicationFrameEventHandler = &H4DA0770D ' {EA5D0DE4-770D-4DA0-A9F8-D7F9A140FF79}
    IID_IApplicationFrameManager = &H4413DBB9 ' {D6DEFAB3-DBB9-4413-8AF9-554586FDFF94}
    IID_IAudioDeviceGraph = &H484C37B2 ' {3C169FF7-37B2-484C-B199-C3155590F316}
    IID_ICallFactory = &H11CE2A1C ' {1C733A30-2A1C-11CE-ADE5-00AA0044773D}
    IID_IEUserBroker = &H4A69E6BB ' {1AC7516E-E6BB-4A69-B63F-E841904DC5A6}
    IID_IFrameTaskManager = &H49271B35 ' {35BD3360-1B35-4927-BAE4-B10E70D99EFF}
    IID_IMarshalOptions = &H4296E3E3 ' {4C1E39E1-E3E3-4296-AA86-EC938D896E92}
    IID_INoMarshal = &H4DC0C1DB ' {ECC8691B-C1DB-4DC0-855E-65F6C551AF49}
    IID_IPimcContext2 = &H415FAB5A ' {1868091E-AB5A-415F-A02F-5C4DD0CF901D}
    IID_IPrivateCallbackReceiver2 = &H490909D1 ' {11456F96-09D1-4909-8F36-4EB74E42B93E}
    IID_IProvideClassInfo = &H101ABAB4 ' {B196B283-BAB4-101A-B69C-00AA00341D07}
    IID_IRemUnknownTestHook = &H49FF50DC ' {2C258AE7-50DC-49FF-9D1D-2ECB9A52CDD7}
    IID_IStreamGroup = &H4EFC5523 ' {816E5B3E-5523-4EFC-9223-98EC4214C3A0}
    IID_Undocumented1 = &H3B150E79 ' {334D391F-0E79-3B15-C9FF-EAC65DD07C42}
    IID_Undocumented2 = &H2BC3139C ' {77DD1250-139C-2BC3-BD95-900ACED61BE5}
    IID_Undocumented3 = &H4E415A1F ' {BFD60505-5A1F-4E41-88BA-A6FB07202DA9}
    IID_Undocumented4 = &H4BB52289 ' {9BC79C93-2289-4BB5-ABF4-3287FD9CAE39}
    IID_Undocumented5 = &H45F5D534 ' {03FB5C57-D534-45F5-A1F4-D39556983875}
    IID_IVpoContext = &H4E9B6DED ' {4F4F92B5-6DED-4E9B-A93F-013891B3A8B7}
    IID_IVerbStateTaskCallBack = &H4474232E ' {F2153260-232E-4474-9D0A-9F2AB153441D}
End Enum

[UseGetLastError(False), DLLStackCheck(False)]
Private Declare PtrSafe Function CloseHandle Lib "kernel32" (ByVal hObject As LongPtr) As BOOL
[UseGetLastError(False), DLLStackCheck(False)]
Private Declare PtrSafe Function CreateEventW Lib "kernel32" (Optional ByVal lpEventAttributes As LongPtr, Optional ByVal bManualReset As BOOL, Optional ByVal bInitialState As BOOL, Optional ByVal lpName As LongPtr) As LongPtr
[UseGetLastError(False), DLLStackCheck(False)]
Private Declare PtrSafe Function SetEvent Lib "kernel32" (ByVal hEvent As LongPtr) As BOOL
[UseGetLastError(False), DLLStackCheck(False)]
Private Declare PtrSafe Function MsgWaitForMultipleObjects Lib "user32" (Optional ByVal nCount As Long, Optional ByVal pHandles As LongPtr, Optional ByVal fWaitAll As BOOL, Optional ByVal dwMilliseconds As Long = INFINITE, Optional ByVal dwWakeMask As QUEUESTATUS_FLAGS = QS_ALLINPUT) As Long

Private m_AsyncInfo As IAsyncInfo, m_AsyncOperation As WinRT.IUnknown, m_sAsyncOperationName As String, AsyncOperation_PutCompleted As Long, AsyncOperation_GetResults As Long, _
        m_IID_AsyncOperationCompletedHandler As UUID, m_hEvent As LongPtr, m_bWaiting As Boolean, m_cyStart As Currency

Friend Function Await(AsyncInfo As IAsyncInfo, Optional ByVal cyTimeout As Currency = INFINITE) As AsyncStatus
Dim vParam As Variant, Handler As IAsyncActionCompletedHandler
    If Not IsBusy Then ' Guard against undesired reentrancy
        If AsyncOperation(AsyncInfo) Then
            m_bWaiting = True: If m_hEvent = vbNullPtr Then m_hEvent = CreateEventW ' Create an auto-reset event object (resets automatically after being signaled)
            Set Handler = Me: vParam = ObjPtr(Handler)
            DispCallFunc ObjPtr(m_AsyncOperation), AsyncOperation_PutCompleted, CC_STDCALL, vbLong, 1, VarType(vParam), VarPtr(vParam), vParam ' Equivalent to: Set AsyncOperation.Completed = Me
            With m_AsyncInfo
                If vParam = S_OK Then
                    If cyTimeout <> INFINITE Then StartTiming m_cyStart
                    Do ' Sometimes the AsyncOperation will have already completed before starting the loop but we need to wait for the delegate handler to be executed and signal the event object!
                        Select Case MsgWaitForMultipleObjects(1, VarPtr(m_hEvent), dwMilliseconds:=cyTimeout)
                            Case WAIT_OBJECT_0: Exit Do ' The event has been signaled confirming the completion of the AsyncOperation
                            Case WAIT_OBJECT_0 + 1: DoEvents ' One or more messages are waiting in the queue and need to be processed
                            Case WAIT_TIMEOUT: .Cancel ' If a timeout has been provided then cancel the AsyncOperation (the completion handler is still executed thus signaling the event)
                        End Select
                        If cyTimeout <> INFINITE Then cyTimeout = cyTimeout - Elapsed(m_cyStart): StartTiming m_cyStart: If cyTimeout < 1 Then cyTimeout = 1
                    Loop
                End If
                Await = .Status: m_IID_AsyncOperationCompletedHandler.Empty
                If App.IsInIDE Then
                    If .Status = AsyncStatus_Error Then Debug.Print m_sAsyncOperationName, Hex$(.ErrorCode), GetErrorMessage(.ErrorCode) ': Debug.Assert False
                End If
            End With
            m_bWaiting = False
        End If
    End If
End Function

Friend Sub CancelAsyncOperation()
    If IsBusy Then m_AsyncInfo.Cancel
End Sub

Friend Property Get ErrorCode() As Long
    If Not m_AsyncInfo Is Nothing Then ErrorCode = m_AsyncInfo.ErrorCode Else ErrorCode = E_POINTER
End Property

Friend Property Get ErrorDescription() As String
    ErrorDescription = GetErrorMessage(ErrorCode)
End Property

Friend Function GetResults(Of T)() As T
Dim vParam As Variant
    If Not m_AsyncOperation Is Nothing Then
        vParam = VarPtr(GetResults)
        DispCallFunc ObjPtr(m_AsyncOperation), AsyncOperation_GetResults, CC_STDCALL, vbLong, 1, VarType(vParam), VarPtr(vParam), vParam ' Call AsyncOperation.GetResults
        If vParam <> S_OK Then If App.IsInIDE Then Debug.Print Hex$(vParam), GetErrorMessage(vParam) ': Debug.Assert False
    End If
End Function

Friend Function GetResults(Optional ByVal GetResultsPrimitive As LongPtr) As IUnknown
Dim vParam As Variant
    If Not m_AsyncOperation Is Nothing Then
        If GetResultsPrimitive = vbNullPtr Then vParam = VarPtr(GetResults) Else vParam = GetResultsPrimitive ' An AsyncOperation can return either an object or a primitive type
        DispCallFunc ObjPtr(m_AsyncOperation), AsyncOperation_GetResults, CC_STDCALL, vbLong, 1, VarType(vParam), VarPtr(vParam), vParam ' Call AsyncOperation.GetResults
        If vParam <> S_OK Then If App.IsInIDE Then Debug.Print m_sAsyncOperationName, Hex$(vParam), GetErrorMessage(vParam) ': Debug.Assert False
    End If
End Function

Friend Property Get IsBusy() As Boolean
    IsBusy = Status = AsyncStatus_Started Or m_bWaiting
End Property

Friend Property Get Name() As String
    Name = m_sAsyncOperationName
End Property

Friend Property Get Status() As AsyncStatus
    If Not m_AsyncInfo Is Nothing Then Status = m_AsyncInfo.Status Else Status = E_POINTER
End Property

Private Function AsyncOperation(AsyncInfo As IAsyncInfo) As Boolean ' All AsyncOperations implement IAsyncInfo
Dim vParam As Variant, InterfaceIIDs() As UUID, i As Long
    If Not m_AsyncInfo Is Nothing Then m_AsyncInfo.Close
    Set m_AsyncInfo = AsyncInfo
    If Not m_AsyncInfo Is Nothing Then
        m_sAsyncOperationName = IInspectableGetRuntimeClassName(m_AsyncInfo) ' Retrieve the verbose name of this AsyncOperation
        If InStr(m_sAsyncOperationName, "WithProgress") = 0 Then ' AsyncOperation and AsyncOperationWithProgress have different method offsets
            AsyncOperation_PutCompleted = 6 * PTR_SIZE: AsyncOperation_GetResults = 8 * PTR_SIZE
        Else
            AsyncOperation_PutCompleted = 8 * PTR_SIZE: AsyncOperation_GetResults = 10 * PTR_SIZE
        End If
        If IInspectableGetIIDs(m_AsyncInfo, InterfaceIIDs) Then ' Find the correct IID of this AsyncOperation and cast to it from IAsyncInfo
            For i = LBound(InterfaceIIDs) To UBound(InterfaceIIDs)
                If InterfaceIIDs(i).Data2 Then Set m_AsyncOperation = Nothing: AsyncOperation = m_AsyncInfo.QueryInterface(InterfaceIIDs(i), m_AsyncOperation) = S_OK: Exit Function
            Next i
        End If
    End If
End Function

Private Sub IAsyncActionCompletedHandler_Invoke(ByVal AsyncAction As IAsyncAction, ByVal AsyncStatus As AsyncStatus)
    SetEvent m_hEvent
End Sub

Private Sub IUnsupportedInterface_UnsupportedInterfaceRequested(Guid As UUID, ppvObj As IAsyncActionCompletedHandler)
    If Guid.IsEqual(m_IID_AsyncOperationCompletedHandler) Then ' We don't know the correct IID of this Completed Handler just yet, but we'll find it below soon enough! :)
        Set ppvObj = Me
    Else
        Select Case Guid.Data2
            Case 0, IID_IApplicationFrame, IID_IApplicationFrameEventHandler, IID_IApplicationFrameManager, IID_IAudioDeviceGraph, IID_ICallFactory, IID_IEUserBroker, _
                 IID_IFrameTaskManager, IID_IMarshalOptions, IID_INoMarshal, IID_IPimcContext2, IID_IPrivateCallbackReceiver2, IID_IRemUnknownTestHook, IID_IStreamGroup, _
                 IID_Undocumented1, IID_Undocumented2, IID_Undocumented3, IID_Undocumented4, IID_Undocumented5, IID_IVpoContext, IID_IVerbStateTaskCallBack
            Case Else: If m_IID_AsyncOperationCompletedHandler.IsEmpty Then m_IID_AsyncOperationCompletedHandler = Guid: Set ppvObj = Me ' This is the correct IID that corresponds to the Completed Handler of this AsyncOperation
        End Select
    End If
End Sub

Private Sub Class_Terminate()
    CloseHandle m_hEvent: If Not m_AsyncInfo Is Nothing Then m_AsyncInfo.Close
End Sub

End Class
Public Type DateTime
    Value As Currency
    Private Sub Type_Assignment(ByVal RHS As Currency): Me.Value = RHS: End Sub
    Private Function Type_Conversion() As Currency: Type_Conversion = Me.Value: End Function
    Private Function Type_DebugView() As String: Type_DebugView = "UTC: " & Me.DateTime & " Local: " & Me.DateTime(True): End Function
    Property Get DateTime(Optional ByVal bUniversalTimeToLocalTime As Boolean) As Date: DateTime = ToDate(Me.Value, bUniversalTimeToLocalTime): End Property
    Property Let DateTime(Optional ByVal bLocalTimeToUniversalTime As Boolean, ByVal RHS As Date): Me.Value = FromDate(RHS, bLocalTimeToUniversalTime): End Property
End Type

Public Type LOOKUP_TABLES
    bInit As Boolean
    Pow(0 To 31) As Long
    Base32(0 To 31) As Byte
End Type

Public Type RGBQUAD
    rgbBlue As Byte
    rgbGreen As Byte
    rgbRed As Byte
    rgbReserved As Byte
    Private Sub Type_Assignment(ByVal RHS As Long): With CType(Of RGBQUAD)(VarPtr(RHS)): Me.rgbBlue = .rgbBlue: Me.rgbGreen = .rgbGreen: Me.rgbRed = .rgbRed: Me.rgbReserved = .rgbReserved: End With: End Sub
    Private Function Type_Conversion() As Long: Type_Conversion = CType(Of UDTWrap(Of Long))(VarPtr(Me)).Value: End Function
    Private Function Type_DebugView() As String: Type_DebugView = "ARGB = " & Right$("00" & Hex$(Me.rgbReserved), 2) & Right$("00" & Hex$(Me.rgbRed), 2) & Right$("00" & Hex$(Me.rgbGreen), 2) & Right$("00" & Hex$(Me.rgbBlue), 2): End Function
    Function FromARGB(Optional ByVal A As Byte = &HFF, Optional ByVal R As Byte, Optional ByVal G As Byte, Optional ByVal B As Byte) As Long: Me.rgbReserved = A: Me.rgbRed = R: Me.rgbGreen = G: Me.rgbBlue = B: FromARGB = Me: End Function
End Type

Private Type SYSTEMTIME
    wYear As Integer
    wMonth As Integer
    wDayOfWeek As Integer
    wDay As Integer
    wHour As Integer
    wMinute As Integer
    wSecond As Integer
    wMilliseconds As Integer
End Type

Public Type TimeSpan
    Duration As Currency
    Private Sub Type_Assignment(ByVal RHS As Currency): Me.Duration = RHS: End Sub
    Private Function Type_Conversion() As Currency: Type_Conversion = Me.Duration: End Function
    Function FromDays(ByVal Days As Long) As Currency: Me = Days * 86400000@: FromDays = Me.Duration: End Function
    Function FromHours(ByVal Hours As Long) As Currency: Me = Hours * 3600000@: FromHours = Me.Duration: End Function
    Function FromMinutes(ByVal Minutes As Currency) As Currency: Me = Minutes * 60000@: FromMinutes = Me.Duration: End Function
    Function FromSeconds(ByVal Seconds As Currency) As Currency: Me = Seconds * 1000@: FromSeconds = Me.Duration: End Function
    Function FromMilliseconds(ByVal Milliseconds As Currency) As Currency: Me = Milliseconds: FromMilliseconds = Me.Duration: End Function
    Function TotalDays() As Double: TotalDays = Me.Duration / 86400000: End Function
    Function TotalHours() As Double: TotalHours = Me.Duration / 3600000: End Function
    Function TotalMinutes() As Double: TotalMinutes = Me.Duration / 60000: End Function
    Function TotalSeconds() As Double: TotalSeconds = Me.Duration / 1000: End Function
    Function TotalMilliseconds() As Currency: TotalMilliseconds = Me.Duration: End Function
End Type

Public Type UDTWrap(Of T)
    Value As T
End Type

Public Type UUID
    Data1 As Long
    Data2 As Long
    Data3 As Long
    Data4 As Long
    [UseGetLastError(False), DLLStackCheck(False)]
    Private Declare PtrSafe Function IsEqualGUID Lib "ole32" (Me As UUID, rTargetGuid As UUID) As BOOL
    [UseGetLastError(False), DLLStackCheck(False)]
    Private Declare PtrSafe Function CLSIDFromProgID Lib "combase" (ByVal pSZ As LongPtr, rCLSID As UUID) As HRESULT
    [UseGetLastError(False), DLLStackCheck(False)]
    Private Declare PtrSafe Function CoCreateGuid Lib "combase" (Me As UUID) As HRESULT
    [UseGetLastError(False), DLLStackCheck(False)]
    Private Declare PtrSafe Function IIDFromString Lib "combase" (ByVal pSZ As LongPtr, rCLSID As UUID) As HRESULT
    [UseGetLastError(False), DLLStackCheck(False)]
    Private Declare PtrSafe Function ProgIDFromCLSID Lib "combase" (Me As UUID, pSZ As LongPtr) As HRESULT
    [UseGetLastError(False), DLLStackCheck(False)]
    Private Declare PtrSafe Function StringFromIID Lib "combase" (Me As UUID, pSZ As LongPtr) As HRESULT
    Private Function Type_DebugView() As String: Dim sProgID As String
        sProgID = Me.ProgID: Type_DebugView = Me.GuidString & If(Len(sProgID), " ProgID: " & sProgID, vbNullString)
    End Function
    Function CreateFromHash(sStringToHash As String, Optional ByVal UnicodeEncoding As UnicodeEncoding = UnicodeEncoding_UTF8, Optional ByVal bSHA1 As Boolean = True) As UUID: CreateFromHash = GuidFromHash(sStringToHash, UnicodeEncoding, bSHA1): Me = CreateFromHash: End Function
    Function CreateFromPointer(ByVal pGuid As LongPtr) As UUID: CreateFromPointer = CType(Of UUID)(pGuid): Me = CreateFromPointer: End Function
    Function CreateNew() As UUID: Me.CoCreateGuid: CreateNew = CType(Of UUID)(VarPtr(Me)): End Function
    Function Empty() As UUID: Me = GUID_NULL: Return GUID_NULL: End Function
    Property Get GuidString(Optional ByVal bLowerCase As Boolean) As String: Dim pSZ As LongPtr
        If Me.StringFromIID(pSZ) = S_OK Then SysReAllocString VarPtr(GuidString), pSZ: CoTaskMemFree pSZ: If bLowerCase Then GuidString = LCase$(GuidString)
    End Property
    Property Let GuidString(Optional ByVal bLowerCase As Boolean, RHS As String): Me.IIDFromString StrPtr(RHS), Me: End Property
    Function IsEmpty() As Boolean: IsEmpty = Me.IsEqualGUID(GUID_NULL) = APITRUE: End Function
    Function IsEqual(rTargetGuid As UUID) As Boolean: IsEqual = Me.IsEqualGUID(rTargetGuid) = APITRUE: End Function
    Property Get ProgID() As String: Dim pSZ As LongPtr
        If Me.ProgIDFromCLSID(pSZ) = S_OK Then SysReAllocString VarPtr(ProgID), pSZ: CoTaskMemFree pSZ
    End Property
    Property Let ProgID(RHS As String): Me.CLSIDFromProgID StrPtr(RHS), Me: End Property
End Type


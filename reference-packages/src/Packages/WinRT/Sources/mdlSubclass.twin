[InterfaceId("7219BB28-41C4-423C-BB6C-994D08212938")]
Interface ISubclass Extends IUnknown
    Sub MessageReceived(ByVal hWnd As LongPtr, ByVal uMsg As WINDOWS_MESSAGES, ByVal wParam As LongPtr, ByVal lParam As LongPtr, ByVal dwRefData As LongPtr, bDiscardMessage As Boolean, ReturnValue As LongPtr)
End Interface

Module mdlSubclass

Public Enum WINDOWS_MESSAGES
    WM_NULL = &H0
    WM_CREATE = &H1
    WM_DESTROY = &H2
    WM_MOVE = &H3
    WM_SIZE = &H5
    WM_ACTIVATE = &H6
    WM_SETFOCUS = &H7
    WM_KILLFOCUS = &H8

' One native EXE: GUI, hidden worker, or isolated executable self-tests.
Module MainModule
    Public UpdateContext As String
    Public UpdateMode As String
    Public ContextValidated As Boolean
    Public StartupError As String
    Public AuthorizedPlanHash As String
    Public AuthorizedContextHash As String
    Private Declare PtrSafe Sub ExitProcess Lib "kernel32" (ByVal exitCode As Long)
    Public Sub Main()
        On Error GoTo Failed
        Dim args As Collection = NativeArguments(), worker As Boolean, i As Long = 1, key As String, seen As Object = UMap()
        If args.Count = 1 Then
            If CStr(args(1)) = "-SelfTest" Then
                If IIsElevated() Then ExitProcess 5
                ExitProcess RunUpdaterSelfTests()
                Exit Sub
            End If
        End If
        If args.Count = 0 Then
            If IIsElevated() Then ExitProcess 5
            WinUI_InitializeDpiAwareness
            ShowUpdaterWindow
            Exit Sub
        End If
        Do While i <= args.Count
            key = CStr(args(i))
            If seen.Exists(key) Then UFail "Duplicate updater argument."
            seen.Add key, True
            If key = "-Worker" Then
                worker = True
            Else
                i = i + 1
                If i > args.Count Then UFail "Missing updater argument value."
                Select Case key
                    Case "-Mode": UpdateMode = CStr(args(i))
                    Case "-Context": UpdateContext = UFull(CStr(args(i)))
                    Case "-PlanSha256": AuthorizedPlanHash = CStr(args(i))
                    Case "-ContextSha256": AuthorizedContextHash = CStr(args(i))
                    Case Else: UFail "Unsupported updater argument."
                End Select
            End If
            i = i + 1
        Loop
        If Len(UpdateContext) = 0 Or Not UExists(UpdateContext) Then UFail "Open updates from the tbUI3IDE add-in."
        UNoLinks UpdateContext
        Dim context As UpdateJson = UReadJson(UpdateContext)
        IValidateContext context, UpdateContext
        ContextValidated = True
        Select Case UpdateMode
            Case "Quiet", "Review", "Settings"
                If worker Or IIsElevated() Or Len(AuthorizedPlanHash & AuthorizedContextHash) > 0 Then UFail "Invalid updater launch."
                If JD(context, "bridge") <> BVersion Then UFail "Incompatible IDE launch protocol."
                If Not IsSessionRunner() Then
                    If UpdateMode = "Quiet" Then
                        If Not QuietCheckDue(JT(context, "installRoot")) Then
                            LaunchContext = UpdateContext: CloseLaunch
                            Exit Sub
                        End If
                    End If
                    UDetached context, SessionFolder(), UpdateMode
                    Exit Sub
                End If
                If Not OpenLifecycle(context) Then CloseLaunch: Exit Sub
                WinUI_InitializeDpiAwareness
                ShowUpdaterWindow
            Case "Check", "Stage"
                If Not worker Or JD(context, "bridge") <> BVersion Or Len(AuthorizedPlanHash & AuthorizedContextHash) > 0 Then UFail "Incompatible metadata/staging worker contract."
                If IIsElevated() Then UFail "Start checks and staging from the unelevated IDE. Elevation is scoped to an approved install/recovery only."
                ExitProcess RunNativeEngine(UpdateMode)
            Case "Apply", "Recover"
                If worker Then
                    If Not IsSessionRunner() Then UFail "Installation worker must use its detached session copy."
                    If IIsElevated() Then
                        UHashValue AuthorizedPlanHash: UHashValue AuthorizedContextHash
                        SecureElevatedSession
                    ElseIf Len(AuthorizedPlanHash) > 0 Or Len(AuthorizedContextHash) > 0 Then
                        UFail "Administrator approval was not obtained. No installation was changed."
                    End If
                    ExitProcess RunNativeEngine(UpdateMode)
                    Exit Sub
                End If
                If IIsElevated() Then UFail "Only an approved hidden transaction worker can run elevated."
                If Len(AuthorizedPlanHash) > 0 Or Len(AuthorizedContextHash) > 0 Then UFail "Authorization hashes are worker-only arguments."
                If Not IsSessionRunner() Then
                    UDetached context, SessionFolder(), UpdateMode
                    Exit Sub
                End If
                WinUI_InitializeDpiAwareness
                ShowUpdaterWindow
            Case Else: UFail "Unsupported updater operation."
        End Select
        Exit Sub
    Failed:
        StartupError = Err.Description
        If Not ContextValidated Then UpdateContext = ""
        If Not IIsElevated() Or ElevatedStateSafe Then ReportStartupFailure StartupError
        If IIsElevated() Then ExitProcess 1
        If worker Or UpdateMode = "Quiet" Then CloseLaunch: ExitProcess 1
        WinUI_InitializeDpiAwareness
        ShowUpdaterWindow
    End Sub
    Private Function IsSessionRunner() As Boolean
        Return StrComp(UParent(App.Path), SessionFolder(), vbTextCompare) = 0 And Left$(LCase$(UFso().GetFileName(App.Path)), 7) = "runner-"
    End Function
End Module

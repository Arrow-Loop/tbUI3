' Compiled worker dispatch. Never constructs a WebView or invokes a command interpreter.
Private Module UpdaterEngine
    Public Sub UState(ByVal session As String, ByVal status As String, ByVal message As String, Optional ByVal choice As String = "")
        Dim state As UpdateJson = JO()
        state.Assign "status", JS(status): state.Assign "message", JS(message)
        If Len(choice) > 0 Then state.Assign "choice", JS(choice)
        UWriteJson USafe(session, "state.json"), state
        BLog UReadJson(UpdateContext), session, status
    End Sub
    Public Sub UContextValid(ByVal context As UpdateJson)
        IValidateContext context, UpdateContext
    End Sub
    Public Sub UDetached(ByVal context As UpdateJson, ByVal session As String, ByVal mode As String)
        Dim destination As String = UCopyRunner(session)
        BLog context, session, "detached launch " & mode
        Shell QuoteArg(destination) & " -Mode " & mode & " -Context " & QuoteArg(UpdateContext), IIf(mode = "Quiet", vbHide, vbNormalFocus)
    End Sub
    Public Function UCopyRunner(ByVal session As String) As String
        Dim runner As String = USafe(session, "runner-" & UUnique())
        UDirectory runner
        Dim source As String = App.Path & "\Updater.exe", destination As String = USafe(runner, "Updater.exe")
        UNoLinks source: UPe source, &H14C: UCopy source, destination
        If UHash(source) <> UHash(destination) Then UFail "Detached updater copy verification failed."
        Return destination
    End Function
    Public Sub UApproval(ByVal session As String, Optional ByVal expectedPlan As UpdateJson = Nothing)
        Dim request As UpdateJson = UReadJson(UpdateContext)
        If request.Has("bridge") Then
            If JD(request, "bridge") <> BVersion Then UFail "Unsupported shutdown approval protocol."
            If Not BMatches(UpdateContext, "armed.json", "armed") Or Not BMatches(UpdateContext, "native-exit.json", "shutdown") Then UFail "No matching normal-shutdown acknowledgement was received. Retry from the IDE."
            Dim seal As UpdateJson = UReadJson(USafe(session, "verified-plan.json"))
            Dim planPath As String = USafe(session, "plan.json")
            If JD(seal, "schema") <> BVersion Or JT(seal, "requestSha256") <> UHash(UpdateContext) Or JT(seal, "planSha256") <> UHash(planPath) Then UFail "The verified transaction plan changed after staging."
            Dim plan As UpdateJson = UReadJson(planPath)
            If Not expectedPlan Is Nothing Then
                If expectedPlan.Encode() <> plan.Encode() Then UFail "The transaction plan changed while applying."
            End If
            If BSelection(plan.Member("components")).Encode() <> request.Member("selection").Encode() Or plan.Member("identity").Encode() <> request.Member("identity").Encode() Then UFail "The verified plan does not match the authorized release selection or IDE identity."
            Exit Sub
        End If
        Dim path As String = USafe(session, "approved.json")
        If Not UExists(path) Then UFail "No normal-shutdown approval was received. Retry from the IDE."
        Dim approval As UpdateJson = UReadJson(path), context As UpdateJson = UReadJson(UpdateContext)
        If Not JBool(approval, "normalShutdown") Or JD(approval, "schema") <> 1 Then UFail "Cancelled/abnormal shutdown cannot install updates."
        If JT(approval, "installationId") <> JT(context, "installationId") Or JT(approval, "contextSha256") <> UHash(UpdateContext) Or JT(approval, "planSha256") <> UHash(USafe(session, "plan.json")) Then UFail "Approval does not bind the current installation and plan."
    End Sub
    Private Function UCancelled(ByVal session As String) As Boolean
        Return UExists(USafe(session, "cancel.json"))
    End Function
    Private Sub UApply(ByVal mode As String, ByVal context As UpdateJson, ByVal session As String)
        If mode = "Apply" And Not context.Has("bridge") Then UFail "Legacy update approvals cannot start a new installation. Check again from the IDE."
        Dim planPath As String = USafe(session, "plan.json"), journalPath As String = USafe(session, "journal.json"), plan As UpdateJson = UReadJson(planPath)
        UValidatePlan plan, context, session
        Dim key As String = JT(context, "installationId"), mutex As LongPtr = IRequireLock("installation-" & key), sharedLock As LongPtr
        On Error GoTo Failed
        UState session, "waiting", "Waiting for normal IDE shutdown. Close other sessions for this installation.", JT(context, "choice")
        Dim seconds As Long = 120
        If JT(context, "choice") = "exit" Then seconds = 43200
        Dim deadline As Date = DateAdd("s", seconds, Now)
        BLog context, session, "checking originating IDE process identity"
        Do While UOwnerAlive(plan.Member("identity"))
            If mode = "Apply" And context.Has("bridge") Then
                If BMatches(UpdateContext, "native-exit.json", "cancelled") Then GoTo Cancelled
            End If
            If mode = "Apply" And UCancelled(session) Then GoTo Cancelled
            If Now >= deadline Then UFail "Timed out waiting for normal IDE shutdown. Close normally and retry."
            UPause
        Loop
        If mode = "Apply" Then
            If UCancelled(session) Then GoTo Cancelled
            UApproval session, plan
        End If
        BLog context, session, "checking installation process locks"
        UWaitInstallation context, plan.Member("identity")
        If mode = "Apply" And UCancelled(session) Then GoTo Cancelled
        Dim c As UpdateJson
        For Each c In plan.Member("components").Items
            If JT(c, "id") <> "ide" And sharedLock = 0 Then sharedLock = IRequireLock("shared-resources")
        Next
        If Not IIsElevated() Then
            If RequiresElevation(plan) Then
                UState session, "elevationRequired", "This approved transaction needs administrator access. Continue in this window to review Windows UAC. Denial leaves the installation unchanged."
                IUnlock sharedLock: sharedLock = 0: IUnlock mutex: mutex = 0
                Exit Sub
            End If
        End If
        UState session, "installing", "Installing verified updates..."
        If mode = "Recover" Then
            Dim recovery As UpdateJson
            If IIsElevated() Then
                Set recovery = ElevatedRecoveryJournal()
            Else
                Set recovery = UReadJson(journalPath)
            End If
            UState session, "rollingBack", "Restoring and verifying the previous installation..."
            UValidateJournal recovery, plan, session: URollback recovery, journalPath
            UState session, "rolledBack", "Previous installation restored."
            IUnlock sharedLock: sharedLock = 0: IUnlock mutex: Exit Sub
        End If
        Dim active As String = USafe(JT(context, "stateRoot"), "active.json")
        If UExists(active) Then
            Dim previous As UpdateJson = UReadJson(active), previousPath As String = JT(previous, "journal"), previousContext As String = JT(previous, "context")
            ' Active markers are trusted only inside an immediate saved updater session.
            UNoLinks previousPath
            If StrComp(UParent(UParent(previousPath)), UParent(session), vbTextCompare) <> 0 Or UFso().GetFileName(previousPath) <> "journal.json" Then UFail "Active journal marker escapes updater sessions."
            If StrComp(previousPath, journalPath, vbTextCompare) <> 0 And UExists(previousPath) Then
                Dim old As UpdateJson = UReadJson(previousPath), status As String = JT(old, "status")
                If status <> "complete" And status <> "rolledBack" Then UFail "An interrupted transaction needs recovery first: " & previousContext
            End If
        End If
        UNoDowngrade plan, context
        Dim marker As UpdateJson = JO()
        marker.Assign "journal", JS(journalPath): marker.Assign "context", JS(UpdateContext): UWriteJson active, marker
        If UCancelled(session) Then GoTo Cancelled
        UApproval session, plan
        UInstall plan, journalPath, USafe(session, "state.json")
        UState session, "complete", "Selected updates installed and verified."
        IUnlock sharedLock: sharedLock = 0: IUnlock mutex: mutex = 0
        If JBool(context, "restart") Then
            BLog context, session, "restarting originating IDE"
            StartIde JT(context, "ideExe"), JT(context, "installRoot")
            ' Only a clean, verified completion followed by a successful IDE launch carries this flag;
            ' the updater window closes itself on it. A launch failure raises instead and stays visible.
            Dim restarted As UpdateJson = JO()
            restarted.Assign "status", JS("complete"): restarted.Assign "message", JS("Selected updates installed and verified. twinBASIC restarted.")
            restarted.Assign "restarted", JB(True)
            UWriteJson USafe(session, "state.json"), restarted
        End If
        Exit Sub
    Cancelled:
        UState session, "cancelled", "Update cancelled. Your installation was not changed."
        IUnlock sharedLock: sharedLock = 0: IUnlock mutex: Exit Sub
    Failed:
        Dim reason As String = Err.Description
        On Error Resume Next: IUnlock sharedLock: sharedLock = 0: IUnlock mutex
        On Error GoTo 0
        UFail reason
    End Sub
    Public Function RunNativeEngine(ByVal mode As String) As Long
        Dim session As String = SessionFolder(), metadataLock As LongPtr
        On Error GoTo Failed
        If Not ContextValidated Or Len(session) = 0 Then UFail "A validated saved session is required."
        UNoLinks UpdateContext
        Dim context As UpdateJson = UReadJson(UpdateContext)
        UContextValid context
        Select Case mode
            Case "Check"
                metadataLock = IRequireLock("metadata-" & JT(context, "installationId"))
                UCleanSessions session
                UState session, "checking", "Checking published releases..."
                Dim root As String = JT(context, "installRoot"), settings As UpdateJson = ISettings(root)
                context.Assign "channel", settings.Member("channel")
                Dim catalog As UpdateJson = UDiscover(context, session)
                catalog.Assign "identity", UReadJson(USafe(session, "identity.json"))
                catalog.Assign "channel", settings.Member("channel")
                UWriteJson USafe(session, "catalog.json"), catalog
                Dim state As UpdateJson = JO(), patch As UpdateJson = JO()
                If catalog.Member("components").Items.Count > 0 Then
                    patch.Assign "lastCheck", JS(Format$(Date, "yyyy-mm-dd")): IApplySettings root, patch
                End If
                state.Assign "status", JS("checked"): state.Assign "message", JS("Release check complete."): state.Assign "catalog", catalog
                UWriteJson USafe(session, "state.json"), state
                BLog context, session, "release discovery complete"
                IUnlock metadataLock: metadataLock = 0
            Case "Stage"
                If Not BMatches(UpdateContext, "armed.json", "armed") Then UFail "The IDE did not arm this request."
                BProgressContext = UpdateContext
                UState session, "staging", "Preparing selected updates..."
                Dim approvedCatalog As UpdateJson = UReadJson(USafe(session, "catalog.json"))
                If BSelection(USelectComponents(context, approvedCatalog)).Encode() <> context.Member("selection").Encode() Or approvedCatalog.Member("identity").Encode() <> context.Member("identity").Encode() Then UFail "Release selection changed before staging."
                BCheckCancellation True
                Dim plan As UpdateJson = UMakePlan(context, approvedCatalog, session)
                BCheckCancellation True
                BProgress "Verifying transaction plan"
                UValidatePlan plan, context, session
                If BSelection(plan.Member("components")).Encode() <> context.Member("selection").Encode() Then UFail "Staged release selection differs from consent."
                Dim planPath As String = USafe(session, "plan.json"), seal As UpdateJson = JO()
                UWriteJson planPath, plan
                seal.Assign "schema", JN(BVersion): seal.Assign "requestSha256", JS(UHash(UpdateContext)): seal.Assign "planSha256", JS(UHash(planPath))
                UWriteJson USafe(session, "verified-plan.json"), seal
                UState session, "ready", "Updates verified. Waiting for normal IDE shutdown.", JT(context, "choice")
            Case "Apply", "Recover": UApply mode, context, session
            Case Else: UFail "Unsupported native worker operation."
        End Select
        Return 0
    Failed:
        Dim reason As String = Err.Description
        On Error Resume Next
        IUnlock metadataLock
        If Len(session) > 0 Then
            If mode = "Stage" And (UCancelled(session) Or BMatches(UpdateContext, "native-exit.json", "cancelled")) Then
                UState session, "cancelled", "Update cancelled. Your installation was not changed."
                Return 0
            End If
            UState session, "error", reason
            BLog UReadJson(UpdateContext), session, mode & " failed: " & reason
        End If
        Return 1
    End Function
    Private Sub UCleanSessions(ByVal current As String)
        On Error GoTo Retain
        Dim root As String = UParent(current), folder As Object
        For Each folder In UFso().GetFolder(root).SubFolders
            If StrComp(folder.Path, current, vbTextCompare) <> 0 And folder.DateLastModified < DateAdd("d", -7, Now) Then UCleanOne folder.Path, root
        Next
    Retain:
        ' Optional cleanup never blocks checking, including unsupported enumeration paths.
    End Sub
    Private Sub UCleanOne(ByVal directory As String, ByVal root As String)
        On Error GoTo Retain
        If StrComp(UParent(UFull(directory)), UFull(root), vbTextCompare) <> 0 Then Exit Sub
        UNoLinks directory
        Dim path As String = USafe(directory, "journal.json")
        If UExists(path) Then
            Dim journal As UpdateJson = UReadJson(path), status As String = JT(journal, "status")
            If status <> "complete" And status <> "rolledBack" Then Exit Sub
        ElseIf Not UExists(USafe(directory, "closed.json")) Then
            Exit Sub
        End If
        UCheckTree directory
        UFso().DeleteFolder directory, True
    Retain:
        ' Unresolved, linked or locked sessions are retained with their evidence.
    End Sub
    Private Sub UCheckTree(ByVal directory As String)
        UNoLinks directory
        Dim folder As Object = UFso().GetFolder(directory), item As Object
        For Each item In folder.Files: UNoLinks item.Path: Next
        For Each item In folder.SubFolders: UCheckTree item.Path: Next
    End Sub
End Module

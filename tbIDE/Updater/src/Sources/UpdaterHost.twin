' Host/process bridge. Uses only fixed operations; the WebView never supplies paths or commands.
Private Module UpdaterHost
    Private mHelpShown As Boolean
    Private Type StartupInfo
        cb As Long
        lpReserved As LongPtr
        lpDesktop As LongPtr
        lpTitle As LongPtr
        dwX As Long
        dwY As Long
        dwXSize As Long
        dwYSize As Long
        dwXCountChars As Long
        dwYCountChars As Long
        dwFillAttribute As Long
        dwFlags As Long
        wShowWindow As Integer
        cbReserved2 As Integer
        lpReserved2 As LongPtr
        hStdInput As LongPtr
        hStdOutput As LongPtr
        hStdError As LongPtr
    End Type
    Private Type ProcessInfo
        hProcess As LongPtr
        hThread As LongPtr
        dwProcessId As Long
        dwThreadId As Long
    End Type
    Private Declare PtrSafe Function CreateProcessW Lib "kernel32" (ByVal application As LongPtr, ByVal commandLine As LongPtr, ByVal processSecurity As LongPtr, ByVal threadSecurity As LongPtr, ByVal inheritHandles As Long, ByVal flags As Long, ByVal environment As LongPtr, ByVal directory As LongPtr, ByRef startup As StartupInfo, ByRef process As ProcessInfo) As Long
    Private Declare PtrSafe Function GetExitCodeProcess Lib "kernel32" (ByVal process As LongPtr, ByRef exitCode As Long) As Long
    Private Declare PtrSafe Function CloseHandle Lib "kernel32" (ByVal handle As LongPtr) As Long
    Private Declare PtrSafe Function MoveFileExW Lib "kernel32" (ByVal source As LongPtr, ByVal destination As LongPtr, ByVal flags As Long) As Long
    Private Declare PtrSafe Function ShellExecuteW Lib "shell32" (ByVal window As LongPtr, ByVal verb As LongPtr, ByVal file As LongPtr, ByVal parameters As LongPtr, ByVal directory As LongPtr, ByVal show As Long) As LongPtr

    Private Type ElevationInfo
        cb As Long
        mask As Long
        window As LongPtr
        verb As LongPtr
        file As LongPtr
        parameters As LongPtr
        directory As LongPtr
        show As Long
        instance As LongPtr
        idList As LongPtr
        className As LongPtr
        classKey As LongPtr
        hotKey As Long
        icon As LongPtr
        process As LongPtr
    End Type
    Private Declare PtrSafe Function ShellExecuteExW Lib "shell32" (ByRef info As ElevationInfo) As Long
    Public Function StartElevatedEngine(ByVal mode As String, ByVal window As LongPtr) As LongPtr
        If mode <> "Apply" And mode <> "Recover" Then UFail "Only installation and recovery can request elevation."
        If Not HasJournal() And mode = "Recover" Then UFail "No journal is available."
        Dim plan As String = USafe(SessionFolder(), "plan.json"), executable As String = UCopyRunner(SessionFolder())
        IValidateContext UReadJson(UpdateContext), UpdateContext
        Dim verb As String = "runas", parameters As String = "-Worker -Mode " & mode & " -Context " & QuoteArg(UpdateContext) & _
            " -PlanSha256 " & UHash(plan) & " -ContextSha256 " & UHash(UpdateContext)
        Dim info As ElevationInfo
        info.cb = LenB(info): info.mask = &H40 Or &H400: info.window = window
        info.verb = StrPtr(verb): info.file = StrPtr(executable): info.parameters = StrPtr(parameters): info.show = 0
        If ShellExecuteExW(info) = 0 Then
            If Err.LastDllError = 1223 Then UFail "Administrator approval was cancelled. Your installation was not changed."
            UFail "Windows could not start the scoped administrator worker."
        End If
        If info.process = 0 Then UFail "Windows did not return an administrator worker handle."
        Return info.process
    End Function

    Public Function QuoteArg(ByVal value As String) As String
        Return IQuoteArg(value)
    End Function

    Public Function SessionFolder() As String
        If Len(UpdateContext) = 0 Then Return ""
        Return UParent(UpdateContext)
    End Function

    Public Function ReadSessionFile(ByVal name As String) As String
        If Len(SessionFolder()) = 0 Then Return ""
        Select Case name
            Case "state.json", "plan.json", "catalog.json", "journal.json"
            Case Else
                Err.Raise 5, , "Unsupported session file."
        End Select
        Dim path As String = USafe(SessionFolder(), name)
        If Not UExists(path) Then Return ""
        Return UText(path)
    End Function

    Public Function StartUpdateEngine(ByVal mode As String) As LongPtr
        Select Case mode
            Case "Check", "Stage", "Apply", "Recover"
            Case Else
                Err.Raise 5, , "Unsupported engine operation."
        End Select
        If Len(UpdateContext) = 0 Then UFail "Choose updates in the tbUI3IDE add-in first."
        Dim executable As String = App.Path & "\Updater.exe"
        If mode = "Apply" Or mode = "Recover" Then executable = UCopyRunner(SessionFolder())
        BLog UReadJson(UpdateContext), SessionFolder(), "worker launch " & mode
        Dim commandLine As String = QuoteArg(executable) & " -Worker -Mode " & mode & " -Context " & QuoteArg(UpdateContext)
        Dim startup As StartupInfo
        Dim process As ProcessInfo
        startup.cb = LenB(startup)
        If CreateProcessW(StrPtr(executable), StrPtr(commandLine), 0, 0, 0, &H8000000, 0, 0, startup, process) = 0 Then _
            Err.Raise 5, , "Windows could not start the updater engine (error " & CStr(Err.LastDllError) & ")."
        CloseHandle process.hThread
        Return process.hProcess
    End Function

    Public Sub StartIde(ByVal executable As String, ByVal directory As String)
        Dim startup As StartupInfo, process As ProcessInfo, commandLine As String = QuoteArg(executable)
        startup.cb = LenB(startup)
        If CreateProcessW(StrPtr(executable), StrPtr(commandLine), 0, 0, 0, 0, 0, StrPtr(directory), startup, process) = 0 Then UFail "Update completed, but restarting the IDE failed."
        CloseHandle process.hThread: CloseHandle process.hProcess
    End Sub

    Public Function WorkerRunning(ByVal handle As LongPtr) As Boolean
        If handle = 0 Then Return False
        Dim exitCode As Long
        If GetExitCodeProcess(handle, exitCode) = 0 Then Err.Raise 5, , "Could not inspect the updater process."
        Return exitCode = 259
    End Function

    Public Function WorkerExitCode(ByVal handle As LongPtr) As Long
        If handle = 0 Then Return 0
        Dim code As Long
        If GetExitCodeProcess(handle, code) = 0 Then Err.Raise 5, , "Could not read the engine exit code."
        Return code
    End Function

    Public Function HasJournal() As Boolean
        If Len(SessionFolder()) = 0 Then Return False
        Return UExists(USafe(SessionFolder(), "journal.json"))
    End Function

    Public Sub ReleaseWorker(ByVal handle As LongPtr)
        If handle <> 0 Then CloseHandle handle
    End Sub

    Public Sub RequestCancel()
        If Len(SessionFolder()) = 0 Then Exit Sub
        Dim record As UpdateJson = JO()
        record.Assign "cancel", JB(True): UWriteJson USafe(SessionFolder(), "cancel.json"), record
    End Sub

    Public Sub ReportStartupFailure(ByVal reason As String)
        On Error Resume Next
        If Not IIsElevated() Then UIX_Log reason
        If Not ContextValidated Or Len(SessionFolder()) = 0 Then Exit Sub
        If IIsElevated() And Not ElevatedStateSafe Then Exit Sub
        UState SessionFolder(), "error", reason
    End Sub

    Public Sub RuntimeHelp(ByVal reason As String)
        ' Verify a complete page before opening it; never launch an empty fallback file.
        ReportStartupFailure reason
        If UpdateMode = "Quiet" Or mHelpShown Then Exit Sub
        mHelpShown = True
        Dim temp As String, memory As Object
        On Error GoTo Failed
        Dim base As String = DiagnosticsRoot(), path As String = DiagnosticsFile("updater-startup-help.html")
        If Len(base) = 0 Or Len(path) = 0 Then
            ' Store logs and diagnostics is off (or the folder is unavailable): show the reason without storing a page.
            MsgBox "The tbUI3 updater window could not start." & vbCrLf & vbCrLf & reason, vbExclamation, "tbUI3 Updater"
            Exit Sub
        End If
        UDirectory base
        temp = USafe(base, "help-" & UUnique() & ".html")
        Dim html As String = UIX_ResourceText("runtime-help.html")
        html = Replace(html, "{{STYLE_BLOCK}}", "<style>" & UIX_ResourceText("winui.css") & "</style>")
        Dim detail As String = Replace(Replace(Replace(reason, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
        html = Replace(html, "{{ERROR_DETAIL}}", detail)
        If InStr(1, html, "<body", vbTextCompare) = 0 Then UFail "The embedded startup-help page is invalid."
        Set memory = CreateObject("ADODB.Stream")
        memory.Type = 2: memory.Charset = "utf-8": memory.Open: memory.WriteText html
        memory.Position = 0: memory.Type = 1
        Dim bytes() As Byte = memory.Read(): memory.Close
        UWriteRaw temp, bytes
        If USize(temp) < 100 Or InStr(1, UText(temp), "<body", vbTextCompare) = 0 Then UFail "Startup-help page could not be verified."
        UReplace temp, path: UDelete temp: temp = ""
        UIX_Log "Startup help written: " & path & "; bytes=" & CStr(USize(path))
        Dim verb As String = "open"
        If ShellExecuteW(0, StrPtr(verb), StrPtr(path), 0, 0, 1) <= 32 Then UFail "Windows could not open the verified startup-help page."
        Exit Sub
    Failed:
        Dim failure As String = Err.Description, number As Long = Err.Number
        On Error Resume Next
        If Not memory Is Nothing Then memory.Close
        If Len(temp) > 0 Then
            If UExists(temp) Then UDelete temp
        End If
        UIX_Log "Startup help failed (" & CStr(number) & "): " & failure
    End Sub
End Module

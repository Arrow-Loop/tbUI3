' Run the real compiled engine against disposable local fixtures, without network or an IDE.
' Updater.exe -SelfTest writes results.json and returns a nonzero exit code on any failure.
Private Module UpdaterSelfTest
    Private mRoot As String
    Private mResults As UpdateJson
    Private mFailed As Long
    Public Function RunUpdaterSelfTests() As Long
        On Error GoTo Fatal
        Dim diagnostics As String = DiagnosticsRoot()
        If Len(diagnostics) = 0 Then UFail "The per-user diagnostics folder is unavailable, or Store logs and diagnostics is off in IDE Options (tbUI3)."
        mRoot = UFull(diagnostics & "\NativeSelfTests\tbUI3-native-updater-tests-" & UUnique())
        UNoLinks mRoot: UDirectory mRoot
        Set mResults = JA(): mFailed = 0
        Dim i As Long
        For i = 1 To 43: RunCase i: Next
        Dim fixtures As UpdateJson = JParse(UIX_ResourceText("native-engine-fixtures.json")), fixture As UpdateJson
        For Each fixture In fixtures.Member("fixtures").Items: RunZipCase fixture: Next
        Dim report As UpdateJson = JO()
        report.Assign "failed", JN(mFailed): report.Assign "total", JN(mResults.Items.Count): report.Assign "results", mResults
        UWriteJson mRoot & "\results.json", report
        Dim pointer As UpdateJson = JO()
        pointer.Assign "results", JS(mRoot & "\results.json"): pointer.Assign "failed", JN(mFailed)
        UWriteJson DiagnosticsFile("native-updater-latest.json"), pointer
        Return IIf(mFailed = 0, 0, 1)
    Fatal:
        UIX_Log "Native self-test failed: " & Err.Description
        Return 1
    End Function
    Private Sub Record(ByVal name As String, ByVal passed As Boolean, ByVal message As String)
        Dim result As UpdateJson = JO()
        result.Assign "name", JS(name): result.Assign "passed", JB(passed): result.Assign "message", JS(message)
        mResults.Push result
        If Not passed Then mFailed = mFailed + 1
    End Sub
    Private Sub Check(ByVal condition As Boolean, ByVal message As String)
        If Not condition Then UFail message
    End Sub
    Private Sub TextFile(ByVal path As String, ByVal text As String)
        UDirectory UParent(path)
        Dim stream As Object = UFso().CreateTextFile(path, True, False)
        stream.Write text: stream.Close
    End Sub
    Private Function FixturePlan(ByVal name As String) As UpdateJson
        Dim root As String = mRoot & "\" & name, staging As String = root & "\stage"
        UDirectory staging
        TextFile staging & "\one.txt", "new one": TextFile staging & "\two.txt", "new two"
        TextFile root & "\install\one.txt", "old one"
        Dim plan As UpdateJson = JO(), operations As UpdateJson = JA()
        operations.Push UOperation(root & "\install", "one.txt", staging & "\one.txt", UHash(staging & "\one.txt"))
        operations.Push UOperation(root & "\install", "two.txt", staging & "\two.txt", UHash(staging & "\two.txt"))
        plan.Assign "schema", JN(IPlanSchema): plan.Assign "operations", operations
        Set FixturePlan = plan
    End Function
    Private Sub RunCase(ByVal number As Long)
        On Error GoTo Failed
        Dim name As String = "native-" & CStr(number), plan As UpdateJson, path As String, journal As UpdateJson, operation As UpdateJson, parsed As UpdateJson
        Dim ignored As Variant, handle As Integer, lockOpen As Boolean
        Select Case number
            Case 1: name = "major-zero four-part comparison": Check UCompare("0.3.0.20", "0.3.0.21") = -1, name
            Case 2: name = "official stable transition": Check UCompare("0.99.99.99", "1.0.0.0") = -1, name
            Case 3: name = "numeric revision": Check UCompare("0.3.0.9", "0.3.0.20") = -1, name
            Case 4: name = "missing numeric components": Check UCompare("0.3", "0.3.0.0") = 0, name
            Case 5: name = "legacy add-in alias": Check UNormalizeAddin("1.3.0.20") = "0.3.0.20", name
            Case 6: name = "stable receipt prevents alias": Check UNormalizeAddin("1.3.0.20", True) = "1.3.0.20", name
            Case 7: name = "alias range stays narrow": Check UNormalizeAddin("1.3.0.21") = "1.3.0.21" And UNormalizeAddin("1.0.0.0") = "1.0.0.0", name
            Case 8: name = "reject fifth version component": MustReject 1
            Case 9: name = "reject version overflow": MustReject 2
            Case 10: name = "reject negative version": MustReject 3
            Case 11
                name = "JSON control-character roundtrip"
                Dim text As String = Chr$(0) & Chr$(8) & vbCrLf & Chr$(34) & "\" & ChrW$(&HE9)
                Set parsed = JParse(JQuote(text)): Check parsed.Text = text, name
            Case 12: name = "duplicate JSON fields rejected": MustReject 4
            Case 13: name = "JSON trailing data rejected": MustReject 5
            Case 14: name = "JSON numeric grammar rejected": MustReject 6
            Case 15: name = "path traversal rejected": MustReject 7
            Case 16: name = "Windows device path rejected": MustReject 8
            Case 17: name = "alternate stream rejected": MustReject 9
            Case 18
                name = "streaming CNG SHA-256"
                path = mRoot & "\abc": TextFile path, "abc"
                Check UHash(path) = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", name
            Case 19
                name = "atomic JSON Unicode roundtrip"
                path = mRoot & "\atomic.json": Set parsed = JO(): parsed.Assign "version", JS("0.3.0.20")
                UWriteJson path, parsed: Check JT(UReadJson(path), "version") = "0.3.0.20", name
            Case 20
                name = "install backup and new-file creation"
                Set plan = FixturePlan("install"): path = mRoot & "\install\journal.json"
                UInstall plan, path
                Check UText(mRoot & "\install\install\one.txt") = "new one", name
                Check JT(UReadJson(path), "status") = "complete", name
                UInstall plan, path
            Case 21
                name = "rollback restores original and removes new file"
                Set plan = FixturePlan("rollback"): path = mRoot & "\rollback\journal.json"
                UInstall plan, path: Set journal = UReadJson(path): UValidateJournal journal, plan, UParent(path): URollback journal, path
                Check UText(mRoot & "\rollback\install\one.txt") = "old one", name
                Check Not UExists(mRoot & "\rollback\install\two.txt"), name
            Case 22
                name = "preflight rejects corrupt staging before writes"
                Set plan = FixturePlan("badstage"): Set operation = plan.Member("operations").Items.Item(2)
                TextFile JT(operation, "staged"), "changed"
                RejectInstall plan, mRoot & "\badstage\journal.json"
                Check UText(mRoot & "\badstage\install\one.txt") = "old one", name
            Case 23
                name = "completed transaction preserves later user edits"
                Set plan = FixturePlan("changed"): path = mRoot & "\changed\journal.json": UInstall plan, path
                TextFile mRoot & "\changed\install\one.txt", "user edit": RejectInstall plan, path
                Check UText(mRoot & "\changed\install\one.txt") = "user edit", name
            Case 24
                name = "rollback rejects corrupt backup"
                Set plan = FixturePlan("backup"): path = mRoot & "\backup\journal.json": UInstall plan, path
                Set journal = UReadJson(path): Set operation = journal.Member("operations").Items.Item(1)
                TextFile JT(operation, "backup"), "corrupt"
                RejectRollback journal, path
            Case 25
                name = "vendor collision backed up and replaced"
                Set plan = FixturePlan("vendor"): Set operation = plan.Member("operations").Items.Item(1)
                UProtectVendor operation, UMap()
                Check JT(operation, "conflict") = "unrecognizedAtOfficialPath" And JT(operation, "expectedOriginal") = UHash(mRoot & "\vendor\install\one.txt") And Not JBool(operation, "expectAbsent"), name
                UInstall plan, mRoot & "\vendor\journal.json"
                Check UHash(mRoot & "\vendor\install\one.txt") = JT(operation, "sha256"), name
                Dim kept As UpdateJson = UReadJson(mRoot & "\vendor\journal.json").Member("operations").Items.Item(1)
                Check UText(JT(kept, "backup")) = "old one", name
            Case 26
                name = "vendor expectation rechecked at preflight"
                Set plan = FixturePlan("vendor-race"): Set operation = plan.Member("operations").Items.Item(1)
                operation.Assign "expectedOriginal", JS(UHash(mRoot & "\vendor-race\install\one.txt"))
                TextFile mRoot & "\vendor-race\install\one.txt", "changed": RejectInstall plan, mRoot & "\vendor-race\journal.json"
            Case 27
                name = "locked destination fails before any replacement"
                Set plan = FixturePlan("locked"): path = mRoot & "\locked\install\one.txt"
                handle = FreeFile(): Open path For Binary Access Read Write Lock Read Write As #handle: lockOpen = True
                RejectInstall plan, mRoot & "\locked\journal.json"
                Close #handle: lockOpen = False
                Check UText(path) = "old one", name
            Case 28
                name = "journal destination tampering rejected"
                Set plan = FixturePlan("journal"): path = mRoot & "\journal\journal.json": UInstall plan, path
                Set journal = UReadJson(path): Set operation = journal.Member("operations").Items.Item(1)
                operation.Assign "target", JS("../escape"): RejectJournal journal, plan, UParent(path)
            Case 29
                name = "installation identity invariant casing"
                Check IIdForCanonicalRoot("C:\Portable\TwinBASIC") = IIdForCanonicalRoot("c:\portable\twinbasic"), name
                Check Len(IIdForCanonicalRoot("C:\Portable\TwinBASIC")) = 67, name
            Case 30
                name = "installation identities isolate roots"
                Check IIdForCanonicalRoot("C:\One") <> IIdForCanonicalRoot("C:\Two"), name
            Case 31
                name = "Unicode JSON durable IO"
                path = mRoot & "\" & ChrW$(&H4E2D) & ChrW$(&HE9) & ".json"
                Set parsed = JO(): parsed.Assign "text", JS(ChrW$(&H4E2D) & ChrW$(&HD83D&) & ChrW$(&HDE00&))
                UWriteJson path, parsed: Check UText(path) = parsed.Encode(), name
            Case 32
                name = "extended-length native IO and atomic replacement"
                path = mRoot
                For ignored = 1 To 12: path = path & "\abcdefghijklmnopqrstuvwx": Next
                UDirectory path: Set parsed = JO(): parsed.Assign "value", JS("before")
                UWriteJson path & "\one.json", parsed
                UCopy path & "\one.json", path & "\backup.json"
                parsed.Assign "value", JS("after"): UWriteJson path & "\one.json", parsed
                Check JT(UReadJson(path & "\one.json"), "value") = "after", name
                UReplace path & "\backup.json", path & "\one.json"
                Check JT(UReadJson(path & "\one.json"), "value") = "before", name
                UDelete path & "\backup.json": Check Not UExists(path & "\backup.json"), name
            Case 33
                name = "future context protocol fails closed": MustReject 10
            Case 34
                name = "Windows argument quoting retains trailing separators"
                Check IQuoteArg("C:\path with space\") = Chr(34) & "C:\path with space\\" & Chr(34), name
                Dim arguments As Collection = ParseNativeArguments("-Mode Apply -Context " & IQuoteArg("C:\space dir\context.json"))
                Check arguments.Count = 4 And CStr(arguments(4)) = "C:\space dir\context.json", name
                Set arguments = ParseNativeArguments(""): Check arguments.Count = 0, name
            Case 35
                name = "future operation kind fails before changes"
                Set plan = FixturePlan("future-op"): Set operation = plan.Member("operations").Items.Item(1)
                operation.Assign "kind", JS("UnknownOperationV2")
                RejectInstall plan, mRoot & "\future-op\journal.json"
                Check UText(mRoot & "\future-op\install\one.txt") = "old one", name
            Case 36
                name = "raw payload native byte-buffer roundtrip"
                Dim payload(0 To 5) As Byte, readback() As Byte, j As Long
                payload(0) = 0: payload(1) = 255: payload(2) = 128: payload(3) = 65: payload(4) = 254: payload(5) = 1
                path = mRoot & "\raw-payload": UWriteRaw path, payload
                readback = UBytes(path, 0, 6)
                For j = 0 To 5: Check readback(j) = payload(j), name: Next
            Case 37
                name = "UTF-8 native typed-buffer decode"
                Dim utf8(1 To 6) As Byte
                utf8(1) = 97: utf8(2) = 195: utf8(3) = 169: utf8(4) = 228: utf8(5) = 184: utf8(6) = 173
                Check UDecodeText(utf8) = "a" & ChrW$(&HE9) & ChrW$(&H4E2D), name
            Case 38
                name = "invalid UTF-8 typed buffer rejected": MustReject 11
            Case 39
                name = "trusted UTF-8 application navigation"
                Dim document As String = "<p>" & ChrW$(&HE9) & ChrW$(&H4E2D) & "</p>"
                Dim expectedUri As String = "data:text/html;charset=utf-8;base64,PHA+w6nkuK08L3A+"
                Check UpdaterDocumentUri(document) = expectedUri, name & " encoding"
                Check UpdaterDocumentUri("a") = "data:text/html;charset=utf-8;base64,YQ==", name & " odd byte length"
                Check UpdaterDocumentAllowed(expectedUri, expectedUri), name & " exact document"
                Check UpdaterDocumentAllowed("about:blank", expectedUri), name & " initial blank"
                Check Not UpdaterDocumentAllowed(expectedUri & "A", expectedUri), name & " modified document"
                Check Not UpdaterDocumentAllowed("data:text/html,<script>bad</script>", expectedUri), name & " foreign data"
                Check Not UpdaterDocumentAllowed("https://example.com/", expectedUri), name & " remote"
                Check Not UpdaterDocumentAllowed("", ""), name & " uninitialized"
                Check InStr(UIX_ResourceText("updater.html"), "Update on Exit") > 0, name & " resource conversion"
            Case 40, 41, 42
                name = TestBridgeRecord(number)
            Case 43
                name = "published icon library index version"
                Dim marker As String = "tbUI3LIB", indexText As String = "#tbUI3-Icons|2026.10.19.1|digest|notice" & vbCrLf
                Dim dat() As Byte, pos As Long
                ReDim dat(0 To 31 + Len(indexText))
                For pos = 1 To Len(marker): dat(pos - 1) = Asc(Mid$(marker, pos, 1)): Next
                dat(8) = 1: dat(16) = 32: dat(20) = Len(indexText)
                For pos = 1 To Len(indexText): dat(31 + pos) = Asc(Mid$(indexText, pos, 1)): Next
                path = mRoot & "\library-header.dat": UWriteRaw path, dat
                Check UInstalledLibrary(path) = "2026.10.19.1", name
        End Select
        Record name, True, "": Exit Sub
    Failed:
        Dim reason As String = Err.Description
        On Error Resume Next
        If lockOpen Then Close #handle
        Record name, False, reason
    End Sub
    Private Function TestBridgeRecord(ByVal number As Long) As String
        Dim session As String = mRoot & "\shutdown-bridge", path As String = session & "\context.json"
        UDirectory session
        Dim request As UpdateJson = JO()
        request.Assign "bridge", JN(BVersion): request.Assign "sessionId", JS("shutdown-bridge")
        request.Assign "expiresUtc", JN(UtcMilliseconds() + 60000#)
        request.Assign "installationId", JS("test-installation"): request.Assign "originSha256", JS(UHashText("origin"))
        request.Assign "choice", JS("exit"): UWriteJson path, request
        UWriteJson USafe(session, "native-exit.json"), BRecord(path, "shutdown")
        Select Case number
            Case 40
                Check BMatches(path, "native-exit.json", "shutdown"), "matching shutdown acknowledgement"
                Check Not BMatches(path, "native-exit.json", "cancelled"), "distinct cancellation"
                Return "native shutdown and cancellation are distinct"
            Case 41
                request.Assign "choice", JS("now"): UWriteJson path, request
                Check Not BMatches(path, "native-exit.json", "shutdown"), "different request bytes"
                Return "native acknowledgement rejects changed request"
            Case 42
                request.Assign "expiresUtc", JN(1): UWriteJson path, request
                On Error GoTo Rejected
                Dim matched As Boolean = BMatches(path, "native-exit.json", "shutdown")
                On Error GoTo 0
                UFail "Expired shutdown acknowledgement was accepted."
        End Select
    Rejected:
        Return "expired shutdown acknowledgement rejected"
    End Function
    Private Sub MustReject(ByVal number As Long)
        On Error GoTo Expected
        Dim ignored As Variant, json As UpdateJson
        Select Case number
            Case 1: ignored = UVersionParts("0.1.2.3.4")
            Case 2: ignored = UVersionParts("4294967296")
            Case 3: ignored = UVersionParts("-1.2")
            Case 4: Set json = JParse("{" & Chr(34) & "a" & Chr(34) & ":1," & Chr(34) & "a" & Chr(34) & ":2}")
            Case 5: Set json = JParse("true false")
            Case 6: Set json = JParse("01")
            Case 7: URelative "a/../escape"
            Case 8: URelative "NUL.txt"
            Case 9: URelative "file:stream"
            Case 10
                Set json = JO(): json.Assign "schema", JN(IContextSchema): json.Assign "protocol", JN(IProtocol + 1)
                IValidateContext json, "not-a-session"
            Case 11
                Dim invalidUtf8(0 To 0) As Byte: invalidUtf8(0) = 255
                ignored = UDecodeText(invalidUtf8)
        End Select
        On Error GoTo 0: UFail "Unsafe input was accepted."
    Expected:
    End Sub
    Private Sub RejectInstall(ByVal plan As UpdateJson, ByVal path As String)
        On Error GoTo Expected
        UInstall plan, path
        On Error GoTo 0: UFail "Unsafe installation was accepted."
    Expected:
    End Sub
    Private Sub RejectRollback(ByVal journal As UpdateJson, ByVal path As String)
        On Error GoTo Expected
        URollback journal, path
        On Error GoTo 0: UFail "Corrupt backup was accepted."
    Expected:
    End Sub
    Private Sub RejectJournal(ByVal journal As UpdateJson, ByVal plan As UpdateJson, ByVal session As String)
        On Error GoTo Expected
        UValidateJournal journal, plan, session
        On Error GoTo 0: UFail "Tampered journal was accepted."
    Expected:
    End Sub
    Private Sub RunZipCase(ByVal fixture As UpdateJson)
        Dim name As String = JT(fixture, "name"), path As String = mRoot & "\zip-" & name & ".zip", directory As String = mRoot & "\zip-" & name
        On Error GoTo Failed
        Dim hex As String = JT(fixture, "archiveHex"), bytes() As Byte, i As Long, file As Integer, opened As Boolean
        ReDim bytes(0 To Len(hex) \ 2 - 1)
        For i = 0 To UBound(bytes): bytes(i) = CByte("&H" & Mid$(hex, i * 2 + 1, 2)): Next
        file = FreeFile(): Open path For Binary Access Write As #file: opened = True: Put #file, , bytes: Close #file: opened = False
        Dim entries As Object = UZipEntries(path), key As Variant, entry As UpdateJson, expected As UpdateJson
        For Each key In entries.Keys
            Set entry = entries.Item(key)
            If Not JBool(entry, "directory") Then UZipExtract path, entry, USafe(directory, JT(entry, "name"))
        Next
        If JBool(fixture, "reject") Then
            Record "ZIP " & name, False, "Unsafe ZIP was accepted.": Exit Sub
        End If
        For Each expected In fixture.Member("files").Items
            Check UHash(USafe(directory, JT(expected, "name"))) = JT(expected, "sha256"), "ZIP contents differ."
        Next
        Record "ZIP " & name, True, "": Exit Sub
    Failed:
        Dim reason As String = Err.Description
        On Error Resume Next
        If opened Then Close #file
        Record "ZIP " & name, JBool(fixture, "reject"), reason
    End Sub
End Module

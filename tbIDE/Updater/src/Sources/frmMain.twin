' Shared WinUI Toolkit WebView2 lifecycle and native theme bridge.
[Description("")]
[FormDesignerId("AA6A1949-4A01-4574-A9E6-665A3A5D05BB")]
[PredeclaredId]
Class frmMain
    Private mOperation As String
    Private mExpectedDocumentUri As String
    Private mNavigated As Boolean
    Private mPageReady As Boolean
    Private mWorker As LongPtr
    Private mArmingDeadline As Date
    Private mRecovery As String
    Private mNormalHeight As Long
    Private mToast As Boolean
    Private mRoot As String
    Private mExitCode As Long
    Private mLastState As String
    Private mScriptFilterInstalled As Boolean

    Sub New()
        WinUI_InitializeDpiAwareness
    End Sub

    Private Sub wvMain_Create()
        On Error GoTo Failed
        UIX_Log "WebView2 Create: configuring per-user profile"
        Dim profile As String = UIX_WebViewUserDataFolder()
        UDirectory profile
        wvMain.EnvironmentOptions.UserDataFolder = profile
        UIX_Log "WebView2 Create: profile configured"
        Exit Sub
    Failed:
        UIX_Log "WebView2 Create failed (" & CStr(Err.Number) & "): " & Err.Description
    End Sub

    Private Sub Form_Load()
        On Error GoTo Failed
        Dim stage As String = "form initialization"
        UIX_Log "Form_Load: begin"
        mOperation = UpdateMode
        mToast = UpdateMode = "Quiet" And Len(StartupError) = 0
        mNormalHeight = Me.Height
        If mToast Then Me.Height = 4500
        Me.Caption = "tbUI3 Updater"
        stage = "form font"
        Me.Font.Name = "Segoe UI"
        Me.Font.Size = 9
        Me.BackColor = vbBlack
        stage = "window theme bridge"
        WinUI_ApplyWindows11Backdrop Me.hWnd
        If Not WinUITheme_Attach(Me.hWnd, Me) Then Err.Raise 5, , "Could not attach the Windows theme bridge."
        ResizeWebView
        UIX_Log "Form_Load: completed; awaiting WebView2 Ready"
        Exit Sub
    Failed:
        RuntimeHelp "Form_Load / " & stage & " (" & CStr(Err.Number) & "): " & Err.Description
        Unload Me
    End Sub

    Private Sub Form_Activate()
        WinUITheme_Refresh
    End Sub

    Private Sub Form_Resize()
        ResizeWebView
    End Sub

    Private Sub ResizeWebView()
        On Error Resume Next
        If Me.WindowState = vbMinimized Then Exit Sub
        wvMain.Move 0, 0, Me.ScaleWidth, Me.ScaleHeight
    End Sub

    Private Sub wvMain_Ready()
        On Error GoTo Failed
        If mNavigated Then Exit Sub
        mNavigated = True
        Dim stage As String = "embedded resource assembly"
        UIX_Log "WebView2 Ready: begin"
        WinUITheme_SetWebViewReady Me.hWnd, False
        Dim html As String = UIX_ResourceText("updater.html")
        If Len(html) = 0 Then Err.Raise 53, , "The embedded updater page is missing."
        html = Replace(html, "{{STYLE_BLOCK}}", "<style>" & UIX_ResourceText("winui.css") & UIX_ResourceText("updater.css") & "</style>")
        html = Replace(html, "{{THEME_SCRIPT}}", "<script>" & UIX_ResourceText("theme-bridge.js") & "</" & "script>")
        If Not mScriptFilterInstalled Then
            stage = "script resource filter"
            wvMain.AddWebResourceRequestedFilter "https://tbui3-updater.invalid/*", 0
            mScriptFilterInstalled = True
        End If
        html = Replace(html, "{{CONTROLS_SCRIPT}}", "<script src=" & Chr(34) & "https://tbui3-updater.invalid/winui-controls.js" & Chr(34) & "></" & "script>")
        html = Replace(html, "{{APP_SCRIPT}}", "<script src=" & Chr(34) & "https://tbui3-updater.invalid/updater.js" & Chr(34) & "></" & "script>")
        stage = "document authorization"
        mExpectedDocumentUri = UpdaterDocumentUri(html)
        stage = "NavigateToString"
        UIX_Log "WebView2 navigation: chars=" & CStr(Len(html))
        wvMain.NavigateToString html
        UIX_Log "WebView2 navigation: submitted; awaiting updater:ready"
        Exit Sub
    Failed:
        mNavigated = False
        RuntimeHelp "WebView2 Ready / " & stage & " (" & CStr(Err.Number) & "): " & Err.Description
        Unload Me
    End Sub

    Private Sub wvMain_Error(ByVal code As Long, ByVal message As String)
        RuntimeHelp "WebView2 error " & Hex$(code) & ": " & message
        Unload Me
    End Sub

    Private Sub wvMain_NavigationStarting(ByVal uri As String, ByVal userInitiated As Boolean, ByVal redirected As Boolean, ByVal headers As WebView2RequestHeaders, Cancel As Boolean)
        Cancel = Not UpdaterDocumentAllowed(uri, mExpectedDocumentUri)
        UIX_Log "WebView2 NavigationStarting: uri=" & Left$(Replace(Replace(uri, vbCr, ""), vbLf, ""), 256) & "; cancelled=" & CStr(Cancel)
    End Sub

    ' Match the Toolkit: completion can describe intermediate about:blank/replacement navigations.
    ' Only updater:ready authorizes starting a worker; this event never starts installation.
    Private Sub wvMain_NavigationComplete(ByVal IsSuccess As Boolean, ByVal WebErrorStatus As Long)
        On Error Resume Next
        UIX_Log "WebView2 NavigationComplete: success=" & CStr(IsSuccess) & "; status=" & CStr(WebErrorStatus)
        If Not IsSuccess Then UIX_Log "Awaiting the updater application page; no worker has been authorized by navigation."
    End Sub

    Private Sub wvMain_JsMessage(ByVal message As Variant)
        On Error GoTo Failed
        ' Only exact fixed messages from our locked local origin. No paths, executable names,
        ' shell commands, or file selection are accepted from the web content.
        If WinUITheme_IsSnapshotRequest(CStr(message)) Then
            WinUITheme_SetWebViewReady Me.hWnd, True
            SendTheme
            Exit Sub
        End If
        Dim command As String = CStr(message)
        Select Case command
            Case "requestThemeSnapshot": SendTheme
            Case "updater:ready"
                If mPageReady Then Exit Sub
                mPageReady = True
                UIX_Log "WebView2 page bootstrap: updater:ready received"
                WinUITheme_SetWebViewReady Me.hWnd, True
                SendTheme
                If Len(StartupError) > 0 Then
                    SendError StartupError
                ElseIf Len(LaunchContext) > 0 Then
                    mRoot = JT(UReadJson(LaunchContext), "installRoot")
                    mRecovery = RecoveryContext(mRoot)
                    If UpdateMode = "Review" Then
                        StartCheck
                    ElseIf UpdateMode = "Quiet" Then
                        mOperation = "Check"
                    Else
                        mOperation = "Settings"
                        UState SessionFolder(), "settings", "Preferences for this twinBASIC installation."
                    End If
                    SendPreferences
                ElseIf Len(UpdateContext) > 0 Then
                    mWorker = StartUpdateEngine(mOperation)
                End If
                PollState
            Case "updater:poll"
                If mPageReady Then PollState
            Case "updater:review"
                If Not mPageReady Or Not mToast Then Exit Sub
                mToast = False: Me.Height = mNormalHeight
                SendPreferences
            Case "updater:check", "updater:retry"
                If Not mPageReady Or mWorker <> 0 Or mOperation = "Arm" Or Len(LaunchContext) = 0 Then Exit Sub
                StartCheck
            Case "updater:later"
                If Not mPageReady Or mWorker <> 0 Or Len(mRoot) = 0 Or (mOperation <> "Check" And mOperation <> "Settings") Then Exit Sub
                Dim patch As UpdateJson = JO()
                patch.Assign "deferredUntil", JN(UtcMilliseconds() + 86400000#)
                IApplySettings mRoot, patch
                Unload Me
            Case "updater:recover"
                If Not mPageReady Or mWorker <> 0 Or mOperation = "Arm" Then Exit Sub
                If Len(mRecovery) > 0 Then UpdateContext = mRecovery
                If Not HasJournal() Then Exit Sub
                mOperation = "Recover"
                mWorker = StartUpdateEngine(mOperation)
            Case "updater:elevate"
                If Not mPageReady Or mWorker <> 0 Then Exit Sub
                If mOperation <> "Apply" And mOperation <> "Recover" Then Exit Sub
                If JT(JParse(ReadSessionFile("state.json")), "status") <> "elevationRequired" Then Exit Sub
                mWorker = StartElevatedEngine(mOperation, Me.hWnd)
            Case "updater:cancel"
                If Not mPageReady Then Exit Sub
                If mOperation = "Apply" Then
                    Dim cancelState As String = JT(JParse(ReadSessionFile("state.json")), "status")
                    If cancelState <> "waiting" And cancelState <> "ready" And cancelState <> "elevationRequired" Then Exit Sub
                End If
                Select Case mOperation
                    Case "Arm", "Stage", "Apply": RequestCancel
                End Select
            Case "updater:close"
                If mWorker = 0 And mOperation <> "Arm" Then Unload Me
            Case Else
                If Not mPageReady Or Len(command) > 2048 Or Left$(command, 1) <> "{" Then Exit Sub
                HandleIntent JParse(command)
        End Select
        Exit Sub
    Failed:
        Dim reason As String = Err.Description
        If mOperation = "Arm" Or (mOperation = "Stage" And mWorker = 0) Then
            If UpdateContext <> LaunchContext Then
                FailPending reason
            Else
                mOperation = "Check"
                IUnlock TransactionLock: TransactionLock = 0
                SendError reason
            End If
        Else
            SendError reason
        End If
    End Sub

    Private Sub HandleIntent(ByVal request As UpdateJson)
        If Len(mRoot) = 0 Or mWorker <> 0 Or mToast Then Exit Sub
        If mOperation <> "Check" And mOperation <> "Settings" Then Exit Sub
        Select Case JT(request, "action")
            Case "select"
                If Not Me.Visible Or mOperation <> "Check" Then Exit Sub
                If JT(JParse(ReadSessionFile("state.json")), "status") <> "checked" Then Exit Sub
                If Len(RecoveryContext(mRoot)) > 0 Then UFail "Restore the unfinished transaction before starting an update."
                mOperation = "Arm"
                BeginSelection request
                mArmingDeadline = DateAdd("s", 15, Now)
                PollState
            Case "automatic", "restart"
                If request.Member("enabled").Kind <> "boolean" Then UFail "Invalid preference."
                Dim patch As UpdateJson = JO()
                patch.Assign JT(request, "action"), request.Member("enabled")
                IApplySettings mRoot, patch
                SendPreferences
            Case "reset"
                If Not JBool(request, "confirmed") Then UFail "Explicit settings reset approval is required."
                ResetSettings
                SendPreferences
        End Select
    End Sub

    Private Sub ResetSettings()
        Dim guard As LongPtr = IRequireLock("settings-" & IId(mRoot))
        On Error GoTo Failed
        Dim home As String = IHome(mRoot), path As String = USafe(home, "settings.json")
        If UExists(path) Then
            Dim backup As String = USafe(home, "Repairs/" & UUnique() & "/settings.json")
            UDirectory UParent(backup): UCopy path, backup: UFlush backup
            If UHash(path) <> UHash(backup) Then UFail "Could not verify the settings backup."
        End If
        Dim settings As UpdateJson = IDefaultSettings(mRoot)
        settings.Assign "automatic", JB(False)
        ISaveSettings mRoot, settings
        IUnlock guard
        Exit Sub
    Failed:
        Dim reason As String = Err.Description
        IUnlock guard
        UFail reason
    End Sub

    Private Sub StartCheck()
        If TransactionLock <> 0 Then IUnlock TransactionLock: TransactionLock = 0
        UpdateContext = LaunchContext: mOperation = "Check": mExitCode = 0: mLastState = ""
        UState SessionFolder(), "checking", "Checking published releases..."
        mWorker = StartUpdateEngine("Check")
        SendPreferences
    End Sub

    Private Sub SendPreferences()
        Dim snapshot As UpdateJson = JO()
        snapshot.Assign "type", JS("preferences")
        snapshot.Assign "toast", JB(mToast)
        snapshot.Assign "root", JS(mRoot): snapshot.Assign "version", JS(Phase1Config.UpdaterVersion)
        snapshot.Assign "recovery", JB(Len(mRecovery) > 0)
        On Error GoTo SettingsError
        snapshot.Assign "settings", ISettings(mRoot)
        GoTo Post
    SettingsError:
        snapshot.Assign "settingsError", JS(Err.Description)
        Resume Post
    Post:
        wvMain.PostWebMessageJSON snapshot.Encode()
    End Sub

    Private Sub FailPending(ByVal reason As String)
        On Error Resume Next
        RequestCancel
        UState SessionFolder(), "error", reason
        mOperation = "Failed"
        IUnlock TransactionLock: TransactionLock = 0
        SendError reason
    End Sub

    Private Sub PollState()
        If mOperation = "Arm" Then
            If UExists(USafe(SessionFolder(), "cancel.json")) Then
                mOperation = "Failed"
                UState SessionFolder(), "cancelled", "Update cancelled."
            ElseIf BMatches(UpdateContext, "armed.json", "armed") Then
                Dim context As UpdateJson = UReadJson(UpdateContext)
                If Not UOwnerAlive(context.Member("identity")) And Not BMatches(UpdateContext, "native-exit.json", "shutdown") Then
                    FailPending "twinBASIC exited before acknowledging normal shutdown."
                Else
                    If JT(context, "choice") = "now" Then UWriteJson USafe(SessionFolder(), "request-exit.json"), BRecord(UpdateContext, "exit")
                    mOperation = "Stage"
                    UState SessionFolder(), "staging", "Shutdown bridge acknowledged. Preparing selected updates..."
                    mWorker = StartUpdateEngine("Stage")
                End If
            ElseIf Now >= mArmingDeadline Or Not UOwnerAlive(LaunchIdentity) Then
                FailPending "twinBASIC did not acknowledge the shutdown request. Reopen updates from the IDE and try again."
            End If
        End If
        Dim running As Boolean = WorkerRunning(mWorker), state As String = ReadSessionFile("state.json")
        If Not running And mWorker <> 0 Then
            mExitCode = WorkerExitCode(mWorker)
            ReleaseWorker mWorker: mWorker = 0
            If mOperation = "Stage" And mExitCode = 0 And Len(state) > 0 Then
                If JT(JParse(state), "status") = "ready" Then
                    mWorker = StartUpdateEngine("Apply")
                    mOperation = "Apply"
                    running = True
                End If
            End If
        End If
        If Len(state) = 0 Then Exit Sub
        Dim status As String = JT(JParse(state), "status")
        If Not running And (status = "cancelled" Or status = "error" Or status = "complete" Or status = "rolledBack") Then
            If mOperation = "Stage" Or mOperation = "Apply" Then
                If status = "error" Then RequestCancel
                IUnlock TransactionLock: TransactionLock = 0
            End If
        End If
        Dim key As String = state & CStr(running) & CStr(mExitCode)
        If key = mLastState Then Exit Sub
        mLastState = key
        wvMain.PostWebMessageJSON "{" & UIX_JsonString("type") & ":" & UIX_JsonString("updateState") & "," & _
            UIX_JsonString("state") & ":" & state & "," & UIX_JsonString("running") & ":" & IIf(running Or mOperation = "Arm", "true", "false") & "," & _
            UIX_JsonString("canRecover") & ":" & IIf(Len(mRecovery) > 0 Or (HasJournal() And status = "error"), "true", "false") & "," & _
            UIX_JsonString("exitCode") & ":" & CStr(mExitCode) & "}"
    End Sub

    Private Sub SendError(ByVal message As String)
        On Error Resume Next
        UIX_Log message
        If Not mPageReady Then Exit Sub
        wvMain.PostWebMessageJSON "{" & UIX_JsonString("type") & ":" & UIX_JsonString("hostError") & "," & UIX_JsonString("message") & ":" & UIX_JsonString(message) & "}"
    End Sub

    Public Sub WinUIThemePostSnapshot(ByVal payload As String)
        wvMain.PostWebMessageJSON payload
    End Sub

    Private Sub SendTheme()
        WinUITheme_SendSnapshotToWebView "request"
    End Sub

    Private Sub wvMain_WebResourceRequested(ByVal request As WebView2Request, ByVal response As WebView2Response)
        On Error GoTo Failed
        Dim name As String
        UIX_Log "WebView2 resource request: " & request.Method & " " & request.Uri
        Select Case request.Uri
            Case "https://tbui3-updater.invalid/winui-controls.js": name = "winui-controls.js"
            Case "https://tbui3-updater.invalid/updater.js": name = "updater.js"
            Case Else
                response.StatusCode = 404
                response.ReasonPhrase = "Not Found"
                Exit Sub
        End Select
        If request.Method <> "GET" Then
            response.StatusCode = 405
            response.ReasonPhrase = "Method Not Allowed"
            Exit Sub
        End If
        response.Headers.AppendHeader "Content-Type", "application/javascript; charset=utf-8"
        response.Headers.AppendHeader "Cache-Control", "no-store"
        response.Headers.AppendHeader "X-Content-Type-Options", "nosniff"
        response.ContentBytes = LoadResData(name, "OTHER")
        Exit Sub
    Failed:
        response.StatusCode = 500
        response.ReasonPhrase = "Embedded Script Unavailable"
        UIX_Log Err.Description
    End Sub

    Private Sub Form_Unload(Cancel As Integer)
        On Error Resume Next
        If mWorker <> 0 Or mOperation = "Arm" Then
            Cancel = True
            SendError "An update operation is still running. Cancel it before installation starts, or wait for verification to finish."
            Exit Sub
        End If
        ReleaseWorker mWorker
        mWorker = 0
        WinUITheme_SetWebViewReady Me.hWnd, False
        CloseLaunch
        WinUITheme_Detach Me.hWnd
    End Sub
End Class

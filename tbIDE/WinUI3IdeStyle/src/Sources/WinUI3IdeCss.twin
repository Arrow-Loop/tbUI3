Module WinUI3IdeCss
    ' The stylesheet the add-in puts on the IDE page while a WinUI3 theme is active.
    ' It only covers what the .theme files cannot reach: rules the IDE's styles.css hard-codes (BETA 1033).
    ' Values are WinUI 3 theme resources from microsoft-ui-xaml (Common_themeresources_any.xaml plus the
    ' control's own *_themeresources.xaml, named on each rule). Solid colours are the WinUI translucent
    ' fill composited over the WinUI3 theme surface underneath, as noted.
    ' body.darkMode is set by the IDE for themes that inherit Dark.

    Public Function Build() As String
        Dim css As String
        AddDialogButtons css
        AddProgressBar css
        AddMenuBar css
        Return css
    End Function

    ' Button_themeresources.xaml: ButtonBackgroundPointerOver = ControlFillColorSecondary,
    ' ButtonBackgroundPressed = ControlFillColorTertiary, ButtonForegroundPressed = TextFillColorSecondary,
    ' ButtonBorderBrushPressed = ControlStrokeColorDefault. Replaces the IDE's #ebeff5 hover and brightness filter.
    Private Sub AddDialogButtons(ByRef css As String)
        ' Dark, over the #202020 command area: Secondary #15FFFFFF gives #323232, Tertiary #08FFFFFF gives #272727.
        AppendLine css, "body.darkMode .msgBoxButton:hover { background: #323232; filter: none; }"
        AppendLine css, "body.darkMode .msgBoxButton:active { background: #272727; filter: none; color: rgba(255, 255, 255, 0.786); border-top-color: rgba(255, 255, 255, 0.07); }"
        ' Light, over the #F3F3F3 command area: Secondary #80F9F9F9 gives #F6F6F6, Tertiary #4DF9F9F9 gives #F5F5F5.
        AppendLine css, "body:not(.darkMode) .msgBoxButton:hover { background: #F6F6F6; filter: none; }"
        AppendLine css, "body:not(.darkMode) .msgBoxButton:active { background: #F5F5F5; filter: none; color: rgba(0, 0, 0, 0.6063); border-bottom-color: rgba(0, 0, 0, 0.0578); }"
    End Sub

    ' ProgressBar_themeresources.xaml: ProgressBarMinHeight 3, ProgressBarTrackHeight 1,
    ' ProgressBarCornerRadius 1.5, ProgressBarTrackCornerRadius 0.5,
    ' ProgressBarForeground = AccentFillColorDefault, ProgressBarBackground = ControlStrongStrokeColorDefault.
    ' The IDE's bar is a 27px green box with centred text; this turns it into a WinUI bar with the text above it.
    Private Sub AddProgressBar(ByRef css As String)
        AppendLine css, "body .mainProgressBarOuter { position: relative; height: 32px; border: 0; border-radius: 0; outline: 0; background: transparent; }"
        ' The 1px track sits centred on the 3px indicator.
        AppendLine css, "body .mainProgressBarOuter::before { content: ''; position: absolute; left: 0; right: 0; bottom: 1px; height: 1px; border-radius: 0.5px; }"
        AppendLine css, "body .mainProgressBarInner { position: absolute; left: 0; bottom: 0; height: 3px; border-radius: 1.5px; }"
        AppendLine css, "body .mainProgressBarInnerText { top: 0; height: calc(100% - 3px); text-align: left; text-shadow: none; }"
        AppendLine css, "body.darkMode .mainProgressBarOuter::before { background: rgba(255, 255, 255, 0.5442); }"
        AppendLine css, "body.darkMode .mainProgressBarInner { background: #60CDFF; }"
        AppendLine css, "body:not(.darkMode) .mainProgressBarOuter::before { background: rgba(0, 0, 0, 0.4458); }"
        AppendLine css, "body:not(.darkMode) .mainProgressBarInner { background: #005FB8; }"
    End Sub

    ' MenuBar_themeresources.xaml: MenuBarItemBackgroundPointerOver = SubtleFillColorSecondary,
    ' MenuBarItemBackgroundSelected = SubtleFillColorTertiary, MenuBarItemForeground = TextFillColorPrimary
    ' (the menu bar's own text colour from the theme). Replaces the IDE's fixed light grey hover and its
    ' fixed rgb(77, 75, 75) hover text. The status bar's menu items share that rule; they keep the status bar's text colour.
    Private Sub AddMenuBar(ByRef css As String)
        AppendLine css, "body.darkMode .menuItem:hover { background-color: rgba(255, 255, 255, 0.0605); color: var(--themeMenuForeColor); }"
        AppendLine css, "body.darkMode .isMenuItemSelected { background-color: rgba(255, 255, 255, 0.0419); color: var(--themeMenuForeColor); }"
        AppendLine css, "body.darkMode .statusMenuItem:hover { background-color: rgba(255, 255, 255, 0.0605); color: inherit; }"
        AppendLine css, "body:not(.darkMode) .menuItem:hover { background-color: rgba(0, 0, 0, 0.0373); color: var(--themeMenuForeColor); }"
        AppendLine css, "body:not(.darkMode) .isMenuItemSelected { background-color: rgba(0, 0, 0, 0.0241); color: var(--themeMenuForeColor); }"
        AppendLine css, "body:not(.darkMode) .statusMenuItem:hover { background-color: rgba(0, 0, 0, 0.0373); color: inherit; }"
    End Sub

    Private Sub AppendLine(ByRef css As String, ByVal Rule As String)
        css = css & Rule & vbCrLf
    End Sub

End Module

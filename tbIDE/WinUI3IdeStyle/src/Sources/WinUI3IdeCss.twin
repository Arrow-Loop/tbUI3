        css = css & "body #hoverTooltip { box-sizing: border-box; max-width: 320px; padding: 6px 9px 8px 9px; border: 1px solid var(--color-popup-border); border-radius: 4px; box-shadow: none; "
        css = css & "font-family: 'Segoe UI Variable Text', 'Segoe UI Variable', 'Segoe UI', sans-serif; font-size: 12px; font-weight: 400; line-height: normal; }" & vbCrLf
        css = css & "body #hoverTooltip.visibleTooltip { -webkit-filter: opacity(1); }" & vbCrLf
        Return css
    End Function

End Module

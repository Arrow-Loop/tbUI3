Module WinUI3IdeCss
    ' GENERATED by tbIDE/tools/build-addin-css.mjs from tbIDE/WinUI3IdeStyle/css/winui3-ide.css. Do not edit here:
    ' change the .css file (it carries the WinUI token names and sources for every rule) and run the script.
    ' The stylesheet the add-in puts on the IDE page while a WinUI3 theme is active, one CSS rule per line.

    ' Number of rules Build() returns. The add-in's log compares it with what the browser parsed.
    Public Function RuleCount() As Long
        Return 45
    End Function

    Public Function Build() As String
        Dim css As String
        css = css & "body.darkMode { --color-text: #ffffff; --color-text-muted: #ffffffc5; --color-text-subtle: #ffffff87; --color-text-disabled: #ffffff5d; --color-control: #ffffff0f; "
        css = css & "--color-control-hover: #ffffff15; --color-control-disabled: #ffffff0b; --color-input-active: #1e1e1eb3; --color-control-border: #ffffff12; --color-border-strong: #ffffff8b; "
        css = css & "--color-neutral-hover: #ffffff0f; --color-neutral-pressed: #ffffff0a; --color-divider: #ffffff15; --color-flyout: #2c2c2c; --color-popup-border: #00000033; --color-accent: #60cdff; "
        css = css & "--color-control-active: #ffffff08; --color-control-border-bottom: #ffffff18; --color-accent-hover: #60cdffe6; --color-accent-pressed: #60cdffcc; --color-accent-text: #000000; "
        css = css & "--color-accent-text-pressed: #00000080; --color-accent-border: #ffffff14; --color-accent-border-bottom: #00000023; --color-border-mask: #ffffff; "
        css = css & "--brush-control-elevation: linear-gradient(to bottom, var(--color-control-border-bottom) 0 1px, var(--color-control-border) 3px); --brush-accent-elevation: linear-gradient(to top, "
        css = css & "var(--color-accent-border-bottom) 0 1px, var(--color-accent-border) 3px); }" & vbCrLf
        css = css & "body:not(.darkMode) { --color-text: #000000e4; --color-text-muted: #0000009e; --color-text-subtle: #00000072; --color-text-disabled: #0000005c; --color-control: #ffffffb3; "
        css = css & "--color-control-hover: #f9f9f980; --color-control-disabled: #f9f9f94d; --color-input-active: #ffffff; --color-control-border: #0000000f; --color-border-strong: #00000072; "
        css = css & "--color-neutral-hover: #00000009; --color-neutral-pressed: #00000006; --color-divider: #0000000f; --color-flyout: #f9f9f9; --color-popup-border: #0000000f; --color-accent: #005fb8; "
        css = css & "--color-control-active: #f9f9f94d; --color-control-border-bottom: #00000029; --color-accent-hover: #005fb8e6; --color-accent-pressed: #005fb8cc; --color-accent-text: #ffffff; "
        css = css & "--color-accent-text-pressed: #ffffffb3; --color-accent-border: #ffffff14; --color-accent-border-bottom: #00000066; --color-border-mask: #ffffff; "
        css = css & "--brush-control-elevation: linear-gradient(to top, var(--color-control-border-bottom) 0 1px, var(--color-control-border) 3px); --brush-accent-elevation: linear-gradient(to top, "
        css = css & "var(--color-accent-border-bottom) 0 1px, var(--color-accent-border) 3px); }" & vbCrLf
        css = css & "body .msgBoxButtons { padding: 24px; gap: 8px; }" & vbCrLf
        css = css & "body .msgBoxButton { position: relative; display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 32px; margin: 0; "
        css = css & "padding: 5px 11px 6px 11px; border: 1px solid transparent; border-radius: 4px; background: var(--color-control); background-clip: padding-box; box-shadow: none; "
        css = css & "color: var(--color-text); font-family: 'Segoe UI Variable Text', 'Segoe UI Variable', 'Segoe UI', sans-serif; font-size: 14px; font-weight: 400; line-height: 19px; "
        css = css & "white-space: nowrap; cursor: default; filter: none; --edge-brush: var(--brush-control-elevation); }" & vbCrLf
        css = css & "body .msgBoxButton::before { content: ''; position: absolute; inset: -1px; padding: 1px; border-radius: inherit; background: var(--edge-brush); "
        css = css & "-webkit-mask: linear-gradient(var(--color-border-mask) 0 0) content-box, linear-gradient(var(--color-border-mask) 0 0); -webkit-mask-composite: xor; mask-composite: exclude; "
        css = css & "pointer-events: none; }" & vbCrLf
        css = css & "body .msgBoxButton:hover { background: var(--color-control-hover); background-clip: padding-box; filter: none; }" & vbCrLf
        css = css & "body .msgBoxButton:active { background: var(--color-control-active); background-clip: padding-box; color: var(--color-text-muted); --edge-brush: var(--color-control-border); }" & vbCrLf
        css = css & "body .msgBoxButton.buttonFocused { background: var(--color-accent); background-clip: border-box; color: var(--color-accent-text); border: 1px solid transparent; outline: none; "
        css = css & "--edge-brush: var(--brush-accent-elevation); }" & vbCrLf
        css = css & "body .msgBoxButton.buttonFocused:hover { background: var(--color-accent-hover); background-clip: border-box; }" & vbCrLf
        css = css & "body .msgBoxButton.buttonFocused:active { background: var(--color-accent-pressed); background-clip: border-box; color: var(--color-accent-text-pressed); --edge-brush: transparent; "
        css = css & "}" & vbCrLf
        css = css & "body .mainProgressBarOuter { position: relative; height: 32px; border: 0; border-radius: 0; outline: 0; background: transparent; }" & vbCrLf
        css = css & "body .mainProgressBarOuter::before { content: ''; position: absolute; left: 0; right: 0; bottom: 1px; height: 1px; border-radius: 0.5px; }" & vbCrLf
        css = css & "body .mainProgressBarInner { position: absolute; left: 0; bottom: 0; height: 3px; border-radius: 1.5px; }" & vbCrLf
        css = css & "body .mainProgressBarInnerText { top: 0; height: calc(100% - 3px); text-align: left; text-shadow: none; }" & vbCrLf
        css = css & "body.darkMode .mainProgressBarOuter::before { background: rgba(255, 255, 255, 0.5442); }" & vbCrLf
        css = css & "body.darkMode .mainProgressBarInner { background: #60CDFF; }" & vbCrLf
        css = css & "body:not(.darkMode) .mainProgressBarOuter::before { background: rgba(0, 0, 0, 0.4458); }" & vbCrLf
        css = css & "body:not(.darkMode) .mainProgressBarInner { background: #005FB8; }" & vbCrLf
        css = css & "body.darkMode .menuItem:hover { background-color: rgba(255, 255, 255, 0.0605); color: var(--themeMenuForeColor); }" & vbCrLf
        css = css & "body.darkMode .isMenuItemSelected { background-color: rgba(255, 255, 255, 0.0419); color: var(--themeMenuForeColor); }" & vbCrLf
        css = css & "body.darkMode .statusMenuItem:hover { background-color: rgba(255, 255, 255, 0.0605); color: inherit; }" & vbCrLf
        css = css & "body:not(.darkMode) .menuItem:hover { background-color: rgba(0, 0, 0, 0.0373); color: var(--themeMenuForeColor); }" & vbCrLf
        css = css & "body:not(.darkMode) .isMenuItemSelected { background-color: rgba(0, 0, 0, 0.0241); color: var(--themeMenuForeColor); }" & vbCrLf
        css = css & "body:not(.darkMode) .statusMenuItem:hover { background-color: rgba(0, 0, 0, 0.0373); color: inherit; }" & vbCrLf
        css = css & "body #contextMenu, body .contextMenu, body .contextMenu2, body #contextMenuSUB { box-sizing: border-box; min-width: 96px; padding: 2px 0; background: var(--color-flyout); "
        css = css & "color: var(--color-text); border: 1px solid var(--color-popup-border); border-radius: 8px; outline: none; font-family: 'Segoe UI Variable Text', 'Segoe UI Variable', 'Segoe UI', "
        css = css & "sans-serif; font-size: 14px; font-weight: 400; }" & vbCrLf
        css = css & "body .contextMenuItem { position: relative; box-sizing: border-box; min-height: 32px; margin: 2px 4px; padding: 4px 25px 5px 39px; border-radius: 4px; color: var(--color-text); "
        css = css & "line-height: 23px; white-space: nowrap; cursor: default; }" & vbCrLf
        css = css & "body .contextMenuNoIcons .contextMenuItem { padding-left: 11px; }" & vbCrLf
        css = css & "body .contextMenuItem > .codicon { left: 0; margin-left: 11px; top: 8px; font-size: 16px; line-height: 16px; }" & vbCrLf
        css = css & "body .contextMenuItem:hover { background-color: var(--color-neutral-hover); }" & vbCrLf
        css = css & "body .contextMenuItem:active { background-color: var(--color-neutral-pressed); color: var(--color-text-muted); }" & vbCrLf
        css = css & "body .contextMenuItem.focusedMenuItem { background-color: var(--color-neutral-hover) !important; }" & vbCrLf
        css = css & "body .contextMenuItemDetail { padding-left: 24px; color: var(--color-text-muted); font-size: 12px; }" & vbCrLf
        css = css & "body .contextMenuItemDisabled, body .contextMenuItemDisabled:active { color: var(--color-text-disabled); }" & vbCrLf
        css = css & "body .contextMenuItemDisabled:hover { background-color: transparent; }" & vbCrLf
        css = css & "body #contextMenu hr, body .contextMenu hr, body .contextMenu2 hr, body #contextMenuSUB hr { height: 1px; margin: 4px 6px; border: 0; background: var(--color-divider); }" & vbCrLf
        css = css & "body .tabItem { border-radius: 8px 8px 0 0; margin-right: 0; padding-left: 8px; padding-right: 4px; font-family: 'Segoe UI Variable Text', 'Segoe UI Variable', 'Segoe UI', "
        css = css & "sans-serif; font-size: 12px; font-weight: 400; color: var(--color-text-muted); }" & vbCrLf
        css = css & "body .tabItemSelected { color: var(--color-text); }" & vbCrLf
        css = css & "body .tabItem:not(.tabItemSelected):not(:has(+ .tabItemSelected))::after { content: ''; position: absolute; right: 0; top: 8px; bottom: 8px; width: 1px; "
        css = css & "background: var(--color-divider); }" & vbCrLf
        css = css & "body .tabItemIconRight { border-radius: 4px; }" & vbCrLf
        css = css & "body .tabItem:hover .tabItemIconRight, body .tabItemSelected .tabItemIconRight { color: var(--color-text-muted); }" & vbCrLf
        css = css & "body .tabItemIconRight:hover { background: var(--color-neutral-hover) !important; color: var(--color-text); }" & vbCrLf
        css = css & "body .configEditorContainer input[type=text], body .configEditorContainer input[type=number], body .configEditorContainer textarea, body .configEditorContainer2 input[type=text], "
        css = css & "body .configEditorContainer2 input[type=number], body .configEditorContainer2 textarea, body .simpleMsgBoxNoImage input[type=text] { box-sizing: border-box; min-height: 32px; "
        css = css & "margin: 0; padding: 5px 6px 6px 10px; background-color: var(--color-control) !important; color: var(--color-text) !important; "
        css = css & "border: 1px solid var(--color-control-border) !important; border-bottom-color: var(--color-border-strong) !important; border-radius: 4px; outline: none !important; "
        css = css & "font-family: 'Segoe UI Variable Text', 'Segoe UI Variable', 'Segoe UI', sans-serif; font-size: 14px; line-height: 19px; }" & vbCrLf
        css = css & "body .configEditorContainer input[type=text]:hover, body .configEditorContainer input[type=number]:hover, body .configEditorContainer textarea:hover, "
        css = css & "body .configEditorContainer2 input[type=text]:hover, body .configEditorContainer2 input[type=number]:hover, body .configEditorContainer2 textarea:hover, "
        css = css & "body .simpleMsgBoxNoImage input[type=text]:hover { background-color: var(--color-control-hover) !important; }" & vbCrLf
        css = css & "body .configEditorContainer input[type=text]:focus, body .configEditorContainer input[type=number]:focus, body .configEditorContainer textarea:focus, "
        css = css & "body .configEditorContainer2 input[type=text]:focus, body .configEditorContainer2 input[type=number]:focus, body .configEditorContainer2 textarea:focus, "
        css = css & "body .simpleMsgBoxNoImage input[type=text]:focus { background-color: var(--color-input-active) !important; border-bottom: 2px solid var(--color-accent) !important; "
        css = css & "padding-bottom: 5px; }" & vbCrLf
        css = css & "body .configEditorContainer input:disabled, body .configEditorContainer textarea:disabled, body .configEditorContainer2 input:disabled, "
        css = css & "body .configEditorContainer2 textarea:disabled { background-color: var(--color-control-disabled) !important; color: var(--color-text-disabled) !important; "
        css = css & "border-color: var(--color-control-border) !important; }" & vbCrLf
        Return css
    End Function

End Module

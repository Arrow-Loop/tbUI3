        js = js & vbLf
        js = js & "        return true;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function menuItems(items) {"
        js = js & vbLf
        js = js & "        const result=[];"
        js = js & vbLf
        js = js & "        for(const entry of items||[]){"
        js = js & vbLf
        js = js & "            if(!Array.isArray(entry)){if(entry)result.push(entry);continue;}"
        js = js & vbLf
        js = js & "            // Match the native context-dependent alternatives, including superHiddenContext."
        js = js & vbLf
        js = js & "            for(const item of entry){if(!item)continue;if(!menuEnabled(item)&&item.superHiddenContext)continue;result.push(item);break;}"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        return result;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function command(item,parent) {"
        js = js & vbLf
        js = js & "        if(!item.name){parent.append(el('div','tbui3-ribbon-separator'));return;}"
        js = js & vbLf
        js = js & "        if(!menuEnabled(item)&&item.superHiddenContext)return;"
        js = js & vbLf
        js = js & "        const b=el('button','tbui3-ribbon-command');b.type='button';"
        js = js & vbLf
        js = js & "        const title=caption(item);"
        js = js & vbLf
        js = js & "        b.title=title+(typeof item.action==='string'?' '+api.shortcut(item.action):'');"
        js = js & vbLf
        js = js & "        b.append(iconFor(null,item),el('span','tbui3-ribbon-label',title));"
        js = js & vbLf
        js = js & "        b.addEventListener('mousedown',e=>e.preventDefault());"
        js = js & vbLf
        js = js & "        bindings.set(b,{item});parent.append(b);"
        js = js & vbLf
        js = js & "        if(item.comboOptions){"
        js = js & vbLf
        js = js & "            const select=el('select','tbui3-ribbon-select');select.setAttribute('aria-label',title);"
        js = js & vbLf
        js = js & "            for(const value of item.comboOptions){const o=el('option','',value);o.value=value;o.selected=value===item.comboValue;select.append(o);}"
        js = js & vbLf
        js = js & "            select.onchange=()=>{if(menuEnabled(item)&&item.onchange)item.onchange(select.value);};"
        js = js & vbLf
        js = js & "            b.replaceWith(select);bindings.delete(b);bindings.set(select,{item});return;"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(item.hoverAction){b.setAttribute('aria-haspopup','menu');b.append(el('span','tbui3-ribbon-chevron','\u2304'));}"
        js = js & vbLf
        js = js & "        b.onclick=()=>{"
        js = js & vbLf
        js = js & "            if(!menuEnabled(item))return;"
        js = js & vbLf
        js = js & "            if(item.action){"
        js = js & vbLf
        js = js & "                closeFile(false);closePopup();"
        js = js & vbLf
        js = js & "                if(typeof item.action==='string')api.execute(item.action);else item.action(item);"
        js = js & vbLf
        js = js & "                tick();"
        js = js & vbLf
        js = js & "            }else if(item.hoverAction)openSubmenu(item,b);"
        js = js & vbLf
        js = js & "        };"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function openSubmenu(item,anchor) {"
        js = js & vbLf
        js = js & "        closePopup();popup=el('div','tbui3-toolbar-owned tbui3-ribbon-popup');popup.setAttribute('role','menu');"
        js = js & vbLf
        js = js & "        const bounds=anchor.getBoundingClientRect();popup.style.setProperty('--tbui3-popup-x',Math.min(bounds.left,w.innerWidth-280)+'px');"
        js = js & vbLf
        js = js & "        popup.style.setProperty('--tbui3-popup-y',Math.min(bounds.bottom,w.innerHeight-200)+'px');d.body.append(popup);"
        js = js & vbLf
        js = js & "        const sink=items=>{if(!popup)return;clear(popup);for(const child of menuItems(items))command(child,popup);syncBindings();popup.querySelector('"
        js = js & "button,select')?.focus();};"
        js = js & vbLf
        js = js & "        captureSink=sink;pendingSubmenu={sink,until:Date.now()+5000};"
        js = js & vbLf
        js = js & "        try{item.hoverAction(anchor);}finally{captureSink=null;}"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function closePopup(){pendingSubmenu=null;if(popup){for(const n of popup.querySelectorAll('button,select'))bindings.delete(n);popup.remove();popup"
        js = js & "=null;}}"
        js = js & vbLf
        js = js & "    function requestMenu(m) {"
        js = js & vbLf
        js = js & "        const sink=items=>{m.items=items||[];if(state.mode!=='Ribbon')return;"
        js = js & vbLf
        js = js & "            if(backstage&&!backstage.hidden&&fileSection===m.title)renderFile(m);"
        js = js & vbLf
        js = js & "            else if(state.active===m.node.id)renderMenu(m);"
        js = js & vbLf
        js = js & "        };"
        js = js & vbLf
        js = js & "        pendingMenus.set(m.node.id,sink);captureSink=sink;"
        js = js & vbLf
        js = js & "        try{"
        js = js & vbLf
        js = js & "            if(m.node.onmousedown)m.node.onmousedown({button:0,preventDefault(){},stopPropagation(){}});"
        js = js & vbLf
        js = js & "            else if(m.node.onclick)m.node.onclick({button:0,preventDefault(){},stopPropagation(){}});"
        js = js & vbLf
        js = js & "        }finally{captureSink=null;}"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function renderMenu(m) {"
        js = js & vbLf
        js = js & "        const items=menuItems(m.items);"
        js = js & vbLf
        js = js & "        const sig=JSON.stringify([m.node.id,items.map(i=>[caption(i),i.action&&String(i.action),i.codicon,i.iconClass,i.class,i.comboOptions,i.comboVa"
        js = js & "lue,checked(i),menuEnabled(i)])]);"
        js = js & vbLf
        js = js & "        if(sig===menuSignature)return;menuSignature=sig;clearContent();"
        js = js & vbLf
        js = js & "        let body=group(m.title),has=false;"
        js = js & vbLf
        js = js & "        for(const item of items){if(!item.name){if(has){body=group(localize(items[items.indexOf(item)+1]?.name)||m.title);has=false;}continue;}"
        js = js & vbLf
        js = js & "            command(item,body);has=true;}"
        js = js & vbLf
        js = js & "        if(m.node.id==='rootMenuFormat'){addSources(['zoomSelect','menuBarPreview'],group('Designer'));addGrid();if(currentHost())pages();}"
        js = js & vbLf
        js = js & "        if(m.node.id==='rootMenuProject')addSources(['buildConfigSelector','restartIcon','trashIcon','buildIcon'],group('Build'));"
        js = js & vbLf
        js = js & "        if(m.node.id==='rootMenuTools')addSources(['menuBarColorMode'],group('Appearance'));"
        js = js & vbLf
        js = js & "        syncBindings();resize();"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function clearContent(){returnNodes();for(const [n]of bindings)if(content.contains(n))bindings.delete(n);clear(content);}"
        js = js & vbLf
        js = js & "    function makeTab(key,title,action) {"
        js = js & vbLf
        js = js & "        const b=el('button','tbui3-ribbon-tab',title);b.type='button';b.dataset.tab=key;"
        js = js & vbLf
        js = js & "        b.addEventListener('mousedown',e=>e.preventDefault());"
        js = js & vbLf
        js = js & "        b.setAttribute('role','tab');b.setAttribute('aria-selected',String(state.active===key));b.tabIndex=state.active===key?0:-1;"
        js = js & vbLf
        js = js & "        b.onclick=action||(()=>selectTab(key));tabs.append(b);return b;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function selectTab(key,focus=false) {"
        js = js & vbLf
        js = js & "        state.active=key;menuSignature='';closeFile(false);closePopup();clearContent();"
        js = js & vbLf
        js = js & "        for(const b of tabs.children){const selected=b.dataset.tab===key;b.setAttribute('aria-selected',String(selected));b.tabIndex=selected?0:-1;if("
        js = js & "selected&&focus)b.focus();}"
        js = js & vbLf
        js = js & "        if(state.mode==='Hybrid'){"
        js = js & vbLf
        js = js & "            if(known[key]){for(const [name,ids]of known[key])addSources(ids,group(name));if(key==='Form'){addGrid();if(currentHost()){const nested=el("
        js = js & "'button','tbui3-ribbon-tab tbui3-ribbon-context','MultiPage');nested.onclick=()=>{clearContent();pages();syncBindings();resize();};content.prepend(nes"
        js = js & "ted);}}}"
        js = js & vbLf
        js = js & "            else addins(content,true);"
        js = js & vbLf
        js = js & "        }else{const m=menus.get(key);if(m)requestMenu(m);else if(key==='Add-ins')addins(content,true);}"
        js = js & vbLf
        js = js & "        syncBindings();resize();"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function renderTabs() {"
        js = js & vbLf
        js = js & "        clear(tabs);"
        js = js & vbLf
        js = js & "        if(state.mode==='Hybrid')for(const title of ['Home','Code','Form','Add-ins'])makeTab(title,title);"
        js = js & vbLf
        js = js & "        else {"
        js = js & vbLf
        js = js & "            const file=[...menus.values()].find(m=>m.node.id==='rootMenuFile');"
        js = js & vbLf
        js = js & "            if(!file)throw Error('File menu is unavailable; restoring Classic');"
        js = js & vbLf
        js = js & "            makeTab('File',file.title,()=>openFile(file.title));"
        js = js & vbLf
        js = js & "            for(const m of menus.values())if(m.node.id!=='rootMenuFile'&&m.node.id!=='rootMenuAddins')makeTab(m.node.id,m.title);"
        js = js & vbLf
        js = js & "            makeTab('Add-ins','Add-ins');"
        js = js & vbLf
        js = js & "            if(![...tabs.children].some(b=>b.dataset.tab===state.active))state.active=[...menus.keys()].find(id=>id!=='rootMenuFile'&&id!=='rootMenuAd"
        js = js & "dins');"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        selectTab(state.active);"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function openFile(section='File') {"
        js = js & vbLf
        js = js & "        if(backstage.hidden)savedFocus=d.activeElement;"
        js = js & vbLf
        js = js & "        fileSection=section;backstage.hidden=false;clear(fileNav);"
        js = js & vbLf
        js = js & "        const back=el('button','tbui3-backstage-back','\u2190 Back');back.onclick=()=>closeFile();fileNav.append(back);"
        js = js & vbLf
        js = js & "        for(const m of menus.values())if(m.node.id==='rootMenuFile'||m.node.id==='rootMenuAddins'||m.node.id==='rootMenuTools'){"
        js = js & vbLf
        js = js & "            const b=el('button','tbui3-backstage-nav',m.title);b.onclick=()=>{fileSection=m.title;requestMenu(m);};fileNav.append(b);"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        const selected=[...menus.values()].find(m=>m.title===section)||menus.get('rootMenuFile');"
        js = js & vbLf
        js = js & "        if(selected){fileSection=selected.title;renderFile(selected);requestMenu(selected);}back.focus();"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function renderFile(m) {"
        js = js & vbLf
        js = js & "        for(const [n]of bindings)if(fileContent.contains(n))bindings.delete(n);clear(fileContent);"
        js = js & vbLf
        js = js & "        fileContent.append(el('h1','tbui3-backstage-heading',m.title));"
        js = js & vbLf
        js = js & "        const list=menuItems(m.items),unsupported=m.node.id==='rootMenuAddins'&&list.some(i=>typeof i.action==='function'&&String(i.action).includes('"
        js = js & "notSupportedMenuOption'));"
        js = js & vbLf
        js = js & "        if(unsupported)fileContent.append(el('p','','This IDE build lists loaded add-ins here. It does not expose enable or disable commands.'));"
        js = js & vbLf
        js = js & "        const body=group(m.title,fileContent);for(const item of list){"
        js = js & vbLf
        js = js & "            if(unsupported&&typeof item.action==='function'&&String(item.action).includes('notSupportedMenuOption'))command({...item,isHidden:true},bo"
        js = js & "dy);"
        js = js & vbLf
        js = js & "            else command(item,body);"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        syncBindings();"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function closeFile(restoreFocus=true){if(backstage&&!backstage.hidden){backstage.hidden=true;if(restoreFocus&&savedFocus?.isConnected)savedFocus.f"
        js = js & "ocus();}}"
        js = js & vbLf
        js = js & "    function syncBindings(){for(const box of d.querySelectorAll('.tbui3-ribbon-grid'))box.disabled=!(api.formGlobals&&api.formGlobals());for(const [b,"
        js = js & "entry]of bindings){"
        js = js & vbLf
        js = js & "        const on=entry.source?!disabled(entry.source):menuEnabled(entry.item);b.disabled=!on;b.setAttribute('aria-disabled',String(!on));"
        js = js & vbLf
        js = js & "            const isChecked=entry.source?entry.source.classList.contains('menuBarToggleOn'):checked(entry.item);"
        js = js & vbLf
        js = js & "            b.classList.toggle('tbui3-ribbon-checked',isChecked);b.setAttribute('aria-pressed',String(isChecked));"
        js = js & vbLf
        js = js & "            if(entry.source){b.title=label(entry.source);b.hidden=!visible(entry.source);}"
        js = js & vbLf
        js = js & "    }}"
        js = js & vbLf
        js = js & "    function syncQuick(){"
        js = js & vbLf
        js = js & "        if(!quick)return;const parent=d.getElementById('rootMenu1Inner');"
        js = js & vbLf
        js = js & "        if(parent&&quick.parentElement!==parent)parent.prepend(quick);"
        js = js & vbLf
        js = js & "        quick.classList.toggle('tbui3-quick-real-titlebar',!!api.realTitlebar());"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function syncOptions() {"
        js = js & vbLf
        js = js & "        for(const name of d.getElementsByClassName('tbis-optionName'))if(name.textContent.trim()==='Enable additional IDE theme styling via add-in'){"
        js = js & vbLf
        js = js & "            const row=name.closest('.tbis-optionRow');if(!row)continue;"
        js = js & vbLf
        js = js & "            let next=row.nextElementSibling;"
        js = js & vbLf
        js = js & "            if(!next||!next.classList.contains('tbui3-toolbar-option')){"
        js = js & vbLf
        js = js & "                next=el('div','tbis-optionRow tbui3-toolbar-option');const left=el('div','tbis-optionLabelCol');"
        js = js & vbLf
        js = js & "                const text=el('label','tbis-optionName','IDE Toolbar'),right=el('div','tbis-optionValueCol'),select=el('select','tbui3-toolbar-select'"
        js = js & ");"
        js = js & vbLf

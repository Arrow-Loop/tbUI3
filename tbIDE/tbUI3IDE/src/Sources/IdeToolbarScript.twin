        js = js & "savedFocus?.isConnected)savedFocus.focus();}}"
        js = js & vbLf
        js = js & "    function syncBindings(){for(const box of d.querySelectorAll('.tbui3-ribbon-grid'))box.disabled=!(api.formGlobals&&api.formGlobals());for(const [b,"
        js = js & "entry]of bindings){"

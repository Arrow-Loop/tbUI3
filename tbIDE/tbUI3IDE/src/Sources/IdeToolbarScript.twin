        js = js & vbLf
        js = js & "    else if(source.startsWith('addinButton-')||has('Add-ins'))glyph=/Search|Find/i.test(n)?'searchIcon':'puzzle_piece';"
        js = js & vbLf
        js = js & "    const iconOnly=/^tbFormDesigner_(?:AlignSelectedControls(?:Left|Top|Right|Bottom|CenterHorizontal|CenterVertical)|ResizeSelectedControls(?:Widest|"

        js = js & vbLf
        js = js & "    function addMultiPageContext(){"
        js = js & vbLf
        js = js & "        if(!currentHost())return;"
        js = js & vbLf
        js = js & "        const body=group('MultiPage');"
        js = js & vbLf
        js = js & "        for(const ids of [pageIds.slice(0,2),pageIds.slice(2,4),pageIds.slice(4)]){"
        js = js & vbLf

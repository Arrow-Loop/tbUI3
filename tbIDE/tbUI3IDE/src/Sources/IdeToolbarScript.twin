        js = js & "er_AlignSelectedControlsBottom',"
        js = js & vbLf
        js = js & "        'tbFormDesigner_ResizeSelectedControlsWidest','tbFormDesigner_ResizeSelectedControlsTallest','tbFormDesigner_ResizeSelectedControlsNarrowest',"
        js = js & "'tbFormDesigner_ResizeSelectedControlsShortest'"
        js = js & vbLf
        js = js & "    ]);"
        js = js & vbLf
        js = js & "    const largeSources=new Set(['saveIcon','searchIcon','designSwitchIcon','playIcon','buildIcon','trashIcon','restartIcon',"
        js = js & vbLf
        js = js & "        'commentIcon','uncommentIcon','menuBarAlignLeft','menuBarAlignTop','menuBarAlignRight','menuBarAlignBottom',"
        js = js & vbLf

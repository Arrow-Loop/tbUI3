        js = js & "storeFocus&&savedFocus?.isConnected)savedFocus.focus();}}"
        js = js & vbLf
        js = js & "    function syncBindings(){sizeLabels();for(const box of d.querySelectorAll('.tbui3-ribbon-grid'))box.disabled=!(api.formGlobals&&api.formGlobals());"

        js = js & vbLf
        js = js & "        if(JSON.stringify([...tabs.children].map(n=>n.dataset.tab))!==JSON.stringify(distinct)){"
        js = js & vbLf
        js = js & "            clear(tabs);for(const id of distinct)makeTab(id,id,id==='File'?()=>openFile():undefined);"
        js = js & vbLf

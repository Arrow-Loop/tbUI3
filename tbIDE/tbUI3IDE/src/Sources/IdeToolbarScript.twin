        js = js & "            const style=w.getComputedStyle(text),box=w.getComputedStyle(button),limits=w.getComputedStyle(shell);"
        js = js & vbLf
        js = js & "            const min=parseFloat(limits.getPropertyValue('--tbui3-large-button-width'))||50,max=parseFloat(limits.getPropertyValue('--tbui3-large-butt"
        js = js & "on-max-width'))||86;"
        js = js & vbLf
        js = js & "            const font=['fontFamily','fontSize','fontWeight','fontStyle','fontStretch','letterSpacing','wordSpacing','textTransform'];"
        js = js & vbLf
        js = js & "            const key=JSON.stringify([text.textContent,min,max,...font.map(p=>style[p]),box.paddingLeft,box.paddingRight,box.borderLeftWidth,box.borde"
        js = js & "rRightWidth]);"
        js = js & vbLf
        js = js & "            let width=labelWidths.get(key);"
        js = js & vbLf
        js = js & "            if(width===undefined){"
        js = js & vbLf
        js = js & "                if(!probe){probe=el('span','');probe.style.cssText='position:fixed;visibility:hidden;white-space:pre;pointer-events:none;';probe.setAt"
        js = js & "tribute('aria-hidden','true');d.body.append(probe);}"
        js = js & vbLf
        js = js & "                for(const p of font)probe.style[p]=style[p];"
        js = js & vbLf
        js = js & "                const measure=s=>{probe.textContent=s;return probe.getBoundingClientRect().width;},words=text.textContent.trim().split(/\s+/);"
        js = js & vbLf
        js = js & "                let best=measure(words.join(' '));"
        js = js & vbLf
        js = js & "                if(!best)continue; // Layout-free DOM tests retain CSS sizing."
        js = js & vbLf
        js = js & "                for(let i=1;i<words.length;i++)best=Math.min(best,Math.max(measure(words.slice(0,i).join(' ')),measure(words.slice(i).join(' '))));"
        js = js & vbLf
        js = js & "                const edges=['paddingLeft','paddingRight','borderLeftWidth','borderRightWidth'].reduce((sum,p)=>sum+(parseFloat(box[p])||0),0);"
        js = js & vbLf
        js = js & "                width=Math.min(max,Math.max(min,Math.ceil(best+edges)));labelWidths.set(key,width);"
        js = js & vbLf
        js = js & "            }"
        js = js & vbLf
        js = js & "            button.style.width=width+'px';"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        probe?.remove();"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    const itemKey=i=>[caption(i),i.action&&String(i.action),i.codicon,i.iconClass,i.class,i.comboValue,i._sourceId,i._ribbonIconSource,i._ribbonLarge,"
        js = js & "checked(i),menuEnabled(i),i._ribbonChildren?.map(itemKey)];"
        js = js & vbLf
        js = js & "    const own=n=>!!(n&&n.closest&&n.closest('.tbui3-toolbar-owned'));"
        js = js & vbLf
        js = js & "    const el=(tag,cls,text)=>{const n=d.createElement(tag);if(cls)n.className=cls;if(text)n.textContent=text;return n;};"
        js = js & vbLf
        js = js & "    const clear=n=>{while(n.firstChild)n.firstChild.remove();};"

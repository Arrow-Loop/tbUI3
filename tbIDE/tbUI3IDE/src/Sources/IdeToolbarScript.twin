        js = js & vbLf
        js = js & "    function renderLayoutTab() {"
        js = js & vbLf
        js = js & "        // Menu-state polling must not tear native inputs out from under an edit."
        js = js & vbLf
        js = js & "        // Selection/mode/tab changes close the flyout through their normal paths."

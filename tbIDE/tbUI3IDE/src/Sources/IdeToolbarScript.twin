        js = js & "        debugStepOverIcon:'Step over',debugStepIntoIcon:'Step into',debugStepOutIcon:'Step out',"
        js = js & vbLf
        js = js & "        restartIcon:'Restart compiler',trashIcon:'Clean',buildIcon:'Build',menuBarColorMode:'Theme',"
        js = js & vbLf
        js = js & "        buildConfigSelector:'Configuration',zoomSelect:'Zoom',menuBarPreview:'Preview',"
        js = js & vbLf
        js = js & "        commentIcon:'Comment',uncommentIcon:'Uncomment',indentIcon:'Indent',unindentIcon:'Outdent',"
        js = js & vbLf
        js = js & "        menuBarAlignLeft:'Align left',menuBarAlignTop:'Align top',menuBarAlignRight:'Align right',menuBarAlignBottom:'Align bottom',"
        js = js & vbLf
        js = js & "        menuBarSizeWidest:'Widest',menuBarSizeTallest:'Tallest',menuBarSizeNarrowest:'Narrowest',menuBarSizeShortest:'Shortest',"
        js = js & vbLf
        js = js & "        menuBarGrid:'Show grid',menuBarBringToFront:'Bring to front',menuBarSendToBack:'Send to back'};"
        js = js & vbLf
        js = js & "    const sourceCaption=n=>sourceLabels[n.id]||label(n).replace(/\s*\([^)]*\)\s*$/,'');"
        js = js & vbLf
        js = js & "    const pageIds=['tbUI3TabNew','tbUI3TabDelete','tbUI3TabLeft','tbUI3TabRight','tbUI3TabRefresh','tbUI3TabDiagnostics'];"
        js = js & vbLf
        js = js & "    const pageSource=n=>pageIds.some(id=>n.id==='addinButton-'+id);"
        js = js & vbLf
        js = js & "    function currentHost() {"
        js = js & vbLf
        js = js & "        const g=api.formGlobals&&api.formGlobals();"
        js = js & vbLf
        js = js & "        if(!g||!g.selectedControls)return null;"
        js = js & vbLf
        js = js & "        for(let n of g.selectedControls)for(;n&&n!==g.designer;n=n.parentElement)"
        js = js & vbLf
        js = js & "            if(n.properties&&/^(tbUI3\.)?UI3TabView$/i.test(n.properties._className||''))return n;"
        js = js & vbLf
        js = js & "        return null;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function discover() {"
        js = js & vbLf
        js = js & "        const toolbar=d.getElementById('rootMenu2'), headers=d.getElementById('rootMenu1Inner');"
        js = js & vbLf
        js = js & "        if(!toolbar||!headers)throw Error('Native toolbar/menu structure is unavailable');"
        js = js & vbLf
        js = js & "        for(const n of [...toolbar.children])if(!n.classList.contains('toolbarSplitter')&&"
        js = js & vbLf
        js = js & "            (n.id||n.matches('select,button,.icon'))&&!/^testArea/.test(n.id))sources.set(n.id||n,n);"
        js = js & vbLf
        js = js & "        for(const [id,n] of sources)if(!n.isConnected)sources.delete(id);"
        js = js & vbLf
        js = js & "        const found=new Set();"
        js = js & vbLf
        js = js & "        for(const n of [...headers.children])if(n.classList.contains('menuItem')&&"
        js = js & vbLf
        js = js & "            (n.onmousedown||n.onclick)&&!/^rootMenu(?:Admin|DevTools)$/.test(n.id)&&visible(n)) {"
        js = js & vbLf
        js = js & "            const id=n.id||n;found.add(id);const m=menus.get(id)||{node:n,items:[]};"
        js = js & vbLf
        js = js & "            m.node=n;m.title=label(n);menus.set(id,m);"
        js = js & vbLf
        js = js & "            n.classList.toggle('tbui3-menu-source',state.mode==='Ribbon');"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        for(const [id,m] of menus)if(!found.has(id)){m.node.classList.remove('tbui3-menu-source');menus.delete(id);}"
        js = js & vbLf
        js = js & "        if(state.mode!=='Classic')syncNativeToolbarVisibility(toolbar);"
        js = js & vbLf
        js = js & "        return toolbar;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function syncNativeToolbarVisibility(toolbar) {"
        js = js & vbLf
        js = js & "        const wanted=new Set([toolbar]),header=toolbar.parentElement;"
        js = js & vbLf
        js = js & "        if(header&&header.panelId==='TOOLBAR'){"
        js = js & vbLf
        js = js & "            wanted.add(header);if(header.sectionRoot)wanted.add(header.sectionRoot);"
        js = js & vbLf
        js = js & "            // BETA 1044 leaves a 30px minimum-height dock slot after its header/body are hidden."
        js = js & vbLf
        js = js & "            // Collapse only the nearest slot whose panel headers all belong to this toolbar."
        js = js & vbLf
        js = js & "            const slot=header.closest('.dockElementContainer, .floatingPanel');"
        js = js & vbLf
        js = js & "            const headers=slot&&[...slot.querySelectorAll('.sectionHeader')];"
        js = js & vbLf
        js = js & "            if(headers&&headers.length===1&&headers[0]===header)wanted.add(slot);"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        let changed=false;"
        js = js & vbLf
        js = js & "        for(const n of hiddenNative)if(!wanted.has(n)){n.classList.remove('tbui3-toolbar-native-hidden');hiddenNative.delete(n);changed=true;}"
        js = js & vbLf
        js = js & "        for(const n of wanted)if(!hiddenNative.has(n)){n.classList.add('tbui3-toolbar-native-hidden');hiddenNative.add(n);changed=true;}"
        js = js & vbLf
        js = js & "        if(changed)resize();"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function group(name,parent=content) {"
        js = js & vbLf
        js = js & "        const n=el('section','tbui3-ribbon-group'),body=el('div','tbui3-ribbon-group-body');"
        js = js & vbLf
        js = js & "        n.setAttribute('aria-label',name);n.append(body,el('div','tbui3-ribbon-group-title',name));parent.append(n);return body;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function iconFor(n,descriptor={}) {"
        js = js & vbLf
        js = js & "        let src=n;"
        js = js & vbLf
        js = js & "        if(!src&&typeof descriptor.action==='string')"
        js = js & vbLf
        js = js & "            src=[...sources.values()].find(x=>[].concat(x.boundCommand||[]).includes(descriptor.action));"
        js = js & vbLf
        js = js & "        const i=el('span','tbui3-ribbon-icon');i.setAttribute('aria-hidden','true');"
        js = js & vbLf
        js = js & "        const mask=uri=>{i.classList.add('tbui3-ribbon-mask');i.style.setProperty('--tbui3-icon',uri);return i;};"
        js = js & vbLf
        js = js & "        if(src&&api.icons[src.id])return mask(api.icons[src.id]);"
        js = js & vbLf
        js = js & "        if(src){"
        js = js & vbLf
        js = js & "            const cs=w.getComputedStyle(src);let image=cs.backgroundImage;"
        js = js & vbLf
        js = js & "            if(!image||image==='none')image=w.getComputedStyle(src,'::before').backgroundImage;"
        js = js & vbLf
        js = js & "            if(image&&image!=='none'){i.style.setProperty('--tbui3-native-image',image);return i;}"
        js = js & vbLf
        js = js & "            const c=src.matches('.codicon')?src:src.querySelector('.codicon');"
        js = js & vbLf
        js = js & "            if(c){i.className+=' '+[...c.classList].filter(x=>x==='codicon'||x.startsWith('codicon-')||x==='flipX'||x==='rotate90').join(' ');return i"
        js = js & ";}"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(descriptor.codicon){i.className+=' codicon codicon-'+descriptor.codicon;return i;}"
        js = js & vbLf
        js = js & "        const glyph=api.present?api.present(descriptor,src&&src.id).glyph:'apps_list';"
        js = js & vbLf
        js = js & "        return mask(api.icons[glyph]||api.icons.apps_list||api.icons.saveIcon);"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function invokeSource(n,event) {"
        js = js & vbLf
        js = js & "        if(disabled(n))return;"
        js = js & vbLf
        js = js & "        const init={bubbles:true,cancelable:true,button:0,ctrlKey:event.ctrlKey,shiftKey:event.shiftKey,altKey:event.altKey,metaKey:event.metaKey};"
        js = js & vbLf
        js = js & "        // Natural mouse sequence covers both native mousedown commands and add-in click handlers."
        js = js & vbLf
        js = js & "        for(const type of ['mousedown','mouseup','click'])n.dispatchEvent(new w.MouseEvent(type,init));"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function sourceButton(n,parent,compact=false,large=!!api.present?.({},n.id).large) {"
        js = js & vbLf
        js = js & "        const b=el('button','tbui3-ribbon-command'+(compact?' tbui3-ribbon-compact':large?' tbui3-ribbon-large':''));b.type='button';"
        js = js & vbLf
        js = js & "        b.dataset.source=typeof n.id==='string'?n.id:'';b.title=label(n);b.setAttribute('aria-label',label(n));"
        js = js & vbLf
        js = js & "        b.append(iconFor(n,{name:sourceCaption(n)}),el('span','tbui3-ribbon-label',sourceCaption(n)));"
        js = js & vbLf
        js = js & "        b.addEventListener('mousedown',e=>e.preventDefault());"
        js = js & vbLf
        js = js & "        b.onclick=e=>{invokeSource(n,e);tick();};parent.append(b);bindings.set(b,{source:n});return b;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function park(n,parent) {"
        js = js & vbLf
        js = js & "        if(!placements.has(n)){const marker=d.createComment('tbUI3IDE restore '+n.id);n.before(marker);placements.set(n,marker);}"
        js = js & vbLf
        js = js & "        parent.append(n);"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function returnNodes() {for(const [n,marker]of placements){if(marker.isConnected)marker.replaceWith(n);}placements.clear();}"
        js = js & vbLf
        js = js & "    function addSources(ids,parent) {"
        js = js & vbLf
        js = js & "        for(const id of ids){const n=sources.get(id);if(!n)continue;"
        js = js & vbLf
        js = js & "            if(n.matches('select')){const l=el('label','tbui3-ribbon-selector',sourceCaption(n));l.title=label(n);park(n,l);parent.append(l);}"
        js = js & vbLf
        js = js & "            else sourceButton(n,parent,false,!!api.present?.({},id).large);"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function addGrid() {"
        js = js & vbLf
        js = js & "        const n=d.getElementById('menuBarGridOptions');if(!n)return;"
        js = js & vbLf
        js = js & "        const body=n.querySelector('.menuBarGridOptionsInner');if(body){const box=el('fieldset','tbui3-ribbon-grid');"
        js = js & vbLf
        js = js & "            box.disabled=!(api.formGlobals&&api.formGlobals());park(body,box);group('Grid options').append(box);}"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function pages(parent=content) {const body=group('MultiPage',parent);for(const n of sources.values())if(pageSource(n))sourceButton(n,body);}"
        js = js & vbLf
        js = js & "    function addins(parent=content,includeUnknown=false) {"
        js = js & vbLf
        js = js & "        const used=new Set(Object.values(known).flatMap(gs=>gs.flatMap(g=>g[1])));"
        js = js & vbLf
        js = js & "        const entries=[...sources.values()].filter(n=>!pageSource(n)&&n.id.startsWith('addinButton-'));"
        js = js & vbLf
        js = js & "        if(entries.length){const body=group('Add-ins',parent);for(const n of entries)sourceButton(n,body);}"
        js = js & vbLf
        js = js & "        if(includeUnknown){const extra=[...sources.values()].filter(n=>!n.id.startsWith('addinButton-')&&!used.has(n.id));"
        js = js & vbLf
        js = js & "            if(extra.length){const body=group('Additional commands',parent);for(const n of extra)sourceButton(n,body);}}"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function menuEnabled(item) {"
        js = js & vbLf
        js = js & "        if(item.isHidden)return false;"
        js = js & vbLf
        js = js & "        try{"
        js = js & vbLf
        js = js & "            if(item.context&&!api.testContext(item.context))return false;"
        js = js & vbLf
        js = js & "            if(typeof item.action==='string'&&!api.commandEnabled(item.action))return false;"
        js = js & vbLf
        js = js & "        }catch(e){return false;}"
        js = js & vbLf
        js = js & "        return true;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function menuItems(items) {"
        js = js & vbLf
        js = js & "        const result=[];"
        js = js & vbLf
        js = js & "        for(const entry of items||[]){"
        js = js & vbLf
        js = js & "            if(!Array.isArray(entry)){if(entry)result.push(entry);continue;}"
        js = js & vbLf
        js = js & "            // Match the native context-dependent alternatives, including superHiddenContext."
        js = js & vbLf
        js = js & "            for(const item of entry){if(!item)continue;if(!menuEnabled(item)&&item.superHiddenContext)continue;result.push(item);break;}"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        return result;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function command(item,parent) {"
        js = js & vbLf
        js = js & "        if(item._sourceId){const n=sources.get(item._sourceId);if(n){if(n.matches('select'))addSources([item._sourceId],parent);else sourceButton(n,pa"
        js = js & "rent,false,item._ribbonLarge);}return;}"
        js = js & vbLf
        js = js & "        if(!item.name){parent.append(el('div','tbui3-ribbon-separator'));return;}"
        js = js & vbLf
        js = js & "        if(!menuEnabled(item)&&item.superHiddenContext)return;"
        js = js & vbLf
        js = js & "        const b=el('button','tbui3-ribbon-command'+(item._ribbonLarge?' tbui3-ribbon-large':''));b.type='button';"
        js = js & vbLf
        js = js & "        const title=caption(item);"
        js = js & vbLf
        js = js & "        b.title=title+(typeof item.action==='string'?' '+api.shortcut(item.action):'');"
        js = js & vbLf
        js = js & "        const shown=/^[^a-z]*[A-Z][^a-z]*$/.test(title)?title.charAt(0)+title.slice(1).toLowerCase():title;"
        js = js & vbLf
        js = js & "        b.append(iconFor(sources.get(item._ribbonIconSource),item),el('span','tbui3-ribbon-label',shown));"
        js = js & vbLf
        js = js & "        b.addEventListener('mousedown',e=>e.preventDefault());"
        js = js & vbLf
        js = js & "        bindings.set(b,{item});parent.append(b);"
        js = js & vbLf
        js = js & "        if(item.comboOptions){"
        js = js & vbLf
        js = js & "            const select=el('select','tbui3-ribbon-select');select.setAttribute('aria-label',title);"
        js = js & vbLf
        js = js & "            for(const value of item.comboOptions){const o=el('option','',value);o.value=value;o.selected=value===item.comboValue;select.append(o);}"
        js = js & vbLf
        js = js & "            select.onchange=()=>{if(menuEnabled(item)&&item.onchange)item.onchange(select.value);};"
        js = js & vbLf
        js = js & "            b.replaceWith(select);bindings.delete(b);bindings.set(select,{item});return;"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(item.hoverAction||item._ribbonChildren){b.setAttribute('aria-haspopup','menu');b.setAttribute('aria-expanded','false');b.classList.add('tbu"
        js = js & "i3-ribbon-dropdown');const chevron=iconFor(null,{_ribbonGlyph:'chevron_down'});chevron.classList.add('tbui3-ribbon-chevron');b.append(chevron);}"
        js = js & vbLf
        js = js & "        b.onclick=()=>{"
        js = js & vbLf
        js = js & "            if(!menuEnabled(item))return;"
        js = js & vbLf
        js = js & "            if(item.action){"
        js = js & vbLf
        js = js & "                closeFile(false);closePopup();"
        js = js & vbLf
        js = js & "                if(typeof item.action==='string')api.execute(item.action);else item.action(item);"
        js = js & vbLf
        js = js & "                tick();"
        js = js & vbLf
        js = js & "            }else if(item.hoverAction||item._ribbonChildren)openSubmenu(item,b);"
        js = js & vbLf
        js = js & "        };"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function openSubmenu(item,anchor) {"
        js = js & vbLf
        js = js & "        closePopup();popupAnchor=anchor;anchor.setAttribute('aria-expanded','true');popup=el('div','tbui3-toolbar-owned tbui3-ribbon-popup');popup.set"
        js = js & "Attribute('role','menu');"
        js = js & vbLf
        js = js & "        const bounds=anchor.getBoundingClientRect();popup.style.setProperty('--tbui3-popup-x',Math.min(bounds.left,w.innerWidth-280)+'px');"
        js = js & vbLf
        js = js & "        popup.style.setProperty('--tbui3-popup-y',Math.min(bounds.bottom,w.innerHeight-200)+'px');d.body.append(popup);"
        js = js & vbLf
        js = js & "        // Top-layer promotion escapes the IDE designer's million-level controls"
        js = js & vbLf
        js = js & "        // and 99,999,999 grabbers without hiding or reparenting the designer."
        js = js & vbLf
        js = js & "        if(typeof popup.showPopover==='function'){"
        js = js & vbLf
        js = js & "            popup.setAttribute('popover','manual');"
        js = js & vbLf
        js = js & "            try{popup.showPopover();popup.dataset.popupLayer='top';}"
        js = js & vbLf
        js = js & "            catch(e){popup.removeAttribute('popover');popup.dataset.popupLayer='fallback';}"
        js = js & vbLf
        js = js & "        }else popup.dataset.popupLayer='fallback';"
        js = js & vbLf
        js = js & "        const sink=items=>{if(!popup)return;clear(popup);for(const child of menuItems(items))command(child,popup);syncBindings();popup.querySelector('"
        js = js & "button,select')?.focus();};"
        js = js & vbLf
        js = js & "        if(item._ribbonChildren){sink(item._ribbonChildren);return;}"
        js = js & vbLf
        js = js & "        captureSink=sink;pendingSubmenu={sink,until:Date.now()+5000};"
        js = js & vbLf
        js = js & "        try{item.hoverAction(anchor);}finally{captureSink=null;}"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function closePopup(){pendingSubmenu=null;if(popup){for(const n of popup.querySelectorAll('button,select'))bindings.delete(n);if(popup.dataset.pop"
        js = js & "upLayer==='top'&&typeof popup.hidePopover==='function'){try{popup.hidePopover();}catch(e){}}popup.remove();popup=null;}if(popupAnchor?.isConnected)pop"
        js = js & "upAnchor.setAttribute('aria-expanded','false');popupAnchor=null;}"
        js = js & vbLf
        js = js & "    function requestMenu(m) {"
        js = js & vbLf
        js = js & "        const sink=items=>{m.items=items||[];m.loading=false;m.ready=true;if(state.mode!=='Ribbon'||hydrating)return;"
        js = js & vbLf
        js = js & "            refreshLayout();"
        js = js & vbLf
        js = js & "        };"
        js = js & vbLf
        js = js & "        if(m.loading)return;m.loading=true;"
        js = js & vbLf
        js = js & "        pendingMenus.set(m.node.id,sink);captureSink=sink;"
        js = js & vbLf
        js = js & "        try{"
        js = js & vbLf
        js = js & "            if(m.node.onmousedown)m.node.onmousedown({button:0,preventDefault(){},stopPropagation(){}});"
        js = js & vbLf
        js = js & "            else if(m.node.onclick)m.node.onclick({button:0,preventDefault(){},stopPropagation(){}});"
        js = js & vbLf
        js = js & "        }catch(e){m.loading=false;throw e;}finally{captureSink=null;}"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function collectLayout() {"
        js = js & vbLf
        js = js & "        const records=[];"
        js = js & vbLf
        js = js & "        for(const m of menus.values())for(const item of menuItems(m.items))records.push({menuId:m.node.id,menuTitle:m.title,item});"
        js = js & vbLf
        js = js & "        const source=(id,tab,group)=>{if(sources.has(id))records.push({item:{name:sourceCaption(sources.get(id)),_sourceId:id,_ribbonTab:tab,_ribbonGr"
        js = js & "oup:group}});};"
        js = js & vbLf
        js = js & "        for(const id of ['commentIcon','uncommentIcon'])source(id,'Code','Comments');"
        js = js & vbLf
        js = js & "        source('buildConfigSelector','Project','Build');source('debugStepOutIcon','Debug','Stepping');"
        js = js & vbLf
        js = js & "        source('zoomSelect','View','Zoom');source('menuBarPreview','Form','Designer');"
        js = js & vbLf
        js = js & "        if(!records.some(r=>String(r.item.name).includes('MenuCaptionWindowTheme')))source('menuBarColorMode','View','Appearance');"
        js = js & vbLf
        js = js & "        const quickActions=new Set();for(const id of quickIds)for(const a of [].concat(sources.get(id)?.boundCommand||[]))quickActions.add(a);"
        js = js & vbLf
        js = js & "        return api.buildLayout(records,quickActions,api.present);"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function hydrateMenus(refresh=false) {"
        js = js & vbLf
        js = js & "        hydrating=true;try{for(const m of menus.values())if(!m.ready||refresh&&(m.node.id!=='rootMenuAddins'||backstage&&!backstage.hidden&&fileSectio"
        js = js & "n==='Add-ins'))requestMenu(m);}finally{hydrating=false;}"
        js = js & vbLf
        js = js & "        refreshLayout();"

        js = js & vbLf
        js = js & "                if(!collectingLayout&&!hydrating)refreshLayout();"
        js = js & vbLf
        js = js & "            },kind);"
        js = js & vbLf
        js = js & "            if(!accepted){entry.loading=false;entry.failed=true;}"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(!entry.ready)return null;"
        js = js & vbLf
        js = js & "        return menuItems(entry.items).filter(i=>i.name).map(child=>({...child,"
        js = js & vbLf
        js = js & "            isHidden:!!(item.isHidden||child.isHidden),"
        js = js & vbLf
        js = js & "            context:item.context&&child.context?'('+item.context+') && ('+child.context+')':child.context||item.context}));"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function collectLayout() {"
        js = js & vbLf
        js = js & "        const records=[];collectingLayout=true;"
        js = js & vbLf
        js = js & "        try{for(const m of menus.values())for(const item of menuItems(m.items)){"
        js = js & vbLf
        js = js & "            const name=String(item.name||''),kind=m.node.id==='rootMenuProject'&&name.includes('MenuCaptionProjectAdd')?'Insert':"
        js = js & vbLf
        js = js & "                m.node.id==='rootMenuFormat'&&/MenuCaptionFormat(?:Align|MakeSameSize)/.test(name)?'Form':null;"
        js = js & vbLf
        js = js & "            const expanded=kind&&expandedItems(m,item,kind);"
        js = js & vbLf
        js = js & "            if(expanded){for(const child of expanded){"
        js = js & vbLf
        js = js & "                if(kind==='Insert'){const a=typeof child.action==='string'?child.action:'';"
        js = js & vbLf

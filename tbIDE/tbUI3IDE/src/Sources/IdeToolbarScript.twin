        js = js & "            popup.setAttribute('popover','auto');"
        js = js & vbLf
        js = js & "            try{popup.showPopover();popup.dataset.popupLayer='top';}"
        js = js & vbLf
        js = js & "            catch(e){popup.removeAttribute('popover');popup.dataset.popupLayer='fallback';}"
        js = js & vbLf
        js = js & "        }else popup.dataset.popupLayer='fallback';"
        js = js & vbLf
        js = js & "        const sink=items=>{if(popup!==surface)return;clear(popup);for(const child of menuItems(items))command(child,popup);syncBindings();popup.queryS"
        js = js & "elector('button,select')?.focus();};"
        js = js & vbLf
        js = js & "        if(item._ribbonChildren){sink(item._ribbonChildren);return;}"

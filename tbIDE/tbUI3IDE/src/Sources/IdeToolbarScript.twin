        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        for(const [id,m] of menus)if(!found.has(id)){m.node.classList.remove('tbui3-menu-source');menus.delete(id);}"
        js = js & vbLf
        js = js & "        if(state.mode!=='Classic')syncNativeToolbarVisibility(toolbar);"

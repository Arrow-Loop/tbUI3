        js = js & vbLf
        js = js & "    function syncFileUnderlays() {"
        js = js & vbLf
        js = js & "        const nodes=[shell,d.getElementById('rootTop'),d.getElementById('rootBottom'),d.getElementById('codePanel'),...d.querySelectorAll('.floatingPa"
        js = js & "nel')];"

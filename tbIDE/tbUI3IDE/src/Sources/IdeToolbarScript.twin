        js = js & "        return {rootMenuEdit:'Home',rootMenuFormat:'Form',rootMenuView:'View',rootMenuWindows:'View',rootMenuProject:'Project',rootMenuRun:'Debug',roo"
        js = js & "tMenuDebug:'Debug',rootMenuTools:'Project',rootMenuHelp:'File'}[m.node.id]||m.title;"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function clearContent(){returnNodes();for(const [n]of bindings)if(content.contains(n))bindings.delete(n);clear(content);}"
        js = js & vbLf
        js = js & "    function makeTab(key,title,action) {"
        js = js & vbLf

        js = js & vbLf
        js = js & "        const back=el('button','tbui3-backstage-back');const circle=el('span','tbui3-backstage-back-circle');circle.setAttribute('aria-hidden','true')"
        js = js & ";circle.append(iconFor(null,{_ribbonGlyph:'arrow_left'}));back.append(circle);back.title='Back to project';back.setAttribute('aria-label','Back to pro"
        js = js & "ject');back.onclick=()=>closeFile();fileNav.append(back);"
        js = js & vbLf
        js = js & "        const main=el('div','tbui3-backstage-nav-group'),footer=el('div','tbui3-backstage-nav-group tbui3-backstage-footer');fileNav.append(main,foote"
        js = js & "r);"
        js = js & vbLf
        js = js & "        const add=(title,section,parent=main,direct=false)=>{"
        js = js & vbLf
        js = js & "            const entries=layout?.file.get(section)||[],item=entries.find(menuEnabled)||entries[0];"
        js = js & vbLf
        js = js & "            if(section!=='Info'&&section!=='Add-ins'&&!entries.length)return;"
        js = js & vbLf
        js = js & "            const b=el('button','tbui3-backstage-nav');"
        js = js & vbLf
        js = js & "            const glyph={Info:'info','Add-ins':'puzzle_piece',Preferences:'settings',Options:'settings',Help:'chat_help',More:'apps_list'}[section];"
        js = js & vbLf
        js = js & "            b.append(iconFor(null,glyph?{_ribbonGlyph:glyph}:item||{}),el('span','',title));b.type='button';b.dataset.fileSection=section;"
        js = js & vbLf
        js = js & "            if(direct&&item){b.title=caption(item);bindings.set(b,{item});b.onclick=()=>activateItem(item,b);}"
        js = js & vbLf
        js = js & "            else{b.onclick=()=>{fileSection=section;renderFile();renderFileNav();};"
        js = js & vbLf
        js = js & "                if(fileSection===section){b.classList.add('tbui3-backstage-selected');b.setAttribute('aria-current','page');}}"
        js = js & vbLf
        js = js & "            parent.append(b);"
        js = js & vbLf
        js = js & "        };"
        js = js & vbLf
        js = js & "        add('Info','Info');add('New','New',main,true);add('Open','Open');add('Save','Save',main,true);add('Save document','Save document',main,true);a"
        js = js & "dd('Save as','Save as',main,true);add('Export','Export');add('Close project','Close',main,true);"

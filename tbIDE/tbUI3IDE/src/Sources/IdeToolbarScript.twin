        js = js & vbLf
        js = js & "    const caption=item=>{let text=localize(item.name).replace(/&(?=\w)/g,'');if(item.isHtmlName){const t=d.createElement('template');t.innerHTML=text;"
        js = js & "text=t.content.textContent;}return text;};"
        js = js & vbLf

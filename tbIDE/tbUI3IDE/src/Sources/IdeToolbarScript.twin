        js = js & vbLf
        js = js & "        if(old.aria===null)n.removeAttribute('aria-hidden');else n.setAttribute('aria-hidden',old.aria);"
        js = js & vbLf
        js = js & "    }fileUnderlays.clear();}"
        js = js & vbLf
        js = js & "    function activateItem(item,anchor) {"
        js = js & vbLf
        js = js & "        if(!menuEnabled(item))return;"
        js = js & vbLf
        js = js & "        if(item.action){closeFile(false);closePopup();if(typeof item.action==='string')api.execute(item.action);else item.action(item);tick();}"
        js = js & vbLf
        js = js & "        else if(item.hoverAction||item._ribbonChildren)openSubmenu(item,anchor);"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function openFile(section='Info') {"
        js = js & vbLf
        js = js & "        if(!backstage)return;closePopup();"
        js = js & vbLf
        js = js & "        if(backstage.hidden)savedFocus=d.activeElement;"
        js = js & vbLf
        js = js & "        fileSection=section==='File'?'Info':section==='Addins'?'Add-ins':section;"
        js = js & vbLf
        js = js & "        backstage.hidden=false;syncQuick();syncFileUnderlays();"
        js = js & vbLf
        js = js & "        renderFileNav();renderFile();fileNav.querySelector('button')?.focus();"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function renderFileNav() {"
        js = js & vbLf
        js = js & "        const sig=JSON.stringify([fileSection,[...(layout?.file||[])].map(([name,items])=>[name,items.map(itemKey)])]);"
        js = js & vbLf

        js = js & "f popup.querySelectorAll('button,select'))bindings.delete(n);if(popup.dataset.popupLayer==='top'&&typeof popup.hidePopover==='function'){try{popup.hid"
        js = js & "ePopover();}catch(e){}}popup.remove();popup=null;}if(popupAnchor?.isConnected)popupAnchor.setAttribute('aria-expanded','false');popupAnchor=null;}"
        js = js & vbLf

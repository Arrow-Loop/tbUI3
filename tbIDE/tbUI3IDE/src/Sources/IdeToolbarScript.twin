        js = js & "6.6944%2020.5%2020.5%2016.6944%2020.5%2012C20.5%207.30558%2016.6944%203.5%2012%203.5ZM2%2012C2%206.47715%206.47715%202%2012%202C17.5228%202%2022%206.4"
        js = js & "7715%2022%2012C22%2017.5228%2017.5228%2022%2012%2022C6.47715%2022%202%2017.5228%202%2012Z%22%20fill%3D%22%23212121%22%2F%3E%0A%3C%2Fsvg%3E')" & Chr(34) & "," & Chr(34) & "chevron"
        js = js & "_down" & Chr(34) & ":" & Chr(34) & "url('data:image/svg+xml,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%"
        js = js & "3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%0A%3Cpath%20d%3D%22M4.21967%208.46967C4.51256%208.17678%204.98744%208.17678%205.28033%208.46967L12%2015.1893L18."
        js = js & "7197%208.46967C19.0126%208.17678%2019.4874%208.17678%2019.7803%208.46967C20.0732%208.76256%2020.0732%209.23744%2019.7803%209.53033L12.5303%2016.7803C1"
        js = js & "2.2374%2017.0732%2011.7626%2017.0732%2011.4697%2016.7803L4.21967%209.53033C3.92678%209.23744%203.92678%208.76256%204.21967%208.46967Z%22%20fill%3D%22%"
        js = js & "23212121%22%2F%3E%0A%3C%2Fsvg%3E')" & Chr(34) & "},buildLayout:/* Office-style organization for the IDE's live descriptors. This is presentation"
        js = js & vbLf
        js = js & " * metadata only: all actions, contexts and lazy submenus remain native. Unknown"
        js = js & vbLf
        js = js & " * commands/menus are deliberately retained rather than filtered by this map. */"
        js = js & vbLf
        js = js & "(function buildRibbonLayout(records, quickActions=new Set(),present=()=>({large:false})) {"
        js = js & vbLf
        js = js & "    const tabs=new Map(), file=new Map(), suppressed=[];"
        js = js & vbLf
        js = js & "    tabs.set('Home',new Map());"
        js = js & vbLf
        js = js & "    const order=['Home','Insert','Code','Form','View','Project','Debug','Tools','Add-ins','Help'];"
        js = js & vbLf
        js = js & "    const groups={Home:['Clipboard','Editing'],Insert:['Components'],Code:['Comments','Formatting','Navigation','Outlining','Case'],"
        js = js & vbLf
        js = js & "        Form:['Arrange','Size','Spacing','Position','Protection','Designer'],View:['Views','Show','Zoom','Window','Appearance'],"
        js = js & vbLf
        js = js & "        Project:['Project','Build','Compiler','Folders'],Debug:['Stepping','Breakpoints','Watches','Execution','Options']};"
        js = js & vbLf
        js = js & "    const get=(map,key,make)=>{if(!map.has(key))map.set(key,make());return map.get(key);};"
        js = js & vbLf
        js = js & "    const add=(tab,group,item)=>get(get(tabs,tab,()=>new Map()),group,()=>[]).push(item);"
        js = js & vbLf
        js = js & "    const addFile=(key,item)=>get(file,key,()=>[]).push(item);"
        js = js & vbLf
        js = js & "    const token=(i,name)=>String(i.name||'').includes(name);"
        js = js & vbLf
        js = js & "    const quick=a=>quickActions.has(a)||/^tb(?:Editor|FormDesigner)_(Undo|Redo)$/.test(a)||/^tbDebug_(StartOrContinue|BreakInto|Stop)$/.test(a);"
        js = js & vbLf
        js = js & "    for(const r of records){const i=r.item,a=typeof i.action==='string'?i.action:'',m=r.menuId;"
        js = js & vbLf
        js = js & "        if(!i.name)continue;"
        js = js & vbLf
        js = js & "        if(i._ribbonTab){add(i._ribbonTab,i._ribbonGroup,i);continue;}"
        js = js & vbLf
        js = js & "        if(m==='rootMenuFile'){"
        js = js & vbLf
        js = js & "            const section={tbProject_New:'New',tbProject_Open:'Open',tbProject_OpenRecent:'Open',tbProject_Close:'Close',"
        js = js & vbLf
        js = js & "                tbProject_SaveAllChanges:'Save',tbProject_SaveAs:'Save as',tbProject_Export:'Export',tbEditor_Save:'Save document',tbIdeWindow_Close:'"
        js = js & "Exit'}[a];"
        js = js & vbLf
        js = js & "            if(section){addFile(section,i);continue;}"
        js = js & vbLf
        js = js & "            if(a==='tbBuild_Start'||a==='tbBuild_Clean'){add('Project','Build',i);continue;}"
        js = js & vbLf
        js = js & "            addFile('More',i);continue;"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(m==='rootMenuAddins'){addFile('Add-ins',i);continue;}"
        js = js & vbLf
        js = js & "        if(m==='rootMenuHelp'){addFile('Help',i);continue;}"
        js = js & vbLf
        js = js & "        if(a==='tbIde_ShowIDEOptions'){addFile('Options',i);continue;}"
        js = js & vbLf
        js = js & "        if(token(i,'MenuCaptionWindowLanguage')||token(i,'MenuCaptionWindowKeyboardShortcuts')){addFile('Preferences',i);continue;}"
        js = js & vbLf
        js = js & "        if(quick(a)){suppressed.push(i);continue;}"
        js = js & vbLf
        js = js & "        if(/_Clipboard(?:Cut|Copy|Paste|PasteAsComment)$/.test(a)){add('Home','Clipboard',i);continue;}"
        js = js & vbLf
        js = js & "        if(/_SelectAll(?:Controls|Matches)?$|_Delete(?:Right|SelectedControls)$|_Find(?:Replace)?$/.test(a)||"
        js = js & vbLf
        js = js & "            a==='tbProject_FindInFiles'||/^tbFindWidget_Show(?:Find|Replace)$/.test(a)||a==='tbEditor_FindWidget_SelectAllMatches'){"
        js = js & vbLf
        js = js & "            add('Home','Editing',i);continue;"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(/^tbEditor_(IndentLine|OutdentLine|FormatSelection|FormatDocument)$/.test(a)){add('Code','Formatting',i);continue;}"
        js = js & vbLf
        js = js & "        if(/^tbEditor_(GoToDefinition|LastPosition|GotoLineColumn)$/.test(a)){add('Code','Navigation',i);continue;}"
        js = js & vbLf
        js = js & "        if(/^tbEditor_(?:Unfold|Fold)/.test(a)){add('Code','Outlining',i);continue;}"
        js = js & vbLf
        js = js & "        if(/^tbEditor_TransformTo/.test(a)){add('Code','Case',i);continue;}"
        js = js & vbLf
        js = js & "        if(/^tbEditor_(SwitchToCode|SwitchToFormDesign)$/.test(a)||a==='tbShowObjectBrowser'){add('View','Views',i);continue;}"
        js = js & vbLf
        js = js & "        if(/_ShowPanel$/.test(a)||m==='rootMenuView'&&typeof i.action==='function'){add('View','Show',i);continue;}"
        js = js & vbLf
        js = js & "        if(/^tb(?:Editor_(?:Increase|Decrease)FontSize|FormDesigner_Zoom)/.test(a)){add('View','Zoom',i);continue;}"
        js = js & vbLf
        js = js & "        if(m==='rootMenuFormat'){"
        js = js & vbLf
        js = js & "            const g=token(i,'MakeSameSize')?'Size':token(i,'Spacing')?'Spacing':"
        js = js & vbLf
        js = js & "                token(i,'LockControls')?'Protection':/CenterInContainer|BringToFront|SendToBack/.test(i.name)?'Position':'Arrange';"
        js = js & vbLf
        js = js & "            const icon=token(i,'MakeSameSize')?'menuBarSizeWidest':token(i,'FormatAlign')?'menuBarAlignLeft':undefined;"
        js = js & vbLf
        js = js & "            add('Form',g,icon?{...i,_ribbonIconSource:icon}:i);continue;"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(m==='rootMenuProject'){"
        js = js & vbLf
        js = js & "            if(token(i,'MenuCaptionProjectAdd'))add('Insert','Components',i);"
        js = js & vbLf
        js = js & "            else {add('Project',/_Open(?:Project|Build)Folder$/.test(a)?'Folders':'Project',i);"
        js = js & vbLf
        js = js & "                if(a==='tbProject_ShowSettings'||a==='tbProject_ShowReferences')addFile('Info',i);}"
        js = js & vbLf
        js = js & "            continue;"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(/^tbCompiler_/.test(a)){add('Project','Compiler',i);continue;}"
        js = js & vbLf
        js = js & "        if(m==='rootMenuDebug'||m==='rootMenuRun'){"
        js = js & vbLf
        js = js & "            add('Debug',/Step/.test(a)?'Stepping':/Breakpoint/.test(a)?'Breakpoints':/^tbWatches_/.test(a)?'Watches':i.hoverAction?'Options':'Executio"
        js = js & "n',i);continue;"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(m==='rootMenuWindows'){"
        js = js & vbLf
        js = js & "            add('View',token(i,'WindowTheme')?'Appearance':'Window',token(i,'WindowTheme')?{...i,_ribbonIconSource:'menuBarColorMode'}:i);continue;"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        const fallback={rootMenuEdit:['Home','More editing'],rootMenuView:['View','More views'],rootMenuTools:['Tools','Tools']}[m];"
        js = js & vbLf
        js = js & "        add(...(fallback||[r.menuTitle||m,'Commands']),i);"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    const action=i=>typeof i.action==='string'?i.action:'';"
        js = js & vbLf
        js = js & "    const dropdown=(name,items,icon)=>({name,codicon:icon||items.find(i=>i.codicon)?.codicon,_ribbonChildren:items});"
        js = js & vbLf
        js = js & "    for(const [tab,gs]of tabs)for(const [name,items]of gs){"
        js = js & vbLf
        js = js & "        if(tab==='Home'&&name==='Clipboard')items.sort((a,b)=>{"
        js = js & vbLf
        js = js & "            const rank=i=>/_ClipboardPaste$/.test(action(i))?0:/_ClipboardCut$/.test(action(i))?1:/_ClipboardCopy$/.test(action(i))?2:3;"
        js = js & vbLf
        js = js & "            return rank(a)-rank(b);});"
        js = js & vbLf
        js = js & "        if(tab==='Home'&&name==='Editing'){"
        js = js & vbLf
        js = js & "            const advanced=items.filter(i=>/^tbFindWidget_|FindWidget_/.test(action(i)));"
        js = js & vbLf
        js = js & "            const primary=items.filter(i=>!advanced.includes(i));"
        js = js & vbLf
        js = js & "            primary.sort((a,b)=>(/_Find$/.test(action(a))?0:1)-(/_Find$/.test(action(b))?0:1));"
        js = js & vbLf
        js = js & "            if(advanced.length)primary.push(dropdown('Find options',advanced,'search'));gs.set(name,primary);"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(tab==='Code'&&name==='Outlining'){"
        js = js & vbLf
        js = js & "            const folds=items.filter(i=>/^tbEditor_Fold/.test(action(i))),unfolds=items.filter(i=>/^tbEditor_Unfold/.test(action(i)));"
        js = js & vbLf
        js = js & "            gs.set(name,[...(folds.length?[dropdown('Fold',folds)]:[]),...(unfolds.length?[dropdown('Unfold',unfolds)]:[])]);"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "        if(tab==='Code'&&name==='Case')gs.set(name,[dropdown('Change case',items)]);"
        js = js & vbLf
        js = js & "        if(tab==='View'&&name==='Show'){"
        js = js & vbLf
        js = js & "            const common=new Set(['tbProjectExplorer_ShowPanel','tbToolbox_ShowPanel','tbProperties_ShowPanel']);"
        js = js & vbLf
        js = js & "            const more=items.filter(i=>!common.has(action(i))),primary=items.filter(i=>common.has(action(i)));"
        js = js & vbLf
        js = js & "            gs.set(name,[...(more.length?[dropdown('More panels',more,'browser')]:[]),...primary]);"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    const result=[...tabs].map(([id,gs])=>({id,title:id,groups:[...gs].map(([title,items])=>({title,items}))}));"
        js = js & vbLf
        js = js & "    for(const tab of result){const preferred=groups[tab.id]||[];tab.groups.sort((a,b)=>{"
        js = js & vbLf
        js = js & "        const rank=g=>preferred.includes(g.title)?preferred.indexOf(g.title):preferred.length;return rank(a)-rank(b);"
        js = js & vbLf
        js = js & "    });}"
        js = js & vbLf
        js = js & "    for(const tab of result)for(const group of tab.groups)group.items=group.items.map(item=>"
        js = js & vbLf
        js = js & "        ({...item,_ribbonLarge:present(item).large}));"
        js = js & vbLf
        js = js & "    result.sort((a,b)=>{const rank=x=>order.includes(x)?order.indexOf(x):order.indexOf('Add-ins')-.5;return rank(a.id)-rank(b.id);});"
        js = js & vbLf
        js = js & "    return {tabs:result,file,suppressed};"
        js = js & vbLf
        js = js & "}),present:/* Command-specific presentation derived from Shane's Office Home/View/Developer/"
        js = js & vbLf
        js = js & " * Page Layout references. No group-position rule decides a command's size."
        js = js & vbLf
        js = js & " * This is IDE presentation metadata, not command execution or an availability list. */"
        js = js & vbLf
        js = js & "(function ribbonPresentation(item={},sourceId='') {"
        js = js & vbLf
        js = js & "    const a=typeof item.action==='string'?item.action:'',n=String(item.name||'');"
        js = js & vbLf
        js = js & "    const has=s=>n.includes(s),source=sourceId||item._sourceId||'';"
        js = js & vbLf
        js = js & "    const largeActions=new Set(["
        js = js & vbLf
        js = js & "        'tbEditor_ClipboardPaste','tbFormDesigner_ClipboardPaste','tbEditor_Find','tbProject_FindInFiles',"
        js = js & vbLf
        js = js & "        'tbEditor_FormatSelection','tbEditor_FormatDocument','tbEditor_GoToDefinition','tbEditor_LastPosition','tbEditor_GotoLineColumn',"
        js = js & vbLf
        js = js & "        'tbEditor_SwitchToCode','tbEditor_SwitchToFormDesign','tbShowObjectBrowser',"
        js = js & vbLf
        js = js & "        'tbEditor_IncreaseFontSize','tbEditor_DecreaseFontSize','tbFormDesigner_ZoomIncrease','tbFormDesigner_ZoomDecrease',"
        js = js & vbLf
        js = js & "        'tbFormDesigner_BringControlToFront','tbFormDesigner_SendControlToBack','tbFormDesigner_ToggleLockSelectedControls',"
        js = js & vbLf
        js = js & "        'tbProject_ShowReferences','tbProject_ShowSettings','tbBuild_Start','tbBuild_Clean',"
        js = js & vbLf
        js = js & "        'tbCompiler_Restart','tbCompiler_RestartAndFlushLlvmCache','tbProject_OpenProjectFolder','tbProject_OpenBuildFolder',"
        js = js & vbLf
        js = js & "        'tbDebug_ToggleBreakpoint','tbDebug_SetNextExecutionStatement'"
        js = js & vbLf
        js = js & "    ]);"
        js = js & vbLf
        js = js & "    const largeSources=new Set(['saveIcon','searchIcon','designSwitchIcon','playIcon','buildIcon','trashIcon','restartIcon',"
        js = js & vbLf
        js = js & "        'commentIcon','uncommentIcon','menuBarAlignLeft','menuBarAlignTop','menuBarAlignRight','menuBarAlignBottom',"
        js = js & vbLf
        js = js & "        'menuBarSizeWidest','menuBarSizeTallest','menuBarSizeNarrowest','menuBarSizeShortest',"
        js = js & vbLf
        js = js & "        'menuBarBringToFront','menuBarSendToBack','menuBarPreview','menuBarColorMode']);"
        js = js & vbLf
        js = js & "    const largeNames=['MenuCaptionProjectAdd','MenuCaptionFormatAlign','MenuCaptionFormatMakeSameSize',"
        js = js & vbLf
        js = js & "        'MenuCaptionFormatHorizontalSpacing','MenuCaptionFormatVerticalSpacing','MenuCaptionWindowPanelLayouts',"
        js = js & vbLf
        js = js & "        'MenuCaptionWindowPanelFeatures','MenuCaptionWindowTheme'];"
        js = js & vbLf
        js = js & "    const large=largeActions.has(a)||largeSources.has(source)||source.startsWith('addinButton-')||"
        js = js & vbLf
        js = js & "        largeNames.some(has)||['Fold','Unfold','Find options','More panels','Debugger Options'].includes(n);"
        js = js & vbLf
        js = js & "    let glyph='apps_list';"
        js = js & vbLf
        js = js & "    if(/Find|Search/i.test(n)||/Find/.test(a))glyph='searchIcon';"
        js = js & vbLf
        js = js & "    if(/ClipboardCut$/.test(a))glyph='cut';"
        js = js & vbLf
        js = js & "    else if(/SelectAll|SelectAllMatches/.test(a))glyph='select_all_on';"
        js = js & vbLf
        js = js & "    else if(/Delete|Clear$|BreakpointsClear/.test(a))glyph='delete';"
        js = js & vbLf
        js = js & "    else if(/FormatSelection|FormatDocument/.test(a))glyph='code';"
        js = js & vbLf
        js = js & "    else if(/Unfold/.test(a)||n==='Unfold')glyph='arrow_expand';"
        js = js & vbLf
        js = js & "    else if(/Fold/.test(a)||n==='Fold')glyph='arrow_collapse_all';"
        js = js & vbLf
        js = js & "    else if(/TransformTo/.test(a)||n==='Change case')glyph='text_change_case';"
        js = js & vbLf
        js = js & "    else if(/GotoLineColumn|GoToDefinition|LastPosition/.test(a))glyph='text_bullet_list_square';"
        js = js & vbLf
        js = js & "    else if(/Breakpoint/.test(a))glyph='circle';"
        js = js & vbLf
        js = js & "    else if(/SetNextExecutionStatement/.test(a))glyph='playIcon';"
        js = js & vbLf
        js = js & "    else if(/HorizontalSpacing/.test(n)||/SpacingHorizontal/.test(a))glyph='align_space_evenly_horizontal';"
        js = js & vbLf
        js = js & "    else if(/VerticalSpacing/.test(n)||/SpacingVertical/.test(a))glyph='align_space_evenly_vertical';"
        js = js & vbLf
        js = js & "    else if(/Settings|Options|PanelFeatures|KeyboardShortcuts|Language/.test(n)||/ShowSettings|ShowIDEOptions/.test(a))glyph='settings';"
        js = js & vbLf
        js = js & "    else if(/^tbHelp_|Help/.test(n))glyph='chat_help';"
        js = js & vbLf
        js = js & "    else if(source.startsWith('addinButton-')||has('Add-ins'))glyph=/Search|Find/i.test(n)?'searchIcon':'puzzle_piece';"
        js = js & vbLf
        js = js & "    return {large,glyph:item._ribbonGlyph||glyph};"
        js = js & vbLf
        js = js & "}),"
        js = js & vbLf
        js = js & "getShowContextMenu:function(){return showContextMenu;},setShowContextMenu:function(fn){showContextMenu=fn;},"
        js = js & vbLf
        js = js & "localize:function(s){return evaluateLocalizedString(s);},execute:function(s){return executeIdeCommand(s,true);},"
        js = js & vbLf
        js = js & "commandEnabled:function(s){var c=ideCommands[s];return !!c&&(!c.defaultContext||evaluateExpression(c.defaultContext));},"
        js = js & vbLf
        js = js & "testContext:function(s){return parseAndEvaluateExpression(s);},shortcut:function(s){return GetIdeCommandShortcutDescription(s)||'';},"
        js = js & vbLf
        js = js & "realTitlebar:function(){return !!liveIDEOptions.showRealTitlebar;},projectName:function(){return typeof g_CurrentProjectName==='string'?g_CurrentProje"
        js = js & "ctName:'';},"
        js = js & vbLf
        js = js & "formGlobals:function(){return getCurrentFormEditorGlobals();},changedSize:function(){changedSize();}});"
        js = js & vbLf
        js = js & "window.__tbUI3Toolbar=adapter;adapter.install('Classic');return 'toolbar installed';})()"
        js = js & vbLf
        Return js
    End Function
End Module

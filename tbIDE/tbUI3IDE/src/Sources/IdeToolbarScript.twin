        js = js & "            n.classList.add('tbui3-backstage-underlay');n.inert=true;n.setAttribute('aria-hidden','true');"
        js = js & vbLf
        js = js & "        }"
        js = js & vbLf
        js = js & "    }"
        js = js & vbLf
        js = js & "    function restoreFileUnderlays(){for(const [n,old]of fileUnderlays){"
        js = js & vbLf
        js = js & "        n.classList.toggle('tbui3-backstage-underlay',old.hidden);"

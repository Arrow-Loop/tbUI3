        js = js & vbLf
        js = js & "            entry.loading=true;entry.started=Date.now();entry.epoch=menuEpoch;entry.failed=false;"
        js = js & vbLf
        js = js & "            const accepted=api.captureMenu(item,m.node,items=>{"

        js = js & vbLf
        js = js & "    function hydrateMenus(refresh=false) {"
        js = js & vbLf
        js = js & "        if(refresh)menuEpoch++;hydrating=true;try{for(const m of menus.values())if(!m.ready||refresh&&(m.node.id!=='rootMenuAddins'||backstage&&!backs"
        js = js & "tage.hidden&&fileSection==='Add-ins'))requestMenu(m);}finally{hydrating=false;}"

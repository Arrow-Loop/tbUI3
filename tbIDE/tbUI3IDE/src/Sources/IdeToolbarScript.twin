        js = js & vbLf
        js = js & "        if(!item.name){parent.append(el('div','tbui3-ribbon-separator'));return;}"
        js = js & vbLf
        js = js & "        if(!menuEnabled(item)&&item.superHiddenContext)return;"
        js = js & vbLf
        js = js & "        const iconOnly=!!api.present?.(item).iconOnly;"
        js = js & vbLf
        js = js & "        const b=el('button','tbui3-ribbon-command'+(iconOnly?' tbui3-ribbon-compact':item._ribbonLarge?' tbui3-ribbon-large':''));b.type='button';"
        js = js & vbLf

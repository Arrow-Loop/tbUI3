        js = js & "        let entry=expandedMenus.get(key);"
        js = js & vbLf
        js = js & "        if(!entry){entry={items:[],ready:false,epoch:-1};expandedMenus.set(key,entry);}"
        js = js & vbLf
        js = js & "        if(entry.loading&&Date.now()-entry.started>5000){entry.loading=false;entry.failed=true;}"
        js = js & vbLf
        js = js & "        const active=state.active===(kind==='Insert'?'Insert':'Form');"
        js = js & vbLf

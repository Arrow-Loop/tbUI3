        js = js & "        'MenuCaptionWindowPanelFeatures','MenuCaptionWindowTheme'];"
        js = js & vbLf
        js = js & "    const large=item._ribbonTab==='Insert'||largeActions.has(a)||largeSources.has(source)||source.startsWith('addinButton-')||"
        js = js & vbLf
        js = js & "        largeNames.some(has)||['Fold','Unfold','Find options','More panels','Debugger Options'].includes(n);"
        js = js & vbLf
        js = js & "    const captions={tbFileSystem_AddFolder:'Folder',tbFileSystem_AddWindowsForm:'Windows form',tbFileSystem_AddWindowsMDIForm:'MDI form',tbFileSystem_"
        js = js & "AddWindowsUserControl:'UserControl',tbFileSystem_AddWindowsPropertyPage:'Property page',tbFileSystem_AddWindowsReport:'Report',tbFileSystem_AddCustomC"
        js = js & "ontrolsForm:'Custom form',tbFileSystem_AddModuleTWIN:'Module (.twin)',tbFileSystem_AddClassTWIN:'Class (.twin)',tbFileSystem_AddModuleBAS:'Module (.ba"
        js = js & "s)',tbFileSystem_AddClassCLS:'Class (.cls)',tbFileSystem_AddOtherFile:'Other file',tbFileSystem_ImportFile:'Import',tbFileSystem_AddResourceVisualStyl"
        js = js & "esManifest:'Visual styles',tbFileSystem_AddResourceStringTable:'String table',tbFileSystem_AddResourceMessageTable:'Message table'};"
        js = js & vbLf
        js = js & "    let glyph='apps_list';"
        js = js & vbLf
        js = js & "    if(/^tbFileSystem_Add(?:Module|Class)/.test(a))glyph='code';"

/*
    WinUI3 Dark for the twinBASIC IDE (built for BETA 1043).
    Colours are WinUI 3 theme resources (Common_themeresources_any.xaml in microsoft-ui-xaml),
    the same tokens WinUI Gallery uses. Accent colours assume the default Windows blue accent.
    Generated by tbIDE-theme/tools/build-themes.mjs; edit that script, not this file.
*/

inherits:                                   dark;                                                /* everything not listed below comes from the IDE Dark theme */

/* Window chrome: SolidBackgroundFillColorBase #202020 (the non-Mica window background) */
GeneralBackColor:                           #202020;                                             /* SolidBackgroundFillColorBase */
GeneralPanelBackColor:                      #202020;                                             /* SolidBackgroundFillColorBase */
MenuBackColor:                              #202020;                                             /* title and menu bar; IDE draws its title text and caption buttons white */
MenuForeColor:                              #FFFFFF;                                             /* TextFillColorPrimary */
FullScreenToggleBackColor:                  #2D2D2D;                                             /* ControlFillColorDefault over base */
ToolbarBackground:                          #202020;                                             /* toolbars sit on the window background */
ToolbarDropDownBorder:                      1px solid rgba(255, 255, 255, 0.07);                 /* ControlStrokeColorDefault #12FFFFFF */
ToolbarPreviewButtonColor:                  rgb(96 205 255 / 30%);                               /* AccentFillColorDefault tint */
StatusBarBackColor:                         #202020;                                             /* SolidBackgroundFillColorBase */
StatusBarBorderTop:                         1px solid rgba(255, 255, 255, 0.08);                 /* DividerStrokeColorDefault #15FFFFFF */

/* Panels are rounded cards on the window background (BETA 1033 dock container properties) */
DockBorder:                                 0;                                                   /* gaps come from the container margin instead */
DockContainerBackground:                    #282828;                                             /* layer surface */
DockContainerBorderRadius:                  8px;                                                 /* OverlayCornerRadius */
DockContainerMargin:                        2px;                                                 /* with the neighbour, a 4px gap */
DockContainerOutline:                       1px solid rgba(255, 255, 255, 0.06);                 /* faint edge; CardStrokeColorDefault #19000000 is invisible on dark */
SplitterBarBottomBorder:                    1px solid rgba(255, 255, 255, 0.08);                 /* DividerStrokeColorDefault */

/* Panels: layer surface #282828 (SolidBackgroundFillColorTertiary, also LayerFillColorDefault over the base) */
PanelBackground:                            #282828;                                             /* SolidBackgroundFillColorTertiary */
PanelBorderTop:                             0;                                                   /* the dock container draws the edge */
PanelBorderBottom:                          0;
PanelBorderLeft:                            0;
PanelBorderRight:                           0;
PanelHeaderBackColor:                       #282828;                                             /* WinUI has no separate title strip, the header shares the layer */
PanelHeaderTextColor:                       #FFFFFF;                                             /* TextFillColorPrimary */
PanelHeaderBorderTop:                       0;                                                   /* also used for the left edge */
PanelHeaderBorderBottom:                    0;                                                   /* also used for the right edge */
PanelHeaderFontSize:                        100%;
PanelHeaderPadding:                         4px 0 4px 0;
PanelHeaderFilterHover:                     brightness(1.3);                                     /* no glow; WinUI hovers do not glow */
PanelCloseButtonBackground:                 transparent;                                         /* SubtleFillColorTransparent */
PanelCloseButtonCornerRadius:               4px;                                                 /* ControlCornerRadius */
PanelCloseButtonForeColor:                  rgba(255, 255, 255, 0.786);                          /* TextFillColorSecondary #C5FFFFFF */
PanelCloseButtonOutline:                    0;
FloatingPanelBorder:                        1px solid rgba(255, 255, 255, 0.08);
FloatingPanelBoxShadow:                     0 8px 16px rgba(0, 0, 0, 0.26);                      /* Flyout elevation */
ToolWindowBodyForeColor:                    #FFFFFF;                                             /* TextFillColorPrimary */

/* Text */
GeneralTextColor:                           #FFFFFF;                                             /* TextFillColorPrimary */
GeneralTextColorProminent:                  #FFFFFF;                                             /* TextFillColorPrimary */
GeneralSubTextColor:                        rgba(255, 255, 255, 0.545);                          /* TextFillColorTertiary #8BFFFFFF */
DebugTimestampColor:                        rgba(255, 255, 255, 0.545);                          /* TextFillColorTertiary */
FindResultColor:                            #60CDFF;                                             /* AccentTextFillColorTertiary (default blue accent, Light2) */
ErrorTabTextColor:                          #FF99A4 !important;                                  /* SystemFillColorCritical */
WarningTreeNodeColor:                       #FCE100;                                             /* SystemFillColorCaution */
DiagnosticsWarningIconColor:                #FCE100;                                             /* SystemFillColorCaution */

/* Tabs: TabView. Unselected tabs are transparent on the strip, the selected tab joins the content */
TabsBackColor:                              #202020;                                             /* TabViewBackground = SolidBackgroundFillColorBase */
TabsBorderBottom:                           0;
TabUnselectedBackColor:                     transparent;                                         /* TabViewItemHeaderBackground */
TabHoverBackColor:                          rgba(255, 255, 255, 0.06);                           /* SubtleFillColorSecondary #0FFFFFFF */
TabSelectedBackColor:                       #282828;                                             /* TabViewItemHeaderBackgroundSelected = SolidBackgroundFillColorTertiary */
TabSelectedHoverBackColor:                  #282828;
TabSelectedHighlightBorderTop:              1px solid rgba(255, 255, 255, 0.08);
TabSelectedHighlightBorderLeft:             1px solid rgba(255, 255, 255, 0.08);
TabSelectedHighlightBorderRight:            1px solid rgba(255, 255, 255, 0.08);
TabUnselectedHighlightBorderTop:            0;
TabUnselectedHighlightBorderLeft:           0;
TabUnselectedHighlightBorderRight:          0;
TabItemSelectedTextColor:                   #FFFFFF;                                             /* TextFillColorPrimary */
TabArrowsBackColor:                         transparent;
TabArrowsForeColor:                         #FFFFFF;

/* Lists and trees: ListView item states */
TreeItemHoverBackColor:                     rgba(255, 255, 255, 0.06);                           /* SubtleFillColorSecondary */
TreeItemSelectedBackColor:                  rgba(255, 255, 255, 0.0837);                         /* ControlFillColorSecondary #15FFFFFF */
TreeItemSelectedForeColor:                  #FFFFFF;
PackageManagerHoverBackColor:               rgba(255, 255, 255, 0.06) !important;                /* SubtleFillColorSecondary */
DiagnosticsGroupBackground:                 rgba(255, 255, 255, 0.04);                           /* SubtleFillColorTertiary #0AFFFFFF */
DiagnosticsGroupFontSize:                   90%;                                                 /* shipped theme misses this semicolon, so set it here */
DiagnosticsGroupFontWeight:                 600;                                                 /* SemiBold */
ProblemSelectedBackColor:                   rgba(255, 255, 255, 0.06);
ProblemSelectedBorderColor:                 #60CDFF;                                             /* accent */

/* Menus and context menus. The IDE hard-codes black menu item text, so these stay light (WinUI light flyout) */
ContextMenuBackColor:                       #F9F9F9;                                             /* AcrylicInAppFillColorDefault fallback, light */
ContextMenuForeColor:                       #1A1A1A;                                             /* TextFillColorPrimary, light */
ContextMenuBackground:                      #F9F9F9;
ContextMenuBorderTop:                       1px solid rgba(0, 0, 0, 0.0578);                     /* SurfaceStrokeColorFlyout, light #0F000000 */
ContextMenuBorderLeft:                      1px solid rgba(0, 0, 0, 0.0578);
ContextMenuBorderRight:                     1px solid rgba(0, 0, 0, 0.0578);
ContextMenuBorderBottom:                    1px solid rgba(0, 0, 0, 0.0578);
ContextMenuBorderBottomLeftRadius:          8px;                                                 /* OverlayCornerRadius */
ContextMenuBorderBottomRightRadius:         8px;                                                 /* OverlayCornerRadius */
ContextMenuItemHoverColor:                  rgba(0, 0, 0, 0.037);                                /* SubtleFillColorSecondary, light #09000000 */

/* Code editor */
CodePanelBackColor:                         #282828;
CodePanelBottomBorder:                      0;
MonacoBackground:                           #1C1C1C;                                             /* SolidBackgroundFillColorSecondary; the text area (BETA 1033) */
CodeEditorMarginBackground:                 #1C1C1C !important;                                  /* gutter matches the text area */
CodeNavDropDownsBackColor:                  #282828;
CodeNavDropDownsSelectColor:                #D6D6D6;                                             /* IDE hard-codes dark text in these drop-downs, so they stay light */
CodeNavDropDownsBorder:                     1px solid rgba(255, 255, 255, 0.07);                 /* ControlStrokeColorDefault */
CodeIndentGuideColor:                       rgba(255, 255, 255, 0.08);                           /* DividerStrokeColorDefault */
CodeIndentGuideActiveColor:                 rgba(255, 255, 255, 0.36);                           /* TextFillColorDisabled #5DFFFFFF */
CodeScrollbarVerticalBackColor:             transparent;
MonacoScrollHorzBack:                       transparent;
MonacoScrollBorderTop:                      0;
SelectedTextBackColor:                      rgb(0 120 212 / 40%) !important;                     /* SystemAccentColor #0078D4 */
StickyScrollBackColor:                      #282828;

/* Scrollbars */
ScrollThumbColor:                           rgba(255, 255, 255, 0.5294);                         /* TextFillColorTertiary #87FFFFFF (reference scroll bar thumb) */
ScrollTrackColor:                           transparent;
GeneralScrollbarBackground:                 transparent !important;
GeneralScrollbarBorderLeft:                 0 !important;

/* Pop-ups: intellisense, signature help, hover tips (Flyout #2C2C2C) */
DebugIntellisenceBackColor:                 #2C2C2C;                                             /* AcrylicInAppFillColorDefault fallback */
DebugIntellisenceForeColor:                 #FFFFFF;
DebugIntellisenceBoxShadow:                 0 8px 16px rgba(0, 0, 0, 0.26);                      /* Flyout elevation */
DebugIntellisensePartialMatchColor:         #60CDFF;                                             /* accent */
IntellisenseSelectedBackColor:              rgb(96 205 255 / 24%);                               /* accent tint */
IntellisenseSelectedForeColor:              #FFFFFF;
SignatureHelpBackColor:                     #2C2C2C;
SignatureHelpForeColor:                     #FFFFFF;
SignatureHelpBoxShadow:                     0 8px 16px rgba(0, 0, 0, 0.26);
SignatureHelpHeaderColor:                   #3A3A3A;
VariablesPanelHoverTooltipBackColor:        #2C2C2C;

/* Status bar badges: InfoBadge colours with black text */
StatusBarGreenBoxForeColor:                 #000000;                                             /* TextOnAccentFillColorPrimary, used by every badge state */
StatusBarGreenBoxBorderRadius:              4px;                                                 /* ControlCornerRadius, used by every badge state */
StatusBarGreenBoxBackground:                #6CCB5F;                                             /* SystemFillColorSuccess */
StatusBarGreenBoxBorderTop:                 1px solid #6CCB5F;
StatusBarGreenBoxBorderLeft:                1px solid #6CCB5F;
StatusBarGreenBoxBorderRight:               1px solid #6CCB5F;
StatusBarGreenBoxBorderBottom:              1px solid #6CCB5F;
StatusBarOrangeBoxBackground:               #FCE100;                                             /* SystemFillColorCaution */
StatusBarOrangeBoxBorderTop:                1px solid #FCE100;
StatusBarOrangeBoxBorderLeft:               1px solid #FCE100;
StatusBarOrangeBoxBorderRight:              1px solid #FCE100;
StatusBarOrangeBoxBorderBottom:             1px solid #FCE100;
StatusBarRedBoxBackground:                  #FF99A4;                                             /* SystemFillColorCritical */
StatusBarRedBoxBorderTop:                   1px solid #FF99A4;
StatusBarRedBoxBorderLeft:                  1px solid #FF99A4;
StatusBarRedBoxBorderRight:                 1px solid #FF99A4;
StatusBarRedBoxBorderBottom:                1px solid #FF99A4;
DiagnosticsBubblesForeColor:                #FFFFFF;
DiagnosticsErrorBackColor:                  #442726;                                             /* SystemFillColorCriticalBackground */
DiagnosticsWarningsBackColor:               #433519;                                             /* SystemFillColorCautionBackground */
DiagnosticsHintsBackColor:                  #393D1B;                                             /* SystemFillColorSuccessBackground */
DiagnosticsInfosBackColor:                  rgb(96 205 255 / 16%);                               /* attention, accent tint */

/* Properties panel */
PropertyCategoryBack:                       #1C1C1C;                                             /* SolidBackgroundFillColorSecondary; IDE draws category text white */
PropertySheetControlSelectorBackground:     #2D2D2D;                                             /* ControlFillColorDefault over base */
PropertySheetNameBackColor:                 #282828;
PropertySheetNameBackground:                #282828;
PropertySheetNameBorderColor:               1px solid rgba(255, 255, 255, 0.06);
PropertySheetValueBackColor:                #2D2D2D;                                             /* ControlFillColorDefault over the layer */
PropertySheetValueBorderColor:              1px solid rgba(255, 255, 255, 0.06);
PropertySheetEntryBorder:                   1px solid rgba(255, 255, 255, 0.06);
PropertySheetValueForeColor:                #FFFFFF !important;                                  /* TextFillColorPrimary */
PropertySheetValueDropDownBackColor:        #2C2C2C;
PropertySheetEntryUnimplementedBackColor:   #442726 !important;                                  /* SystemFillColorCriticalBackground */
PropertySheetValueUnimplementedBackColor:   #442726 !important;

/* Form designer */
FormDesignerCanvasBackground:               #1C1C1C;                                             /* SolidBackgroundFillColorSecondary */
FormDesignerCanvasBackground2:              radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px) 0 0 / 16px 16px, #1C1C1C; /* dot grid instead of stripes */
DesignerBoxShadow:                          0 8px 16px rgba(0, 0, 0, 0.26);                      /* Flyout elevation */
DesignerRulerBackColor:                     #202020;
DesignerRulerCornerBackColor:               #2C2C2C;
DesignerRulerCornerBorder:                  1px solid rgba(255, 255, 255, 0.08);
DesignerRulerCornerBorderRadius:            4px;                                                 /* ControlCornerRadius */
DesignerRulerCornerDotColor:                rgba(255, 255, 255, 0.786);                          /* TextFillColorSecondary */
DesignerRulerCornerOutline:                 0;
DesignerRulerMarkerColor:                   #60CDFF;                                             /* accent */
DesignerToolboxItemHoverBackground:         rgba(255, 255, 255, 0.06);                           /* SubtleFillColorSecondary */
DesignerToolboxItemSelectedOutline:         1.5px solid #60CDFF !important;                      /* accent */

/* Dialogs: WinUI ContentDialog, dark. BETA 1033 made dialog contents themeable */
DialogHeaderBackColor:                      #2B2B2B;                                             /* same as the content, WinUI dialogs have no title strip; IDE draws title text white */
DialogGeneralBackColor:                     #2B2B2B;                                             /* LayerFillColorAlt #0DFFFFFF over SolidBackgroundFillColorBase */
DialogGeneralForeColor:                     #FFFFFF;                                             /* TextFillColorPrimary */
DialogSubTextForeColor:                     rgba(255, 255, 255, 0.786);                          /* TextFillColorSecondary */
DialogBoldFontWeight:                       600;                                                 /* SemiBold */
DialogButtonsBarBackColor:                  #202020;                                             /* command area, SolidBackgroundFillColorBase */
DialogButtonsSectionTopBorder:              1px solid rgba(255, 255, 255, 0.08);                 /* DividerStrokeColorDefault */
DialogButtonsBackColor:                     linear-gradient(#2D2D2D, #2D2D2D);                   /* ControlFillColorDefault over the command area; a gradient (as Aurora does) so the IDE's fixed #EBEFF5 hover background-color sits under it, leaving the brightness(1.3) hover filter */
DialogButtonForeColor:                      #FFFFFF;                                             /* TextFillColorPrimary */
DialogButtonBorderRadius:                   4px;                                                 /* ControlCornerRadius */
DialogButtonBoxShadow:                      none;
DialogButtonBorderTop:                      1px solid rgba(255, 255, 255, 0.094);                /* ControlElevationBorder, ControlStrokeColorSecondary #18FFFFFF */
DialogButtonBorderLeft:                     1px solid rgba(255, 255, 255, 0.07);                 /* ControlStrokeColorDefault #12FFFFFF */
DialogButtonBorderRight:                    1px solid rgba(255, 255, 255, 0.07);
DialogButtonBorderBottom:                   1px solid rgba(255, 255, 255, 0.07);
DialogButtonFocusBackColor:                 linear-gradient(#2D2D2D, #2D2D2D);                   /* gradient for the same hover reason; one text colour is shared by all buttons, so focus is a ring, not an accent fill */
DialogButtonFocusBorderTop:                 1px solid rgba(255, 255, 255, 0.094);
DialogButtonFocusBorderLeft:                1px solid rgba(255, 255, 255, 0.07);
DialogButtonFocusBorderRight:               1px solid rgba(255, 255, 255, 0.07);
DialogButtonFocusBorderBottom:              1px solid rgba(255, 255, 255, 0.07);
DialogButtonFocusRectColor:                 #FFFFFF;                                             /* FocusStrokeColorOuter */
DialogButtonFocusWidth:                     2px;                                                 /* FocusVisualPrimaryThickness */
DialogTabBarBackColor:                      #2B2B2B;                                             /* selected dialog tab */
DialogTabBarBorderTop:                      2px solid #60CDFF;                                   /* accent */
DialogTabForeColor:                         #FFFFFF;
DialogTabButtonBackColor:                   #202020;                                             /* unselected dialog tab */
DialogTabButtonForeColor:                   rgba(255, 255, 255, 0.786);                          /* TextFillColorSecondary */
DialogNavBarBackColor:                      #202020;                                             /* Options page list and New Project side rail */
DialogNavButtonBackColorSelected:           rgba(255, 255, 255, 0.0837);                         /* ControlFillColorSecondary */
DialogTextInputBackColor:                   rgba(255, 255, 255, 0.0588);                         /* ControlFillColorDefault #0FFFFFFF, TextBox rest (reference .text-field) */
DialogTextInputForeColor:                   #FFFFFF;
DialogTextInputBorder:                      1px solid rgba(255, 255, 255, 0.07) !important;      /* ControlStrokeColorDefault */
DialogTextInputOutline:                     0 !important;
DialogListBackColor:                        #282828;
DialogListHeaderBackColor:                  #202020;
DialogListHeaderForeColor:                  rgba(255, 255, 255, 0.786);
DialogListRowBorderBottom:                  1px solid rgba(255, 255, 255, 0.08);                 /* DividerStrokeColorDefault */
DialogListDragIconFilter:                   invert(1) brightness(2);                             /* as the IDE Aurora theme does */
DialogImportListHoverBackColor:             rgba(255, 255, 255, 0.0605);                         /* ListViewItemBackgroundPointerOver, SubtleFillColorSecondary (BETA 1043) */
DialogImportListHoverForeColor:             #FFFFFF;                                             /* TextFillColorPrimary */
DialogTickForeColor:                        #FFFFFF;                                             /* TextFillColorPrimary; dialog check marks (BETA 1043) */
DialogConfigRowBorderBottom:                1px solid rgba(255, 255, 255, 0.08);
DialogScrollTrackColor:                     transparent;
DialogScrollThumbColor:                     rgba(255, 255, 255, 0.5294);                         /* TextFillColorTertiary (reference scroll bar thumb) */
DialogScrollThumbColorHover:                rgba(255, 255, 255, 0.7725);                         /* TextFillColorSecondary (reference thumb hover) */
ModalDialogBorderTop:                       1px solid rgba(117, 117, 117, 0.4);                  /* SurfaceStrokeColorDefault #66757575 */
ModalDialogBorderLeft:                      1px solid rgba(117, 117, 117, 0.4);
ModalDialogBorderRight:                     1px solid rgba(117, 117, 117, 0.4);
ModalDialogBorderBottom:                    1px solid rgba(117, 117, 117, 0.4);
ModalDialogOutline:                         0;
ModalDialogBorderRadiusTopLeft:             8px;                                                 /* OverlayCornerRadius */
ModalDialogBorderRadiusTopRight:            8px;
ModalDialogBorderRadiusBottomLeft:          8px;
ModalDialogBorderRadiusBottomRight:         8px;
ModalDialogBoxShadow:                       0 32px 64px rgba(0, 0, 0, 0.37);                     /* Dialog elevation */
FrontPageBackground:                        #2B2B2B;                                             /* New Project dialog */
FrontPageItemBackColor:                     #323232;                                             /* CardBackgroundFillColorDefault over the dialog */
FrontPageItemBorder:                        1px solid rgba(255, 255, 255, 0.06);
FrontPageItemBorderRadius:                  8px;                                                 /* OverlayCornerRadius, like Gallery cards */
FrontPageSelectedItemBackColor:             #3A3A3A !important;
FrontPageSelectedItemBorder:                1px solid rgba(255, 255, 255, 0.08);                 /* despite the name, 1033 uses this for every card; selection is a fixed white border and blue outline */
ProgressBarBackColor:                       #2D2D2D;                                             /* track; the fill is a fixed green gradient in 1033 */
ProgressBarForeColor:                       #FFFFFF;
FrontPageIconColor:                         #60CDFF;                                             /* accent */
FrontPageBETANoticeColor:                   #FFFFFF;

/* Documents */
VirtualDocBackColor:                        #282828;
VirtualDocForeColor:                        #FFFFFF;
VirtualDocMarkdownBackColor:                #282828;
VirtualDocMarkdownBorderColor:              rgba(255, 255, 255, 0.08);
VirtualDocMarkdownForeColor:                #FFFFFF;
VirtualDocMarkdownHeaderColor:              #FCE100;

/* Icons: same filters as the IDE Dark theme, minus the hover glows */
IconHoverFilter:                            brightness(1.2);
IconType1HoverFilter:                       brightness(1.5);
IconType2HoverFilter:                       invert(1);
IconType3HoverFilter:                       brightness(1.5);
IconType8HoverFilter:                       brightness(1.5);
IconTypeUndoRedoHoverFilter:                brightness(1.1);
PlayIconBlue:                               url('data:image/svg+xml;base64,');
StopIconRed:                                url('data:image/svg+xml;base64,PHN2ZyB2ZXJzaW9uPSIxLjEiIHZpZXdCb3g9IjAgMCAzMzAgMzMwIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxyZWN0IHg9IjMwIiB5PSIzMCIgd2lkdGg9IjI3MCIgaGVpZ2h0PSIyNzAiIHJ4PSIyNCIgcnk9IjI0IiBzdHlsZT0iZmlsbDogI0ZGOTlBNDsiPjwvcmVjdD48L3N2Zz4=');

/*
    WinUI3 Light for the twinBASIC IDE (built for BETA 1043).
    Colours are WinUI 3 theme resources (Common_themeresources_any.xaml in microsoft-ui-xaml),
    the same tokens WinUI Gallery uses. Accent colours assume the default Windows blue accent.
    Generated by tbIDE-theme/tools/build-themes.mjs; edit that script, not this file.
*/

inherits:                                   light;                                               /* everything not listed below comes from the IDE Light theme */

/* Window chrome: SolidBackgroundFillColorBase #F3F3F3. The IDE draws its title text and caption buttons white, */

/* so the title and menu bar uses the accent (AccentFillColorDefault #005FB8), like the IDE Light theme does. */
GeneralBackColor:                           #F3F3F3;                                             /* SolidBackgroundFillColorBase */
GeneralPanelBackColor:                      #F3F3F3;                                             /* SolidBackgroundFillColorBase */
MenuBackColor:                              #005FB8;                                             /* AccentFillColorDefault (default blue accent, Dark1) */
MenuForeColor:                              #FFFFFF;                                             /* TextOnAccentFillColorPrimary */
FullScreenToggleBackColor:                  #F9F9F9;                                             /* its text uses the general text colour */
ToolbarBackground:                          #F3F3F3;
ToolbarDropDownBorder:                      1px solid rgba(0, 0, 0, 0.0578);                     /* ControlStrokeColorDefault #0F000000 */
ToolbarPreviewButtonColor:                  rgb(0 95 184 / 20%);                                 /* accent tint */
StatusBarBackColor:                         #F3F3F3;
StatusBarBorderTop:                         1px solid rgba(0, 0, 0, 0.0578);                     /* DividerStrokeColorDefault #0F000000 */

/* Panels are rounded cards on the window background (BETA 1033 dock container properties) */
DockBorder:                                 0;                                                   /* gaps come from the container margin instead */
DockContainerBackground:                    #F9F9F9;                                             /* layer surface */
DockContainerBorderRadius:                  8px;                                                 /* OverlayCornerRadius */
DockContainerMargin:                        2px;                                                 /* with the neighbour, a 4px gap */
DockContainerOutline:                       1px solid rgba(0, 0, 0, 0.0578);                     /* CardStrokeColorDefault #0F000000 */
SplitterBarBottomBorder:                    1px solid rgba(0, 0, 0, 0.0578);

/* Panels: layer surface #F9F9F9 (SolidBackgroundFillColorTertiary, also LayerFillColorDefault #80FFFFFF over the base) */
PanelBackground:                            #F9F9F9;
PanelBorderTop:                             0;                                                   /* the dock container draws the edge */
PanelBorderBottom:                          0;
PanelBorderLeft:                            0;
PanelBorderRight:                           0;
PanelHeaderBackColor:                       #F9F9F9;
PanelHeaderTextColor:                       #1A1A1A;                                             /* TextFillColorPrimary #E4000000 */
PanelHeaderBorderTop:                       0;
PanelHeaderBorderBottom:                    0;
PanelHeaderBorderLeft:                      0;
PanelHeaderFontSize:                        100%;
PanelHeaderPadding:                         4px 0 4px 0;
PanelHeaderFilterHover:                     invert(1) brightness(0.3);                           /* keeps the dark icon, darker on hover */
PanelCloseButtonBackground:                 transparent;
PanelCloseButtonCornerRadius:               4px;                                                 /* ControlCornerRadius */
PanelCloseButtonForeColor:                  rgba(0, 0, 0, 0.62);                                 /* TextFillColorSecondary #9E000000 */
PanelCloseButtonOutline:                    0;
FloatingPanelBorder:                        1px solid rgba(0, 0, 0, 0.0578);
FloatingPanelBoxShadow:                     0 8px 16px rgba(0, 0, 0, 0.14);                      /* Flyout elevation */
ToolWindowBodyForeColor:                    #1A1A1A;

/* Text */
GeneralTextColor:                           #1A1A1A;                                             /* TextFillColorPrimary */
GeneralTextColorProminent:                  #1A1A1A;                                             /* the IDE Light theme leaves this white on a white pop-up */
GeneralSubTextColor:                        rgba(0, 0, 0, 0.447);                                /* TextFillColorTertiary #72000000 */
DebugTimestampColor:                        rgba(0, 0, 0, 0.447);
FindResultColor:                            #005FB8;                                             /* AccentTextFillColorPrimary (Dark2 is #003E92; Dark1 reads better here) */
ErrorTabTextColor:                          #C42B1C;                                             /* SystemFillColorCritical */
WarningTreeNodeColor:                       #9D5D00;                                             /* SystemFillColorCaution */
DiagnosticsWarningIconColor:                #9D5D00;

/* Tabs */
TabsBackColor:                              #F3F3F3;
TabsBorderBottom:                           0;
TabUnselectedBackColor:                     transparent;
TabHoverBackColor:                          rgba(0, 0, 0, 0.0392);                               /* LayerOnMicaBaseAltFillColorSecondary #0A000000 (reference --color-tab-hover) */
TabSelectedBackColor:                       #F9F9F9;                                             /* SolidBackgroundFillColorTertiary */
TabSelectedHoverBackColor:                  #F9F9F9;
TabSelectedHighlightBorderTop:              1px solid rgba(0, 0, 0, 0.0578);
TabSelectedHighlightBorderLeft:             1px solid rgba(0, 0, 0, 0.0578);
TabSelectedHighlightBorderRight:            1px solid rgba(0, 0, 0, 0.0578);
TabUnselectedHighlightBorderTop:            0;
TabUnselectedHighlightBorderLeft:           0;
TabUnselectedHighlightBorderRight:          0;
TabItemSelectedTextColor:                   #1A1A1A;
TabArrowsBackColor:                         transparent;
TabArrowsForeColor:                         #1A1A1A;

/* Lists and trees */
TreeItemHoverBackColor:                     rgba(0, 0, 0, 0.037);                                /* SubtleFillColorSecondary */
TreeItemSelectedBackColor:                  rgba(0, 0, 0, 0.06);
PackageManagerHoverBackColor:               rgba(0, 0, 0, 0.037) !important;
DiagnosticsGroupBackground:                 rgba(0, 0, 0, 0.024);                                /* SubtleFillColorTertiary #06000000 */
DiagnosticsGroupFontSize:                   90%;
DiagnosticsGroupFontWeight:                 600;
ProblemSelectedBackColor:                   rgba(0, 0, 0, 0.037);
ProblemSelectedBorderColor:                 #005FB8;                                             /* accent */

/* Menus and context menus (light flyout) */
ContextMenuBackColor:                       #F9F9F9;
ContextMenuForeColor:                       #1A1A1A;
ContextMenuBackground:                      #F9F9F9;
ContextMenuBorderTop:                       1px solid rgba(0, 0, 0, 0.0578);                     /* SurfaceStrokeColorFlyout */
ContextMenuBorderLeft:                      1px solid rgba(0, 0, 0, 0.0578);
ContextMenuBorderRight:                     1px solid rgba(0, 0, 0, 0.0578);
ContextMenuBorderBottom:                    1px solid rgba(0, 0, 0, 0.0578);
ContextMenuBorderBottomLeftRadius:          8px;                                                 /* OverlayCornerRadius */
ContextMenuBorderBottomRightRadius:         8px;
ContextMenuItemHoverColor:                  rgba(0, 0, 0, 0.037);

/* Code editor */
CodePanelBackColor:                         #F9F9F9;
CodePanelBottomBorder:                      0;
MonacoBackground:                           #FFFFFF;                                             /* SolidBackgroundFillColorQuarternary; the text area (BETA 1033) */
CodeEditorMarginBackground:                 #FFFFFF !important;                                  /* gutter matches the text area */
CodeNavDropDownsBackColor:                  #F9F9F9;
CodeNavDropDownsSelectColor:                #FFFFFF;
CodeNavDropDownsBorder:                     1px solid rgba(0, 0, 0, 0.1);
CodeIndentGuideColor:                       rgba(0, 0, 0, 0.08);
CodeIndentGuideActiveColor:                 rgba(0, 0, 0, 0.3);
CodeScrollbarVerticalBackColor:             transparent;
MonacoScrollHorzBack:                       transparent;
MonacoScrollBorderTop:                      0;
SelectedTextBackColor:                      rgb(0 120 212 / 25%) !important;                     /* SystemAccentColor */
StickyScrollBackColor:                      #F9F9F9;

/* Scrollbars */
ScrollThumbColor:                           rgba(0, 0, 0, 0.4471);                               /* TextFillColorTertiary #72000000 (reference scroll bar thumb) */
ScrollTrackColor:                           transparent;
GeneralScrollbarBackground:                 transparent !important;
GeneralScrollbarBorderLeft:                 0 !important;

/* Pop-ups (Flyout #F9F9F9) */
DebugIntellisenceBackColor:                 #F9F9F9;
DebugIntellisenceForeColor:                 #1A1A1A;
DebugIntellisenceBoxShadow:                 0 8px 16px rgba(0, 0, 0, 0.14);
DebugIntellisensePartialMatchColor:         #005FB8;
IntellisenseSelectedBackColor:              rgb(0 95 184 / 14%);                                 /* accent tint */
IntellisenseSelectedForeColor:              #1A1A1A;
SignatureHelpBackColor:                     #F9F9F9;
SignatureHelpForeColor:                     #1A1A1A;
SignatureHelpBoxShadow:                     0 8px 16px rgba(0, 0, 0, 0.14);
SignatureHelpHeaderColor:                   #005FB8;
VariablesPanelHoverTooltipBackColor:        #F9F9F9;

/* Status bar badges: InfoBadge colours with white text */
StatusBarGreenBoxForeColor:                 #FFFFFF;
StatusBarGreenBoxBorderRadius:              4px;
StatusBarGreenBoxBackground:                #0F7B0F;                                             /* SystemFillColorSuccess */
StatusBarGreenBoxBorderTop:                 1px solid #0F7B0F;
StatusBarGreenBoxBorderLeft:                1px solid #0F7B0F;
StatusBarGreenBoxBorderRight:               1px solid #0F7B0F;
StatusBarGreenBoxBorderBottom:              1px solid #0F7B0F;
StatusBarOrangeBoxBackground:               #9D5D00;                                             /* SystemFillColorCaution */
StatusBarOrangeBoxBorderTop:                1px solid #9D5D00;
StatusBarOrangeBoxBorderLeft:               1px solid #9D5D00;
StatusBarOrangeBoxBorderRight:              1px solid #9D5D00;
StatusBarOrangeBoxBorderBottom:             1px solid #9D5D00;
StatusBarRedBoxBackground:                  #C42B1C;                                             /* SystemFillColorCritical */
StatusBarRedBoxBorderTop:                   1px solid #C42B1C;
StatusBarRedBoxBorderLeft:                  1px solid #C42B1C;
StatusBarRedBoxBorderRight:                 1px solid #C42B1C;
StatusBarRedBoxBorderBottom:                1px solid #C42B1C;
DiagnosticsBubblesForeColor:                #1A1A1A;
DiagnosticsErrorBackColor:                  #FDE7E9;                                             /* SystemFillColorCriticalBackground */
DiagnosticsWarningsBackColor:               #FFF4CE;                                             /* SystemFillColorCautionBackground */
DiagnosticsHintsBackColor:                  #DFF6DD;                                             /* SystemFillColorSuccessBackground */
DiagnosticsInfosBackColor:                  rgb(0 95 184 / 12%);                                 /* attention, accent tint */

/* Properties panel */
PropertyCategoryBack:                       #5D5D5D;                                             /* IDE draws category text white, so this stays dark */
PropertySheetNameBackColor:                 #F9F9F9;
PropertySheetNameBackground:                #F9F9F9;
PropertySheetNameBorderColor:               1px solid rgba(0, 0, 0, 0.0578);
PropertySheetValueBackColor:                #FFFFFF;                                             /* ControlFillColorInputActive */
PropertySheetValueBorderColor:              1px solid rgba(0, 0, 0, 0.0578);
PropertySheetEntryBorder:                   1px solid rgba(0, 0, 0, 0.0578);
PropertySheetValueForeColor:                #1A1A1A;
PropertySheetValueDropDownBackColor:        #F9F9F9;
PropertySheetEntryUnimplementedBackColor:   #FDE7E9 !important;                                  /* SystemFillColorCriticalBackground */
PropertySheetValueUnimplementedBackColor:   #FDE7E9 !important;

/* Form designer */
FormDesignerCanvasBackground:               #EEEEEE;                                             /* SolidBackgroundFillColorSecondary */
FormDesignerCanvasBackground2:              radial-gradient(rgba(0, 0, 0, 0.09) 1px, transparent 1px) 0 0 / 16px 16px, #EEEEEE; /* dot grid instead of stripes */
DesignerBoxShadow:                          0 8px 16px rgba(0, 0, 0, 0.14);
DesignerRulerBackColor:                     #F9F9F9;
DesignerRulerCornerBackColor:               #F3F3F3;
DesignerRulerCornerBorder:                  1px solid rgba(0, 0, 0, 0.0578);
DesignerRulerCornerBorderRadius:            4px;
DesignerRulerCornerDotColor:                rgba(0, 0, 0, 0.62);
DesignerRulerCornerOutline:                 0;
DesignerRulerMarkerColor:                   #005FB8;                                             /* accent */
DesignerToolboxItemHoverBackground:         rgba(0, 0, 0, 0.037);
DesignerToolboxItemSelectedOutline:         1.5px solid #005FB8 !important;                      /* accent */

/* Dialogs: WinUI ContentDialog, light */
DialogHeaderBackColor:                      #005FB8;                                             /* IDE draws dialog title text white, so this stays the accent */
DialogGeneralBackColor:                     #FFFFFF;                                             /* LayerFillColorAlt over the base */
DialogGeneralForeColor:                     #1A1A1A;                                             /* TextFillColorPrimary */
DialogSubTextForeColor:                     rgba(0, 0, 0, 0.62);                                 /* TextFillColorSecondary */
DialogBoldFontWeight:                       600;                                                 /* SemiBold */
DialogButtonsBarBackColor:                  #F3F3F3;                                             /* command area */
DialogButtonsSectionTopBorder:              1px solid rgba(0, 0, 0, 0.0578);                     /* DividerStrokeColorDefault */
DialogButtonsBackColor:                     linear-gradient(#FBFBFB, #FBFBFB);                   /* ControlFillColorDefault; a gradient so the IDE's fixed #EBEFF5 hover colour sits under it */
DialogButtonForeColor:                      #1A1A1A;
DialogButtonBorderRadius:                   4px;                                                 /* ControlCornerRadius */
DialogButtonBoxShadow:                      none;
DialogButtonBorderTop:                      1px solid rgba(0, 0, 0, 0.0578);                     /* ControlStrokeColorDefault #0F000000 */
DialogButtonBorderLeft:                     1px solid rgba(0, 0, 0, 0.0578);
DialogButtonBorderRight:                    1px solid rgba(0, 0, 0, 0.0578);
DialogButtonBorderBottom:                   1px solid rgba(0, 0, 0, 0.16);                       /* ControlStrokeColorSecondary #29000000 */
DialogButtonFocusBackColor:                 linear-gradient(#FBFBFB, #FBFBFB);                   /* gradient for the same hover reason; one text colour is shared by all buttons, so focus is a ring, not an accent fill */
DialogButtonFocusBorderTop:                 1px solid rgba(0, 0, 0, 0.0578);
DialogButtonFocusBorderLeft:                1px solid rgba(0, 0, 0, 0.0578);
DialogButtonFocusBorderRight:               1px solid rgba(0, 0, 0, 0.0578);
DialogButtonFocusBorderBottom:              1px solid rgba(0, 0, 0, 0.16);
DialogButtonFocusRectColor:                 #1A1A1A;                                             /* FocusStrokeColorOuter */
DialogButtonFocusWidth:                     2px;                                                 /* FocusVisualPrimaryThickness */
DialogTabBarBackColor:                      #FFFFFF;
DialogTabBarBorderTop:                      2px solid #005FB8;                                   /* accent */
DialogTabForeColor:                         #1A1A1A;
DialogTabButtonBackColor:                   #F3F3F3;
DialogTabButtonForeColor:                   rgba(0, 0, 0, 0.62);                                 /* TextFillColorSecondary */
DialogNavBarBackColor:                      #F3F3F3;
DialogNavButtonBackColorSelected:           rgba(0, 0, 0, 0.0353);                               /* SubtleFillColorSecondary, NavigationViewItemBackgroundSelected (reference --color-neutral-selected) */
DialogTextInputBackColor:                   rgba(255, 255, 255, 0.702);                          /* ControlFillColorDefault #B3FFFFFF, TextBox rest (reference .text-field) */
DialogTextInputForeColor:                   #1A1A1A;
DialogTextInputBorder:                      1px solid rgba(0, 0, 0, 0.16) !important;
DialogTextInputOutline:                     0 !important;
DialogListBackColor:                        #FFFFFF;
DialogListHeaderBackColor:                  #F3F3F3;
DialogListHeaderForeColor:                  rgba(0, 0, 0, 0.62);
DialogListRowBorderBottom:                  1px solid rgba(0, 0, 0, 0.0578);
DialogImportListHoverBackColor:             rgba(0, 0, 0, 0.0373);                               /* ListViewItemBackgroundPointerOver, SubtleFillColorSecondary (BETA 1043) */
DialogImportListHoverForeColor:             #1A1A1A;                                             /* TextFillColorPrimary */
DialogTickForeColor:                        #1A1A1A;                                             /* TextFillColorPrimary; dialog check marks (BETA 1043) */
InfoBoxIconFilter:                          invert(1) opacity(0.6196);                           /* white PNG inverted to black at TextFillColorSecondary #9E000000 */
DialogConfigRowBorderBottom:                1px solid rgba(0, 0, 0, 0.0578);
DialogScrollTrackColor:                     transparent;
DialogScrollThumbColor:                     rgba(0, 0, 0, 0.4471);                               /* TextFillColorTertiary (reference scroll bar thumb) */
DialogScrollThumbColorHover:                rgba(0, 0, 0, 0.6196);                               /* TextFillColorSecondary (reference thumb hover) */
ModalDialogBorderTop:                       1px solid rgba(117, 117, 117, 0.4);                  /* SurfaceStrokeColorDefault */
ModalDialogBorderLeft:                      1px solid rgba(117, 117, 117, 0.4);
ModalDialogBorderRight:                     1px solid rgba(117, 117, 117, 0.4);
ModalDialogBorderBottom:                    1px solid rgba(117, 117, 117, 0.4);
ModalDialogOutline:                         0;
ModalDialogBorderRadiusTopLeft:             8px;                                                 /* OverlayCornerRadius */
ModalDialogBorderRadiusTopRight:            8px;
ModalDialogBorderRadiusBottomLeft:          8px;
ModalDialogBorderRadiusBottomRight:         8px;
ModalDialogBoxShadow:                       0 32px 64px rgba(0, 0, 0, 0.19);                     /* Dialog elevation */
FrontPageBackground:                        #F3F3F3;
FrontPageItemBackColor:                     #FFFFFF;                                             /* CardBackgroundFillColorDefault */
FrontPageItemBorder:                        1px solid rgba(0, 0, 0, 0.0578);                     /* CardStrokeColorDefault */
FrontPageItemBorderRadius:                  8px;
FrontPageSelectedItemBackColor:             rgb(0 95 184 / 10%) !important;                      /* accent tint */
FrontPageSelectedItemBorder:                1px solid rgba(0, 0, 0, 0.0578);                     /* despite the name, 1033 uses this for every card; selection is a fixed white border and blue outline */
FrontPageIconColor:                         #005FB8;                                             /* accent */
FrontPageBETANoticeColor:                   #1A1A1A;

/* Documents */
VirtualDocBackColor:                        #FFFFFF;
VirtualDocForeColor:                        #1A1A1A;
VirtualDocMarkdownBackColor:                #FFFFFF;
VirtualDocMarkdownBorderColor:              rgba(0, 0, 0, 0.0578);
VirtualDocMarkdownForeColor:                #1A1A1A;
VirtualDocMarkdownHeaderColor:              #9D5D00;

/* Icons: same filters as the IDE Light theme, minus the hover glows */
IconHoverFilter:                            contrast(1) brightness(0.7);
IconType2HoverFilter:                       invert(1);
IconType3HoverFilter:                       brightness(1.1) invert(1);
IconType8HoverFilter:                       brightness(1.1);
IconTypeUndoRedoHoverFilter:                brightness(1) invert(0.9);
PlayIconBlue:                               url('data:image/svg+xml;base64,');
StopIconRed:                                url('data:image/svg+xml;base64,PHN2ZyB2ZXJzaW9uPSIxLjEiIHZpZXdCb3g9IjAgMCAzMzAgMzMwIiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxyZWN0IHg9IjMwIiB5PSIzMCIgd2lkdGg9IjI3MCIgaGVpZ2h0PSIyNzAiIHJ4PSIyNCIgcnk9IjI0IiBzdHlsZT0iZmlsbDogI0M0MkIxQzsiPjwvcmVjdD48L3N2Zz4=');

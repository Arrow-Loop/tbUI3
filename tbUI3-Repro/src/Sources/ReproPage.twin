Class ReproPage

	Sub New()
	End Sub

    Private Sub PropertyPage_SelectionChanged()
        Text1.Text = CStr(Me.SelectedControls(0).Value)
    End Sub

    Private Sub Text1_Change()
        Me.Changed = True
    End Sub

    Private Sub PropertyPage_ApplyChanges()
        Me.SelectedControls(0).Value = CLng(Val(Text1.Text))
    End Sub

End Class
[FormDesignerId("35E99E9A-8C48-48C2-B333-6809F44B6A8B")]
[ClassId("32A0CE42-2A55-4FED-A85E-2FA3DAE02B62")]
[InterfaceId("04830CFD-8885-44BA-B656-3BE3DC1EB5B5")]
[EventInterfaceId("9537C7F3-9248-4E57-A001-3F7866775C78")]
[COMControl]
[Description("tbUI3 button. Direct2D/DirectWrite WinUI rendering with semantic system-icon support.")]
Public Class UI3Button

    ' S2 implements the rest state of WinUI's DefaultButtonStyle and AccentButtonStyle.
    ' S3 adds semantic icon content while preserving those visuals. Hover, pressed,
    ' disabled and focus states remain later roadmap steps.

    Public Event Click()

    ' Caption given to a newly dropped button. The saved default is an empty string, so a
    ' caption cleared in the designer stays empty (an icon-only button) instead of reloading as "Button".
    Private Const NEW_CONTROL_CAPTION As String = "Button"
    Private Const DEFAULT_CAPTION As String = ""
    Private Const DEFAULT_STYLE As Long = 0
    Private Const DEFAULT_ICON As Long = 0
    Private Const DEFAULT_ICON_GLYPH As String = ""
    Private Const DEFAULT_ICON_FONT_NAME As String = ""
    Private Const DEFAULT_ICON_POSITION As Long = 0

    Private m_Caption As String
    Private m_Style As UI3ButtonStyle
    Private m_Icon As UI3Icon
    Private m_IconGlyph As String
    Private m_IconFontName As String
    Private m_IconPosition As UI3IconPosition
    Private m_IconSpacing As Single
    Private m_Target As ID2D1DCRenderTarget

    Public Property Get Caption() As String
        Caption = m_Caption
    End Property

    Public Property Let Caption(ByVal Value As String)
        m_Caption = Value
        PropertyChanged "Caption"
        UserControl.Refresh
    End Property

    Public Property Get Style() As UI3ButtonStyle
        Style = m_Style
    End Property

    Public Property Let Style(ByVal Value As UI3ButtonStyle)
        m_Style = Value
        PropertyChanged "Style"
        UserControl.Refresh
    End Property

    ' Linked to the UI3IconPage picker: Icon gets its own "..." in the Properties pane, as in VB6
    ' (twinBASIC BETA 1008 and later; earlier betas open the page only from (Custom)).
    [PropertyPage("UI3IconPage")]
    [Description("Segoe Fluent Icons glyph, as in WinUI's FontIcon. Drawn in Segoe Fluent Icons, or Segoe MDL2 Assets on Windows 10.")]
    Public Property Get Icon() As UI3Icon
        Icon = m_Icon
    End Property

    Public Property Let Icon(ByVal Value As UI3Icon)
        m_Icon = Value
        If IconPageApplying Then SetPendingIcon DesignName(), Value
        DesignLog "Let Icon " & Hex$(ObjPtr(Me)) & " " & DesignName() & " = " & CLng(Value) & IIf(IconPageApplying, " (from page)", "")
        PropertyChanged "Icon"
        UserControl.Refresh
    End Property

    [Description("Advanced raw glyph override. When non-empty, this takes precedence over Icon.")]
    Public Property Get IconGlyph() As String
        IconGlyph = m_IconGlyph
    End Property

    Public Property Let IconGlyph(ByVal Value As String)
        m_IconGlyph = Value
        PropertyChanged "IconGlyph"
        UserControl.Refresh
    End Property

    [Description("Font family used only with an explicit IconGlyph. Leave empty for Segoe Fluent Icons with Segoe MDL2 Assets fallback.")]
    Public Property Get IconFontName() As String
        IconFontName = m_IconFontName
    End Property

    Public Property Let IconFontName(ByVal Value As String)
        m_IconFontName = Value
        PropertyChanged "IconFontName"
        UserControl.Refresh
    End Property

    [Description("Position of the icon relative to Caption.")]
    Public Property Get IconPosition() As UI3IconPosition
        IconPosition = m_IconPosition
    End Property

    Public Property Let IconPosition(ByVal Value As UI3IconPosition)
        If Value < ui3IconLeft Or Value > ui3IconBottom Then Err.Raise 380
        m_IconPosition = Value
        PropertyChanged "IconPosition"
        UserControl.Refresh
    End Property

    [Description("Gap in DIPs between icon and Caption. Default 8, following WinUI Gallery spacing guidance.")]
    Public Property Get IconSpacing() As Single
        IconSpacing = m_IconSpacing
    End Property

    Public Property Let IconSpacing(ByVal Value As Single)
        If Value < 0 Then Err.Raise 380
        m_IconSpacing = Value
        PropertyChanged "IconSpacing"
        UserControl.Refresh
    End Property

    Private Sub UserControl_InitProperties()
        m_Caption = NEW_CONTROL_CAPTION
        m_Style = DEFAULT_STYLE
        m_Icon = DEFAULT_ICON
        m_IconGlyph = DEFAULT_ICON_GLYPH
        m_IconFontName = DEFAULT_ICON_FONT_NAME
        m_IconPosition = DEFAULT_ICON_POSITION
        m_IconSpacing = ButtonIconSpacingDefault
    End Sub

    Private Sub UserControl_ReadProperties(PropBag As PropertyBag)
        m_Caption = PropBag.ReadProperty("Caption", DEFAULT_CAPTION)
        m_Style = PropBag.ReadProperty("Style", DEFAULT_STYLE)
        m_Icon = PropBag.ReadProperty("Icon", DEFAULT_ICON)
        m_IconGlyph = PropBag.ReadProperty("IconGlyph", DEFAULT_ICON_GLYPH)
        m_IconFontName = PropBag.ReadProperty("IconFontName", DEFAULT_ICON_FONT_NAME)
        m_IconPosition = PropBag.ReadProperty("IconPosition", DEFAULT_ICON_POSITION)
        m_IconSpacing = PropBag.ReadProperty("IconSpacing", ButtonIconSpacingDefault)
        DesignLog "ReadProperties " & Hex$(ObjPtr(Me)) & " " & DesignName() & " Icon = " & CLng(m_Icon)
        If Not IsUserMode() Then
            If TakePendingIcon(DesignName(), m_Icon) Then PropertyChanged "Icon"
        End If
    End Sub

    ' Design-time name of this control, for the UI3IconPage designer bridge (see UI3Icons).
    Private Function DesignName() As String
        On Error Resume Next
        DesignName = UserControl.Ambient.DisplayName
    End Function

    Private Function IsUserMode() As Boolean
        IsUserMode = True
        On Error Resume Next
        IsUserMode = UserControl.Ambient.UserMode
    End Function

    Private Sub UserControl_WriteProperties(PropBag As PropertyBag)
        DesignLog "WriteProperties " & Hex$(ObjPtr(Me)) & " " & DesignName() & " Icon = " & CLng(m_Icon)
        PropBag.WriteProperty "Caption", m_Caption, DEFAULT_CAPTION
        PropBag.WriteProperty "Style", m_Style, DEFAULT_STYLE
        PropBag.WriteProperty "Icon", m_Icon, DEFAULT_ICON
        PropBag.WriteProperty "IconGlyph", m_IconGlyph, DEFAULT_ICON_GLYPH
        PropBag.WriteProperty "IconFontName", m_IconFontName, DEFAULT_ICON_FONT_NAME
        PropBag.WriteProperty "IconPosition", m_IconPosition, DEFAULT_ICON_POSITION
        PropBag.WriteProperty "IconSpacing", m_IconSpacing, ButtonIconSpacingDefault
    End Sub

    Private Sub UserControl_Resize()
        UserControl.Refresh
    End Sub

    Private Sub UserControl_Click()
        RaiseEvent Click
    End Sub

    Private Sub UserControl_AmbientChanged(PropertyName As String)
        If StrComp(PropertyName, "BackColor", vbTextCompare) = 0 Then UserControl.Refresh
    End Sub

    Private Sub UserControl_Paint()
        Dim hr As Long
        hr = PaintWithDirect2D()
        If hr <> 0 Then PaintFailure hr
    End Sub

    ' Returns 0, or the failing HRESULT / error number.
    Private Function PaintWithDirect2D() As Long
        Dim hdc As LongPtr
        Dim client As UI3GdiRect
        Dim dpi As Single
        Dim w As Single
        Dim h As Single
        Dim drawing As Boolean

        On Error GoTo Failed

        hdc = UserControl.hDC
        If hdc = 0 Then Exit Function
        UI3GetClientRect UserControl.hWnd, client
        If client.Right <= 0 Or client.Bottom <= 0 Then Exit Function

        If m_Target Is Nothing Then Set m_Target = CreateDCTarget()
        dpi = DpiOfDC(hdc)
        m_Target.SetDpi dpi, dpi
        m_Target.BindDC hdc, client
        ' Work in device-independent pixels, as WinUI does.
        w = client.Right * 96! / dpi
        h = client.Bottom * 96! / dpi

        m_Target.BeginDraw
        drawing = True
        DrawButton w, h
        drawing = False

        Dim hr As Long
        hr = m_Target.EndDraw(0, 0)
        If hr < 0 Then
            PaintWithDirect2D = hr
            Set m_Target = Nothing
        End If
        Exit Function

Failed:
        PaintWithDirect2D = Err.Number
        If PaintWithDirect2D = 0 Then PaintWithDirect2D = -1
        If drawing Then m_Target.EndDraw 0, 0
        Set m_Target = Nothing
    End Function

    Private Sub DrawButton(ByVal w As Single, ByVal h As Single)
        Dim dark As Boolean
        Dim fill As Long
        Dim strokeDefault As Long
        Dim strokeSecondary As Long
        Dim foreground As Long
        Dim borderAtBottom As Boolean
        Dim fillInset As Single
        Dim backdrop As D2D1_COLOR_F
        Dim box As D2D1_ROUNDED_RECT
        Dim r As Single
        Dim t As Single

        dark = IsDarkMode()
        r = ControlCornerRadius
        t = ButtonBorderThemeThickness

        If m_Style = ui3ButtonAccent Then
            If dark Then
                fill = AccentShade(ACCENT_LIGHT2)
                foreground = DARK_TextOnAccentFillColorPrimary
                strokeDefault = DARK_ControlStrokeColorOnAccentDefault
                strokeSecondary = DARK_ControlStrokeColorOnAccentSecondary
            Else
                fill = AccentShade(ACCENT_DARK1)
                foreground = LIGHT_TextOnAccentFillColorPrimary
                strokeDefault = LIGHT_ControlStrokeColorOnAccentDefault
                strokeSecondary = LIGHT_ControlStrokeColorOnAccentSecondary
            End If
            borderAtBottom = True
            fillInset = 0
        Else
            If dark Then
                fill = DARK_ControlFillColorDefault
                foreground = DARK_TextFillColorPrimary
                strokeDefault = DARK_ControlStrokeColorDefault
                strokeSecondary = DARK_ControlStrokeColorSecondary
                borderAtBottom = False
            Else
                fill = LIGHT_ControlFillColorDefault
                foreground = LIGHT_TextFillColorPrimary
                strokeDefault = LIGHT_ControlStrokeColorDefault
                strokeSecondary = LIGHT_ControlStrokeColorSecondary
                borderAtBottom = True
            End If
            fillInset = t
        End If

        backdrop = ColorFromArgb(ArgbFromOleColor(ContainerBackColor()))
        m_Target.Clear backdrop

        box = RoundedRect(fillInset, fillInset, w - fillInset, h - fillInset, r - fillInset)
        m_Target.FillRoundedRectangle box, SolidBrush(m_Target, fill)

        Dim border As ID2D1LinearGradientBrush
        If borderAtBottom Then
            Set border = VerticalGradientBrush(m_Target, h, h - ElevationBorderGradientLength, _
                ElevationBorderStop0, strokeSecondary, ElevationBorderStop1, strokeDefault)
        Else
            Set border = VerticalGradientBrush(m_Target, 0, ElevationBorderGradientLength, _
                ElevationBorderStop0, strokeSecondary, ElevationBorderStop1, strokeDefault)
        End If
        box = RoundedRect(t / 2, t / 2, w - t / 2, h - t / 2, r - t / 2)
        m_Target.DrawRoundedRectangle box, border, t, 0

        Dim iconFamily As String
        Dim glyph As String
        ResolveIconContent glyph, iconFamily

        DrawButtonContent m_Target, m_Caption, glyph, iconFamily, SymbolIconDefaultFontSize, _
            m_IconPosition, m_IconSpacing, ButtonPaddingLeft, ButtonPaddingTop, _
            w - ButtonPaddingRight, h - ButtonPaddingBottom, foreground
    End Sub

    Private Sub ResolveIconContent(ByRef Glyph As String, ByRef FontFamily As String)
        Glyph = ""
        FontFamily = ""

        If Len(m_IconGlyph) <> 0 Then
            Glyph = m_IconGlyph
            FontFamily = m_IconFontName
            If Len(FontFamily) = 0 Then FontFamily = SystemIconFontFamily()
        ElseIf m_Icon <> ui3IconNone Then
            FontFamily = SystemIconFontFamily()
            Glyph = SemanticIconGlyph(m_Icon)
        End If
    End Sub

    Private Function ContainerBackColor() As Long
        On Error Resume Next
        ContainerBackColor = vbButtonFace
        ContainerBackColor = UserControl.Ambient.BackColor
    End Function

    Private Sub PaintFailure(ByVal hr As Long)
        On Error Resume Next
        UserControl.ScaleMode = vbPixels
        UserControl.Cls
        UserControl.ForeColor = vbRed
        UserControl.CurrentX = 2
        UserControl.CurrentY = 2
        UserControl.Print "D2D error &H" & Hex$(hr)
    End Sub

End Class

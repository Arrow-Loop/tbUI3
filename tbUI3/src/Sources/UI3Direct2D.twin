' tbUI3 private Direct2D / DirectWrite layer.
'
' The interface declarations below are a minimal private subset adapted from
' fafalone's WinDevLib (https://github.com/fafalone/WinDevLib, wdDirectX.twin,
' CC0 / public domain). Thanks to fafalone. Only the vtable slots tbUI3 calls are
' declared with real signatures; every other slot is a numbered placeholder that
' keeps the vtable order and must never be called. Slot order follows d2d1.h and
' dwrite.h. Nothing in this file is visible outside the package.

[InterfaceId("2CD90691-12E2-11DC-9FED-001143A055F9")]
[OleAutomation(False)]
Private Interface ID2D1Resource Extends stdole.IUnknown
    Sub Slot00_GetFactory()
End Interface

[InterfaceId("2CD906A8-12E2-11DC-9FED-001143A055F9")]

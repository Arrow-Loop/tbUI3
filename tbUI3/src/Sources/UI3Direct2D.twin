Private Module UI3D2D

    Public Type UI3Guid
        Data1 As Long
        Data2 As Integer
        Data3 As Integer
        Data4(0 To 7) As Byte
    End Type

    Public Type UI3GdiRect
        Left As Long
        Top As Long
        Right As Long
        Bottom As Long
    End Type

    Public Type D2D1_COLOR_F
        r As Single
        g As Single
        b As Single
        a As Single
    End Type

    Public Type D2D1_POINT_2F
        x As Single
        y As Single
    End Type

    Public Type D2D1_RECT_F
        Left As Single
        Top As Single
        Right As Single
        Bottom As Single
    End Type

    Public Type D2D1_ROUNDED_RECT
        rect As D2D1_RECT_F
        radiusX As Single
        radiusY As Single
    End Type

    Public Type D2D1_GRADIENT_STOP
        position As Single
        color As D2D1_COLOR_F
    End Type

    Public Type D2D1_LINEAR_GRADIENT_BRUSH_PROPERTIES
        startPoint As D2D1_POINT_2F
        endPoint As D2D1_POINT_2F
    End Type

    Public Type D2D1_PIXEL_FORMAT
        dxgiFormat As Long
        alphaMode As Long
    End Type

    Public Type D2D1_RENDER_TARGET_PROPERTIES
        targetType As Long
        pixelFormat As D2D1_PIXEL_FORMAT
        dpiX As Single
        dpiY As Single
        usage As Long
        minLevel As Long
    End Type

    Public Type DWRITE_TEXT_METRICS
        Left As Single
        Top As Single
        width As Single
        widthIncludingTrailingWhitespace As Single
        Height As Single
        layoutWidth As Single
        layoutHeight As Single
        maxBidiReorderingDepth As Long
        lineCount As Long
    End Type

    Public Const D2D1_FACTORY_TYPE_SINGLE_THREADED As Long = 0
    Public Const D2D1_RENDER_TARGET_TYPE_DEFAULT As Long = 0
    Public Const DXGI_FORMAT_B8G8R8A8_UNORM As Long = 87
    Public Const D2D1_ALPHA_MODE_PREMULTIPLIED As Long = 1
    Public Const D2D1_TEXT_ANTIALIAS_MODE_GRAYSCALE As Long = 2
    Public Const D2D1_DRAW_TEXT_OPTIONS_CLIP As Long = 2
    Public Const D2D1_GAMMA_2_2 As Long = 0
    Public Const D2D1_EXTEND_MODE_CLAMP As Long = 0
    Public Const D2DERR_RECREATE_TARGET As Long = &H8899000C
    Public Const DWRITE_FACTORY_TYPE_SHARED As Long = 0
    Public Const DWRITE_FONT_WEIGHT_NORMAL As Long = 400
    Public Const DWRITE_FONT_WEIGHT_SEMI_BOLD As Long = 600
    Public Const DWRITE_FONT_STYLE_NORMAL As Long = 0
    Public Const DWRITE_FONT_STRETCH_NORMAL As Long = 5
    Public Const DWRITE_TEXT_ALIGNMENT_CENTER As Long = 2
    Public Const DWRITE_PARAGRAPH_ALIGNMENT_CENTER As Long = 2
    Public Const DWRITE_WORD_WRAPPING_NO_WRAP As Long = 1
    Public Const DWRITE_MEASURING_MODE_NATURAL As Long = 0

    Private Const IID_ID2D1Factory As String = "{06152247-6F50-465A-9245-118BFD3B6007}"
    Private Const IID_IDWriteFactory As String = "{B859EE5A-D838-4B5B-A2E8-1ADC7D93DB48}"
    Private Const LOGPIXELSX As Long = 88

    Private Declare PtrSafe Function D2D1CreateFactory Lib "d2d1" (ByVal factoryType As Long, ByRef riid As UI3Guid, ByVal pFactoryOptions As LongPtr, ByRef ppIFactory As ID2D1Factory) As Long
    Private Declare PtrSafe Function DWriteCreateFactory Lib "dwrite" (ByVal factoryType As Long, ByRef iid As UI3Guid, ByRef ppFactory As IDWriteFactory) As Long
    Private Declare PtrSafe Function IIDFromString Lib "ole32" (ByVal lpsz As LongPtr, ByRef lpiid As UI3Guid) As Long
    Private Declare PtrSafe Function GetDeviceCaps Lib "gdi32" (ByVal hdc As LongPtr, ByVal nIndex As Long) As Long
    Private Declare PtrSafe Function OleTranslateColor Lib "oleaut32" (ByVal clr As Long, ByVal hpal As LongPtr, ByRef lpcolorref As Long) As Long
    Public Declare PtrSafe Function UI3GetClientRect Lib "user32" Alias "GetClientRect" (ByVal hWnd As LongPtr, ByRef lpRect As UI3GdiRect) As Long

    ' One factory of each kind per process, created on first use.
    Private m_D2DFactory As ID2D1Factory
    Private m_DWriteFactory As IDWriteFactory
    Private m_ControlTextFormat As IDWriteTextFormat
    Private m_IconTextFormat As IDWriteTextFormat
    Private m_IconTextFormatFamily As String
    Private m_IconTextFormatSize As Single

    Private Function GuidFromString(ByVal guidText As String) As UI3Guid
        Dim id As UI3Guid
        IIDFromString StrPtr(guidText), id
        GuidFromString = id
    End Function

    Private Function D2DFactory() As ID2D1Factory
        If m_D2DFactory Is Nothing Then
            Dim hr As Long
            Dim iid As UI3Guid
            iid = GuidFromString(IID_ID2D1Factory)
            hr = D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, iid, 0, m_D2DFactory)
            If hr < 0 Then Err.Raise hr, "tbUI3", "D2D1CreateFactory failed"
        End If
        Set D2DFactory = m_D2DFactory
    End Function

    Private Function DWriteFactory() As IDWriteFactory
        If m_DWriteFactory Is Nothing Then
            Dim hr As Long
            Dim iid As UI3Guid
            iid = GuidFromString(IID_IDWriteFactory)
            hr = DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED, iid, m_DWriteFactory)
            If hr < 0 Then Err.Raise hr, "tbUI3", "DWriteCreateFactory failed"
        End If
        Set DWriteFactory = m_DWriteFactory
    End Function

    ' A render target that draws into a GDI device context (BindDC before each BeginDraw).
    ' 32-bit BGRA with premultiplied alpha, as ID2D1DCRenderTarget requires.
    Public Function CreateDCTarget() As ID2D1DCRenderTarget
        Dim props As D2D1_RENDER_TARGET_PROPERTIES
        props.targetType = D2D1_RENDER_TARGET_TYPE_DEFAULT
        props.pixelFormat.dxgiFormat = DXGI_FORMAT_B8G8R8A8_UNORM
        props.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED
        props.dpiX = 96
        props.dpiY = 96
        Dim target As ID2D1DCRenderTarget
        Set target = D2DFactory().CreateDCRenderTarget(props)
        ' WinUI renders text with grayscale antialiasing; ClearType needs an opaque target anyway.
        target.SetTextAntialiasMode D2D1_TEXT_ANTIALIAS_MODE_GRAYSCALE
        Set CreateDCTarget = target
    End Function

    Public Function DpiOfDC(ByVal hdc As LongPtr) As Single
        Dim dpi As Long
        dpi = GetDeviceCaps(hdc, LOGPIXELSX)
        If dpi <= 0 Then dpi = 96
        DpiOfDC = dpi
    End Function

    Public Function FontFamilyExists(ByVal familyName As String) As Boolean
        Dim fonts As IDWriteFontCollection
        Dim index As Long
        Dim exists As Long
        DWriteFactory().GetSystemFontCollection fonts, 0
        fonts.FindFamilyName StrPtr(familyName), index, exists
        FontFamilyExists = (exists <> 0)
    End Function

    ' Text format for control content: ContentControlThemeFontFamily at ControlContentThemeFontSize
    ' (14), FontWeight Normal (generic.xaml; DefaultButtonStyle in Button_themeresources.xaml).
    ' WinUI's XamlAutoFontFamily resolves to Segoe UI Variable on Windows 11; Windows 10 lacks it,
    ' so fall back to Segoe UI there.
    Public Function ControlTextFormat() As IDWriteTextFormat
        If m_ControlTextFormat Is Nothing Then
            Dim family As String
            family = "Segoe UI Variable Text"
            If Not FontFamilyExists(family) Then family = "Segoe UI"
            Set m_ControlTextFormat = CreateCenteredTextFormat(family, 14)
        End If
        Set ControlTextFormat = m_ControlTextFormat
    End Function

    Public Function IconTextFormat(ByVal family As String, ByVal fontSize As Single) As IDWriteTextFormat
        If m_IconTextFormat Is Nothing Or StrComp(m_IconTextFormatFamily, family, vbTextCompare) <> 0 Or m_IconTextFormatSize <> fontSize Then
            Set m_IconTextFormat = CreateCenteredTextFormat(family, fontSize)
            m_IconTextFormatFamily = family
            m_IconTextFormatSize = fontSize
        End If
        Set IconTextFormat = m_IconTextFormat
    End Function

    Private Function CreateCenteredTextFormat(ByVal family As String, ByVal fontSize As Single, _
            Optional ByVal fontWeight As Long = DWRITE_FONT_WEIGHT_NORMAL) As IDWriteTextFormat
        Dim format As IDWriteTextFormat
        Set format = DWriteFactory().CreateTextFormat(StrPtr(family), 0, _
            fontWeight, DWRITE_FONT_STYLE_NORMAL, DWRITE_FONT_STRETCH_NORMAL, fontSize, StrPtr("en-us"))
        format.SetTextAlignment DWRITE_TEXT_ALIGNMENT_CENTER
        format.SetParagraphAlignment DWRITE_PARAGRAPH_ALIGNMENT_CENTER
        format.SetWordWrapping DWRITE_WORD_WRAPPING_NO_WRAP
        Set CreateCenteredTextFormat = format
    End Function

    Private Sub MeasureTextWithFormat(ByVal text As String, ByVal format As IDWriteTextFormat, ByRef width As Single, ByRef height As Single)
        width = 0
        height = 0
        If Len(text) = 0 Then Exit Sub

        Dim layout As IDWriteTextLayout
        Dim metrics As DWRITE_TEXT_METRICS
        Set layout = DWriteFactory().CreateTextLayout(StrPtr(text), Len(text), format, 4096, 4096)
        metrics = layout.GetMetrics()
        width = metrics.widthIncludingTrailingWhitespace
        height = metrics.Height
    End Sub

    Public Sub MeasureControlText(ByVal text As String, ByRef width As Single, ByRef height As Single)
        MeasureTextWithFormat text, ControlTextFormat(), width, height
    End Sub

    Public Sub MeasureIconText(ByVal text As String, ByVal family As String, ByVal fontSize As Single, ByRef width As Single, ByRef height As Single)
        MeasureTextWithFormat text, IconTextFormat(family, fontSize), width, height
    End Sub

    Private Sub DrawTextWithFormat(ByVal target As ID2D1RenderTarget, ByVal text As String, ByVal format As IDWriteTextFormat, _
            ByVal x0 As Single, ByVal y0 As Single, ByVal x1 As Single, ByVal y1 As Single, ByVal argb As Long)
        If Len(text) = 0 Then Exit Sub
        Dim layout As D2D1_RECT_F
        layout.Left = x0
        layout.Top = y0
        layout.Right = x1
        layout.Bottom = y1
        Dim brush As ID2D1SolidColorBrush
        Set brush = SolidBrush(target, argb)
        target.DrawText StrPtr(text), Len(text), format, layout, brush, D2D1_DRAW_TEXT_OPTIONS_CLIP, DWRITE_MEASURING_MODE_NATURAL
    End Sub

    Public Sub DrawButtonContent(ByVal target As ID2D1RenderTarget, ByVal caption As String, ByVal glyph As String, ByVal iconFamily As String, _
            ByVal iconFontSize As Single, ByVal iconPosition As UI3IconPosition, ByVal iconSpacing As Single, _
            ByVal x0 As Single, ByVal y0 As Single, ByVal x1 As Single, ByVal y1 As Single, ByVal argb As Long)
        Dim hasText As Boolean
        Dim hasIcon As Boolean
        Dim textW As Single
        Dim textH As Single
        Dim iconW As Single
        Dim iconH As Single
        Dim startX As Single
        Dim startY As Single
        Dim totalW As Single
        Dim totalH As Single

        hasText = (Len(caption) <> 0)
        hasIcon = (Len(glyph) <> 0)
        If Not hasText And Not hasIcon Then Exit Sub

        If hasText Then MeasureControlText caption, textW, textH
        If hasIcon Then MeasureIconText glyph, iconFamily, iconFontSize, iconW, iconH

        If hasText And Not hasIcon Then
            DrawCenteredText target, caption, x0, y0, x1, y1, argb
            Exit Sub
        End If

        If hasIcon And Not hasText Then
            DrawTextWithFormat target, glyph, IconTextFormat(iconFamily, iconFontSize), x0, y0, x1, y1, argb
            Exit Sub
        End If

        If iconSpacing < 0 Then iconSpacing = 0

        If iconPosition = ui3IconTop Or iconPosition = ui3IconBottom Then
            totalH = iconH + iconSpacing + textH
            startY = y0 + ((y1 - y0) - totalH) / 2
            If iconPosition = ui3IconTop Then
                DrawTextWithFormat target, glyph, IconTextFormat(iconFamily, iconFontSize), x0, startY, x1, startY + iconH, argb
                DrawTextWithFormat target, caption, ControlTextFormat(), x0, startY + iconH + iconSpacing, x1, startY + totalH, argb
            Else
                DrawTextWithFormat target, caption, ControlTextFormat(), x0, startY, x1, startY + textH, argb
                DrawTextWithFormat target, glyph, IconTextFormat(iconFamily, iconFontSize), x0, startY + textH + iconSpacing, x1, startY + totalH, argb
            End If
        Else
            totalW = iconW + iconSpacing + textW
            startX = x0 + ((x1 - x0) - totalW) / 2
            If iconPosition = ui3IconRight Then
                DrawTextWithFormat target, caption, ControlTextFormat(), startX, y0, startX + textW, y1, argb
                DrawTextWithFormat target, glyph, IconTextFormat(iconFamily, iconFontSize), startX + textW + iconSpacing, y0, startX + totalW, y1, argb
            Else
                DrawTextWithFormat target, glyph, IconTextFormat(iconFamily, iconFontSize), startX, y0, startX + iconW, y1, argb
                DrawTextWithFormat target, caption, ControlTextFormat(), startX + iconW + iconSpacing, y0, startX + totalW, y1, argb
            End If
        End If
    End Sub

    ' &HAARRGGBB (the XAML #AARRGGBB notation) to a straight-alpha Direct2D colour.
    Public Function ColorFromArgb(ByVal argb As Long) As D2D1_COLOR_F
        Dim c As D2D1_COLOR_F
        Dim alpha As Long
        alpha = (argb And &H7F000000) \ &H1000000
        If argb < 0 Then alpha = alpha Or &H80&
        c.a = alpha / 255!
        c.r = ((argb And &HFF0000) \ &H10000) / 255!
        c.g = ((argb And &HFF00&) \ &H100&) / 255!
        c.b = (argb And &HFF&) / 255!
        ColorFromArgb = c
    End Function

    ' A VB OLE_COLOR (BGR, or a system colour such as vbButtonFace) to an opaque &HAARRGGBB value.
    Public Function ArgbFromOleColor(ByVal oleColor As Long) As Long
        Dim bgr As Long
        If OleTranslateColor(oleColor, 0, bgr) < 0 Then bgr = 0
        ArgbFromOleColor = &HFF000000 Or ((bgr And &HFF&) * &H10000) Or (bgr And &HFF00&) Or ((bgr And &HFF0000) \ &H10000)
    End Function

    Public Function SolidBrush(ByVal target As ID2D1RenderTarget, ByVal argb As Long) As ID2D1SolidColorBrush
        Dim c As D2D1_COLOR_F
        c = ColorFromArgb(argb)
        Set SolidBrush = target.CreateSolidColorBrush(c, 0)
    End Function

    ' Two-stop vertical gradient in absolute coordinates, clamped beyond its ends.
    Public Function VerticalGradientBrush(ByVal target As ID2D1RenderTarget, ByVal startY As Single, ByVal endY As Single, _
            ByVal offset0 As Single, ByVal argb0 As Long, ByVal offset1 As Single, ByVal argb1 As Long) As ID2D1LinearGradientBrush
        Dim stops(0 To 1) As D2D1_GRADIENT_STOP
        stops(0).position = offset0
        stops(0).color = ColorFromArgb(argb0)
        stops(1).position = offset1
        stops(1).color = ColorFromArgb(argb1)
        Dim stopList As ID2D1GradientStopCollection
        Set stopList = target.CreateGradientStopCollection(stops(0), 2, D2D1_GAMMA_2_2, D2D1_EXTEND_MODE_CLAMP)
        Dim props As D2D1_LINEAR_GRADIENT_BRUSH_PROPERTIES
        props.startPoint.y = startY
        props.endPoint.y = endY
        Set VerticalGradientBrush = target.CreateLinearGradientBrush(props, 0, stopList)
    End Function

    Public Function RoundedRect(ByVal x0 As Single, ByVal y0 As Single, ByVal x1 As Single, ByVal y1 As Single, ByVal radius As Single) As D2D1_ROUNDED_RECT
        Dim rr As D2D1_ROUNDED_RECT
        rr.rect.Left = x0
        rr.rect.Top = y0
        rr.rect.Right = x1
        rr.rect.Bottom = y1
        rr.radiusX = radius
        rr.radiusY = radius
        RoundedRect = rr
    End Function

    Public Sub DrawCenteredText(ByVal target As ID2D1RenderTarget, ByVal caption As String, ByVal x0 As Single, ByVal y0 As Single, _
            ByVal x1 As Single, ByVal y1 As Single, ByVal argb As Long)
        If Len(caption) = 0 Then Exit Sub
        Dim layout As D2D1_RECT_F
        layout.Left = x0
        layout.Top = y0
        layout.Right = x1
        layout.Bottom = y1
        Dim brush As ID2D1SolidColorBrush
        Set brush = SolidBrush(target, argb)
        target.DrawText StrPtr(caption), Len(caption), ControlTextFormat(), layout, brush, D2D1_DRAW_TEXT_OPTIONS_CLIP, DWRITE_MEASURING_MODE_NATURAL
    End Sub

    Public Sub DrawCenteredTextStyled(ByVal target As ID2D1RenderTarget, ByVal caption As String, _
            ByVal fontSize As Single, ByVal fontWeight As Long, ByVal x0 As Single, ByVal y0 As Single, _
            ByVal x1 As Single, ByVal y1 As Single, ByVal argb As Long)
        If Len(caption) = 0 Then Exit Sub
        Dim family As String
        family = "Segoe UI Variable Text"
        If Not FontFamilyExists(family) Then family = "Segoe UI"
        DrawTextWithFormat target, caption, CreateCenteredTextFormat(family, fontSize, fontWeight), _
            x0, y0, x1, y1, argb
    End Sub

End Module

    [PreserveSig]
    Sub DrawText(ByVal textString As LongPtr, ByVal stringLength As Long, ByVal textFormat As IDWriteTextFormat, ByRef layoutRect As D2D1_RECT_F, ByVal defaultFillBrush As ID2D1Brush, ByVal options As Long, ByVal measuringMode As Long)
    Sub Slot24_DrawTextLayout()

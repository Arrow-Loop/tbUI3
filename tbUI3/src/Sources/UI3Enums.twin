Module UI3Enums

    [Description("Visual style of a UI3Button. WinUI equivalents: Button (Standard), Button with AccentButtonStyle (Accent).")]
    Public Enum UI3ButtonStyle
        ui3ButtonStandard = 0
        ui3ButtonAccent = 1
    End Enum

    [Description("A shade of the Windows accent colour, light to dark. WinUI equivalents: SystemAccentColorLight3 ... SystemAccentColorDark3.")]
    Public Enum UI3AccentShade
        ui3AccentLight3 = 0
        ui3AccentLight2 = 1
        ui3AccentLight1 = 2
        ui3AccentBase = 3
        ui3AccentDark1 = 4
        ui3AccentDark2 = 5
        ui3AccentDark3 = 6
    End Enum

    [Description("Theme mode used by UI3FormTheme and UI3Window.Attach.")]
    Public Enum UI3ThemeMode
        ui3ThemeSystem = 0
        ui3ThemeLight = 1
        ui3ThemeDark = 2
    End Enum

    [Description("Position of an icon relative to a UI3Button caption.")]
    Public Enum UI3IconPosition
        ui3IconLeft = 0
        ui3IconTop = 1
        ui3IconRight = 2
        ui3IconBottom = 3
    End Enum

    ' Values are WinUI's own Symbol enum values (Microsoft.UI.Xaml.Controls.Symbol), copied from
    ' microsoft-ui-xaml main commit cd7c7c41, dxaml/xcp/core/core/elements/icon.cpp,
    ' CSymbolIcon::ConvertSymbolValueToGlyph. Microsoft never renumbers these, so forms that save an
    ' icon stay correct when new symbols are added. They are IDs, not the glyphs drawn: UI3Icons maps
    ' each one to its modern glyph, as WinUI does. Add new symbols with their WinUI value; never renumber.
    [Description("Semantic WinUI symbol icon. Values match WinUI's Symbol enum.")]
    Public Enum UI3Icon

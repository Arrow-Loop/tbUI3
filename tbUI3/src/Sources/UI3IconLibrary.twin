' tbUI3 icon library: the Fluent UI System Icons and WinUI Gallery images the icon picker offers.
'
' The library is one file per PC, %LOCALAPPDATA%\tbUI3\tbUI3-Icons.dat, needed only at design time
' (built apps carry just the icons a developer picked). The picker's Setup tab installs, updates,
' reinstalls and removes it. Releases live in https://github.com/Arrow-Loop/tbUI3-Libraries: the
' manifest on main names the current zip, its size and SHA-256. tools/build-icon-library.mjs builds
' both and documents the .dat format.
'
' Install steps, each a separate call so the picker can show progress between them:
' IconLibraryCheckLatest, IconLibraryDownload, IconLibraryUnpack (Windows' own tar.exe), IconLibraryCommit.

Private Module UI3IconLibrary

    Private Const MANIFEST_URL As String = "https://raw.githubusercontent.com/Arrow-Loop/tbUI3-Libraries/main/icons/manifest.txt"
    ' A manifest may only send the download to this repository's releases.
    Private Const RELEASE_URL_PREFIX As String = "https://github.com/Arrow-Loop/tbUI3-Libraries/releases/download/"
    Private Const LIBRARY_FILE As String = "tbUI3-Icons.dat"
    Private Const NOTICE_FILE As String = "NOTICE.txt"
    Private Const LIBRARY_MAGIC As String = "tbUI3LIB"
    Private Const LIBRARY_FORMAT As Long = 1
    Private Const TAR_TIMEOUT_MS As Long = 300000

    Private Const MOVEFILE_REPLACE_EXISTING As Long = 1
    Private Const MOVEFILE_COPY_ALLOWED As Long = 2
    Private Const CREATE_NO_WINDOW As Long = &H8000000
    Private Const WAIT_OBJECT_0 As Long = 0

    Private Type UI3StartupInfo
        cb As Long
        lpReserved As LongPtr
        lpDesktop As LongPtr
        lpTitle As LongPtr
        dwX As Long
        dwY As Long
        dwXSize As Long
        dwYSize As Long
        dwXCountChars As Long
        dwYCountChars As Long
        dwFillAttribute As Long
        dwFlags As Long
        wShowWindow As Integer
        cbReserved2 As Integer
        lpReserved2 As LongPtr
        hStdInput As LongPtr
        hStdOutput As LongPtr
        hStdError As LongPtr
    End Type

    Private Type UI3ProcessInfo
        hProcess As LongPtr
        hThread As LongPtr
        dwProcessId As Long
        dwThreadId As Long
    End Type

    Private Declare PtrSafe Function URLDownloadToFileW Lib "urlmon" (ByVal pCaller As LongPtr, ByVal szURL As LongPtr, _
        ByVal szFileName As LongPtr, ByVal dwReserved As Long, ByVal lpfnCB As LongPtr) As Long
    Private Declare PtrSafe Function DeleteUrlCacheEntryW Lib "wininet" (ByVal lpszUrlName As LongPtr) As Long
    Private Declare PtrSafe Function BCryptOpenAlgorithmProvider Lib "bcrypt" (ByRef phAlgorithm As LongPtr, _
        ByVal pszAlgId As LongPtr, ByVal pszImplementation As LongPtr, ByVal dwFlags As Long) As Long
    Private Declare PtrSafe Function BCryptHash Lib "bcrypt" (ByVal hAlgorithm As LongPtr, ByVal pbSecret As LongPtr, _
        ByVal cbSecret As Long, ByVal pbInput As LongPtr, ByVal cbInput As Long, ByVal pbOutput As LongPtr, _
        ByVal cbOutput As Long) As Long
    Private Declare PtrSafe Function BCryptCloseAlgorithmProvider Lib "bcrypt" (ByVal hAlgorithm As LongPtr, _
        ByVal dwFlags As Long) As Long
    Private Declare PtrSafe Function CreateProcessW Lib "kernel32" (ByVal lpApplicationName As LongPtr, _
        ByVal lpCommandLine As LongPtr, ByVal lpProcessAttributes As LongPtr, ByVal lpThreadAttributes As LongPtr, _
        ByVal bInheritHandles As Long, ByVal dwCreationFlags As Long, ByVal lpEnvironment As LongPtr, _
        ByVal lpCurrentDirectory As LongPtr, ByRef lpStartupInfo As UI3StartupInfo, _
        ByRef lpProcessInformation As UI3ProcessInfo) As Long
    Private Declare PtrSafe Function WaitForSingleObject Lib "kernel32" (ByVal hHandle As LongPtr, _
        ByVal dwMilliseconds As Long) As Long
    Private Declare PtrSafe Function GetExitCodeProcess Lib "kernel32" (ByVal hProcess As LongPtr, _
        ByRef lpExitCode As Long) As Long
    Private Declare PtrSafe Function TerminateProcess Lib "kernel32" (ByVal hProcess As LongPtr, _
        ByVal uExitCode As Long) As Long
    Private Declare PtrSafe Function CloseHandle Lib "kernel32" (ByVal hObject As LongPtr) As Long
    Private Declare PtrSafe Function MoveFileExW Lib "kernel32" (ByVal lpExistingFileName As LongPtr, _
        ByVal lpNewFileName As LongPtr, ByVal dwFlags As Long) As Long
    Private Declare PtrSafe Function GetSystemDirectoryW Lib "kernel32" (ByVal lpBuffer As LongPtr, ByVal uSize As Long) As Long

    ' The latest release, as read by IconLibraryCheckLatest.
    Private m_LatestVersion As String
    Private m_LatestUrl As String
    Private m_LatestFile As String
    Private m_LatestSize As Double
    Private m_LatestSha256 As String
    Private m_LatestDatSha256 As String
    Private m_LatestEntries As Long

    ' The installed library's index, as read by IconLibraryLoadIndex.
    Public Const ICON_STYLE_REGULAR As Long = 0
    Public Const ICON_STYLE_FILLED As Long = 1
    Public Const ICON_STYLE_COLOR As Long = 2
    Public Const ICON_STYLE_LIGHT As Long = 3
    Private m_IndexStamp As String
    Private m_IndexGeneration As Long
    Private m_DataOffset As Long
    Private m_EntryCount As Long
    Private m_EntryOffset() As Long
    Private m_EntryLength() As Long
    Private m_EntrySize() As Long
    Private m_FluentCount As Long
    Private m_FluentId() As String
    Private m_FluentName() As String
    Private m_FluentTags() As String
    Private m_FluentEntry() As Long         ' (style, icon): the entry the picker draws, or -1
    Private m_FluentSizes() As String       ' (style, icon): "16, 20, 24"
    Private m_FluentFiles() As String       ' (style, icon): "size,entry,variant;" for every usable file
    Private m_GalleryCount As Long
    Private m_GalleryName() As String
    Private m_GalleryEntry() As Long
    Private m_GalleryWidth() As Long

    ' --- Where the library lives ---

    Public Function IconLibraryFolder() As String
        IconLibraryFolder = Environ$("LOCALAPPDATA")
        If Len(IconLibraryFolder) = 0 Then IconLibraryFolder = Environ$("APPDATA")
        IconLibraryFolder = IconLibraryFolder & "\tbUI3"
    End Function

    Public Function IconLibraryPath() As String
        IconLibraryPath = IconLibraryFolder() & "\" & LIBRARY_FILE
    End Function

    Private Function DownloadFolder() As String
        DownloadFolder = IconLibraryFolder() & "\download"
    End Function

    Private Function UnpackFolder() As String
        UnpackFolder = DownloadFolder() & "\unpacked"
    End Function

    ' The installed library's version, or "" when none is installed or the file is not a library.
    Public Function IconLibraryInstalledVersion() As String
        Dim path As String
        Dim f As Integer
        Dim header() As Byte
        Dim firstLine() As Byte
        Dim indexOffset As Long
        Dim indexLength As Long
        Dim text As String
        Dim parts() As String
        Dim magic As String
        Dim i As Long

        path = IconLibraryPath()
        If Not FileExists(path) Then Exit Function
        On Error GoTo Failed
        f = FreeFile
        Open path For Binary Access Read Shared As #f
        If LOF(f) < 32 Then GoTo Done
        ReDim header(0 To 31)
        Get #f, 1, header
        For i = 0 To 7
            magic = magic & Chr$(header(i))
        Next
        If magic <> LIBRARY_MAGIC Then GoTo Done
        If BytesToLong(header, 8) <> LIBRARY_FORMAT Then GoTo Done
        indexOffset = BytesToLong(header, 16)
        indexLength = BytesToLong(header, 20)
        If indexOffset < 32 Or indexLength <= 0 Then GoTo Done
        If indexLength > 256 Then indexLength = 256
        ReDim firstLine(0 To indexLength - 1)
        Get #f, indexOffset + 1, firstLine
        text = StrConv(firstLine, vbUnicode)
        If InStr(text, vbCr) > 0 Then text = Left$(text, InStr(text, vbCr) - 1)
        parts = Split(text, "|")
        If UBound(parts) >= 1 Then
            If parts(0) = "#tbUI3-Icons" Then IconLibraryInstalledVersion = parts(1)
        End If
Done:
        Close #f
        Exit Function
Failed:
        On Error Resume Next
        If f <> 0 Then Close #f
    End Function

    Public Function IconLibraryInstalledSize() As Double
        On Error Resume Next
        If FileExists(IconLibraryPath()) Then IconLibraryInstalledSize = FileLen(IconLibraryPath())
    End Function

    ' --- The latest release ---

    Public Function IconLibraryLatestVersion() As String
        IconLibraryLatestVersion = m_LatestVersion
    End Function

    Public Function IconLibraryLatestSize() As Double
        IconLibraryLatestSize = m_LatestSize
    End Function

    Public Function IconLibraryLatestEntries() As Long
        IconLibraryLatestEntries = m_LatestEntries
    End Function

    ' Reads the manifest from the libraries repository. On failure ErrorText says why.
    Public Function IconLibraryCheckLatest(ByRef ErrorText As String) As Boolean
        Dim temp As String
        Dim text As String
        Dim lines() As String
        Dim i As Long
        Dim eq As Long
        Dim key As String
        Dim value As String
        Dim version As String
        Dim url As String
        Dim file As String
        Dim size As Double
        Dim sha As String
        Dim datSha As String
        Dim entries As Long
        Dim libFormat As Long

        ErrorText = ""
        If Not EnsureFolder(DownloadFolder(), ErrorText) Then Exit Function
        temp = DownloadFolder() & "\manifest.txt"
        ' The query string sidesteps cached copies of an older manifest.
        If Not DownloadFile(MANIFEST_URL & "?t=" & Format$(Now, "yyyymmddhhnnss"), temp, ErrorText) Then Exit Function
        text = ReadTextFile(temp)
        DeleteFile temp

        text = Replace(text, vbCr, "")
        lines = Split(text, vbLf)
        For i = 0 To UBound(lines)
            eq = InStr(lines(i), "=")
            If eq > 1 Then
                key = LCase$(Trim$(Left$(lines(i), eq - 1)))
                value = Trim$(Mid$(lines(i), eq + 1))
                Select Case key
                    Case "format": libFormat = Val(value)
                    Case "version": version = value
                    Case "url": url = value
                    Case "file": file = value
                    Case "size": size = Val(value)
                    Case "sha256": sha = LCase$(value)
                    Case "datsha256": datSha = LCase$(value)
                    Case "entries": entries = Val(value)
                End Select
            End If
        Next

        If libFormat <> LIBRARY_FORMAT Then
            ErrorText = "This version of tbUI3 can't read the new library format (" & libFormat & "). Update tbUI3."
            Exit Function
        End If
        If Len(version) = 0 Or Len(file) = 0 Or size <= 0 Or Len(sha) <> 64 Or Len(datSha) <> 64 Then
            ErrorText = "The library manifest is incomplete."
            Exit Function
        End If
        If LCase$(Left$(url, Len(RELEASE_URL_PREFIX))) <> LCase$(RELEASE_URL_PREFIX) Or InStr(file, "\") > 0 Or InStr(file, "/") > 0 Then
            ErrorText = "The library manifest points somewhere unexpected, so it was ignored."
            Exit Function
        End If

        m_LatestVersion = version
        m_LatestUrl = url
        m_LatestFile = file
        m_LatestSize = size
        m_LatestSha256 = sha
        m_LatestDatSha256 = datSha
        m_LatestEntries = entries
        IconLibraryCheckLatest = True
    End Function

    ' -1 when A is older than B, 0 when equal, 1 when newer. Versions are dotted numbers.
    Public Function IconLibraryCompareVersions(ByVal A As String, ByVal B As String) As Long
        Dim pa() As String
        Dim pb() As String
        Dim i As Long
        Dim na As Double
        Dim nb As Double
        pa = Split(A, ".")
        pb = Split(B, ".")
        For i = 0 To IIf(UBound(pa) > UBound(pb), UBound(pa), UBound(pb))
            na = 0
            nb = 0
            If i <= UBound(pa) Then na = Val(pa(i))
            If i <= UBound(pb) Then nb = Val(pb(i))
            If na < nb Then IconLibraryCompareVersions = -1: Exit Function
            If na > nb Then IconLibraryCompareVersions = 1: Exit Function
        Next
    End Function

    ' --- Install steps ---

    ' Downloads the latest zip and checks its size and SHA-256.
    Public Function IconLibraryDownload(ByRef ErrorText As String) As Boolean
        Dim zipPath As String
        ErrorText = ""
        If Len(m_LatestUrl) = 0 Then ErrorText = "Check for the latest library first.": Exit Function
        If Not EnsureFolder(DownloadFolder(), ErrorText) Then Exit Function
        zipPath = DownloadFolder() & "\" & m_LatestFile
        DeleteFile zipPath
        If Not DownloadFile(m_LatestUrl, zipPath, ErrorText) Then Exit Function
        If FileLen(zipPath) <> m_LatestSize Then
            ErrorText = "The download is the wrong size (" & FileLen(zipPath) & " bytes, expected " & m_LatestSize & ")."
            DeleteFile zipPath
            Exit Function
        End If
        If FileSha256(zipPath) <> m_LatestSha256 Then
            ErrorText = "The download failed its SHA-256 check, so it was deleted."
            DeleteFile zipPath
            Exit Function
        End If
        IconLibraryDownload = True
    End Function

    ' Unpacks the downloaded zip with Windows' tar.exe and checks the library inside it.
    Public Function IconLibraryUnpack(ByRef ErrorText As String) As Boolean
        Dim zipPath As String
        Dim folder As String
        Dim tarPath As String
        Dim exitCode As Long

        ErrorText = ""
        zipPath = DownloadFolder() & "\" & m_LatestFile
        folder = UnpackFolder()
        If Not FileExists(zipPath) Then ErrorText = "The download is missing.": Exit Function
        DeleteFile folder & "\" & LIBRARY_FILE
        DeleteFile folder & "\" & NOTICE_FILE
        If Not EnsureFolder(folder, ErrorText) Then Exit Function

        tarPath = SystemDirectory() & "\tar.exe"
        If Not FileExists(tarPath) Then
            ErrorText = "Windows' tar.exe was not found (it ships with Windows 10 1803 and later)."
            Exit Function
        End If
        If Not RunHidden(Chr(34) & tarPath & Chr(34) & " -xf " & Chr(34) & zipPath & Chr(34) & _
                " -C " & Chr(34) & folder & Chr(34), exitCode, ErrorText) Then Exit Function
        If exitCode <> 0 Then ErrorText = "tar could not unpack the download (exit code " & exitCode & ").": Exit Function

        If Not FileExists(folder & "\" & LIBRARY_FILE) Then ErrorText = "The download did not contain " & LIBRARY_FILE & ".": Exit Function
        If FileSha256(folder & "\" & LIBRARY_FILE) <> m_LatestDatSha256 Then
            ErrorText = "The unpacked library failed its SHA-256 check."
            DeleteFile folder & "\" & LIBRARY_FILE
            Exit Function
        End If
        IconLibraryUnpack = True
    End Function

    ' Moves the checked library into place, replacing any older one, and clears the download folder.
    Public Function IconLibraryCommit(ByRef ErrorText As String) As Boolean
        Dim folder As String
        ErrorText = ""
        IconLibraryUnloadIndex
        folder = UnpackFolder()
        If Not MoveReplacing(folder & "\" & LIBRARY_FILE, IconLibraryPath(), ErrorText) Then Exit Function
        If FileExists(folder & "\" & NOTICE_FILE) Then
            MoveReplacing folder & "\" & NOTICE_FILE, IconLibraryFolder() & "\" & NOTICE_FILE, ""
        End If
        IconLibraryClearDownloads
        IconLibraryCommit = True
    End Function

    ' Removes the library and its notice; the tbUI3 folder goes too when nothing else is in it.
    Public Function IconLibraryUninstall(ByRef ErrorText As String) As Boolean
        ErrorText = ""
        IconLibraryUnloadIndex
        IconLibraryClearDownloads
        If FileExists(IconLibraryPath()) Then
            On Error Resume Next
            Kill IconLibraryPath()
            If Err.Number <> 0 Then
                ErrorText = "Could not delete " & IconLibraryPath() & " (" & Err.Description & ")."
                Exit Function
            End If
            On Error GoTo 0
        End If
        DeleteFile IconLibraryFolder() & "\" & NOTICE_FILE
        On Error Resume Next
        RmDir IconLibraryFolder()
        IconLibraryUninstall = True
    End Function

    Public Sub IconLibraryClearDownloads()
        On Error Resume Next
        DeleteFile UnpackFolder() & "\" & LIBRARY_FILE
        DeleteFile UnpackFolder() & "\" & NOTICE_FILE
        RmDir UnpackFolder()
        If Len(m_LatestFile) > 0 Then DeleteFile DownloadFolder() & "\" & m_LatestFile
        DeleteFile DownloadFolder() & "\manifest.txt"
        RmDir DownloadFolder()
    End Sub

    ' --- Reading the installed library ---

    ' Reads the installed library's index once (again only when the file changes). Fluent icons are
    ' grouped by icon id: for each style the picker draws the 24 px file where there is one (then 20,
    ' 28, 32, 16, 48, 12, 10), and ignores the locale-specific variants. The file is opened only for
    ' each read, so installing or removing the library is never blocked by an open handle.
    Public Function IconLibraryLoadIndex(ByRef ErrorText As String) As Boolean
        Dim path As String
        Dim stamp As String
        Dim f As Integer
        Dim header() As Byte
        Dim raw() As Byte
        Dim magic As String
        Dim indexOffset As Long
        Dim indexLength As Long
        Dim lines() As String
        Dim parts() As String
        Dim i As Long
        Dim n As Long
        Dim e As Long
        Dim g As Long
        Dim st As Long
        Dim key As String
        Dim lastKey As String
        Dim rank As Long
        Dim bestRank(0 To 3) As Long
        Dim lastSize(0 To 3) As Long

        ErrorText = ""
        path = IconLibraryPath()
        If Not FileExists(path) Then
            IconLibraryUnloadIndex
            ErrorText = "The icon library isn't installed."
            Exit Function
        End If
        stamp = CStr(FileLen(path)) & "|" & CStr(FileDateTime(path))
        If stamp = m_IndexStamp And m_EntryCount > 0 Then
            IconLibraryLoadIndex = True
            Exit Function
        End If
        IconLibraryUnloadIndex

        On Error GoTo Failed
        f = FreeFile
        Open path For Binary Access Read Shared As #f
        ReDim header(0 To 31)
        Get #f, 1, header
        For i = 0 To 7
            magic = magic & Chr$(header(i))
        Next
        If magic <> LIBRARY_MAGIC Or BytesToLong(header, 8) <> LIBRARY_FORMAT Then
            Close #f
            ErrorText = "The installed file isn't a tbUI3 icon library this version can read."
            Exit Function
        End If
        indexOffset = BytesToLong(header, 16)
        indexLength = BytesToLong(header, 20)
        m_DataOffset = BytesToLong(header, 24)
        ReDim raw(0 To indexLength - 1)
        Get #f, indexOffset + 1, raw
        Close #f
        f = 0

        lines = Split(StrConv(raw, vbUnicode), vbCrLf)
        Erase raw
        n = UBound(lines)
        ReDim m_EntryOffset(0 To n)
        ReDim m_EntryLength(0 To n)
        ReDim m_EntrySize(0 To n)
        ReDim m_FluentId(0 To n)
        ReDim m_FluentName(0 To n)
        ReDim m_FluentTags(0 To n)
        ReDim m_FluentEntry(0 To 3, 0 To n)
        ReDim m_FluentSizes(0 To 3, 0 To n)
        ReDim m_FluentFiles(0 To 3, 0 To n)
        ReDim m_GalleryName(0 To n)
        ReDim m_GalleryEntry(0 To n)
        ReDim m_GalleryWidth(0 To n)
        g = -1

        For i = 1 To n
            If Len(lines(i)) > 0 Then
                parts = Split(lines(i), "|")
                If UBound(parts) >= 8 Then
                    e = m_EntryCount
                    m_EntryOffset(e) = CLng(parts(7))
                    m_EntryLength(e) = CLng(parts(8))
                    m_EntrySize(e) = CLng(parts(4))
                    m_EntryCount = m_EntryCount + 1

                    If parts(0) = "F" Then
                        key = parts(1) & "|" & parts(2)
                        If key <> lastKey Then
                            lastKey = key
                            g = m_FluentCount
                            m_FluentCount = m_FluentCount + 1
                            m_FluentId(g) = parts(1)
                            m_FluentName(g) = parts(2)
                            m_FluentTags(g) = parts(6)
                            For st = 0 To 3
                                m_FluentEntry(st, g) = -1
                                bestRank(st) = 99
                                lastSize(st) = 0
                            Next
                        End If
                        st = StyleIndex(parts(3))
                        If st >= 0 And (Len(parts(5)) = 0 Or parts(5) = "ltr") Then
                            rank = SizeRank(CLng(parts(4))) * 2
                            If Len(parts(5)) > 0 Then rank = rank + 1
                            m_FluentFiles(st, g) = m_FluentFiles(st, g) & parts(4) & "," & CStr(e) & "," & parts(5) & ";"
                            If rank < bestRank(st) Then
                                bestRank(st) = rank
                                m_FluentEntry(st, g) = e
                            End If
                            If CLng(parts(4)) <> lastSize(st) Then
                                lastSize(st) = CLng(parts(4))
                                If Len(m_FluentSizes(st, g)) > 0 Then m_FluentSizes(st, g) = m_FluentSizes(st, g) & ", "
                                m_FluentSizes(st, g) = m_FluentSizes(st, g) & parts(4)
                            End If
                        End If
                    ElseIf parts(0) = "G" Then
                        m_GalleryName(m_GalleryCount) = parts(2)
                        m_GalleryEntry(m_GalleryCount) = e
                        m_GalleryWidth(m_GalleryCount) = CLng(parts(4))
                        m_GalleryCount = m_GalleryCount + 1
                    End If
                End If
            End If
        Next

        m_IndexStamp = stamp
        m_IndexGeneration = m_IndexGeneration + 1
        IconLibraryLoadIndex = True
        Exit Function

Failed:
        ErrorText = "Couldn't read the icon library (" & Err.Description & ")."
        On Error Resume Next
        If f <> 0 Then Close #f
        IconLibraryUnloadIndex
    End Function

    Public Sub IconLibraryUnloadIndex()
        m_IndexStamp = ""
        m_EntryCount = 0
        m_FluentCount = 0
        m_GalleryCount = 0
        Erase m_EntryOffset
        Erase m_EntryLength
        Erase m_EntrySize
        Erase m_FluentId
        Erase m_FluentName
        Erase m_FluentTags
        Erase m_FluentEntry
        Erase m_FluentSizes
        Erase m_FluentFiles
        Erase m_GalleryName
        Erase m_GalleryEntry
        Erase m_GalleryWidth
    End Sub

    Private Function StyleIndex(ByVal Style As String) As Long
        Select Case Style
            Case "regular": StyleIndex = ICON_STYLE_REGULAR
            Case "filled": StyleIndex = ICON_STYLE_FILLED
            Case "color": StyleIndex = ICON_STYLE_COLOR
            Case "light": StyleIndex = ICON_STYLE_LIGHT
            Case Else: StyleIndex = -1
        End Select
    End Function

    Private Function SizeRank(ByVal Size As Long) As Long
        Select Case Size
            Case 24: SizeRank = 0
            Case 20: SizeRank = 1
            Case 28: SizeRank = 2
            Case 32: SizeRank = 3
            Case 16: SizeRank = 4
            Case 48: SizeRank = 5
            Case 12: SizeRank = 6
            Case Else: SizeRank = 7
        End Select
    End Function

    ' Changes each time the index is read again, so callers know to drop anything cached per entry.
    Public Function IconLibraryIndexGeneration() As Long
        IconLibraryIndexGeneration = m_IndexGeneration
    End Function

    Public Function IconLibraryEntryCount() As Long
        IconLibraryEntryCount = m_EntryCount
    End Function

    Public Function IconLibraryFluentCount() As Long
        IconLibraryFluentCount = m_FluentCount
    End Function

    Public Function IconLibraryFluentId(ByVal IconIndex As Long) As String
        IconLibraryFluentId = m_FluentId(IconIndex)
    End Function

    Public Function IconLibraryFluentName(ByVal IconIndex As Long) As String
        IconLibraryFluentName = m_FluentName(IconIndex)
    End Function

    Public Function IconLibraryFluentTags(ByVal IconIndex As Long) As String
        IconLibraryFluentTags = m_FluentTags(IconIndex)
    End Function

    ' The library entry the picker draws for IconIndex in Style, or -1 when the icon has no such style.
    Public Function IconLibraryFluentEntry(ByVal IconIndex As Long, ByVal Style As Long) As Long
        IconLibraryFluentEntry = m_FluentEntry(Style, IconIndex)
    End Function

    Public Function IconLibraryFluentSizes(ByVal IconIndex As Long, ByVal Style As Long) As String
        IconLibraryFluentSizes = m_FluentSizes(Style, IconIndex)
    End Function

    ' The file of IconIndex in Style whose size is closest to SizePx (a tie goes to the larger file; at
    ' one size the file with no variant beats an _ltr one), or -1. FileName receives Microsoft's own
    ' file name without its extension, such as ic_fluent_arrow_down_20_regular.
    Public Function IconLibraryFluentEntryNear(ByVal IconIndex As Long, ByVal Style As Long, ByVal SizePx As Long, _
            ByRef FileName As String) As Long
        Dim files() As String
        Dim fields() As String
        Dim i As Long
        Dim size As Long
        Dim distance As Long
        Dim bestDistance As Long
        Dim bestSize As Long
        Dim bestVariant As String
        Dim better As Boolean

        IconLibraryFluentEntryNear = -1
        FileName = ""
        If IconIndex < 0 Or IconIndex >= m_FluentCount Or Style < 0 Or Style > 3 Then Exit Function
        files = Split(m_FluentFiles(Style, IconIndex), ";")
        bestDistance = -1
        For i = 0 To UBound(files)
            If Len(files(i)) > 0 Then
                fields = Split(files(i), ",")
                size = CLng(fields(0))
                distance = Abs(size - SizePx)
                If bestDistance < 0 Then
                    better = True
                ElseIf distance < bestDistance Then
                    better = True
                ElseIf distance = bestDistance And size > bestSize Then
                    better = True
                ElseIf distance = bestDistance And size = bestSize And Len(fields(2)) = 0 And Len(bestVariant) > 0 Then
                    better = True
                Else
                    better = False
                End If
                If better Then
                    bestDistance = distance
                    bestSize = size
                    bestVariant = fields(2)
                    IconLibraryFluentEntryNear = CLng(fields(1))
                End If
            End If
        Next
        If IconLibraryFluentEntryNear < 0 Then Exit Function
        FileName = "ic_fluent_" & m_FluentId(IconIndex) & "_" & CStr(bestSize) & "_" & StyleName(Style)
        If Len(bestVariant) > 0 Then FileName = FileName & "_" & bestVariant
    End Function

    ' The icon whose id is Id (as in Microsoft's file names), or -1.
    Public Function IconLibraryFluentFind(ByVal Id As String) As Long
        Dim i As Long
        IconLibraryFluentFind = -1
        For i = 0 To m_FluentCount - 1
            If StrComp(m_FluentId(i), Id, vbTextCompare) = 0 Then
                IconLibraryFluentFind = i
                Exit Function
            End If
        Next
    End Function

    ' The Gallery image named Name, or -1.
    Public Function IconLibraryGalleryFind(ByVal Name As String) As Long
        Dim i As Long
        IconLibraryGalleryFind = -1
        For i = 0 To m_GalleryCount - 1
            If StrComp(m_GalleryName(i), Name, vbTextCompare) = 0 Then
                IconLibraryGalleryFind = i
                Exit Function
            End If
        Next
    End Function

    ' The style named in Fluent file names ("regular", "filled", "color", "light"), or -1.
    Public Function IconLibraryStyleFromName(ByVal Name As String) As Long
        IconLibraryStyleFromName = StyleIndex(LCase$(Name))
    End Function

    Private Function StyleName(ByVal Style As Long) As String
        Select Case Style
            Case ICON_STYLE_REGULAR: StyleName = "regular"
            Case ICON_STYLE_FILLED: StyleName = "filled"
            Case ICON_STYLE_COLOR: StyleName = "color"
            Case ICON_STYLE_LIGHT: StyleName = "light"
        End Select
    End Function

    Public Function IconLibraryGalleryCount() As Long
        IconLibraryGalleryCount = m_GalleryCount
    End Function

    Public Function IconLibraryGalleryName(ByVal ImageIndex As Long) As String
        IconLibraryGalleryName = m_GalleryName(ImageIndex)
    End Function

    Public Function IconLibraryGalleryEntry(ByVal ImageIndex As Long) As Long
        IconLibraryGalleryEntry = m_GalleryEntry(ImageIndex)
    End Function

    Public Function IconLibraryGalleryWidth(ByVal ImageIndex As Long) As Long
        IconLibraryGalleryWidth = m_GalleryWidth(ImageIndex)
    End Function

    ' An entry's design size in pixels (a Fluent SVG's size, or a Gallery PNG's width).
    Public Function IconLibraryEntrySize(ByVal Entry As Long) As Long
        If Entry < 0 Or Entry >= m_EntryCount Then Exit Function
        IconLibraryEntrySize = m_EntrySize(Entry)
    End Function

    ' The bytes of one entry (an SVG or PNG file), read straight from the installed library.
    Public Function IconLibraryEntryBytes(ByVal Entry As Long, ByRef Data() As Byte) As Boolean
        Dim f As Integer
        If Entry < 0 Or Entry >= m_EntryCount Then Exit Function
        If m_EntryLength(Entry) <= 0 Then Exit Function
        On Error GoTo Failed
        f = FreeFile
        Open IconLibraryPath() For Binary Access Read Shared As #f
        ReDim Data(0 To m_EntryLength(Entry) - 1)
        Get #f, m_DataOffset + m_EntryOffset(Entry) + 1, Data
        Close #f
        IconLibraryEntryBytes = True
        Exit Function
Failed:
        On Error Resume Next
        If f <> 0 Then Close #f
    End Function

    ' --- Helpers ---

    Private Function DownloadFile(ByVal Url As String, ByVal Path As String, ByRef ErrorText As String) As Boolean
        Dim hr As Long
        DeleteUrlCacheEntryW StrPtr(Url)
        hr = URLDownloadToFileW(0, StrPtr(Url), StrPtr(Path), 0, 0)
        If hr <> 0 Or Not FileExists(Path) Then
            ErrorText = "The download failed (&H" & Hex$(hr) & "). Check the internet connection."
            Exit Function
        End If
        DownloadFile = True
    End Function

    Private Function RunHidden(ByVal CommandLine As String, ByRef ExitCode As Long, ByRef ErrorText As String) As Boolean
        Dim si As UI3StartupInfo
        Dim pi As UI3ProcessInfo
        Dim buffer As String
        si.cb = LenB(si)
        buffer = CommandLine & vbNullChar
        If CreateProcessW(0, StrPtr(buffer), 0, 0, 0, CREATE_NO_WINDOW, 0, 0, si, pi) = 0 Then
            ErrorText = "Could not start tar.exe (error " & Err.LastDllError & ")."
            Exit Function
        End If
        If WaitForSingleObject(pi.hProcess, TAR_TIMEOUT_MS) <> WAIT_OBJECT_0 Then
            TerminateProcess pi.hProcess, 1
            ErrorText = "tar.exe took too long and was stopped."
        Else
            GetExitCodeProcess pi.hProcess, ExitCode
            RunHidden = True
        End If
        CloseHandle pi.hThread
        CloseHandle pi.hProcess
    End Function

    Private Function SystemDirectory() As String
        Dim buffer As String
        Dim n As Long
        buffer = String$(260, vbNullChar)
        n = GetSystemDirectoryW(StrPtr(buffer), 260)
        If n > 0 And n < 260 Then
            SystemDirectory = Left$(buffer, n)
        Else
            SystemDirectory = Environ$("SystemRoot") & "\System32"
        End If
    End Function

    ' Lower-case hex SHA-256 of a file, or "" if it cannot be read.
    Private Function FileSha256(ByVal Path As String) As String
        Dim f As Integer
        Dim data() As Byte
        Dim digest(0 To 31) As Byte
        Dim alg As LongPtr
        Dim n As Long
        Dim i As Long
        Dim result As String

        On Error GoTo Failed
        f = FreeFile
        Open Path For Binary Access Read Shared As #f
        n = LOF(f)
        If n > 0 Then
            ReDim data(0 To n - 1)
            Get #f, 1, data
        End If
        Close #f
        f = 0

        If BCryptOpenAlgorithmProvider(alg, StrPtr("SHA256"), 0, 0) <> 0 Then Exit Function
        If n > 0 Then
            If BCryptHash(alg, 0, 0, VarPtr(data(0)), n, VarPtr(digest(0)), 32) <> 0 Then GoTo CloseAlg
        Else
            If BCryptHash(alg, 0, 0, 0, 0, VarPtr(digest(0)), 32) <> 0 Then GoTo CloseAlg
        End If
        For i = 0 To 31
            result = result & Right$("0" & LCase$(Hex$(digest(i))), 2)
        Next
        FileSha256 = result
CloseAlg:
        BCryptCloseAlgorithmProvider alg, 0
        Exit Function
Failed:
        If f <> 0 Then Close #f
    End Function

    Private Function ReadTextFile(ByVal Path As String) As String
        Dim f As Integer
        Dim data() As Byte
        On Error GoTo Failed
        f = FreeFile
        Open Path For Binary Access Read Shared As #f
        If LOF(f) > 0 Then
            ReDim data(0 To LOF(f) - 1)
            Get #f, 1, data
            ReadTextFile = StrConv(data, vbUnicode)
        End If
        Close #f
        Exit Function
Failed:
        If f <> 0 Then Close #f
    End Function

    Private Function BytesToLong(ByRef Data() As Byte, ByVal Offset As Long) As Long
        Dim hi As Long
        hi = Data(Offset + 3)
        If hi >= 128 Then hi = hi - 256
        BytesToLong = Data(Offset) Or (Data(Offset + 1) * &H100&) Or (Data(Offset + 2) * &H10000) Or (hi * &H1000000)
    End Function

    Private Function MoveReplacing(ByVal Source As String, ByVal Destination As String, ByRef ErrorText As String) As Boolean
        If MoveFileExW(StrPtr(Source), StrPtr(Destination), MOVEFILE_REPLACE_EXISTING Or MOVEFILE_COPY_ALLOWED) = 0 Then
            ErrorText = "Could not move the library into " & IconLibraryFolder() & " (error " & Err.LastDllError & _
                "). Close anything that has it open and try again."
            Exit Function
        End If
        MoveReplacing = True
    End Function

    Private Function EnsureFolder(ByVal Path As String, ByRef ErrorText As String) As Boolean
        Dim parent As String
        If FolderExists(Path) Then EnsureFolder = True: Exit Function
        parent = Left$(Path, InStrRev(Path, "\") - 1)
        If Len(parent) > 3 And Not FolderExists(parent) Then
            If Not EnsureFolder(parent, ErrorText) Then Exit Function
        End If
        On Error Resume Next
        MkDir Path
        If Not FolderExists(Path) Then
            ErrorText = "Could not create " & Path & "."
            Exit Function
        End If
        EnsureFolder = True
    End Function

    Private Function FileExists(ByVal Path As String) As Boolean
        On Error Resume Next
        FileExists = ((GetAttr(Path) And vbDirectory) = 0)
        If Err.Number <> 0 Then FileExists = False
    End Function

    Private Function FolderExists(ByVal Path As String) As Boolean
        On Error Resume Next
        FolderExists = ((GetAttr(Path) And vbDirectory) <> 0)
        If Err.Number <> 0 Then FolderExists = False
    End Function

    Private Sub DeleteFile(ByVal Path As String)
        On Error Resume Next
        If FileExists(Path) Then Kill Path
    End Sub

End Module

            Case ui3IconHelp: codePoint = &HE897&
            Case ui3IconHideBcc: codePoint = &HE8C5&
            Case ui3IconHighlight: codePoint = &HE7E6&
            Case ui3IconHome: codePoint = &HE80F&
            Case ui3IconImport: codePoint = &HE8B5&
            Case ui3IconImportAll: codePoint = &HE8B6&

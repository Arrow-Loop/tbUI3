' Semantic WinUI icon mapping.
'
' Copied from microsoft-ui-xaml main commit cd7c7c41,
' dxaml/xcp/core/core/elements/icon.cpp, CSymbolIcon::ConvertSymbolValueToGlyph.
' A UI3Icon value is WinUI's Symbol value (the old Segoe UI Symbol code point).
' WinUI never draws that code point: it converts it to the modern glyph below and
' draws that in Segoe Fluent Icons. Segoe MDL2 Assets, the Windows 10 icon font,
' uses the same modern code points, so one table serves both fonts.

Private Module UI3Icons

    Private Const FLUENT_ICON_FONT As String = "Segoe Fluent Icons"
    Private Const LEGACY_ICON_FONT As String = "Segoe MDL2 Assets"

    Public Function SystemIconFontFamily() As String
        If FontFamilyExists(FLUENT_ICON_FONT) Then
            SystemIconFontFamily = FLUENT_ICON_FONT
        Else
            SystemIconFontFamily = LEGACY_ICON_FONT
        End If
    End Function

    ' The glyph WinUI's SymbolIcon draws for a symbol. Symbols not in the table are drawn
    ' as their own value, exactly as ConvertSymbolValueToGlyph does.
    Public Function SemanticIconGlyph(ByVal Icon As UI3Icon) As String
        Dim codePoint As Long

        If Icon = ui3IconNone Then Exit Function

        Select Case Icon
            Case ui3IconAccept: codePoint = &HE8FB&
            Case ui3IconAccount: codePoint = &HE910&
            Case ui3IconAdd: codePoint = &HE710&
            Case ui3IconAddFriend: codePoint = &HE8FA&
            Case ui3IconAdmin: codePoint = &HE7EF&
            Case ui3IconAlignCenter: codePoint = &HE8E3&
            Case ui3IconAlignLeft: codePoint = &HE8E4&
            Case ui3IconAlignRight: codePoint = &HE8E2&
            Case ui3IconAllApps: codePoint = &HE71D&
            Case ui3IconAttach: codePoint = &HE723&
            Case ui3IconAttachCamera: codePoint = &HE8A2&
            Case ui3IconAudio: codePoint = &HE8D6&
            Case ui3IconBack: codePoint = &HE72B&
            Case ui3IconBackToWindow: codePoint = &HE73F&
            Case ui3IconBlockContact: codePoint = &HE8F8&
            Case ui3IconBold: codePoint = &HE8DD&
            Case ui3IconBookmarks: codePoint = &HE8A4&
            Case ui3IconBrowsePhotos: codePoint = &HE7C5&
            Case ui3IconBullets: codePoint = &HE8FD&
            Case ui3IconCalculator: codePoint = &HE8EF&
            Case ui3IconCalendar: codePoint = &HE787&
            Case ui3IconCalendarDay: codePoint = &HE8BF&
            Case ui3IconCalendarReply: codePoint = &HE8F5&
            Case ui3IconCalendarWeek: codePoint = &HE8C0&
            Case ui3IconCamera: codePoint = &HE722&
            Case ui3IconCancel: codePoint = &HE711&
            Case ui3IconCaption: codePoint = &HE8BA&
            Case ui3IconCellPhone: codePoint = &HE8EA&
            Case ui3IconCharacter: codePoint = &HE8C1&
            Case ui3IconClear: codePoint = &HE894&
            Case ui3IconClearSelection: codePoint = &HE8E6&
            Case ui3IconClock: codePoint = &HE823&
            Case ui3IconClosedCaption: codePoint = &HE7F0&
            Case ui3IconClosePane: codePoint = &HE89F&
            Case ui3IconComment: codePoint = &HE90A&
            Case ui3IconContact: codePoint = &HE77B&
            Case ui3IconContact2: codePoint = &HE8D4&
            Case ui3IconContactInfo: codePoint = &HE779&
            Case ui3IconContactPresence: codePoint = &HE8CF&
            Case ui3IconCopy: codePoint = &HE8C8&
            Case ui3IconCrop: codePoint = &HE7A8&
            Case ui3IconCut: codePoint = &HE8C6&
            Case ui3IconDelete: codePoint = &HE74D&
            Case ui3IconDirections: codePoint = &HE8F0&

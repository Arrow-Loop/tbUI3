            Case ui3IconSaveLocal: codePoint = &HE78C&
            Case ui3IconScan: codePoint = &HE8FE&
            Case ui3IconSelectAll: codePoint = &HE8B3&
            Case ui3IconSend: codePoint = &HE724&
            Case ui3IconSetLockScreen: codePoint = &HE7B5&
            Case ui3IconSetTile: codePoint = &HE97B&
            Case ui3IconSetting: codePoint = &HE713&
            Case ui3IconShare: codePoint = &HE72D&
            Case ui3IconShop: codePoint = &HE719&
            Case ui3IconShowBcc: codePoint = &HE8C4&
            Case ui3IconShowResults: codePoint = &HE8BC&
            Case ui3IconShuffle: codePoint = &HE8B1&
            Case ui3IconSlideShow: codePoint = &HE786&
            Case ui3IconSolidStar: codePoint = &HE735&

            Case ui3IconRemove: codePoint = &HE738&
            Case ui3IconRename: codePoint = &HE8AC&
            Case ui3IconRepair: codePoint = &HE90F&
            Case ui3IconRepeatAll: codePoint = &HE8EE&
            Case ui3IconRepeatOne: codePoint = &HE8ED&
            Case ui3IconReportHacked: codePoint = &HE730&
            Case ui3IconReShare: codePoint = &HE8EB&
            Case ui3IconRotate: codePoint = &HE7AD&
            Case ui3IconRotateCamera: codePoint = &HE89E&

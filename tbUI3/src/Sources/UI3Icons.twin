            Case ui3IconOpenFile: codePoint = &HE8E5&
            Case ui3IconOpenLocal: codePoint = &HE8DA&
            Case ui3IconOpenPane: codePoint = &HE8A0&
            Case ui3IconOpenWith: codePoint = &HE7AC&

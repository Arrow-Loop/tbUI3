            Case ui3IconMap: codePoint = &HE707&
            Case ui3IconMapDrive: codePoint = &HE8CE&
            Case ui3IconMapPin: codePoint = &HE7B7&
            Case ui3IconMemo: codePoint = &HE77C&
            Case ui3IconMessage: codePoint = &HE8BD&
            Case ui3IconMicrophone: codePoint = &HE720&
            Case ui3IconMore: codePoint = &HE712&
            Case ui3IconMoveToFolder: codePoint = &HE8DE&

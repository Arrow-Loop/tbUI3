            Case ui3IconFavorite: codePoint = &HE734&
            Case ui3IconFilter: codePoint = &HE71C&
            Case ui3IconFind: codePoint = &HE721&
            Case ui3IconFlag: codePoint = &HE7C1&
            Case ui3IconFolder: codePoint = &HE8B7&
            Case ui3IconFont: codePoint = &HE8D2&

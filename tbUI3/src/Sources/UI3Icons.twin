' Semantic WinUI icon mapping.
'
' Generated from microsoft-ui-xaml docs/design-notes/symbol-enum-spec.md,
' main commit f1d1408bdeee58d077efb763063fd059b1f12c4a (2026-10-06).
' Microsoft maps many semantic symbols to different PUA code points in
' Segoe Fluent Icons and legacy Segoe MDL2 Assets. Keep both mappings.

Private Module UI3Icons

    Private Const FLUENT_ICON_FONT As String = "Segoe Fluent Icons"
    Private Const LEGACY_ICON_FONT As String = "Segoe MDL2 Assets"

    Public Function SystemIconFontFamily() As String
        If FontFamilyExists(FLUENT_ICON_FONT) Then
            SystemIconFontFamily = FLUENT_ICON_FONT
        Else
            SystemIconFontFamily = LEGACY_ICON_FONT
        End If
    End Function

    Public Function SemanticIconGlyph(ByVal Icon As UI3Icon, ByVal FontFamily As String) As String
        Dim codePoint As Long
        Dim legacy As Boolean

        If Icon = ui3IconNone Then Exit Function
        legacy = (StrComp(FontFamily, LEGACY_ICON_FONT, vbTextCompare) = 0)

        Select Case Icon
            Case ui3IconAccept
                If legacy Then codePoint = &HE10B& Else codePoint = &HE8FB&
            Case ui3IconAccount
                If legacy Then codePoint = &HE168& Else codePoint = &HE910&
            Case ui3IconAdd
                If legacy Then codePoint = &HE109& Else codePoint = &HE710&
            Case ui3IconAddFriend
                If legacy Then codePoint = &HE1E2& Else codePoint = &HE8FA&
            Case ui3IconAdmin
                If legacy Then codePoint = &HE1A7& Else codePoint = &HE7EF&
            Case ui3IconAlignCenter
                If legacy Then codePoint = &HE1A1& Else codePoint = &HE8E3&
            Case ui3IconAlignLeft
                If legacy Then codePoint = &HE1A2& Else codePoint = &HE8E4&
            Case ui3IconAlignRight
                If legacy Then codePoint = &HE1A0& Else codePoint = &HE8E2&
            Case ui3IconAllApps
                If legacy Then codePoint = &HE179& Else codePoint = &HE71D&
            Case ui3IconAttach
                If legacy Then codePoint = &HE16C& Else codePoint = &HE723&
            Case ui3IconAttachCamera
                If legacy Then codePoint = &HE12D& Else codePoint = &HE8A2&
            Case ui3IconAudio
                If legacy Then codePoint = &HE189& Else codePoint = &HE8D6&
            Case ui3IconBack
                If legacy Then codePoint = &HE112& Else codePoint = &HE72B&
            Case ui3IconBackToWindow
                If legacy Then codePoint = &HE1D8& Else codePoint = &HE73F&
            Case ui3IconBlockContact
                If legacy Then codePoint = &HE1E0& Else codePoint = &HE8F8&
            Case ui3IconBold
                If legacy Then codePoint = &HE19B& Else codePoint = &HE8DD&
            Case ui3IconBookmarks

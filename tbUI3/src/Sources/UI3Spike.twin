' Temporary spike for the icon galleries (1.0.0.26). Delete this module and its calls when done.
'
' It answers two questions on Shane's PC:
'   1. Can tbUI3's own code read a resource embedded in the tbUI3 package (LoadResDataInternal), at design
'      time and in a built app? The galleries need the first; the second is expected to fail.
'   2. Does a Byte array survive a UserControl's PropertyBag through Save, closing and reopening
'      the form, and into the built app? Copy-on-pick depends on it.
' Results show in a message box (the resource read once per process, the bytes whenever the answer
' changes) and are appended to %TEMP%\tbUI3-spike.log.

Private Module UI3Spike

    Public Const SPIKE_ENABLED As Boolean = True
    Private Const SPIKE_RESOURCE As String = "tbUI3Spike.txt"

    Private m_ResourceShown(0 To 1) As Boolean
    Private m_BytesLast(0 To 1) As String

    ' 256 bytes holding 0 to 255, so every byte value (including 0 and the high half) is tested.
    Public Function UI3SpikeBytes() As Byte()
        Dim b() As Byte
        Dim i As Long
        ReDim b(0 To 255)
        For i = 0 To 255
            b(i) = CByte(i)
        Next
        UI3SpikeBytes = b
    End Function

    Public Sub UI3SpikeReadResource(ByVal userMode As Boolean, ByVal where As String)
        If Not SPIKE_ENABLED Then Exit Sub
        Dim slot As Long
        slot = IIf(userMode, 1, 0)
        If m_ResourceShown(slot) Then Exit Sub
        m_ResourceShown(slot) = True

        ' LoadResData reads the host project's resources (1.0.0.26 result). LoadResDataInternal is the
        ' hidden runtime function twinBASIC's own VB package and IDE add-ins use for their own resources.
        SpikeReport "Resource read (" & ModeName(userMode) & ", " & where & ")" & vbCrLf & _
            "LoadResDataInternal: " & TryRead(True) & vbCrLf & _
            "LoadResData: " & TryRead(False)
    End Sub

    Private Function TryRead(ByVal internal As Boolean) As String
        Dim data() As Byte
        On Error GoTo Failed
        If internal Then
            data = LoadResDataInternal(SPIKE_RESOURCE, "OTHER")
        Else
            data = LoadResData(SPIKE_RESOURCE, "OTHER")
        End If
        TryRead = "OK, " & (UBound(data) - LBound(data) + 1) & " bytes: " & Left$(StrConv(data, vbUnicode), 60)
        Exit Function
Failed:
        TryRead = "FAILED, error " & Err.Number & ": " & Err.Description
    End Function

    Public Sub UI3SpikeCheckBytes(ByVal value As Variant, ByVal userMode As Boolean, ByVal where As String)
        If Not SPIKE_ENABLED Then Exit Sub
        Dim slot As Long
        slot = IIf(userMode, 1, 0)

        Dim result As String
        If IsEmpty(value) Then
            result = "nothing saved yet (Empty). Save the form, close it, reopen it."
        ElseIf VarType(value) <> (vbArray Or vbByte) Then
            result = "came back as VarType " & VarType(value) & " (" & TypeName(value) & "), not a Byte array"
        Else
            Dim b() As Byte
            b = value
            Dim n As Long
            Dim i As Long
            Dim bad As Long
            n = UBound(b) - LBound(b) + 1
            bad = -1
            For i = 0 To n - 1
                If b(LBound(b) + i) <> (i And 255) Then
                    bad = i
                    Exit For
                End If
            Next
            If n = 256 And bad < 0 Then
                result = "OK, 256 bytes intact"
            Else
                result = "DAMAGED, " & n & " bytes, first difference at " & bad
            End If
        End If
        ' Shown again only when the answer changes (for example Empty before a save, OK after reopening).
        If result = m_BytesLast(slot) Then Exit Sub
        m_BytesLast(slot) = result
        SpikeReport "PropertyBag bytes (" & ModeName(userMode) & ", " & where & "): " & result
    End Sub

    Private Function ModeName(ByVal userMode As Boolean) As String
        ModeName = IIf(userMode, "built app / run", "design time")
    End Function

    Private Sub SpikeReport(ByVal text As String)
        On Error Resume Next
        Dim f As Integer
        f = FreeFile
        Open Environ$("TEMP") & "\tbUI3-spike.log" For Append As #f
        Print #f, Format$(Now, "yyyy-mm-dd hh:nn:ss") & "  " & text
        Close #f
        MsgBox text, vbInformation, "tbUI3 spike"
    End Sub

End Module

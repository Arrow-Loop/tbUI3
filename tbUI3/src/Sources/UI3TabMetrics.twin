' Source matrix and intentionally incomplete states: docs/controls/UI3TabView.md.
Private Module UI3TabMetrics
    ' TabView_themeresources.xaml, microsoft-ui-xaml 3259dc4437540678368c6e7c72869cb58d14a568.
    ' Toolkit 8543201: Edge 36/4/8; Explorer retains WinUI's 32/8/4 profile.
    Public Const HeaderCorner As Single = 8
    Public Const ScrollWidth As Single = 32
    Public Const HeaderMinWidth As Single = 100
    Public Const HeaderMaxWidth As Single = 240
    Public Const HeaderFontSize As Single = 12
    Public Const HeaderPadding As Single = 8
    Public Const AddWidth As Single = 32
    Public Const AddGap As Single = 3
    Public Const AddHeight As Single = 24
    Public Const ContentTop As Single = 40

    Public Function HeaderTop(ByVal Style As UI3TabStyle) As Single
        If Style = ui3TabExplorer Then HeaderTop = 8 Else HeaderTop = 4
    End Function

    Public Function AuxiliaryTop(ByVal Style As UI3TabStyle) As Single
        AuxiliaryTop = (HeaderTop(Style) + ContentTop - AddHeight) / 2
    End Function

    Public Function FootRadius(ByVal Style As UI3TabStyle) As Single
        If Style = ui3TabExplorer Then FootRadius = 4 Else FootRadius = 8
    End Function

    Public Function HeaderHeight(ByVal Style As UI3TabStyle) As Single
        HeaderHeight = ContentTop - HeaderTop(Style)
    End Function

    Public Function Overflowing(ByVal Width As Single, ByVal Count As Long, ByVal ShowAdd As Boolean, ByVal Style As UI3TabStyle) As Boolean
        If ShowAdd Then Width = Width - AddWidth - AddGap
        Overflowing = Count * HeaderMinWidth > Width - 2 * FootRadius(Style) And Width >= 2 * FootRadius(Style) + 2 * ScrollWidth + 1
    End Function

    Public Function HeaderStart(ByVal Width As Single, ByVal Count As Long, ByVal ShowAdd As Boolean, ByVal Style As UI3TabStyle) As Single
        HeaderStart = FootRadius(Style)
        If Overflowing(Width, Count, ShowAdd, Style) Then HeaderStart = HeaderStart + ScrollWidth
    End Function

    Public Function HeaderArea(ByVal Width As Single, ByVal Count As Long, ByVal ShowAdd As Boolean, ByVal Style As UI3TabStyle) As Single
        HeaderArea = Width - 2 * FootRadius(Style)
        If ShowAdd Then HeaderArea = HeaderArea - AddWidth - AddGap
        If Overflowing(Width, Count, ShowAdd, Style) Then HeaderArea = HeaderArea - 2 * ScrollWidth
        If HeaderArea < 0 Then HeaderArea = 0
    End Function

    Public Function HoverFill() As Long
        If IsDarkMode() Then HoverFill = &H0FFFFFFF Else HoverFill = &H0A000000
    End Function

    Public Function PressedFill() As Long
        If IsDarkMode() Then PressedFill = &H733A3A3A Else PressedFill = &HB3FFFFFF
    End Function

    Public Function Divider() As Long
        If IsDarkMode() Then Divider = &H15FFFFFF Else Divider = &H0F000000
    End Function

    Public Function AuxiliaryFill(ByVal Pressed As Boolean) As Long
        If IsDarkMode() Then
            If Pressed Then AuxiliaryFill = &H0AFFFFFF Else AuxiliaryFill = &H0FFFFFFF
        Else
            If Pressed Then AuxiliaryFill = &H06000000 Else AuxiliaryFill = &H09000000
        End If
    End Function

    Private Declare PtrSafe Function GetKeyState Lib "user32" (ByVal Key As Long) As Integer
    Private Declare PtrSafe Function SetCapture Lib "user32" (ByVal hWnd As LongPtr) As LongPtr
    Private Declare PtrSafe Function GetCapture Lib "user32" () As LongPtr
    Private Declare PtrSafe Function ReleaseCapture Lib "user32" () As Long

    ' Hover tracking, erase suppression and header-only invalidation moved to UI3Surface in
    ' 1.0.0.71. WM_GETDLGCODE: arrows always, and Tab while Ctrl is held (Ctrl+Tab switches pages).
    Public Function TabDialogCode(ByVal Code As LongPtr) As LongPtr
        TabDialogCode = Code Or 1 ' DLGC_WANTARROWS
        If GetKeyState(vbKeyControl) < 0 Then TabDialogCode = TabDialogCode Or 2 ' DLGC_WANTTAB
    End Function

    Public Sub CapturePointer(ByVal hWnd As LongPtr)
        SetCapture hWnd
    End Sub

    Public Sub ReleasePointer(ByVal hWnd As LongPtr)
        If GetCapture() = hWnd Then ReleaseCapture
    End Sub

    Public Function KeyboardFocusIntent() As Boolean
        KeyboardFocusIntent = GetKeyState(vbKeyTab) < 0 Or GetKeyState(vbKeyLeft) < 0 Or _
            GetKeyState(vbKeyRight) < 0 Or GetKeyState(vbKeyHome) < 0 Or GetKeyState(vbKeyEnd) < 0
    End Function

    Public Function PointerPressed(ByVal hWnd As LongPtr) As Boolean
        PointerPressed = GetCapture() = hWnd And GetKeyState(vbLeftButton) < 0
    End Function

    Private Declare PtrSafe Function GetDpiForWindow Lib "user32" (ByVal hWnd As LongPtr) As Long

    Public Function WindowDpi(ByVal hWnd As LongPtr) As Single
        WindowDpi = GetDpiForWindow(hWnd)
        If WindowDpi <= 0 Then WindowDpi = 96
    End Function

    Public Function HeaderBackground() As Long
        If IsDarkMode() Then HeaderBackground = DARK_SolidBackgroundFillColorBase Else HeaderBackground = LIGHT_SolidBackgroundFillColorBase
    End Function

    Public Function PageBackground() As Long
        If IsDarkMode() Then PageBackground = DARK_SolidBackgroundFillColorTertiary Else PageBackground = LIGHT_SolidBackgroundFillColorTertiary
    End Function

    Public Function HeaderOleColor() As Long
        Dim color As Long = HeaderBackground()
        HeaderOleColor = RGB((color And &HFF0000) \ &H10000, (color And &HFF00&) \ &H100&, color And &HFF&)
    End Function

    Public Function PageOleColor() As Long
        Dim color As Long = PageBackground()
        PageOleColor = RGB((color And &HFF0000) \ &H10000, (color And &HFF00&) \ &H100&, color And &HFF&)
    End Function

    Public Function HeaderWidth(ByVal Width As Single, ByVal Count As Long, ByVal ShowAdd As Boolean, ByVal Style As UI3TabStyle) As Single
        If Count = 0 Then Return HeaderMinWidth
        HeaderWidth = HeaderArea(Width, Count, ShowAdd, Style) / Count
        If HeaderWidth < HeaderMinWidth Then HeaderWidth = HeaderMinWidth
        If HeaderWidth > HeaderMaxWidth Then HeaderWidth = HeaderMaxWidth
    End Function

    Public Sub FillBox(ByVal Target As ID2D1RenderTarget, ByVal X As Single, ByVal Y As Single, ByVal W As Single, ByVal H As Single, ByVal Color As Long)
        If W <= 0 Or H <= 0 Then Exit Sub
        Dim box As D2D1_ROUNDED_RECT = RoundedRect(X, Y, X + W, Y + H, 0)
        Target.FillRoundedRectangle box, SolidBrush(Target, Color)
    End Sub
End Module

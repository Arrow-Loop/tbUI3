' tbUI3 theme: cached light/dark state, the system accent palette, and WinUI colour tokens.
'
' Token values are copied from microsoft-ui-xaml (main, commit 8318c5bf, 2026-10-05):
'   controls/dev/CommonStyles/Common_themeresources_any.xaml   (Default = dark, Light)
'   controls/dev/CommonStyles/Button_themeresources.xaml
'   controls/dev/CommonStyles/TextBox_themeresources.xaml
'   controls/dev/CommonStyles/ScrollBar_themeresources.xaml
'   controls/dev/CommonStyles/CornerRadius_themeresources.xaml
' Colours are &HAARRGGBB, the same order as XAML's #AARRGGBB.
' High contrast is not handled yet.

Private Module UI3Theme

    Public Const DARK_TextFillColorPrimary As Long = &HFFFFFFFF
    Public Const DARK_TextFillColorSecondary As Long = &HC5FFFFFF
    Public Const DARK_TextFillColorDisabled As Long = &H5DFFFFFF
    Public Const DARK_TextOnAccentFillColorPrimary As Long = &HFF000000
    Public Const DARK_TextOnAccentFillColorSecondary As Long = &H80000000
    Public Const DARK_TextOnAccentFillColorDisabled As Long = &H87FFFFFF
    Public Const DARK_ControlFillColorDefault As Long = &H0FFFFFFF
    Public Const DARK_ControlFillColorSecondary As Long = &H15FFFFFF
    Public Const DARK_ControlFillColorTertiary As Long = &H08FFFFFF
    Public Const DARK_ControlFillColorDisabled As Long = &H0BFFFFFF
    Public Const DARK_AccentFillColorDisabled As Long = &H28FFFFFF
    Public Const DARK_ControlFillColorInputActive As Long = &HB31E1E1E
    Public Const DARK_ControlStrongFillColorDefault As Long = &H8BFFFFFF
    Public Const DARK_ControlStrokeColorDefault As Long = &H12FFFFFF
    Public Const DARK_ControlStrokeColorSecondary As Long = &H18FFFFFF
    Public Const DARK_ControlStrokeColorOnAccentDefault As Long = &H14FFFFFF
    Public Const DARK_ControlStrokeColorOnAccentSecondary As Long = &H23000000
    Public Const DARK_SolidBackgroundFillColorBase As Long = &HFF202020

    Public Const LIGHT_TextFillColorPrimary As Long = &HE4000000
    Public Const LIGHT_TextFillColorSecondary As Long = &H9E000000
    Public Const LIGHT_TextFillColorDisabled As Long = &H5C000000
    Public Const LIGHT_TextOnAccentFillColorPrimary As Long = &HFFFFFFFF
    Public Const LIGHT_TextOnAccentFillColorSecondary As Long = &HB3FFFFFF
    Public Const LIGHT_TextOnAccentFillColorDisabled As Long = &HFFFFFFFF
    Public Const LIGHT_ControlFillColorDefault As Long = &HB3FFFFFF
    Public Const LIGHT_ControlFillColorSecondary As Long = &H80F9F9F9
    Public Const LIGHT_ControlFillColorTertiary As Long = &H4DF9F9F9
    Public Const LIGHT_ControlFillColorDisabled As Long = &H4DF9F9F9
    Public Const LIGHT_AccentFillColorDisabled As Long = &H37000000
    Public Const LIGHT_ControlFillColorInputActive As Long = &HFFFFFFFF
    Public Const LIGHT_ControlStrongFillColorDefault As Long = &H72000000
    Public Const LIGHT_ControlStrokeColorDefault As Long = &H0F000000
    Public Const LIGHT_ControlStrokeColorSecondary As Long = &H29000000
    Public Const LIGHT_ControlStrokeColorOnAccentDefault As Long = &H14FFFFFF
    Public Const LIGHT_ControlStrokeColorOnAccentSecondary As Long = &H66000000
    Public Const LIGHT_SolidBackgroundFillColorBase As Long = &HFFF3F3F3

    Public Const ControlCornerRadius As Single = 4
    Public Const ButtonBorderThemeThickness As Single = 1
    Public Const ButtonPaddingLeft As Single = 11
    Public Const ButtonPaddingTop As Single = 5
    Public Const ButtonPaddingRight As Single = 11
    Public Const ButtonPaddingBottom As Single = 6
    Public Const ElevationBorderGradientLength As Single = 3
    Public Const ElevationBorderStop0 As Single = 0.33
    Public Const ElevationBorderStop1 As Single = 1

    ' WinUI IconElement/SymbolIcon core default font size (microsoft-ui-xaml icon.cpp).
    Public Const SymbolIconDefaultFontSize As Single = 20
    ' WinUI Gallery Spacing guidance: 8 epx between a control and label / adjacent UI controls.
    ' Button content itself is arbitrary XAML, so tbUI3 uses this documented 8-DIP spacing
    ' as the default convenience gap for icon + Caption composition.
    Public Const ButtonIconSpacingDefault As Single = 8

    Public Const ACCENT_LIGHT3 As Long = 0
    Public Const ACCENT_LIGHT2 As Long = 1
    Public Const ACCENT_LIGHT1 As Long = 2
    Public Const ACCENT_BASE As Long = 3
    Public Const ACCENT_DARK1 As Long = 4
    Public Const ACCENT_DARK2 As Long = 5
    Public Const ACCENT_DARK3 As Long = 6

    Private Const FALLBACK_ACCENT As Long = &HFF0078D4
    Private Const HKEY_CURRENT_USER As Long = &H80000001
    Private Const RRF_RT_REG_DWORD As Long = &H10
    Private Const RRF_RT_REG_BINARY As Long = &H8
    Private Const PERSONALIZE_KEY As String = "Software\Microsoft\Windows\CurrentVersion\Themes\Personalize"
    Private Const ACCENT_KEY As String = "Software\Microsoft\Windows\CurrentVersion\Explorer\Accent"

    Private Declare PtrSafe Function RegGetValueW Lib "advapi32" (ByVal hkey As LongPtr, ByVal lpSubKey As LongPtr, ByVal lpValue As LongPtr, _
        ByVal dwFlags As Long, ByRef pdwType As Long, ByRef pvData As Any, ByRef pcbData As Long) As Long
    Private Declare PtrSafe Function DwmGetColorizationColor Lib "dwmapi" (ByRef pcrColorization As Long, ByRef pfOpaqueBlend As Long) As Long

    Private m_CacheValid As Boolean
    Private m_SystemDark As Boolean
    Private m_ThemeMode As UI3ThemeMode
    Private m_Accent(0 To 6) As Long

    Public Sub SetThemeMode(ByVal Value As UI3ThemeMode)
        If Value < ui3ThemeSystem Or Value > ui3ThemeDark Then Err.Raise 380
        m_ThemeMode = Value
    End Sub

    Public Sub RefreshTheme()
        m_SystemDark = ReadSystemDarkMode()

        Dim palette(0 To 31) As Byte
        Dim valueType As Long
        Dim size As Long
        Dim hr As Long
        Dim i As Long

        size = 32
        hr = RegGetValueW(CLngPtr(HKEY_CURRENT_USER), StrPtr(ACCENT_KEY), StrPtr("AccentPalette"), _
            RRF_RT_REG_BINARY, valueType, palette(0), size)

        If hr = 0 And size >= 28 Then
            For i = 0 To 6
                m_Accent(i) = &HFF000000 Or (CLng(palette(i * 4)) * &H10000) Or _
                    (CLng(palette(i * 4 + 1)) * &H100&) Or CLng(palette(i * 4 + 2))
            Next i
        Else
            Dim colorization As Long
            Dim opaque As Long
            Dim fallback As Long

            If DwmGetColorizationColor(colorization, opaque) = 0 Then
                fallback = colorization Or &HFF000000
            Else
                fallback = FALLBACK_ACCENT
            End If

            For i = 0 To 6
                m_Accent(i) = fallback
            Next i
        End If

        m_CacheValid = True
    End Sub

    Public Function IsDarkMode() As Boolean
        EnsureThemeCache

        Select Case m_ThemeMode
            Case ui3ThemeLight
                IsDarkMode = False
            Case ui3ThemeDark
                IsDarkMode = True
            Case Else
                IsDarkMode = m_SystemDark
        End Select
    End Function

    Public Function AccentShade(ByVal shade As Long) As Long
        EnsureThemeCache
        If shade < ACCENT_LIGHT3 Or shade > ACCENT_DARK3 Then shade = ACCENT_BASE
        AccentShade = m_Accent(shade)
    End Function

    Private Sub EnsureThemeCache()
        If Not m_CacheValid Then RefreshTheme
    End Sub

    Private Function ReadSystemDarkMode() As Boolean
        Dim value As Long
        Dim valueType As Long
        Dim size As Long

        size = 4
        If RegGetValueW(CLngPtr(HKEY_CURRENT_USER), StrPtr(PERSONALIZE_KEY), StrPtr("AppsUseLightTheme"), _
                RRF_RT_REG_DWORD, valueType, value, size) = 0 Then
            ReadSystemDarkMode = (value = 0)
        Else
            ReadSystemDarkMode = False
        End If
    End Function

End Module

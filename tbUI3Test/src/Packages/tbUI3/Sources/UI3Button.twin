[FormDesignerId("35E99E9A-8C48-48C2-B333-6809F44B6A8B")]
[ClassId("32A0CE42-2A55-4FED-A85E-2FA3DAE02B62")]
[InterfaceId("04830CFD-8885-44BA-B656-3BE3DC1EB5B5")]
[EventInterfaceId("9537C7F3-9248-4E57-A001-3F7866775C78")]
[COMControl]
[Description("tbUI3 button. Direct2D/DirectWrite WinUI rendering with semantic system-icon support.")]
Public Class UI3Button
    ' Paint goes through the shared flicker-free surface (docs/RENDERING.md).
    Implements IUI3SurfaceClient

    ' Visual states follow WinUI's DefaultButtonStyle, AccentButtonStyle and SubtleButtonStyle
    ' (Button_themeresources.xaml) and Button::ChangeVisualState: Disabled wins over Pressed,
    ' Pressed over PointerOver, PointerOver over Normal. Pointer and keyboard behaviour follows
    ' ButtonBase (ButtonBase_Partial.cpp). Sources and deviations: docs/controls/UI3Button.md.

    Public Event Click()

    ' Caption given to a newly dropped button. The saved default is an empty string, so a
    ' caption cleared in the designer stays empty (an icon-only button) instead of reloading as "Button".
    Private Const NEW_CONTROL_CAPTION As String = "Button"
    Private Const DEFAULT_CAPTION As String = ""
    Private Const DEFAULT_STYLE As Long = 0
    Private Const DEFAULT_ICON As Long = 0
    Private Const DEFAULT_ICON_GLYPH As String = ""
    Private Const DEFAULT_ICON_FONT_NAME As String = ""
    Private Const DEFAULT_ICON_POSITION As Long = 0
    Private Const DEFAULT_ICON_KEY As String = ""
    Private Const DEFAULT_ICON_LIST As String = ""
    Private Const DEFAULT_ENABLED As Boolean = True
    Private Const DEFAULT_CLICK_MODE As Long = 0
    Private Const DEFAULT_USE_SYSTEM_FOCUS_VISUALS As Boolean = True
    Private Const DEFAULT_ACCESS_KEY As String = ""
    Private Const WM_ENABLE As Long = &HA
    Private Const WM_CAPTURECHANGED As Long = &H215

    ' Button::ChangeVisualState's CommonStates.
    Private Const STATE_NORMAL As Long = 0
    Private Const STATE_POINTER_OVER As Long = 1
    Private Const STATE_PRESSED As Long = 2
    Private Const STATE_DISABLED As Long = 3

    ' Border kinds used by the three styles' visual states.
    Private Const BORDER_NONE As Long = 0        ' a transparent brush (ControlFillColorTransparent and friends)
    Private Const BORDER_ELEVATION As Long = 1   ' ControlElevationBorderBrush / AccentControlElevationBorderBrush
    Private Const BORDER_SOLID As Long = 2       ' a solid colour

    Private m_Caption As String
    Private m_Style As UI3ButtonStyle
    Private m_Icon As UI3Icon
    Private m_IconGlyph As String
    Private m_IconFontName As String
    Private m_IconPosition As UI3IconPosition
    Private m_IconSpacing As Single
    Private m_IconSize As Single
    ' A stored SVG or bitmap icon (IconData). When it holds one, Icon is None and IconGlyph is empty.
    Private m_IconImage As New UI3IconImage
    ' UI3IconList link (IconKey, IconList). The entry is fetched from the list when the button
    ' paints, and fetched again only when the list's Revision or the key changes.
    Private m_IconKey As String
    Private m_IconListName As String
    Private m_IconListObject As UI3IconList   ' set from code only; never saved
    Private m_ListImage As New UI3IconImage
    Private m_ListGlyph As Long
    Private m_ListRevision As Long
    Private m_ListFetchedKey As String
    Private m_ListLookupNote As String
    Private m_RegisteredHwnd As LongPtr
    ' Borrowed from m_Surface for the length of one SurfaceRender call.
    Private m_Target As ID2D1RenderTarget
    Private m_Surface As UI3Surface
    Private m_TargetGeneration As Long

    Private m_ClickMode As UI3ClickMode
    Private m_UseSystemFocusVisuals As Boolean
    Private m_AccessKey As String
    ' IsPressed is any of: a left-button press with the pointer inside, Space or Enter held,
    ' or the pointer over a ClickMode Hover button.
    Private m_PointerDown As Boolean
    Private m_PointerPressed As Boolean
    Private m_KeyPressed As Boolean
    Private m_HeldKey As Integer
    Private m_HoverPressed As Boolean
    Private m_Focused As Boolean
    Private m_KeyboardFocus As Boolean
    Private m_PointerFocusing As Boolean

    Public Property Get Caption() As String
        Caption = m_Caption
    End Property

    Public Property Let Caption(ByVal Value As String)
        m_Caption = Value
        PropertyChanged "Caption"
        Repaint
    End Property

    Public Property Get Style() As UI3ButtonStyle
        Style = m_Style
    End Property

    Public Property Let Style(ByVal Value As UI3ButtonStyle)
        If Value < ui3ButtonStandard Or Value > ui3ButtonSubtle Then Err.Raise 380
        m_Style = Value
        PropertyChanged "Style"
        Repaint
    End Property

    ' The container reads this as the control's Enabled (DISPID_ENABLED), as for VB's own controls.
    [DispId(-514)]
    [Description("Whether the button responds to the user. False shows WinUI's Disabled state. WinUI: Control.IsEnabled.")]
    Public Property Get Enabled() As Boolean
        Enabled = UserControl.Enabled
    End Property

    Public Property Let Enabled(ByVal Value As Boolean)
        UserControl.Enabled = Value
        If Not Value Then CancelPress
        PropertyChanged "Enabled"
        Repaint
    End Property

    [Description("When Click is raised: Release (default), Press, or Hover. WinUI: ButtonBase.ClickMode.")]
    Public Property Get ClickMode() As UI3ClickMode
        ClickMode = m_ClickMode
    End Property

    Public Property Let ClickMode(ByVal Value As UI3ClickMode)
        If Value < ui3ClickModeRelease Or Value > ui3ClickModeHover Then Err.Raise 380
        m_ClickMode = Value
        CancelPress
        PropertyChanged "ClickMode"
        Repaint
    End Property

    [Description("Show the system focus visual when the button has keyboard focus. Default True. WinUI: Control.UseSystemFocusVisuals.")]
    Public Property Get UseSystemFocusVisuals() As Boolean
        UseSystemFocusVisuals = m_UseSystemFocusVisuals
    End Property

    Public Property Let UseSystemFocusVisuals(ByVal Value As Boolean)
        m_UseSystemFocusVisuals = Value
        PropertyChanged "UseSystemFocusVisuals"
        Repaint
    End Property

    [Description("Key that clicks the button with Alt, such as S for Alt+S. WinUI: UIElement.AccessKey. Key tips are not shown.")]
    Public Property Get AccessKey() As String
        AccessKey = m_AccessKey
    End Property

    Public Property Let AccessKey(ByVal Value As String)
        m_AccessKey = Left$(Value, 1)
        ApplyAccessKey
        PropertyChanged "AccessKey"
    End Property

    ' Run-time state, read-only, as in WinUI.
    [Description("True while the button is pressed (pointer, Space or Enter, or Hover click mode). WinUI: ButtonBase.IsPressed.")]
    [NonBrowsable]
    Public Property Get IsPressed() As Boolean
        IsPressed = PressedNow()
    End Property

    [Description("True while the pointer is over the button. WinUI: ButtonBase.IsPointerOver.")]
    [NonBrowsable]
    Public Property Get IsPointerOver() As Boolean
        IsPointerOver = PointerOverNow()
    End Property

    ' Linked to the UI3IconPage picker: Icon gets its own "..." in the Properties pane, as in VB6
    ' (twinBASIC BETA 1008 and later; earlier betas open the page only from (Custom)).
    [PropertyPage("UI3IconPage")]
    [Description("Segoe Fluent Icons glyph, as in WinUI's FontIcon. Drawn in Segoe Fluent Icons, or Segoe MDL2 Assets on Windows 10.")]
    Public Property Get Icon() As UI3Icon
        Icon = m_Icon
    End Property

    Public Property Let Icon(ByVal Value As UI3Icon)
        m_Icon = Value
        ClearIconImage
        If Value <> ui3IconNone Then ClearIconKey
        If IconPageApplying Then
            SetPendingIcon DesignName(), Value
            ClearPendingLibraryIcon DesignName()
        End If
        DesignTrace "Let Icon " & Hex$(ObjPtr(Me)) & " " & DesignName() & " = " & CLng(Value) & IIf(IconPageApplying, " (from page)", "")
        DesignLog "Let Icon " & Hex$(ObjPtr(Me)) & " " & DesignName() & " = " & CLng(Value) & IIf(IconPageApplying, " (from page)", "")
        PropertyChanged "Icon"
        DesignTrace "Let Icon PropertyChanged done " & DesignName()
        Repaint
        DesignTrace "Let Icon done " & DesignName()
    End Property

    [Description("Advanced raw glyph override. When non-empty, this takes precedence over Icon.")]
    Public Property Get IconGlyph() As String
        IconGlyph = m_IconGlyph
    End Property

    Public Property Let IconGlyph(ByVal Value As String)
        m_IconGlyph = Value
        If Len(Value) <> 0 Then
            ClearIconImage
            ClearIconKey
        End If
        PropertyChanged "IconGlyph"
        Repaint
    End Property

    [Description("Font family used only with an explicit IconGlyph. Leave empty for Segoe Fluent Icons with Segoe MDL2 Assets fallback.")]
    Public Property Get IconFontName() As String
        IconFontName = m_IconFontName
    End Property

    Public Property Let IconFontName(ByVal Value As String)
        m_IconFontName = Value
        PropertyChanged "IconFontName"
        Repaint
    End Property

    [Description("Position of the icon relative to Caption.")]
    Public Property Get IconPosition() As UI3IconPosition
        IconPosition = m_IconPosition
    End Property

    Public Property Let IconPosition(ByVal Value As UI3IconPosition)
        If Value < ui3IconLeft Or Value > ui3IconBottom Then Err.Raise 380
        m_IconPosition = Value
        PropertyChanged "IconPosition"
        Repaint
    End Property

    [Description("Gap in DIPs between icon and Caption. Default 8, following WinUI Gallery spacing guidance.")]
    Public Property Get IconSpacing() As Single
        IconSpacing = m_IconSpacing
    End Property

    Public Property Let IconSpacing(ByVal Value As Single)
        If Value < 0 Then Err.Raise 380
        m_IconSpacing = Value
        PropertyChanged "IconSpacing"
        Repaint
    End Property

    [Description("Size in DIPs of the square the icon fills. Default 20, WinUI's SymbolIcon size (SymbolIcon.FontSize).")]
    Public Property Get IconSize() As Single
        IconSize = m_IconSize
    End Property

    Public Property Let IconSize(ByVal Value As Single)
        If Value <= 0 Then Err.Raise 380
        m_IconSize = Value
        PropertyChanged "IconSize"
        Repaint
    End Property

    [Description("Key of the UI3IconList entry to show. Setting it replaces Icon, IconGlyph and a stored image. A missing key or list shows no icon.")]
    Public Property Get IconKey() As String
        IconKey = m_IconKey
    End Property

    Public Property Let IconKey(ByVal Value As String)
        m_IconKey = Value
        m_ListRevision = 0
        If Len(Value) <> 0 Then
            If m_Icon <> ui3IconNone Then
                m_Icon = ui3IconNone
                PropertyChanged "Icon"
            End If
            If Len(m_IconGlyph) <> 0 Then
                m_IconGlyph = ""
                PropertyChanged "IconGlyph"
            End If
            ClearIconImage
        End If
        PropertyChanged "IconKey"
        Repaint
    End Property

    ' The list IconKey refers to: a list's name (typed in the Properties pane), or in code a
    ' UI3IconList object (Set). Empty means the form's only UI3IconList.
    [Description("Name of the UI3IconList that IconKey refers to. Leave empty to use the form's only UI3IconList. In code, Set it to a UI3IconList.")]
    Public Property Get IconList() As Variant
        If Not m_IconListObject Is Nothing Then
            Set IconList = m_IconListObject
        Else
            IconList = m_IconListName
        End If
    End Property

    Public Property Let IconList(ByVal Value As Variant)
        m_IconListName = CStr(Value)
        Set m_IconListObject = Nothing
        m_ListRevision = 0
        PropertyChanged "IconList"
        Repaint
    End Property

    Public Property Set IconList(ByVal Value As Variant)
        If Not IsObject(Value) Then Err.Raise 13
        If Value Is Nothing Then
            Set m_IconListObject = Nothing
        ElseIf TypeOf Value Is UI3IconList Then
            Set m_IconListObject = Value
            m_IconListName = ""
        Else
            Err.Raise 13
        End If
        m_ListRevision = 0
        Repaint
    End Property

    Private Sub ClearIconKey()
        If Len(m_IconKey) = 0 Then Exit Sub
        m_IconKey = ""
        m_ListRevision = 0
        PropertyChanged "IconKey"
    End Sub

    ' The stored icon file (an SVG, or a PNG or other image) as a Byte array in a Variant, or Empty.
    ' Assigning another control's IconData copies its icon; assigning Empty or an empty array removes it.
    ' Not listed in the Properties pane (it can't show bytes); IconSource names the icon there.
    [Description("The stored SVG or image icon's file bytes. Assign another control's IconData to copy its icon. Set it with LoadIcon or LoadIconFile.")]
    [NonBrowsable]
    Public Property Get IconData() As Variant
        If m_IconImage.HasImage Then IconData = m_IconImage.GetData() Else IconData = Empty
    End Property

    [NonBrowsable]
    Public Property Let IconData(ByVal Value As Variant)
        Dim data() As Byte
        If IsEmpty(Value) Then
            ClearIconImage
            Repaint
            Exit Property
        End If
        If Not IsArray(Value) Then Err.Raise 380
        data = Value
        If ByteArrayLength(data) = 0 Then
            ClearIconImage
            Repaint
            Exit Property
        End If
        StoreIconImage data, ""
    End Property

    [Description("Read-only name of the stored SVG or image icon, such as file:save.svg. Empty when the icon is Icon or IconGlyph.")]
    Public Property Get IconSource() As String
        If Not m_IconImage.HasImage Then Exit Property
        IconSource = m_IconImage.Source
        If Len(IconSource) = 0 Then IconSource = IIf(m_IconImage.IsSvg, "(SVG)", "(image)")
    End Property

    ' Read-only. The Let exists only so the Properties pane lists IconSource; it refuses every value.
    Public Property Let IconSource(ByVal Value As String)
        Err.Raise 383
    End Property

    ' Stores an SVG, PNG or other image file's bytes (a Byte array, or a Variant holding one, as
    ' LoadResData returns) as the icon. Name is shown as IconSource. Raises error 380 when Data is not
    ' a recognised image. The icon picker applies its library picks through this method.
    [Description("Stores SVG or image file bytes (for example from LoadResData) as the icon. Name is shown as IconSource.")]
    Public Sub LoadIcon(ByVal Data As Variant, Optional ByVal Name As String = "")
        Dim bytes() As Byte
        If IconPageApplying Then UI3PropertyPageLog "BUTTON LoadIcon start " & DesignName() & " = " & Name
        If Not IsArray(Data) Then Err.Raise 380
        bytes = Data
        StoreIconImage bytes, Name
        If IconPageApplying Then UI3PropertyPageLog "BUTTON LoadIcon done " & DesignName()
    End Sub

    ' Stores an SVG, PNG or other image file as the icon. IconSource becomes file:<file name>.
    [Description("Stores an SVG or image file as the icon. IconSource becomes file:<file name>.")]
    Public Sub LoadIconFile(ByVal Path As String)
        Dim data() As Byte
        Dim f As Integer
        Dim n As Long
        Dim fileName As String

        f = FreeFile
        Open Path For Binary Access Read As #f
        n = LOF(f)
        If n > 0 Then
            ReDim data(0 To n - 1)
            Get #f, , data
        End If
        Close #f
        If n = 0 Then Err.Raise 380

        fileName = Mid$(Path, InStrRev(Path, "\") + 1)
        fileName = Mid$(fileName, InStrRev(fileName, "/") + 1)
        StoreIconImage data, "file:" & fileName
    End Sub

    ' The last icon set wins: a stored image replaces Icon and IconGlyph.
    Private Sub StoreIconImage(ByRef Data() As Byte, ByVal Source As String)
        If Not m_IconImage.SetData(Data, Source) Then Err.Raise 380
        DesignLog "Store image " & Hex$(ObjPtr(Me)) & " " & DesignName() & " = " & Source & IIf(IconPageApplying, " (from page)", "")
        If IconPageApplying Then
            SetPendingLibraryIcon DesignName(), Data, Source
            UI3PropertyPageLog "BUTTON stored and pending " & DesignName() & " = " & Source
        End If
        If m_Icon <> ui3IconNone Then
            m_Icon = ui3IconNone
            PropertyChanged "Icon"
        End If
        If Len(m_IconGlyph) <> 0 Then
            m_IconGlyph = ""
            PropertyChanged "IconGlyph"
        End If
        ClearIconKey
        PropertyChanged "IconData"
        PropertyChanged "IconSource"
        If IconPageApplying Then UI3PropertyPageLog "BUTTON PropertyChanged done " & DesignName()
        Repaint
    End Sub

    Private Sub ClearIconImage()
        If Not m_IconImage.HasImage Then Exit Sub
        m_IconImage.Clear
        PropertyChanged "IconData"
        PropertyChanged "IconSource"
    End Sub

    Private Function ByteArrayLength(ByRef Data() As Byte) As Long
        On Error Resume Next
        ByteArrayLength = UBound(Data) - LBound(Data) + 1
    End Function

    Private Sub UserControl_InitProperties()
        m_Caption = NEW_CONTROL_CAPTION
        m_Style = DEFAULT_STYLE
        m_Icon = DEFAULT_ICON
        m_IconGlyph = DEFAULT_ICON_GLYPH
        m_IconFontName = DEFAULT_ICON_FONT_NAME
        m_IconPosition = DEFAULT_ICON_POSITION
        m_IconSpacing = ButtonIconSpacingDefault
        m_IconSize = SymbolIconDefaultFontSize
        m_IconImage.Clear
        m_IconKey = DEFAULT_ICON_KEY
        m_IconListName = DEFAULT_ICON_LIST
        m_ClickMode = DEFAULT_CLICK_MODE
        m_UseSystemFocusVisuals = DEFAULT_USE_SYSTEM_FOCUS_VISUALS
        m_AccessKey = DEFAULT_ACCESS_KEY
        ApplyAccessKey
    End Sub

    Private Sub UserControl_ReadProperties(PropBag As PropertyBag)
        m_Caption = PropBag.ReadProperty("Caption", DEFAULT_CAPTION)
        m_Style = PropBag.ReadProperty("Style", DEFAULT_STYLE)
        m_Icon = PropBag.ReadProperty("Icon", DEFAULT_ICON)
        m_IconGlyph = PropBag.ReadProperty("IconGlyph", DEFAULT_ICON_GLYPH)
        m_IconFontName = PropBag.ReadProperty("IconFontName", DEFAULT_ICON_FONT_NAME)
        m_IconPosition = PropBag.ReadProperty("IconPosition", DEFAULT_ICON_POSITION)
        m_IconSpacing = PropBag.ReadProperty("IconSpacing", ButtonIconSpacingDefault)
        m_IconSize = PropBag.ReadProperty("IconSize", SymbolIconDefaultFontSize)
        If m_IconSize <= 0 Then m_IconSize = SymbolIconDefaultFontSize
        ReadIconImage PropBag
        m_IconKey = PropBag.ReadProperty("IconKey", DEFAULT_ICON_KEY)
        m_IconListName = PropBag.ReadProperty("IconList", DEFAULT_ICON_LIST)
        m_ListRevision = 0
        UserControl.Enabled = PropBag.ReadProperty("Enabled", DEFAULT_ENABLED)
        m_ClickMode = PropBag.ReadProperty("ClickMode", DEFAULT_CLICK_MODE)
        If m_ClickMode < ui3ClickModeRelease Or m_ClickMode > ui3ClickModeHover Then m_ClickMode = DEFAULT_CLICK_MODE
        m_UseSystemFocusVisuals = PropBag.ReadProperty("UseSystemFocusVisuals", DEFAULT_USE_SYSTEM_FOCUS_VISUALS)
        m_AccessKey = Left$(PropBag.ReadProperty("AccessKey", DEFAULT_ACCESS_KEY), 1)
        ApplyAccessKey
        DesignLog "ReadProperties " & Hex$(ObjPtr(Me)) & " " & DesignName() & " Icon = " & CLng(m_Icon)
        If Not IsUserMode() Then
            DesignTrace "ReadProperties " & Hex$(ObjPtr(Me)) & " " & DesignName() & " Icon = " & CLng(m_Icon) & _
                ", IconSource = " & m_IconImage.Source & ", bytes = " & m_IconImage.ByteCount()
            If TakePendingIcon(DesignName(), m_Icon) Then
                DesignTrace "pending Icon taken " & DesignName() & " = " & CLng(m_Icon)
                PropertyChanged "Icon"
                ClearIconImage
                If m_Icon <> ui3IconNone Then ClearIconKey
            End If
            TakeLibraryIcon
        End If
    End Sub

    ' Design-time steps of the icon picker's designer bridge, written to the property page log
    ' (pass 5 diagnostics; the log is %TEMP%\tbUI3-propertypage.log while it is switched on).
    Private Sub DesignTrace(ByVal Text As String)
        If IsUserMode() Then Exit Sub
        UI3PropertyPageLog "BUTTON " & Text
    End Sub

    ' The library half of the designer bridge: an SVG or PNG the picker applied (see UI3Icons).
    Private Sub TakeLibraryIcon()
        Dim data() As Byte
        Dim source As String
        If Not TakePendingLibraryIcon(DesignName(), data, source) Then Exit Sub
        DesignTrace "pending library taken " & DesignName() & " = " & source & ", bytes = " & ByteArrayLength(data)
        If Not m_IconImage.SetData(data, source) Then
            DesignTrace "pending library rejected by SetData " & DesignName()
            Exit Sub
        End If
        m_Icon = ui3IconNone
        m_IconGlyph = ""
        PropertyChanged "Icon"
        PropertyChanged "IconGlyph"
        PropertyChanged "IconData"
        PropertyChanged "IconSource"
        ClearIconKey
    End Sub

    Private Sub ReadIconImage(ByVal PropBag As PropertyBag)
        Dim stored As Variant
        Dim data() As Byte
        m_IconImage.Clear
        stored = PropBag.ReadProperty("IconData", Empty)
        If Not IsArray(stored) Then Exit Sub
        data = stored
        If ByteArrayLength(data) = 0 Then Exit Sub
        m_IconImage.SetData data, PropBag.ReadProperty("IconSource", "")
    End Sub

    ' Design-time name of this control, for the UI3IconPage designer bridge (see UI3Icons).
    Private Function DesignName() As String
        On Error Resume Next
        DesignName = UserControl.Ambient.DisplayName
    End Function

    Private Function IsUserMode() As Boolean
        IsUserMode = True
        On Error Resume Next
        IsUserMode = UserControl.Ambient.UserMode
    End Function

    Private Sub UserControl_WriteProperties(PropBag As PropertyBag)
        DesignLog "WriteProperties " & Hex$(ObjPtr(Me)) & " " & DesignName() & " Icon = " & CLng(m_Icon)
        PropBag.WriteProperty "Caption", m_Caption, DEFAULT_CAPTION
        PropBag.WriteProperty "Style", m_Style, DEFAULT_STYLE
        PropBag.WriteProperty "Icon", m_Icon, DEFAULT_ICON
        PropBag.WriteProperty "IconGlyph", m_IconGlyph, DEFAULT_ICON_GLYPH
        PropBag.WriteProperty "IconFontName", m_IconFontName, DEFAULT_ICON_FONT_NAME
        PropBag.WriteProperty "IconPosition", m_IconPosition, DEFAULT_ICON_POSITION
        PropBag.WriteProperty "IconSpacing", m_IconSpacing, ButtonIconSpacingDefault
        PropBag.WriteProperty "IconSize", m_IconSize, SymbolIconDefaultFontSize
        PropBag.WriteProperty "IconKey", m_IconKey, DEFAULT_ICON_KEY
        PropBag.WriteProperty "IconList", m_IconListName, DEFAULT_ICON_LIST
        PropBag.WriteProperty "Enabled", UserControl.Enabled, DEFAULT_ENABLED
        PropBag.WriteProperty "ClickMode", m_ClickMode, DEFAULT_CLICK_MODE
        PropBag.WriteProperty "UseSystemFocusVisuals", m_UseSystemFocusVisuals, DEFAULT_USE_SYSTEM_FOCUS_VISUALS
        PropBag.WriteProperty "AccessKey", m_AccessKey, DEFAULT_ACCESS_KEY
        DesignTrace "WriteProperties " & Hex$(ObjPtr(Me)) & " " & DesignName() & " Icon = " & CLng(m_Icon) & _
            ", IconSource = " & m_IconImage.Source & ", bytes = " & m_IconImage.ByteCount()
        If m_IconImage.HasImage Then
            On Error GoTo WriteFailed
            PropBag.WriteProperty "IconData", m_IconImage.GetData()
            PropBag.WriteProperty "IconSource", m_IconImage.Source, ""
        End If
        Exit Sub
WriteFailed:
        DesignTrace "WriteProperties image failed " & DesignName() & ": " & Err.Number & " " & Err.Description
    End Sub

    Private Sub UserControl_Resize()
        Repaint
    End Sub

    Private Sub UserControl_Show()
        EnsureSurface
    End Sub

    Private Sub UserControl_Terminate()
        If Not m_Surface Is Nothing Then m_Surface.Detach
        If m_RegisteredHwnd <> 0 Then UnregisterIconListUser m_RegisteredHwnd
        m_RegisteredHwnd = 0
        Set m_IconListObject = Nothing
    End Sub

    ' ---- Input (ButtonBase_Partial.cpp) ----
    ' Click is raised here, not from UserControl_Click, so ClickMode, a press dragged off the
    ' button and keyboard presses all behave as in WinUI.

    Private Sub UserControl_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If Button <> vbLeftButton Or Not UserControl.Enabled Then Exit Sub
        ' OnPointerPressed: Hover buttons ignore presses; others take focus (FocusState Pointer,
        ' so no focus visual), capture the pointer and become pressed.
        If m_ClickMode = ui3ClickModeHover Then Exit Sub
        FocusFromPointer
        ' A press moves focus to FocusState Pointer, which hides a keyboard focus visual.
        If m_KeyboardFocus Then
            m_KeyboardFocus = False
            Repaint
        End If
        m_PointerDown = True
        If Not m_Surface Is Nothing Then m_Surface.CapturePointer
        If Not m_KeyPressed Then SetPointerPressed True
        If m_ClickMode = ui3ClickModePress Then RaiseEvent Click
    End Sub

    Private Sub UserControl_MouseMove(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If Not m_PointerDown Then Exit Sub
        If (Button And vbLeftButton) = 0 Then
            ' The release happened where this control could not see it.
            m_PointerDown = False
            SetPointerPressed False
            Exit Sub
        End If
        ' OnPointerMoved: pressed only while the pointer is inside the button.
        If Not m_KeyPressed Then SetPointerPressed PointInside(X, Y)
    End Sub

    Private Sub UserControl_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If Button <> vbLeftButton Or Not m_PointerDown Then Exit Sub
        ' OnPointerReleased: act only if still pressed and no Space/Enter press is in progress.
        Dim perform As Boolean
        perform = PointInside(X, Y) And Not m_KeyPressed And UserControl.Enabled
        m_PointerDown = False
        SetPointerPressed False
        If Not m_Surface Is Nothing Then m_Surface.ReleasePointer
        If perform And m_ClickMode = ui3ClickModeRelease Then RaiseEvent Click
    End Sub

    ' Space and Enter press the button on key down and click on key up (ClickMode Release),
    ' or click on key down (ClickMode Press).
    Private Sub UserControl_KeyDown(KeyCode As Integer, Shift As Integer)
        If KeyCode <> vbKeySpace And KeyCode <> vbKeyReturn Then Exit Sub
        If Not UserControl.Enabled Or m_ClickMode = ui3ClickModeHover Then Exit Sub
        If m_HeldKey <> 0 Then
            KeyCode = 0          ' auto-repeat of the held key
            Exit Sub
        End If
        m_HeldKey = KeyCode
        m_KeyPressed = True
        KeyCode = 0
        Repaint
        If m_ClickMode = ui3ClickModePress Then RaiseEvent Click
    End Sub

    Private Sub UserControl_KeyUp(KeyCode As Integer, Shift As Integer)
        If m_HeldKey = 0 Or KeyCode <> m_HeldKey Then Exit Sub
        Dim perform As Boolean
        perform = m_KeyPressed And UserControl.Enabled And m_ClickMode = ui3ClickModeRelease
        m_HeldKey = 0
        m_KeyPressed = False
        KeyCode = 0
        Repaint
        If perform Then RaiseEvent Click
    End Sub

    ' Enter on the form's Default button, Esc on its Cancel button (DefaultCancel), or Alt+AccessKey.
    ' An Enter already being handled through KeyDown/KeyUp is not clicked twice.
    Private Sub UserControl_AccessKeyPress(KeyAscii As Integer)
        If Not UserControl.Enabled Then Exit Sub
        If KeyAscii = vbKeyReturn And m_HeldKey = vbKeyReturn Then Exit Sub
        RaiseEvent Click
    End Sub

    Private Sub UserControl_GotFocus()
        m_Focused = True
        ' Pointer focus never shows the focus visual; Tab or an access key does.
        m_KeyboardFocus = False
        If Not m_PointerFocusing And Not m_Surface Is Nothing Then m_KeyboardFocus = m_Surface.KeyboardFocusIntent()
        Repaint
    End Sub

    Private Sub UserControl_LostFocus()
        m_Focused = False
        m_KeyboardFocus = False
        ' OnLostFocus: no longer pressed, capture released, Space/Enter state cleared.
        CancelPress
        Repaint
    End Sub

    Private Sub FocusFromPointer()
        If m_Focused Then Exit Sub
        On Error Resume Next
        m_PointerFocusing = True
        UserControl.Extender.SetFocus
        m_PointerFocusing = False
    End Sub

    ' Ends any press without clicking (focus lost, disabled, capture taken away, ClickMode change).
    Private Sub CancelPress()
        Dim changed As Boolean
        changed = m_PointerPressed Or m_KeyPressed Or m_HoverPressed
        If m_PointerDown And Not m_Surface Is Nothing Then m_Surface.ReleasePointer
        m_PointerDown = False
        m_PointerPressed = False
        m_KeyPressed = False
        m_HeldKey = 0
        m_HoverPressed = False
        If changed Then Repaint
    End Sub

    Private Sub SetPointerPressed(ByVal Value As Boolean)
        If m_PointerPressed = Value Then Exit Sub
        m_PointerPressed = Value
        Repaint
    End Sub

    ' The control's own scale, so no DPI conversion is needed. ButtonBase allows 0.05 DIP tolerance.
    Private Function PointInside(ByVal X As Single, ByVal Y As Single) As Boolean
        PointInside = X >= 0 And Y >= 0 And X <= UserControl.ScaleWidth And Y <= UserControl.ScaleHeight
    End Function

    Private Function PressedNow() As Boolean
        PressedNow = m_PointerPressed Or m_KeyPressed Or m_HoverPressed
    End Function

    Private Function PointerOverNow() As Boolean
        If m_Surface Is Nothing Then Exit Function
        If Not m_Surface.OwnsPaint Then Exit Function
        PointerOverNow = (m_Surface.HotPart <> 0)
    End Function

    Private Function VisualState() As Long
        If Not UserControl.Enabled Then
            VisualState = STATE_DISABLED
        ElseIf PressedNow() Then
            VisualState = STATE_PRESSED
        ElseIf PointerOverNow() Then
            VisualState = STATE_POINTER_OVER
        Else
            VisualState = STATE_NORMAL
        End If
    End Function

    Private Sub ApplyAccessKey()
        On Error Resume Next
        UserControl.AccessKeys = m_AccessKey
    End Sub

    Private Sub UserControl_AmbientChanged(PropertyName As String)
        If StrComp(PropertyName, "BackColor", vbTextCompare) = 0 Then Repaint
    End Sub

    ' Run time: the surface owns WM_PAINT. Design time: the IDE's synchronous snapshots arrive
    ' through the Paint event, which draws through the same surface render.
    Private Sub EnsureSurface()
        If m_Surface Is Nothing Then Set m_Surface = New UI3Surface
        m_Surface.Attach UserControl.hWnd, Me, IsUserMode()
    End Sub

    Private Function OwnsPaint() As Boolean
        If Not m_Surface Is Nothing Then OwnsPaint = m_Surface.OwnsPaint
    End Function

    ' Property, size and theme changes: no-erase invalidate at run time, synchronous snapshot in the designer.
    Private Sub Repaint()
        If OwnsPaint() Then
            m_Surface.Invalidate
        Else
            UserControl.Refresh
        End If
    End Sub

    ' Design time (and any paint before Show). At run time this event does not fire.
    Private Sub UserControl_Paint()
        EnsureSurface
        m_Surface.PaintEvent UserControl.hDC
        If m_Surface.LastResult <> 0 Then PaintFailure m_Surface.LastResult
    End Sub

    Private Sub IUI3SurfaceClient_SurfaceRender(ByVal Target As ID2D1RenderTarget, ByVal w As Single, ByVal h As Single)
        ' Icon bitmaps and SVG documents belong to the render target that made them.
        If m_Surface.TargetGeneration <> m_TargetGeneration Then
            m_IconImage.ReleaseDeviceResources
            m_ListImage.ReleaseDeviceResources
            m_TargetGeneration = m_Surface.TargetGeneration
        End If
        Set m_Target = Target
        On Error GoTo Failed
        DrawButton w, h
        Set m_Target = Nothing
        Exit Sub
    Failed:
        Dim number As Long = Err.Number, description As String = Err.Description
        Set m_Target = Nothing
        Err.Raise number, "UI3Button", description
    End Sub

    ' The whole button is one part: 1 while the pointer is over it.
    Private Function IUI3SurfaceClient_SurfaceHitTest(ByVal X As Single, ByVal Y As Single) As Long
        IUI3SurfaceClient_SurfaceHitTest = 1
    End Function

    ' PointerOver changed. A ClickMode Hover button is pressed, and clicks, when the pointer enters
    ' (ButtonBase::OnPointerEntered) and is released when it leaves (OnPointerExited).
    Private Sub IUI3SurfaceClient_SurfaceHotChanged(ByVal OldPart As Long, ByVal NewPart As Long)
        Dim clickNow As Boolean
        If m_ClickMode = ui3ClickModeHover And UserControl.Enabled Then
            m_HoverPressed = (NewPart <> 0)
            clickNow = m_HoverPressed
        End If
        m_Surface.Invalidate
        If clickNow Then RaiseEvent Click
    End Sub

    Private Sub IUI3SurfaceClient_SurfaceStateChanged(ByVal Message As Long)
        Select Case Message
            Case WM_CAPTURECHANGED
                ' OnPointerCaptureLost: capture taken away while the button is still held.
                ' Capture moving to this same window (VB's own capture on mouse down) is not a loss.
                If m_PointerDown And m_Surface.LeftButtonHeld() And Not m_Surface.HasCapture() Then CancelPress
            Case WM_ENABLE
                If Not UserControl.Enabled Then CancelPress
                m_Surface.SyncHot
        End Select
        m_Surface.Invalidate
    End Sub

    Private Function IUI3SurfaceClient_SurfaceDialogCode(ByVal Code As LongPtr) As LongPtr
        IUI3SurfaceClient_SurfaceDialogCode = Code
    End Function

    ' The container shows through the rounded corners.
    Private Function IUI3SurfaceClient_SurfaceBackground() As Long
        IUI3SurfaceClient_SurfaceBackground = ArgbFromOleColor(ContainerBackColor())
    End Function

    Private Sub DrawButton(ByVal w As Single, ByVal h As Single)
        Dim dark As Boolean
        Dim state As Long
        Dim fill As Long
        Dim foreground As Long
        Dim borderKind As Long
        Dim borderColor As Long
        Dim strokeDefault As Long
        Dim strokeSecondary As Long
        Dim borderAtBottom As Boolean
        Dim fillInset As Single
        Dim box As D2D1_ROUNDED_RECT
        Dim r As Single
        Dim t As Single

        dark = IsDarkMode()
        state = VisualState()
        r = ControlCornerRadius
        t = ButtonBorderThemeThickness

        Select Case m_Style
            Case ui3ButtonAccent
                ' AccentButtonStyle: BackgroundSizing OuterBorderEdge, so the fill runs under the border.
                Dim accent As Long
                If dark Then accent = AccentShade(ACCENT_LIGHT2) Else accent = AccentShade(ACCENT_DARK1)
                fillInset = 0
                borderAtBottom = True
                If dark Then
                    strokeDefault = DARK_ControlStrokeColorOnAccentDefault
                    strokeSecondary = DARK_ControlStrokeColorOnAccentSecondary
                Else
                    strokeDefault = LIGHT_ControlStrokeColorOnAccentDefault
                    strokeSecondary = LIGHT_ControlStrokeColorOnAccentSecondary
                End If
                Select Case state
                    Case STATE_POINTER_OVER
                        fill = WithOpacity(accent, AccentFillSecondaryOpacity)
                        foreground = IIf(dark, DARK_TextOnAccentFillColorPrimary, LIGHT_TextOnAccentFillColorPrimary)
                        borderKind = BORDER_ELEVATION
                    Case STATE_PRESSED
                        fill = WithOpacity(accent, AccentFillTertiaryOpacity)
                        foreground = IIf(dark, DARK_TextOnAccentFillColorSecondary, LIGHT_TextOnAccentFillColorSecondary)
                        borderKind = BORDER_NONE
                    Case STATE_DISABLED
                        fill = IIf(dark, DARK_AccentFillColorDisabled, LIGHT_AccentFillColorDisabled)
                        foreground = IIf(dark, DARK_TextOnAccentFillColorDisabled, LIGHT_TextOnAccentFillColorDisabled)
                        borderKind = BORDER_NONE
                    Case Else
                        fill = accent
                        foreground = IIf(dark, DARK_TextOnAccentFillColorPrimary, LIGHT_TextOnAccentFillColorPrimary)
                        borderKind = BORDER_ELEVATION
                End Select

            Case ui3ButtonSubtle
                ' SubtleButtonStyle: InnerBorderEdge; the border uses the same brush as the background.
                fillInset = t
                Select Case state
                    Case STATE_POINTER_OVER
                        fill = IIf(dark, DARK_SubtleFillColorSecondary, LIGHT_SubtleFillColorSecondary)
                        foreground = IIf(dark, DARK_TextFillColorPrimary, LIGHT_TextFillColorPrimary)
                    Case STATE_PRESSED
                        fill = IIf(dark, DARK_SubtleFillColorTertiary, LIGHT_SubtleFillColorTertiary)
                        foreground = IIf(dark, DARK_TextFillColorSecondary, LIGHT_TextFillColorSecondary)
                    Case STATE_DISABLED
                        fill = IIf(dark, DARK_SubtleFillColorTransparent, LIGHT_SubtleFillColorTransparent)
                        foreground = IIf(dark, DARK_TextFillColorDisabled, LIGHT_TextFillColorDisabled)
                    Case Else
                        fill = IIf(dark, DARK_SubtleFillColorTransparent, LIGHT_SubtleFillColorTransparent)
                        foreground = IIf(dark, DARK_TextFillColorPrimary, LIGHT_TextFillColorPrimary)
                End Select
                borderKind = BORDER_SOLID
                borderColor = fill

            Case Else
                ' DefaultButtonStyle: InnerBorderEdge, so the fill sits inside the border.
                fillInset = t
                If dark Then
                    strokeDefault = DARK_ControlStrokeColorDefault
                    strokeSecondary = DARK_ControlStrokeColorSecondary
                    borderAtBottom = False
                Else
                    strokeDefault = LIGHT_ControlStrokeColorDefault
                    strokeSecondary = LIGHT_ControlStrokeColorSecondary
                    borderAtBottom = True
                End If
                Select Case state
                    Case STATE_POINTER_OVER
                        fill = IIf(dark, DARK_ControlFillColorSecondary, LIGHT_ControlFillColorSecondary)
                        foreground = IIf(dark, DARK_TextFillColorPrimary, LIGHT_TextFillColorPrimary)
                        borderKind = BORDER_ELEVATION
                    Case STATE_PRESSED
                        fill = IIf(dark, DARK_ControlFillColorTertiary, LIGHT_ControlFillColorTertiary)
                        foreground = IIf(dark, DARK_TextFillColorSecondary, LIGHT_TextFillColorSecondary)
                        borderKind = BORDER_SOLID
                        borderColor = strokeDefault
                    Case STATE_DISABLED
                        fill = IIf(dark, DARK_ControlFillColorDisabled, LIGHT_ControlFillColorDisabled)
                        foreground = IIf(dark, DARK_TextFillColorDisabled, LIGHT_TextFillColorDisabled)
                        borderKind = BORDER_SOLID
                        borderColor = strokeDefault
                    Case Else
                        fill = IIf(dark, DARK_ControlFillColorDefault, LIGHT_ControlFillColorDefault)
                        foreground = IIf(dark, DARK_TextFillColorPrimary, LIGHT_TextFillColorPrimary)
                        borderKind = BORDER_ELEVATION
                End Select
        End Select

        ' The surface has already cleared to SurfaceBackground (the container colour).
        If (fill And &HFF000000) <> 0 Then
            box = RoundedRect(fillInset, fillInset, w - fillInset, h - fillInset, r - fillInset)
            m_Target.FillRoundedRectangle box, SolidBrush(m_Target, fill)
        End If

        box = RoundedRect(t / 2, t / 2, w - t / 2, h - t / 2, r - t / 2)
        Select Case borderKind
            Case BORDER_ELEVATION
                Dim border As ID2D1LinearGradientBrush
                If borderAtBottom Then
                    Set border = VerticalGradientBrush(m_Target, h, h - ElevationBorderGradientLength, _
                        ElevationBorderStop0, strokeSecondary, ElevationBorderStop1, strokeDefault)
                Else
                    Set border = VerticalGradientBrush(m_Target, 0, ElevationBorderGradientLength, _
                        ElevationBorderStop0, strokeSecondary, ElevationBorderStop1, strokeDefault)
                End If
                m_Target.DrawRoundedRectangle box, border, t, 0
            Case BORDER_SOLID
                If (borderColor And &HFF000000) <> 0 Then m_Target.DrawRoundedRectangle box, SolidBrush(m_Target, borderColor), t, 0
        End Select

        Dim iconFamily As String
        Dim glyph As String
        Dim ink As Long
        Dim iconImage As UI3IconImage
        Set iconImage = ResolveIconContent(glyph, iconFamily)
        ' A recolouring SVG takes the text colour, made opaque over the button's own fill.
        ink = ComposeArgb(foreground, ComposeArgb(fill, ArgbFromOleColor(ContainerBackColor())))

        DrawButtonContent m_Target, m_Caption, glyph, iconFamily, m_IconSize, _
            m_IconPosition, m_IconSpacing, ButtonPaddingLeft, ButtonPaddingTop, _
            w - ButtonPaddingRight, h - ButtonPaddingBottom, foreground, iconImage, ink

        If ShowsFocusVisual() Then DrawFocusVisual w, h, dark
    End Sub

    ' Button::ChangeVisualState: focus states apply only while enabled; the system focus visual
    ' shows for keyboard focus, not pointer focus.
    Private Function ShowsFocusVisual() As Boolean
        ShowsFocusVisual = m_UseSystemFocusVisuals And m_Focused And m_KeyboardFocus And UserControl.Enabled
    End Function

    ' WinUI draws the system focus visual 3 DIPs outside the button (FocusVisualMargin -3): a
    ' 2-DIP FocusStrokeColorOuter ring with a 1-DIP FocusStrokeColorInner ring inside it, corner
    ' radius ControlCornerRadius + 3 (FocusRectManager AdjustCornerRadius). A twinBASIC control
    ' cannot draw outside its own window, so tbUI3 draws the same two rings inside the button's
    ' edge instead, with radii that keep the same 2 + 1 geometry from ControlCornerRadius.
    ' Documented deviation: docs/controls/UI3Button.md.
    Private Sub DrawFocusVisual(ByVal w As Single, ByVal h As Single, ByVal dark As Boolean)
        Dim outerColor As Long
        Dim innerColor As Long
        Dim p As Single
        Dim q As Single
        Dim r As Single
        Dim box As D2D1_ROUNDED_RECT

        If dark Then
            outerColor = DARK_FocusStrokeColorOuter
            innerColor = DARK_FocusStrokeColorInner
        Else
            outerColor = LIGHT_FocusStrokeColorOuter
            innerColor = LIGHT_FocusStrokeColorInner
        End If
        r = ControlCornerRadius
        p = FocusVisualPrimaryThickness
        q = FocusVisualSecondaryThickness

        box = RoundedRect(p / 2, p / 2, w - p / 2, h - p / 2, MaxSingle(r - p / 2, 0))
        m_Target.DrawRoundedRectangle box, SolidBrush(m_Target, outerColor), p, 0
        box = RoundedRect(p + q / 2, p + q / 2, w - p - q / 2, h - p - q / 2, MaxSingle(r - p - q / 2, 0))
        m_Target.DrawRoundedRectangle box, SolidBrush(m_Target, innerColor), q, 0
    End Sub

    Private Function MaxSingle(ByVal a As Single, ByVal b As Single) As Single
        If a > b Then MaxSingle = a Else MaxSingle = b
    End Function

    ' The icon to draw: returns the image to draw (or Nothing), or sets Glyph and FontFamily.
    Private Function ResolveIconContent(ByRef Glyph As String, ByRef FontFamily As String) As UI3IconImage
        Glyph = ""
        FontFamily = ""

        If Len(m_IconKey) <> 0 Then
            Set ResolveIconContent = ListIconContent(Glyph, FontFamily)
        ElseIf m_IconImage.HasImage Then
            Set ResolveIconContent = m_IconImage
        ElseIf Len(m_IconGlyph) <> 0 Then
            Glyph = m_IconGlyph
            FontFamily = m_IconFontName
            If Len(FontFamily) = 0 Then FontFamily = SystemIconFontFamily()
        ElseIf m_Icon <> ui3IconNone Then
            FontFamily = SystemIconFontFamily()
            Glyph = SemanticIconGlyph(m_Icon)
        End If
    End Function

    ' The IconKey entry of the linked list, fetched again only when the list's Revision or the key
    ' changed. A missing list or key draws nothing.
    Private Function ListIconContent(ByRef Glyph As String, ByRef FontFamily As String) As UI3IconImage
        Dim linked As UI3IconList
        Dim stored As Variant
        Dim bytes() As Byte

        RegisterForListChanges
        Set linked = ResolveIconList()
        If linked Is Nothing Then
            m_ListRevision = 0
            Exit Function
        End If

        On Error GoTo Failed
        If linked.Revision <> m_ListRevision Or StrComp(m_ListFetchedKey, m_IconKey, vbBinaryCompare) <> 0 Then
            m_ListImage.Clear
            m_ListGlyph = 0
            stored = linked.IconData(m_IconKey)
            If IsArray(stored) Then
                bytes = stored
                m_ListImage.SetData bytes, linked.IconSource(m_IconKey)
            Else
                m_ListGlyph = linked.Icon(m_IconKey)
            End If
            m_ListRevision = linked.Revision
            m_ListFetchedKey = m_IconKey
        End If

        If m_ListImage.HasImage Then
            Set ListIconContent = m_ListImage
        ElseIf m_ListGlyph <> 0 Then
            FontFamily = SystemIconFontFamily()
            Glyph = SemanticIconGlyph(m_ListGlyph)
        End If
        Exit Function

Failed:
        NoteListLookup "fetch failed " & Err.Number & " " & Err.Description
        m_ListRevision = 0
    End Function

    ' Finds the list on each paint rather than keeping it: Parent.Controls(name) works at design
    ' and run time (L2 spike, 2026-11-01), and a list deleted or renamed in the designer is then
    ' never held on to.
    Private Function ResolveIconList() As UI3IconList
        Dim found As Object
        Dim item As Object
        Dim lists As Long

        If Not m_IconListObject Is Nothing Then
            Set ResolveIconList = m_IconListObject
            Exit Function
        End If

        On Error GoTo Failed
        If Len(m_IconListName) <> 0 Then
            Set found = UserControl.Parent.Controls(m_IconListName)
            If TypeOf found Is UI3IconList Then
                Set ResolveIconList = found
                NoteListLookup "found " & m_IconListName & " by name"
            Else
                NoteListLookup m_IconListName & " is a " & TypeName(found) & ", not a UI3IconList"
            End If
            Exit Function
        End If

        For Each item In UserControl.Parent.Controls
            If TypeOf item Is UI3IconList Then
                lists = lists + 1
                Set found = item
            End If
        Next
        If lists = 1 Then
            Set ResolveIconList = found
            NoteListLookup "found the form's only list"
        Else
            NoteListLookup "the form has " & lists & " lists; IconList names none"
        End If
        Exit Function

Failed:
        NoteListLookup "lookup " & IIf(Len(m_IconListName) <> 0, m_IconListName, "(only list)") & " failed " & Err.Number & " " & Err.Description
    End Function

    Private Sub RegisterForListChanges()
        Dim wnd As LongPtr
        wnd = UserControl.hWnd
        If wnd = m_RegisteredHwnd Then Exit Sub
        If m_RegisteredHwnd <> 0 Then UnregisterIconListUser m_RegisteredHwnd
        RegisterIconListUser wnd
        m_RegisteredHwnd = wnd
    End Sub

    ' Writes each new list lookup outcome to the property page log once (L3 diagnostics).
    Private Sub NoteListLookup(ByVal Text As String)
        If Text = m_ListLookupNote Then Exit Sub
        m_ListLookupNote = Text
        UI3PropertyPageLog "BUTTON " & DesignName() & " " & IIf(IsUserMode(), "run", "design") & " IconList: " & Text
    End Sub

    Private Function ContainerBackColor() As Long
        On Error Resume Next
        ContainerBackColor = vbButtonFace
        ContainerBackColor = UserControl.Ambient.BackColor
    End Function

    Private Sub PaintFailure(ByVal hr As Long)
        On Error Resume Next
        UserControl.ScaleMode = vbPixels
        UserControl.Cls
        UserControl.ForeColor = vbRed
        UserControl.CurrentX = 2
        UserControl.CurrentY = 2
        UserControl.Print "D2D error &H" & Hex$(hr)
    End Sub

End Class

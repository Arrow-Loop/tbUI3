    ' --- Designer bridge for UI3IconPage (workaround, twinBASIC BETA 997) ---
    ' Earlier builds lost a value the property page set: the designer kept the old Icon. While the
    ' page applies, UI3Button records the new Icon here under the control's design-time name, and a
    ' later design-time ReadProperties for that name re-applies it. In the 2026-10-07 test this build
    ' saved the picked icon, but through the live control's WriteProperties, not this fallback; why
    ' it now works is not understood, so keep this code unchanged until that is (see CHANGELOG).

    Private m_PageApplying As Boolean
    Private m_PendingIcons As Collection

    Public Property Get IconPageApplying() As Boolean
        IconPageApplying = m_PageApplying
    End Property

    Public Property Let IconPageApplying(ByVal Value As Boolean)
        m_PageApplying = Value
    End Property

    Public Sub SetPendingIcon(ByVal ControlName As String, ByVal Icon As UI3Icon)
        If Len(ControlName) = 0 Then Exit Sub
        If m_PendingIcons Is Nothing Then Set m_PendingIcons = New Collection
        On Error Resume Next
        m_PendingIcons.Remove LCase$(ControlName)
        m_PendingIcons.Add CLng(Icon), LCase$(ControlName)
        DesignLog "pending set " & ControlName & " = " & CLng(Icon)
    End Sub

    ' Returns True and sets Icon when a pending value exists for ControlName, then forgets it.
    Public Function TakePendingIcon(ByVal ControlName As String, ByRef Icon As UI3Icon) As Boolean
        If m_PendingIcons Is Nothing Or Len(ControlName) = 0 Then Exit Function
        Dim value As Long
        On Error Resume Next
        value = m_PendingIcons.Item(LCase$(ControlName))
        If Err.Number <> 0 Then Exit Function
        m_PendingIcons.Remove LCase$(ControlName)
        On Error GoTo 0
        Icon = value
        TakePendingIcon = True
        DesignLog "pending taken " & ControlName & " = " & value
    End Function

    ' --- Library slot (pass 5c) ---
    ' The same workaround for an SVG or PNG applied from the picker's library tabs: while the page
    ' applies, the control records the file and its name here, and its next design-time
    ' ReadProperties takes them. Added beside the members above, which stay as they are.

    Private m_PendingLibrary As Collection

    Public Sub SetPendingLibraryIcon(ByVal ControlName As String, ByRef Data() As Byte, ByVal Source As String)
        If Len(ControlName) = 0 Then Exit Sub
        If m_PendingLibrary Is Nothing Then Set m_PendingLibrary = New Collection
        On Error Resume Next
        m_PendingLibrary.Remove LCase$(ControlName)
        m_PendingLibrary.Add Array(Data, Source), LCase$(ControlName)
        DesignLog "pending library set " & ControlName & " = " & Source
    End Sub

    ' Returns True and sets Data and Source when a pending library icon exists for ControlName, then
    ' forgets it.
    Public Function TakePendingLibraryIcon(ByVal ControlName As String, ByRef Data() As Byte, ByRef Source As String) As Boolean
        If m_PendingLibrary Is Nothing Or Len(ControlName) = 0 Then Exit Function
        Dim item As Variant
        On Error Resume Next
        item = m_PendingLibrary.Item(LCase$(ControlName))
        If Err.Number <> 0 Then Exit Function
        m_PendingLibrary.Remove LCase$(ControlName)
        On Error GoTo 0
        Data = item(0)
        Source = item(1)
        TakePendingLibraryIcon = True
        DesignLog "pending library taken " & ControlName & " = " & Source
    End Function

    ' Forgets a pending library icon for ControlName (a Segoe icon was applied after it).
    Public Sub ClearPendingLibraryIcon(ByVal ControlName As String)
        If m_PendingLibrary Is Nothing Or Len(ControlName) = 0 Then Exit Sub
        On Error Resume Next
        m_PendingLibrary.Remove LCase$(ControlName)
    End Sub

    ' Set True to append designer events to %LOCALAPPDATA%\tbUI3\Diagnostics\tbUI3-design.log while diagnosing the picker.
    Private Const DESIGN_LOG_ENABLED As Boolean = False

    Public Sub DesignLog(ByVal Text As String)
        If Not DESIGN_LOG_ENABLED Then Exit Sub
        On Error Resume Next
        Dim path As String = DiagnosticsFile("tbUI3-design.log")
        If Len(path) = 0 Then Exit Sub ' Store logs and diagnostics is off.
        Dim f As Integer
        f = FreeFile
        Open path For Append As #f
        Print #f, Format$(Now, "hh:nn:ss") & "  " & Text
        Close #f
    End Sub

End Module

' Segoe Fluent icon catalog.
'
' A UI3Icon value is the glyph's own code point in Segoe Fluent Icons, the font WinUI's
' FontIcon draws (FontIcon.Glyph). The names, codes and search tags come from the WinUI
' Gallery's Iconography data; see tools/gen-icons.mjs for the source commit and licence.
' Segoe MDL2 Assets, the Windows 10 icon font, uses the same code points but lacks some
' newer glyphs (FluentOnly below); the picker hides those when only MDL2 is installed.
'
' Before 1.0.0.25 a UI3Icon value was WinUI's Symbol enum value, converted to a glyph through
' icon.cpp's table. That table is gone: every Symbol icon is in this catalog under its Gallery name.

Private Module UI3Icons

    Private Const FLUENT_ICON_FONT As String = "Segoe Fluent Icons"
    Private Const LEGACY_ICON_FONT As String = "Segoe MDL2 Assets"

    Public Function SystemIconFontFamily() As String
        If FontFamilyExists(FLUENT_ICON_FONT) Then
            SystemIconFontFamily = FLUENT_ICON_FONT
        Else
            SystemIconFontFamily = LEGACY_ICON_FONT
        End If
    End Function

    ' The glyph drawn for an icon: its value is its code point.
    Public Function SemanticIconGlyph(ByVal Icon As UI3Icon) As String
        If Icon = ui3IconNone Then Exit Function
        SemanticIconGlyph = ChrW$(Icon And &HFFFF&)
    End Function

    ' --- Icon catalog, used by the UI3IconPage picker ---
    ' Name, value, search tags and Fluent-only flag for every icon, alphabetical by name.
    ' Built once on first use. Icons missing from Segoe MDL2 Assets are left out when
    ' Segoe Fluent Icons is not installed, so the picker never offers a blank glyph.
    Private m_CatalogNames() As String
    Private m_CatalogValues() As Long
    Private m_CatalogTags() As String
    Private m_CatalogFluentOnly() As Boolean
    Private m_CatalogCount As Long

    Private Sub EnsureCatalog()
        If m_CatalogCount > 0 Then Exit Sub
        Dim s As String
        CatalogData s
        Dim entries() As String
        entries = Split(s, ";")
        ReDim m_CatalogNames(0 To UBound(entries))
        ReDim m_CatalogValues(0 To UBound(entries))
        ReDim m_CatalogTags(0 To UBound(entries))
        ReDim m_CatalogFluentOnly(0 To UBound(entries))
        Dim legacyOnly As Boolean
        legacyOnly = (SystemIconFontFamily() <> FLUENT_ICON_FONT)
        Dim fields() As String
        Dim fluentOnly As Boolean
        Dim i As Long
        For i = 0 To UBound(entries)
            ' Name|Code|F (Fluent only) or empty|tags separated by spaces
            fields = Split(entries(i), "|")
            If UBound(fields) = 3 Then
                fluentOnly = (fields(2) = "F")
                If Not (fluentOnly And legacyOnly) Then
                    m_CatalogNames(m_CatalogCount) = fields(0)
                    ' The mask keeps a 4-digit hex string from reading as a negative Integer.
                    m_CatalogValues(m_CatalogCount) = CLng("&H" & fields(1)) And &HFFFF&
                    m_CatalogFluentOnly(m_CatalogCount) = fluentOnly
                    m_CatalogTags(m_CatalogCount) = fields(3)
                    m_CatalogCount = m_CatalogCount + 1
                End If
            End If
        Next
    End Sub

    ' Number of icons in the catalog (ui3IconNone is not counted).
    Public Function IconCatalogCount() As Long
        EnsureCatalog
        IconCatalogCount = m_CatalogCount
    End Function

    ' Name of catalog entry Index (0-based), for example "Accept".
    Public Function IconCatalogName(ByVal Index As Long) As String
        EnsureCatalog
        IconCatalogName = m_CatalogNames(Index)
    End Function

    ' UI3Icon value of catalog entry Index (0-based).
    Public Function IconCatalogValue(ByVal Index As Long) As UI3Icon
        EnsureCatalog
        IconCatalogValue = m_CatalogValues(Index)
    End Function

    ' Search tags of catalog entry Index (0-based), separated by spaces.
    Public Function IconCatalogTags(ByVal Index As Long) As String
        EnsureCatalog
        IconCatalogTags = m_CatalogTags(Index)
    End Function

    ' True when catalog entry Index (0-based) is in Segoe Fluent Icons but not Segoe MDL2 Assets.
    Public Function IconCatalogFluentOnly(ByVal Index As Long) As Boolean
        EnsureCatalog
        IconCatalogFluentOnly = m_CatalogFluentOnly(Index)
    End Function


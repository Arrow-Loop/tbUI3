[FormDesignerId("10C2BCB6-B44A-4BC9-81F4-AFAEF469E97C")]
[ClassId("FF14322E-C9BC-4F3A-BCE8-0FDE58F230E0")]
[InterfaceId("162F5756-8BC1-4C2F-95E7-64E7A2130744")]
[EventInterfaceId("CBF158A3-6300-4966-A26F-8F79A383AC2A")]
[COMControl]
[Description("TabView with real UI3TabPage containers and Edge/Explorer tab shapes. Designer authoring uses tbUI3IDE.")]
Public Class UI3TabView
    ' Paint goes through the shared flicker-free surface (UI3Surface.twin).
    Implements IUI3SurfaceClient

    Public Event SelectionChanged()
    Public Event AddTabButtonClick()

    Private m_SyncingBackground As Boolean
    Private m_TabStyle As UI3TabStyle
    Private m_PressedPage As String
    Private m_PressedHit As Long
    Private m_ManualHeaderScroll As Boolean
    Private m_SelectedPage As String
    Private m_ShowAddButton As Boolean
    Private m_Pages As Collection
    Private m_Collecting As Boolean
    Private m_LastDiscoveryTrace As String
    Private m_Refreshing As Boolean
    Private m_LastPaintTrace As String
    Private m_Painting As Boolean
    Private m_KeyboardFocus As Boolean
    Private m_PointerFocusing As Boolean
    Private m_Focused As Boolean
    Private m_FirstHeader As Long
    Private m_NewPageRequest As Long
    ' Borrowed from m_Surface for the length of one SurfaceRender call.
    Private m_Target As ID2D1RenderTarget
    Private m_Surface As UI3Surface

    [Description("tbUI3 convenience: the selected page's control name. Empty selects the first page.")]
    Public Property Get SelectedPage() As String
        SelectedPage = m_SelectedPage
    End Property

    Public Property Let SelectedPage(ByVal Value As String)
        Dim changed As Boolean = (StrComp(m_SelectedPage, Value, vbTextCompare) <> 0)
        m_SelectedPage = Value
        m_ManualHeaderScroll = False
        PropertyChanged "SelectedPage"
        RefreshPages
        If changed And Ambient.UserMode Then RaiseEvent SelectionChanged
    End Property

    Public Property Get IsAddTabButtonVisible() As Boolean
        IsAddTabButtonVisible = m_ShowAddButton
    End Property

    Public Property Let IsAddTabButtonVisible(ByVal Value As Boolean)
        m_ShowAddButton = Value
        PropertyChanged "IsAddTabButtonVisible"
        Repaint
    End Property

    [NonBrowsable]
    Public Property Get ScaleMode() As Long
        ScaleMode = UserControl.ScaleMode
    End Property

    [NonBrowsable]
    Public Property Get PageCount() As Long
        CollectPages
        PageCount = m_Pages.Count
    End Property

    [NonBrowsable]
    Public Property Get Pages(ByVal Index As Long) As UI3TabPage
        CollectPages
        Set Pages = m_Pages(Index)
    End Property

    [NonBrowsable]
    Public Property Get SelectedIndex() As Long
        CollectPages
        SelectedIndex = ActiveIndex() - 1
    End Property

    [NonBrowsable]
    Public Property Let SelectedIndex(ByVal Value As Long)
        RefreshPages
        If Value < 0 Or Value >= m_Pages.Count Then Err.Raise 380
        SelectedPage = m_Pages(Value + 1).PageName
    End Property

    [NonBrowsable]
    Public Property Get DesignerNewPageRequest() As Long
        DesignerNewPageRequest = m_NewPageRequest
    End Property

    ' Keep the same coordinate scale as the immediate containing form/control.
    ' Do not keep page references between refreshes: pages may be removed in the IDE.
    Private Sub CollectPages()
        If m_Collecting Then Exit Sub
        m_Collecting = True
        On Error GoTo Done
        ' Build a distinct list before publishing it. A repeated native enumeration
        ' entry must not become another header, count, layout or keyboard position.
        Dim found As Collection
        Set found = New Collection
        Dim contained As Object, childIndex As Long, rawCount As Long, duplicates As Long, skipped As Long
        Dim failure As String
        Set contained = UserControl.ContainedControls
        rawCount = contained.Count
        For childIndex = 0 To rawCount - 1
            CollectPageEntry contained, childIndex, found, duplicates, skipped, failure
        Next
    Done:
        Set m_Pages = found
        If m_Pages Is Nothing Then Set m_Pages = New Collection
        m_Collecting = False
        On Error Resume Next
        If Not Ambient.UserMode Then UI3TabDiagnostics.DiscoveryState UserControl.Extender.Name, rawCount, m_Pages, duplicates, skipped, failure, m_LastDiscoveryTrace
    End Sub

    ' A deleted native entry can remain in ContainedControls during designer resync.
    ' Reject only that entry; later live pages must still be discovered and arranged.
    Private Sub CollectPageEntry(ByVal Contained As Object, ByVal Index As Long, ByVal Found As Collection, _
            ByRef Duplicates As Long, ByRef Skipped As Long, ByRef Failure As String)
        On Error GoTo Rejected
        Dim stage As String, item As Object, page As UI3TabPage, existing As UI3TabPage
        Dim at As Long, pageName As String, pageOrder As Long, caption As String
        stage = "Item"
        Set item = Contained.Item(Index)
        stage = "Object"
        Set page = PageObject(item)
        If page Is Nothing Then Exit Sub
        stage = "Name"
        pageName = page.PageName
        stage = "Order"
        pageOrder = page.PageOrder
        ' Probe Caption before admitting the page to the list used by Paint.
        stage = "Caption"
        caption = page.Caption
        stage = "Duplicate"
        If ContainsPage(Found, page) Then
            Duplicates = Duplicates + 1
            Exit Sub
        End If
        stage = "Sort"
        at = 1
        Do While at <= Found.Count
            Set existing = Found(at)
            If pageOrder < existing.PageOrder Then Exit Do
            If pageOrder = existing.PageOrder Then
                If StrComp(pageName, existing.PageName, vbTextCompare) < 0 Then Exit Do
            End If
            at = at + 1
        Loop
        If at > Found.Count Then Found.Add page Else Found.Add page, , at
        Exit Sub
    Rejected:
        Skipped = Skipped + 1
        Failure = "index=" & Index & " stage=" & stage & " hr=&H" & Hex$(Err.Number)
        Err.Clear
    End Sub

    ' Native snapshot capture temporarily changes the HWND size. Painting and
    ' property getters only discover pages; they must never move controls.
    Public Sub RefreshPages()
        If m_Refreshing Or m_Painting Then Exit Sub
        m_Refreshing = True
        On Error GoTo Done
        MatchContainerScale
        CollectPages
        Dim page As UI3TabPage
        Dim top As Single, w As Single, h As Single, i As Long, active As Long
        top = UserControl.ScaleY(UI3TabMetrics.ContentTop * UI3TabMetrics.WindowDpi(UserControl.hWnd) / 96!, vbPixels, UserControl.ScaleMode)
        w = UserControl.ScaleWidth
        h = UserControl.ScaleHeight - top
        If w < 1 Then w = 1
        If h < 1 Then h = 1
        active = ActiveIndex()
        For i = 1 To m_Pages.Count
            Set page = m_Pages(i)
            page.Arrange 0, top, w, h, i = active
        Next
        ' If a selected page was deleted, the first survivor is the effective selection.
        ' Do not overwrite saved SelectedPage during ReadProperties/load-order discovery.
        EnsureHeaderVisible active
    Done:
        If m_Pages Is Nothing Then Set m_Pages = New Collection
        m_Refreshing = False
        If Not m_Painting Then Repaint
    End Sub

    [Description("Tab shape profile: Edge Style (Toolkit default) or Explorer Style (WinUI profile).")]
    Public Property Get TabStyle() As UI3TabStyle
        TabStyle = m_TabStyle
    End Property

    Public Property Let TabStyle(ByVal Value As UI3TabStyle)
        If Value <> ui3TabEdge And Value <> ui3TabExplorer Then Err.Raise 380
        If m_TabStyle = Value Then Exit Property
        m_TabStyle = Value
        m_ManualHeaderScroll = False
        PropertyChanged "TabStyle"
        RefreshPages
    End Property

    ' Transient viewport position; no PropertyBag persistence or child movement.
    [NonBrowsable]
    Public Property Get FirstVisibleTabIndex() As Long
        If m_FirstHeader > 0 Then FirstVisibleTabIndex = m_FirstHeader - 1
    End Property

    [NonBrowsable]
    Public Property Let FirstVisibleTabIndex(ByVal Value As Long)
        CollectPages
        If Value < 0 Or Value >= m_Pages.Count Then Err.Raise 380
        m_FirstHeader = Value + 1
        m_ManualHeaderScroll = True
        Repaint
    End Property

    Private Function ContainsPage(ByVal Pages As Collection, ByVal Candidate As UI3TabPage) As Boolean
        Dim current As UI3TabPage, candidateName As String, i As Long
        candidateName = Candidate.PageName
        For i = 1 To Pages.Count
            Set current = Pages(i)
            If current Is Candidate Then Return True
            If Len(candidateName) > 0 Then
                If StrComp(current.PageName, candidateName, vbTextCompare) = 0 Then Return True
            End If
        Next
    End Function

    Private Sub MatchContainerScale()
        On Error Resume Next
        Dim mode As Long = UserControl.Extender.Container.ScaleMode
        If UserControl.ScaleMode <> mode Then UserControl.ScaleMode = mode
    End Sub

    Private Function PageObject(ByVal Item As Object) As UI3TabPage
        On Error GoTo Done
        If TypeOf Item Is UI3TabPage Then
            Set PageObject = Item
        Else
            Dim actual As Object
            Set actual = Item.Object
            If TypeOf actual Is UI3TabPage Then Set PageObject = actual
        End If
    Done:
    End Function

    Private Function ActiveIndex() As Long
        Dim i As Long
        For i = 1 To m_Pages.Count
            If StrComp(m_Pages(i).PageName, m_SelectedPage, vbTextCompare) = 0 Then Return i
        Next
        If m_Pages.Count > 0 Then ActiveIndex = 1
    End Function

    Private Function WidthDips() As Single
        WidthDips = UserControl.ScaleX(UserControl.ScaleWidth, UserControl.ScaleMode, vbPixels) * 96! / UI3TabMetrics.WindowDpi(UserControl.hWnd)
    End Function

    Private Function HeaderSize() As Single
        HeaderSize = UI3TabMetrics.HeaderWidth(WidthDips(), m_Pages.Count, m_ShowAddButton, m_TabStyle)
    End Function

    Private Function HeaderStart() As Single
        HeaderStart = UI3TabMetrics.HeaderStart(WidthDips(), m_Pages.Count, m_ShowAddButton, m_TabStyle)
    End Function

    Private Function HeaderArea() As Single
        HeaderArea = UI3TabMetrics.HeaderArea(WidthDips(), m_Pages.Count, m_ShowAddButton, m_TabStyle)
    End Function

    Private Function HeaderSlots() As Long
        HeaderSlots = Int(HeaderArea() / HeaderSize())
        If HeaderSlots < 1 Then HeaderSlots = 1
    End Function

    Private Sub EnsureHeaderVisible(ByVal Active As Long)
        If Active = 0 Then m_FirstHeader = 1: Exit Sub
        If m_FirstHeader < 1 Then m_FirstHeader = 1
        Dim last As Long = m_Pages.Count - HeaderSlots() + 1
        If last < 1 Then last = 1
        If m_FirstHeader > last Then m_FirstHeader = last
        If m_ManualHeaderScroll Then Exit Sub
        If Active < m_FirstHeader Then m_FirstHeader = Active
        If Active >= m_FirstHeader + HeaderSlots() Then m_FirstHeader = Active - HeaderSlots() + 1
    End Sub

    Private Sub RequestNewPage()
        If Not m_ShowAddButton Then Exit Sub
        If Ambient.UserMode Then
            RaiseEvent AddTabButtonClick
        Else
            If m_NewPageRequest = &H7FFFFFFF Then m_NewPageRequest = 0
            m_NewPageRequest = m_NewPageRequest + 1
            PropertyChanged "DesignerNewPageRequest"
        End If
    End Sub

    Private Function HitHeader(ByVal X As Single, ByVal Y As Single) As Long
        If X < 0 Or X >= WidthDips() Or Y < UI3TabMetrics.HeaderTop(m_TabStyle) Or Y >= UI3TabMetrics.ContentTop Then Exit Function
        Dim finish As Single = HeaderStart() + HeaderArea()
        Dim index As Long
        If UI3TabMetrics.Overflowing(WidthDips(), m_Pages.Count, m_ShowAddButton, m_TabStyle) And Y >= UI3TabMetrics.AuxiliaryTop(m_TabStyle) And Y < UI3TabMetrics.AuxiliaryTop(m_TabStyle) + UI3TabMetrics.AddHeight Then
            If X < UI3TabMetrics.ScrollWidth Then
                If m_FirstHeader > 1 Then Return -2 Else Exit Function
            End If
            If X >= finish + UI3TabMetrics.FootRadius(m_TabStyle) And X < finish + UI3TabMetrics.FootRadius(m_TabStyle) + UI3TabMetrics.ScrollWidth Then
                If m_FirstHeader + HeaderSlots() <= m_Pages.Count Then Return -3 Else Exit Function
            End If
        End If
        If m_ShowAddButton And X >= WidthDips() - UI3TabMetrics.AddWidth And Y >= UI3TabMetrics.AuxiliaryTop(m_TabStyle) And Y < UI3TabMetrics.AuxiliaryTop(m_TabStyle) + UI3TabMetrics.AddHeight Then Return -1
        If X < HeaderStart() Or X >= finish Or HeaderArea() <= 0 Then Exit Function
        index = m_FirstHeader + Int((X - HeaderStart()) / HeaderSize())
        If index <= m_Pages.Count Then HitHeader = index
    End Function

    ' The part under the pointer, tracked by the surface at run time; 0 in the designer.
    Private Function HotHeader() As Long
        If m_Surface Is Nothing Or Not UserControl.Enabled Then Exit Function
        HotHeader = m_Surface.HotPart
    End Function

    Private Sub ScrollHeaders(ByVal Direction As Long)
        Dim nextHeader As Long = m_FirstHeader + Direction * HeaderSlots()
        Dim last As Long = m_Pages.Count - HeaderSlots() + 1
        If last < 1 Then last = 1
        If nextHeader < 1 Then nextHeader = 1
        If nextHeader > last Then nextHeader = last
        m_FirstHeader = nextHeader
        m_ManualHeaderScroll = True
        RepaintHeader
    End Sub

    ' Hover/press/focus/scroll: at run time only the header is invalidated, never erased.
    Private Sub RepaintHeader()
        If OwnsPaint() Then
            ' Scrolling or a selection change can move a different tab under a still pointer.
            m_Surface.SyncHot
            InvalidateHeader
        Else
            ' The IDE requests synchronous control snapshots after edits.
            UserControl.Refresh
        End If
    End Sub

    ' Layout or property changes: the whole control, without erase at run time.
    Private Sub Repaint()
        If OwnsPaint() Then
            m_Surface.SyncHot
            m_Surface.Invalidate
        Else
            UserControl.Refresh
        End If
    End Sub

    Private Sub InvalidateHeader()
        If Not m_Surface Is Nothing Then m_Surface.InvalidateArea 0, 0, WidthDips(), UI3TabMetrics.ContentTop
    End Sub

    Private Function OwnsPaint() As Boolean
        If Not m_Surface Is Nothing Then OwnsPaint = m_Surface.OwnsPaint
    End Function

    ' Run time: the surface owns WM_PAINT. Design time: it only suppresses erase and adds
    ' arrow/Ctrl+Tab keys, and the Paint event draws through PaintEvent.
    Private Sub EnsureSurface()
        If m_Surface Is Nothing Then Set m_Surface = New UI3Surface
        m_Surface.Attach UserControl.hWnd, Me, Ambient.UserMode
    End Sub

    Private Sub UserControl_MouseDown(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If Button <> vbLeftButton Or Not UserControl.Enabled Then Exit Sub
        CollectPages
        Dim px As Single = UserControl.ScaleX(X, UserControl.ScaleMode, vbPixels) * 96! / UI3TabMetrics.WindowDpi(UserControl.hWnd)
        Dim py As Single = UserControl.ScaleY(Y, UserControl.ScaleMode, vbPixels) * 96! / UI3TabMetrics.WindowDpi(UserControl.hWnd)
        m_PressedHit = HitHeader(px, py)
        m_PressedPage = ""
        If m_PressedHit > 0 Then m_PressedPage = m_Pages(m_PressedHit).PageName
        If m_PressedHit = 0 Then Exit Sub
        On Error Resume Next
        m_KeyboardFocus = False
        m_PointerFocusing = True
        UserControl.Extender.SetFocus
        m_PointerFocusing = False
        UI3TabMetrics.CapturePointer UserControl.hWnd
        RepaintHeader
    End Sub

    Private Sub UserControl_MouseUp(Button As Integer, Shift As Integer, X As Single, Y As Single)
        If Button <> vbLeftButton Then Exit Sub
        Dim pressed As Long = m_PressedHit
        m_PressedHit = 0
        UI3TabMetrics.ReleasePointer UserControl.hWnd
        If Not UserControl.Enabled Then Exit Sub
        Dim px As Single = UserControl.ScaleX(X, UserControl.ScaleMode, vbPixels) * 96! / UI3TabMetrics.WindowDpi(UserControl.hWnd)
        Dim py As Single = UserControl.ScaleY(Y, UserControl.ScaleMode, vbPixels) * 96! / UI3TabMetrics.WindowDpi(UserControl.hWnd)
        CollectPages
        If pressed > m_Pages.Count Then pressed = 0
        If pressed > 0 Then
            If StrComp(m_PressedPage, m_Pages(pressed).PageName, vbTextCompare) <> 0 Then pressed = 0
        End If
        If pressed <> 0 And pressed = HitHeader(px, py) Then
            Select Case pressed
                Case -1: RequestNewPage
                Case -2: ScrollHeaders -1
                Case -3: ScrollHeaders 1
                Case Else: SelectedPage = m_Pages(pressed).PageName
            End Select
        End If
        RepaintHeader
    End Sub

    Private Function VisibleHeaderCount(ByVal Available As Single, ByVal Width As Single) As Long
        If HeaderArea() <= 0 Then Exit Function
        VisibleHeaderCount = -Int(-HeaderArea() / Width)
        If VisibleHeaderCount > m_Pages.Count - m_FirstHeader + 1 Then VisibleHeaderCount = m_Pages.Count - m_FirstHeader + 1
    End Function

    Private Sub UserControl_KeyDown(KeyCode As Integer, Shift As Integer)
        If Not UserControl.Enabled Then Exit Sub
        CollectPages
        Dim index As Long = ActiveIndex()
        If (Shift And vbCtrlMask) <> 0 Then
            If KeyCode = vbKeyT Then
                m_KeyboardFocus = True
                RepaintHeader
                KeyCode = 0: RequestNewPage: Exit Sub
            End If
            If KeyCode = vbKeyTab Then
                If (Shift And vbShiftMask) <> 0 Then index = index - 1 Else index = index + 1
            Else
                Exit Sub
            End If
        Else
            Select Case KeyCode
                Case vbKeyLeft: index = index - 1
                Case vbKeyRight: index = index + 1
                Case vbKeyHome: index = 1
                Case vbKeyEnd: index = m_Pages.Count
                Case Else: Exit Sub
            End Select
        End If
        m_KeyboardFocus = True
        KeyCode = 0
        If m_Pages.Count = 0 Then Exit Sub
        If index < 1 Then index = m_Pages.Count
        If index > m_Pages.Count Then index = 1
        SelectedPage = m_Pages(index).PageName
    End Sub

    Private Sub UserControl_VerbInvoked(ByVal Verb As String)
        If Verb = "New page" Then RequestNewPage
    End Sub

    ' Keep the native opaque control's erase color paired with our D2D surface.
    ' Never change BackColor inside Paint: that can reenter painting and snapshots.
    Private Sub SyncNativeBackground()
        If m_SyncingBackground Then Exit Sub
        m_SyncingBackground = True
        On Error GoTo Done
        Dim color As Long = UI3TabMetrics.HeaderOleColor()
        If UserControl.BackColor <> color Then UserControl.BackColor = color
    Done:
        m_SyncingBackground = False
    End Sub

    Private Sub UserControl_AmbientChanged(PropertyName As String)
        If m_SyncingBackground Then Exit Sub
        If StrComp(PropertyName, "BackColor", vbTextCompare) = 0 Then
            SyncNativeBackground
            Repaint
        End If
    End Sub

    Private Sub UserControl_InitProperties()
        SyncNativeBackground
        m_TabStyle = ui3TabEdge
        m_ShowAddButton = True
        m_FirstHeader = 1
        Set m_Pages = New Collection
        MatchContainerScale
    End Sub

    Private Sub UserControl_ReadProperties(PropBag As PropertyBag)
        SyncNativeBackground
        m_TabStyle = PropBag.ReadProperty("TabStyle", ui3TabEdge)
        If m_TabStyle <> ui3TabEdge And m_TabStyle <> ui3TabExplorer Then m_TabStyle = ui3TabEdge
        m_SelectedPage = PropBag.ReadProperty("SelectedPage", "")
        m_ShowAddButton = PropBag.ReadProperty("IsAddTabButtonVisible", True)
        m_FirstHeader = 1
        Set m_Pages = New Collection
        MatchContainerScale
    End Sub

    Private Sub UserControl_WriteProperties(PropBag As PropertyBag)
        PropBag.WriteProperty "TabStyle", m_TabStyle, ui3TabEdge
        PropBag.WriteProperty "SelectedPage", m_SelectedPage, ""
        PropBag.WriteProperty "IsAddTabButtonVisible", m_ShowAddButton, True
    End Sub

    Private Sub UserControl_Show()
        SyncNativeBackground
        EnsureSurface
        RefreshPages
    End Sub

    Private Sub UserControl_Terminate()
        If Not m_Surface Is Nothing Then m_Surface.Detach
    End Sub

    Private Sub UserControl_Resize()
        RefreshPages
    End Sub

    Private Sub UserControl_GotFocus()
        m_Focused = True
        If m_PointerFocusing Then m_KeyboardFocus = False Else m_KeyboardFocus = UI3TabMetrics.KeyboardFocusIntent()
        If Not Ambient.UserMode Then UI3TabDiagnostics.Note "host " & UserControl.Extender.Name & " GotFocus"
        RepaintHeader
    End Sub

    Private Sub UserControl_LostFocus()
        m_PressedHit = 0
        UI3TabMetrics.ReleasePointer UserControl.hWnd
        m_Focused = False
        If Not Ambient.UserMode Then UI3TabDiagnostics.Note "host " & UserControl.Extender.Name & " LostFocus"
        RepaintHeader
    End Sub

    Private Sub PaintHeader(ByVal Index As Long, ByVal X As Single, ByVal W As Single, ByVal Selected As Boolean, ByVal Hot As Long, ByVal Held As Boolean)
        Dim fill As Long, color As Long, path As ID2D1PathGeometry
        Dim pressed As Boolean = Held And m_PressedHit = Index And Hot = Index
        If UserControl.Enabled Then
            If Selected Then
                fill = UI3TabMetrics.PageBackground()
            ElseIf pressed Then
                fill = UI3TabMetrics.PressedFill()
            ElseIf Hot = Index Then
                fill = UI3TabMetrics.HoverFill()
            End If
        End If
        If fill <> 0 Then
            If m_TabStyle = ui3TabExplorer And Not Selected Then
                Dim hover As D2D1_ROUNDED_RECT = RoundedRect(X, UI3TabMetrics.HeaderTop(m_TabStyle), X + W, UI3TabMetrics.ContentTop - 1, UI3TabMetrics.HeaderCorner)
                m_Target.FillRoundedRectangle hover, SolidBrush(m_Target, fill)
            Else
                Set path = UI3D2D.TabOutline(X, UI3TabMetrics.HeaderTop(m_TabStyle), W, UI3TabMetrics.HeaderHeight(m_TabStyle), UI3TabMetrics.HeaderCorner, UI3TabMetrics.FootRadius(m_TabStyle))
                m_Target.FillGeometry path, SolidBrush(m_Target, fill), 0
            End If
        End If
        If IsDarkMode() Then
            color = DARK_TextFillColorSecondary
            If Selected Then color = DARK_TextFillColorPrimary
            If pressed And Not Selected Then color = DARK_TextFillColorTertiary
            If Not UserControl.Enabled Then color = DARK_TextFillColorDisabled
        Else
            color = LIGHT_TextFillColorSecondary
            If Selected Then color = LIGHT_TextFillColorPrimary
            If pressed And Not Selected Then color = LIGHT_TextFillColorTertiary
            If Not UserControl.Enabled Then color = LIGHT_TextFillColorDisabled
        End If
        DrawLeftTextStyled m_Target, m_Pages(Index).Caption, UI3TabMetrics.HeaderFontSize, 400, X + UI3TabMetrics.HeaderPadding, UI3TabMetrics.HeaderTop(m_TabStyle), X + W - UI3TabMetrics.HeaderPadding, UI3TabMetrics.ContentTop, color, True
        If Not Selected And Index + 1 <> ActiveIndex() And Hot <> Index And Hot <> Index + 1 Then UI3TabMetrics.FillBox m_Target, X + W - 1, UI3TabMetrics.HeaderTop(m_TabStyle) + 8, 1, UI3TabMetrics.HeaderHeight(m_TabStyle) - 16, UI3TabMetrics.Divider()
        If m_Focused And m_KeyboardFocus And Selected And UserControl.Enabled Then
            Dim focus As D2D1_ROUNDED_RECT = RoundedRect(X + 10, UI3TabMetrics.HeaderTop(m_TabStyle) + 5, X + W - 10, UI3TabMetrics.ContentTop - 5, 0)
            If IsDarkMode() Then color = &HFFFFFFFF Else color = &HFF000000
            m_Target.DrawRoundedRectangle focus, SolidBrush(m_Target, color), 2, 0
        End If
    End Sub

    Private Sub PaintAuxiliary(ByVal Hit As Long, ByVal X As Single, ByVal Glyph As String, ByVal Hot As Long, ByVal Held As Boolean, ByVal Enabled As Boolean)
        Dim color As Long
        If Enabled And Hot = Hit Then
            Dim box As D2D1_ROUNDED_RECT = RoundedRect(X, UI3TabMetrics.AuxiliaryTop(m_TabStyle), X + UI3TabMetrics.AddWidth, UI3TabMetrics.AuxiliaryTop(m_TabStyle) + UI3TabMetrics.AddHeight, 4)
            m_Target.FillRoundedRectangle box, SolidBrush(m_Target, UI3TabMetrics.AuxiliaryFill(Held And m_PressedHit = Hit))
        End If
        If IsDarkMode() Then
            color = DARK_TextFillColorPrimary
            If Not Enabled Then color = DARK_TextFillColorDisabled
        Else
            color = LIGHT_TextFillColorPrimary
            If Not Enabled Then color = LIGHT_TextFillColorDisabled
        End If
        Dim fontSize As Single = 8
        If Hit = -1 Then fontSize = 12
        UI3D2D.DrawTabGlyph m_Target, Glyph, X, UI3TabMetrics.AuxiliaryTop(m_TabStyle), UI3TabMetrics.AddWidth, UI3TabMetrics.AddHeight, color, fontSize
    End Sub

    ' Design time (and any paint before Show): the IDE's synchronous snapshots arrive here.
    ' At run time the surface handles WM_PAINT itself and this event does not fire.
    Private Sub UserControl_Paint()
        If m_Painting Then Exit Sub
        EnsureSurface
        m_Surface.PaintEvent UserControl.hDC
        If Not Ambient.UserMode Or m_Surface.LastResult <> 0 Then
            On Error Resume Next
            Dim client As UI3GdiRect
            UI3GetClientRect UserControl.hWnd, client
            UI3TabDiagnostics.PaintState "host " & UserControl.Extender.Name, UserControl.hWnd, UserControl.hDC, client, _
                m_Surface.Dpi(), UserControl.ScaleWidth, UserControl.ScaleHeight, m_Surface.LastResult, m_LastPaintTrace
        End If
    End Sub

    Private Sub IUI3SurfaceClient_SurfaceRender(ByVal Target As ID2D1RenderTarget, ByVal w As Single, ByVal h As Single)
        If m_Painting Then Exit Sub
        m_Painting = True
        Set m_Target = Target
        On Error GoTo Failed
        ' Run time keeps the page list RefreshPages built; only the designer, where pages can
        ' be deleted underneath the control, rediscovers them on every snapshot.
        If Not OwnsPaint() Then CollectPages
        EnsureHeaderVisible ActiveIndex()
        ' The surface has already cleared to SurfaceBackground (the header surface).
        UI3TabMetrics.FillBox m_Target, 0, UI3TabMetrics.ContentTop, w, h - UI3TabMetrics.ContentTop, UI3TabMetrics.PageBackground()
        Dim size As Single, i As Long, active As Long, count As Long
        size = HeaderSize()
        count = VisibleHeaderCount(w, size)
        active = ActiveIndex()
        Dim hot As Long = HotHeader(), held As Boolean = UI3TabMetrics.PointerPressed(UserControl.hWnd)
        Dim clip As D2D1_RECT_F
        clip.Left = HeaderStart() - UI3TabMetrics.FootRadius(m_TabStyle)
        clip.Top = 0: clip.Right = HeaderStart() + HeaderArea() + UI3TabMetrics.FootRadius(m_TabStyle): clip.Bottom = UI3TabMetrics.ContentTop
        m_Target.PushAxisAlignedClip clip, 1
        For i = m_FirstHeader To m_FirstHeader + count - 1
            If i <> active Then PaintHeader i, HeaderStart() + (i - m_FirstHeader) * size, size, False, hot, held
        Next
        If active >= m_FirstHeader And active < m_FirstHeader + count Then PaintHeader active, HeaderStart() + (active - m_FirstHeader) * size, size, True, hot, held
        m_Target.PopAxisAlignedClip
        ' No horizontal stroke across the page top: the selected curve joins
        ' the content surface directly (Shane's Edge/Explorer presentation).
        If m_ShowAddButton Then PaintAuxiliary -1, w - UI3TabMetrics.AddWidth, ChrW$(&HE710&), hot, held, UserControl.Enabled
        If UI3TabMetrics.Overflowing(w, m_Pages.Count, m_ShowAddButton, m_TabStyle) Then
            PaintAuxiliary -2, 0, ChrW$(&HE76B&), hot, held, UserControl.Enabled And m_FirstHeader > 1
            PaintAuxiliary -3, HeaderStart() + HeaderArea() + UI3TabMetrics.FootRadius(m_TabStyle), ChrW$(&HE76C&), hot, held, UserControl.Enabled And m_FirstHeader + HeaderSlots() <= m_Pages.Count
        End If
        Set m_Target = Nothing
        m_Painting = False
        Exit Sub
    Failed:
        Dim number As Long = Err.Number, description As String = Err.Description
        Set m_Target = Nothing
        m_Painting = False
        UI3TabDiagnostics.Note "host " & UserControl.Extender.Name & " Paint exception &H" & Hex$(number) & " " & description
        ' Let the surface discard this frame's render target.
        Err.Raise number, "UI3TabView", description
    End Sub

    Private Function IUI3SurfaceClient_SurfaceHitTest(ByVal X As Single, ByVal Y As Single) As Long
        If Not UserControl.Enabled Or m_Pages Is Nothing Then Exit Function
        IUI3SurfaceClient_SurfaceHitTest = HitHeader(X, Y)
    End Function

    Private Sub IUI3SurfaceClient_SurfaceHotChanged(ByVal OldPart As Long, ByVal NewPart As Long)
        InvalidateHeader
    End Sub

    ' Leave/capture/focus/enable changes repaint only the header, as before 1.0.0.71.
    Private Sub IUI3SurfaceClient_SurfaceStateChanged(ByVal Message As Long)
        InvalidateHeader
    End Sub

    Private Function IUI3SurfaceClient_SurfaceDialogCode(ByVal Code As LongPtr) As LongPtr
        IUI3SurfaceClient_SurfaceDialogCode = UI3TabMetrics.TabDialogCode(Code)
    End Function

    Private Function IUI3SurfaceClient_SurfaceBackground() As Long
        IUI3SurfaceClient_SurfaceBackground = UI3TabMetrics.HeaderBackground()
    End Function
End Class

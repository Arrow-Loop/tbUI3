[Description("")]
[FormDesignerId("6C0574F9-82B0-484D-A009-E32D41C34CA7")]
[PredeclaredId]
Class frmMain

    ' Pass 5b test (tbUI3 1.0.0.43): SVG and image icons loaded in code.
    ' The icons are in test-icons next to tbUI3Test.twinproj. A button that already has a stored
    ' icon (one applied from the picker's library tabs, pass 5c) keeps it.

    Sub New()
    End Sub

    Private Sub Form_Load()
        ' Built EXEs give no line number, so a failure names the step it stopped at.
        Dim stepName As String
        On Error GoTo Failed
        Dim folder As String
        stepName = "IconFolder"
        folder = IconFolder()
        If Len(folder) = 0 Then MsgBox "test-icons not found next to " & App.Path

        stepName = "button 1"
        If Len(UI3Button1.IconSource) = 0 Then
            UI3Button1.Caption = "Mono SVG"
            UI3Button1.LoadIconFile folder & "mono.svg"
        End If

        stepName = "button 2 Style"
        UI3Button2.Style = ui3ButtonStandard
        stepName = "button 2 icon"
        If Len(UI3Button2.IconSource) = 0 Then
            UI3Button2.Caption = "Color SVG"
            UI3Button2.LoadIconFile folder & "color.svg"
        End If

        stepName = "button 3 Style"
        UI3Button3.Style = ui3ButtonStandard
        stepName = "button 3 IconPosition"
        UI3Button3.IconPosition = ui3IconLeft
        stepName = "button 3 icon"
        If Len(UI3Button3.IconSource) = 0 Then
            UI3Button3.Caption = "PNG"
            UI3Button3.LoadIconFile folder & "sample.png"
        End If

        stepName = "button 4 Style"
        UI3Button4.Style = ui3ButtonStandard
        stepName = "button 4 icon"
        If Len(UI3Button4.IconSource) = 0 Then UI3Button4.IconData = UI3Button1.IconData
        stepName = "button 4 Caption"
        UI3Button4.Caption = "Copy, size " & UI3Button4.IconSize
        Exit Sub

    Failed:
        MsgBox "Form_Load stopped at " & stepName & ": " & Err.Number & " " & Err.Description & _
            " (source: " & Err.Source & ")" & vbCrLf & "App.Path = " & App.Path
    End Sub

    ' test-icons beside the project: App.Path in the IDE, one folder up from a built EXE in Build.
    Private Function IconFolder() As String
        Dim candidate As Variant
        On Error Resume Next
        For Each candidate In Array(App.Path & "\test-icons\", App.Path & "\..\test-icons\")
            If Len(Dir$(candidate & "mono.svg")) > 0 Then
                IconFolder = candidate
                Exit Function
            End If
        Next
    End Function

    Private Sub UI3Button1_Click()
        MsgBox "IconSource: " & UI3Button1.IconSource & " | " & UI3Button2.IconSource & " | " & _
            UI3Button3.IconSource & " | " & UI3Button4.IconSource
    End Sub

    Private Sub UI3Button2_Click()
        UI3Button2.Icon = ui3IconAccept
        UI3Button2.Caption = "Now a Segoe icon"
    End Sub

    Private Sub UI3Button4_Click()
        Dim size As Single
        Select Case UI3Button4.IconSize
            Case 20: size = 32
            Case 32: size = 48
            Case Else: size = 20
        End Select
        UI3Button1.IconSize = size
        UI3Button2.IconSize = size
        UI3Button3.IconSize = size
        UI3Button4.IconSize = size
        UI3Button4.Caption = "Copy, size " & size
    End Sub

End Class
